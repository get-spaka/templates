{% assign channel = data.navigation | where: "label", "YouTube" | first %}
<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-16 md:px-10 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="text-[clamp(2.75rem,5.5vw,5rem)]" data-reveal>Every video</h2>
      {% if channel %}<a href="{{ channel.href }}" target="_blank" rel="noopener" class="btn btn-outline whitespace-nowrap" data-reveal>More on our YouTube channel <span aria-hidden="true">↗</span></a>{% endif %}
    </div>
    <ul class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {% for video in data.videos %}
      <li data-reveal>{% render 'video-card', video: video %}</li>
      {% endfor %}
    </ul>
  </div>
</section>
