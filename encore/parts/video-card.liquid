<a href="{{ video.url }}" target="_blank" rel="noopener" class="video-card group block">
  <span class="relative block overflow-hidden rounded-box bg-base-200" data-bw>
    {% if video.poster %}<img src="{{ video.poster }}" class="aspect-video w-full object-cover">{% else %}<span class="block aspect-video w-full bg-linear-to-br from-base-300 to-base-200"></span>{% endif %}
    <span class="absolute inset-x-0 bottom-0 z-[2] flex items-end justify-between gap-3 bg-linear-to-t from-neutral/85 to-transparent p-4 pt-12">
      <span class="mono rounded-field bg-neutral/80 px-3 py-1 text-[0.6875rem] text-neutral-content">{{ video.kind }}</span>
      <span class="mono rounded-field bg-neutral/80 px-3 py-1 text-[0.6875rem] text-neutral-content">{{ video.runtime }}</span>
    </span>
    <span class="absolute top-4 left-4 z-[2] flex size-12 items-center justify-center rounded-full bg-primary text-primary-content transition-transform group-hover:scale-110" aria-hidden="true"><svg class="ml-0.5 size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l12.5-7.5z"/></svg></span>
  </span>
  <span class="mt-4 flex items-start justify-between gap-4">
    <span class="display text-[1.625rem] leading-none transition-colors group-hover:text-primary">{{ video.title }}</span>
    <span class="mono shrink-0 pt-1 text-[0.6875rem] text-base-content/60">{{ video.date | date: "%b %Y" }}</span>
  </span>
  <span class="mono mt-2 block text-[0.6875rem] text-base-content/60">Watch on YouTube <span aria-hidden="true">↗</span></span>
</a>
