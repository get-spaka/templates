<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-14 md:px-10 md:py-20">
    <h2 class="text-center"><span class="mono text-base-content/70">Listen everywhere</span></h2>
    <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 md:gap-x-16">
      {% for item in data.navigation %}{% if item.place == "listen" %}
      {% assign style = forloop.index0 | modulo: 4 %}
      <li><a href="{{ item.href }}" target="_blank" rel="noopener" class="text-base-content/75 transition-colors hover:text-primary {% case style %}{% when 0 %}display text-[2.25rem] leading-none{% when 1 %}text-[1.625rem] font-semibold tracking-tight{% when 2 %}mono text-[1rem]{% else %}text-[1.625rem] font-light italic{% endcase %}">{{ item.label }}</a></li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
