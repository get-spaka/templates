{% assign today = "now" | date: "%Y-%m-%d" %}
<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-14 md:px-10 md:py-20" data-board>
    {% assign month = "" %}{% assign count = 0 %}
    {% for show in data.events %}{% if show.date >= today %}{% assign count = count | plus: 1 %}
    {% assign m = show.date | date: "%B %Y" %}
    {% if m != month %}{% if month != "" %}</ol>{% endif %}
    <h2 class="{% if month != '' %}mt-14 {% endif %}flex items-center justify-between gap-4"><span class="mono text-base-content/70">{{ m }}</span></h2>
    <ol class="mt-4 border-t border-base-300" aria-label="{{ m }}">
    {% assign month = m %}{% endif %}
      <li class="border-b border-base-300">{% render 'show-row', show: show, details: true %}</li>
    {% endif %}{% endfor %}
    {% if month != "" %}</ol>{% endif %}
    {% if count == 0 %}<p class="max-w-xl text-base-content/80">No dates on the board right now. Join the list below and you will hear first when we come to your town.</p>{% endif %}
  </div>
</section>
