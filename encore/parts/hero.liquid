{% assign featured = data.releases | where: "featured", true | first %}{% unless featured %}{% assign featured = data.releases | first %}{% endunless %}
{% assign today = "now" | date: "%Y-%m-%d" %}
{% assign next = nil %}{% for show in data.events %}{% if show.date >= today %}{% assign next = show %}{% break %}{% endif %}{% endfor %}
<section class="stage-light overflow-hidden text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-4 pt-10 pb-16 md:px-10 md:pt-16 md:pb-24 lg:grid-cols-12 lg:items-center lg:gap-10">
    <div class="lg:col-span-7">
      <p class="mono flex items-center gap-3 text-base-content/75"><span class="dot dot-accent" aria-hidden="true"></span>On tour · Winter and spring 2027</p>
      <h1 class="poster mt-6 text-[clamp(4.5rem,15vw,15rem)] leading-[0.82] tracking-tight text-balance">Velvet Freight</h1>
      <p class="mt-8 max-w-xl text-[clamp(1.25rem,2vw,1.625rem)] leading-snug text-pretty">Slow-burning soul from the shore of Lake Superior.</p>
      {% if next %}
      <a href="/shows" class="board-row mt-10 inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-2 rounded-box p-1 text-[0.8125rem] md:text-sm" data-board="load" data-board-row>
        <span class="flap text-primary" data-flap>Next</span>
        <span class="flap" data-flap>{{ next.date | date: "%b %d" }}</span>
        <span class="flap" data-flap>{{ next.title }}</span>
        <span class="flap" data-flap>{{ next.place }}</span>
        {% if next.status == "Sold out" or next.status == "Few left" %}<span class="flap text-accent" data-flap>{{ next.status }}</span>{% endif %}
      </a>
      {% endif %}
    </div>
    {% if featured %}
    <div class="lg:col-span-5">
      <a href="/music/{{ featured.id }}" class="block max-w-[34rem]" aria-label="{{ featured.title }}">
        {% render 'sleeve', release: featured, place: 'hero', flight: true %}
      </a>
      <div class="mt-8 max-w-[34rem]">
        <p class="mono flex items-center gap-3 text-base-content/75"><span class="dot" aria-hidden="true"></span>{% if featured.type == "Album" %}New album{% elsif featured.type == "EP" %}New EP{% elsif featured.type == "Single" %}New single{% else %}New live record{% endif %} · {% if featured.date > today %}Out {{ featured.date | date: "%B %-d" }}{% else %}Out now{% endif %}</p>
        <h2 class="mt-3 text-[clamp(2.75rem,5vw,4.5rem)]"><a href="/music/{{ featured.id }}" class="transition-colors hover:text-primary">{{ featured.title }}</a></h2>
        {% if featured.listen.size > 0 %}
        <ul class="mono mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[0.75rem] text-base-content/70" aria-label="Listen on">
          {% for link in featured.listen %}<li><a href="{{ link.href }}" target="_blank" rel="noopener" class="whitespace-nowrap transition-colors hover:text-primary">{{ link.label }}</a></li>{% endfor %}
        </ul>
        {% endif %}
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/music/{{ featured.id }}#listen" class="btn btn-primary whitespace-nowrap">Listen</a>
          {% if featured.buy %}<a href="{{ featured.buy }}" target="_blank" rel="noopener" class="btn btn-outline whitespace-nowrap">{% if featured.formats contains "LP" %}Buy the LP{% else %}Buy the record{% endif %} <span aria-hidden="true">↗</span></a>{% endif %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</section>
