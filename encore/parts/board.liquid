{% assign today = "now" | date: "%Y-%m-%d" %}
<section id="shows" class="border-t border-base-300 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-16 md:px-10 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="mono flex items-center gap-3 text-base-content/70" data-reveal><span class="dot dot-accent" aria-hidden="true"></span>The Breakwater tour</p>
        <h2 class="mt-4 text-[clamp(3rem,7vw,6rem)]" data-reveal>On the road</h2>
      </div>
      <a href="/shows" class="btn btn-outline whitespace-nowrap" data-reveal>All dates <span aria-hidden="true">→</span></a>
    </div>
    {% assign count = 0 %}
    <ol class="mt-12 border-t border-base-300" data-board aria-label="Upcoming shows">
      {% for show in data.events %}{% if show.date >= today %}{% assign count = count | plus: 1 %}
      <li class="border-b border-base-300">{% render 'show-row', show: show %}</li>
      {% if count >= 6 %}{% break %}{% endif %}
      {% endif %}{% endfor %}
    </ol>
    {% if count == 0 %}<p class="mt-8 max-w-xl text-base-content/80">No dates on the board right now. Join the list below and you will hear first when we come to your town.</p>{% endif %}
  </div>
</section>
