<section id="booking" class="scroll-mt-20 border-t border-base-300 text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-14 px-4 py-16 md:px-10 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="mono flex items-center gap-3 text-base-content/70"><span class="dot dot-accent" aria-hidden="true"></span>Promoters, festivals, private events</p>
      <h2 class="mt-4 text-[clamp(2.75rem,5.5vw,5rem)]">Book the band</h2>
      <p class="copy mt-5 max-w-xl text-pretty">Tell us the date, the room and what kind of night it is. Our booking agent reads every request and writes back within a week.</p>
      <form hx-post="/_data/bookings" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#booking-problems swap:innerHTML" class="mt-10 flex flex-col gap-8">
        <fieldset>
          <legend class="mono text-base-content/70">The show</legend>
          <div class="mt-4 grid gap-x-4 gap-y-1 sm:grid-cols-2">
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Date of the show</legend>
              <input name="date" type="date" class="input w-full" required>
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Expected capacity <span class="font-normal text-base-content/60">(optional)</span></legend>
              <input name="capacity" type="number" min="1" max="100000" step="1" class="input w-full" placeholder="450">
            </fieldset>
            <fieldset class="fieldset sm:col-span-2">
              <legend class="fieldset-legend">City and venue or event</legend>
              <input name="city" type="text" class="input w-full" required maxlength="200" placeholder="Minneapolis, Larkspur Hall">
            </fieldset>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-4" role="radiogroup" aria-label="Kind of show">
            <label class="flex cursor-pointer items-center gap-3 rounded-field border border-base-300 px-4 py-3 has-checked:border-primary has-checked:bg-base-200">
              <input type="radio" name="kind" value="Club show" class="radio radio-primary radio-sm" checked>
              <span class="text-sm font-semibold">Club show</span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-field border border-base-300 px-4 py-3 has-checked:border-primary has-checked:bg-base-200">
              <input type="radio" name="kind" value="Festival" class="radio radio-primary radio-sm">
              <span class="text-sm font-semibold">Festival</span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-field border border-base-300 px-4 py-3 has-checked:border-primary has-checked:bg-base-200">
              <input type="radio" name="kind" value="Private event" class="radio radio-primary radio-sm">
              <span class="text-sm font-semibold">Private event</span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-field border border-base-300 px-4 py-3 has-checked:border-primary has-checked:bg-base-200">
              <input type="radio" name="kind" value="Something else" class="radio radio-primary radio-sm">
              <span class="text-sm font-semibold">Something else</span>
            </label>
          </div>
        </fieldset>
        <fieldset>
          <legend class="mono text-base-content/70">You</legend>
          <div class="mt-4 grid gap-x-4 gap-y-1 sm:grid-cols-2">
            <fieldset class="fieldset sm:col-span-2">
              <legend class="fieldset-legend">Your name</legend>
              <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Your email</legend>
              <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
            </fieldset>
            <fieldset class="fieldset">
              <legend class="fieldset-legend">Your phone <span class="font-normal text-base-content/60">(optional)</span></legend>
              <input name="phone" type="tel" class="input w-full" maxlength="30" autocomplete="tel">
            </fieldset>
            <fieldset class="fieldset sm:col-span-2">
              <legend class="fieldset-legend">Message <span class="font-normal text-base-content/60">(optional)</span></legend>
              <textarea name="message" class="textarea w-full rounded-box" rows="5" maxlength="4000" placeholder="The room, the bill, the fee you have in mind."></textarea>
            </fieldset>
          </div>
        </fieldset>
        <div id="booking-problems" class="empty:hidden"></div>
        <div class="flex flex-col items-start gap-3 border-t border-base-300 pt-8">
          <button type="submit" class="btn btn-primary btn-lg whitespace-nowrap">Send the request</button>
          <p class="mono text-[0.6875rem] text-base-content/60">Nothing is confirmed until our agent writes back.</p>
        </div>
      </form>
    </div>
    <aside class="lg:col-span-5 lg:pt-28">
      <div class="paper rounded-box p-6 md:p-10">
        <h3 class="text-[2.25rem]">For promoters</h3>
        <ul class="mt-6 space-y-6">
          {% for item in data["contact-rider"] %}
          <li class="border-t border-secondary-content/20 pt-5">
            <p class="flex items-center gap-3 font-semibold"><span class="mono text-secondary-content/60">{{ forloop.index | prepend: "0" | slice: -2, 2 }}</span>{{ item.title }}</p>
            {% if item.text %}<p class="mt-2 pl-9 text-secondary-content/80 text-pretty">{{ item.text }}</p>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
    </aside>
  </div>
</section>
