{% assign featured = data.releases | where: "featured", true | first %}{% unless featured %}{% assign featured = data.releases | first %}{% endunless %}
<header class="site-header sticky top-0 z-50 text-base-content">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center justify-between gap-6 px-4 md:h-20 md:px-10">
    <a href="/" class="display shrink-0 text-2xl tracking-[0.02em] whitespace-nowrap md:text-[1.75rem]">Velvet Freight</a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 xl:gap-10">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
        <li><a href="{{ item.href }}" class="mono whitespace-nowrap underline-offset-[0.6em] transition-colors hover:text-primary {% if page.url == item.href or page.url contains item.href and item.href != '/' %}text-primary underline decoration-1{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href="{% if featured %}/music/{{ featured.id }}#listen{% else %}/music{% endif %}" class="btn btn-primary btn-sm whitespace-nowrap md:btn-md"><span class="dot bg-primary-content shadow-none" aria-hidden="true"></span>Listen</a>
      <details class="site-menu lg:hidden">
        <summary class="btn btn-ghost btn-square relative z-[70]" aria-label="Menu">
          <svg class="menu-open size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h11"/></svg>
          <svg class="menu-close size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6 6 18"/></svg>
        </summary>
        <nav aria-label="Main" class="fixed inset-0 z-[60] flex flex-col justify-between overflow-y-auto bg-neutral px-6 pt-24 pb-10 text-neutral-content">
          <ul class="space-y-1">
            {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
            <li><a href="{{ item.href }}" class="display block text-[clamp(3rem,15vw,5rem)] leading-[1] transition-colors hover:text-primary {% if page.url == item.href %}text-primary{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endif %}{% endfor %}
          </ul>
          <div class="mt-12 space-y-5">
            <a href="/contact#booking" class="btn btn-outline btn-lg w-full">Book the band</a>
            <p class="mono text-neutral-content/70">Duluth, Minnesota · Since 2019</p>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
