<!doctype html>
<html lang="en">
<head>
<title>Contact — Velvet Freight</title>
<meta name="description" content="Book Velvet Freight for a club show, a festival or a private event, or write to the band's agents, publicist and management in North America and Europe.">
<meta property="og:title" content="Contact — Velvet Freight">
<meta property="og:description" content="Booking, press, or just hello.">
</head>
<body>
{% render 'header', page: page %}
<main>
<section class="stage-light text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 pt-12 pb-12 md:px-10 md:pt-20 md:pb-16">
    <p class="mono text-base-content/70">Write to us</p>
    <h1 class="poster mt-5 text-[clamp(4.5rem,13vw,12rem)] leading-[0.82] tracking-tight">Contact</h1>
    <p class="mt-8 max-w-2xl text-[clamp(1.25rem,2vw,1.625rem)] leading-snug text-pretty">Booking, press, or just hello.</p>
  </div>
</section>
<section class="border-t border-base-300 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-16 md:px-10 md:py-20">
    <h2 class="text-[clamp(2.5rem,5vw,4rem)]" data-reveal>Who to write to</h2>
    <div class="mt-10">{% render 'contact-cards', contacts: data.contacts, wide: true %}</div>
  </div>
</section>
{% render 'booking' %}
{% render 'mailing-list' %}
</main>
{% render 'footer' %}
</body>
</html>
