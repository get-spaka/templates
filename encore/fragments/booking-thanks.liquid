<div class="flex flex-col gap-3 rounded-box border border-primary/50 bg-base-200 p-6 md:p-8" role="status">
  <p class="mono flex items-center gap-3 text-primary"><span class="dot" aria-hidden="true"></span>Request received</p>
  <p class="display text-[2.25rem] leading-none">Thank you{% if record.name %}, {{ record.name }}{% endif %}</p>
  <p class="copy max-w-lg">Our booking agent reads every request and will write back within a week{% if record.date %} about {{ record.date | date: "%B %-d, %Y" }}{% endif %}{% if record.city %} in {{ record.city }}{% endif %}, with our fee and what we need.</p>
</div>
