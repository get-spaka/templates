<!doctype html>
<html lang="en">
<head>
<title>{{ record.title }} — Weddings — Incline Flowers</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.title }} — Weddings — Incline Flowers">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header', page: page %}
<main>
<article>
  <header class="bg-base-100 text-base-content">
    <div class="mx-auto max-w-[80rem] px-5 pt-14 md:px-8 md:pt-20" data-reveal>
      <a href="/weddings" class="mono text-base-content/75 hover:text-base-content">← The wedding book</a>
      <h1 class="mt-6 text-[clamp(3rem,6vw+1rem,6rem)] leading-[0.98]">{{ record.title }}</h1>
      <p class="mono-md mt-5">{{ record.date | date: "%B %Y" }} · {{ record.venue }}</p>
    </div>
    <div class="mx-auto mt-10 max-w-[80rem] px-5 md:px-8">
      {% if record.cover %}<img src="{{ record.cover }}" class="aspect-[16/9] w-full rounded-box object-cover">{% else %}<div class="aspect-[16/9] w-full rounded-box bg-gradient-to-br from-secondary to-primary/40"></div>{% endif %}
    </div>
  </header>
  <div class="bg-base-100 text-base-content">
    <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-10">
      <aside class="lg:col-span-4">
        <dl class="mono-md divide-y divide-base-300 border-y border-base-300">
          <div class="flex justify-between gap-4 py-3"><dt class="text-base-content/75">Venue</dt><dd class="text-right">{{ record.venue }}</dd></div>
          <div class="flex justify-between gap-4 py-3"><dt class="text-base-content/75">Season</dt><dd class="text-right">{{ record.date | date: "%B" }}</dd></div>
          <div class="flex justify-between gap-4 py-3"><dt class="text-base-content/75">Guests</dt><dd class="text-right">{{ record.guests }}</dd></div>
          <div class="flex justify-between gap-4 py-3"><dt class="text-base-content/75">Service</dt><dd class="text-right">{{ record.service | capitalize }}</dd></div>
        </dl>
        <p class="mono mt-8 text-base-content/75">In it</p>
        {% assign month = record.date | date: "%b" | downcase %}<div class="mt-3">{% render 'stem-chips', names: record.stems, stems: data.stems, month: month %}</div>
      </aside>
      <div class="story-copy body-copy max-w-[62ch] text-[1.125rem] lg:col-span-7 lg:col-start-6">{{ record.body }}</div>
    </div>
  </div>
  {% if record.photos.size > 0 %}
  <section class="bg-base-100 text-base-content">
    <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28">
      <div class="columns-1 gap-5 sm:columns-2 [&>*]:mb-5" data-reveal="stagger">
        {% for photo in record.photos %}<img src="{{ photo }}" class="w-full break-inside-avoid rounded-box object-cover">{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}
</article>
<section class="bg-secondary text-secondary-content">
  <div class="mx-auto max-w-[80rem] px-5 py-16 md:px-8 md:py-20">
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between" data-reveal>
      <p class="font-heading text-[clamp(1.75rem,2vw+1rem,2.5rem)] font-light leading-[1.1]">Planning yours?</p>
      <a href="/weddings#consultation" class="btn btn-primary btn-lg whitespace-nowrap">Plan yours</a>
    </div>
    <ul class="mt-12 grid gap-6 border-t border-secondary-content/25 pt-8 md:grid-cols-2">
      {% assign shown = 0 %}
      {% for other in data.weddings %}{% if other.id != record.id and shown < 2 %}{% assign shown = shown | plus: 1 %}
      <li><a href="/weddings/{{ other.id }}" class="group flex items-center gap-5">
        {% if other.cover %}<img src="{{ other.cover }}" class="aspect-square w-24 flex-none rounded-box object-cover">{% endif %}
        <span><span class="block font-heading text-[1.5rem] group-hover:underline">{{ other.title }}</span><span class="mono block">{{ other.venue }} · {{ other.date | date: "%B" }}</span></span>
      </a></li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
