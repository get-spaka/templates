<section id="zip" class="scroll-mt-28 bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5" data-reveal>
        <h2 class="text-[clamp(2rem,3vw+1rem,3.25rem)]">Do we deliver to you?</h2>
        <form action="#zones" method="get" class="mt-8" data-zip-check>
          <label for="zip-field" class="mono text-base-content/75">Your ZIP code</label>
          <div class="mt-2 flex gap-2">
            <input id="zip-field" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" class="input input-lg mono-md w-full max-w-[12rem]" placeholder="15217">
            <button class="btn btn-primary btn-lg whitespace-nowrap">Check</button>
          </div>
          <div class="mt-5 text-[1.125rem] leading-relaxed" aria-live="polite">
            {% for zone in data.zones %}
            <p class="zip-answer" data-zip-answer="{{ zone.id }}" hidden>Yes, <span class="mono-md font-semibold" data-slot="zip"></span> is in {{ zone.name }}: {{ zone.fee }}, {% if zone.same_day %}same day when you order by 1&nbsp;pm{% else %}next day when you order by 1&nbsp;pm{% endif %}.</p>
            {% endfor %}
            <p class="zip-answer" data-zip-answer="none" hidden>We don't drive to <span class="mono-md font-semibold" data-slot="zip"></span>. Pick up at the shop, or <a href="tel:+14125550147" class="text-link whitespace-nowrap">call us</a>: we'll send you to a florist near them.</p>
          </div>
        </form>
      </div>
      <div id="zones" class="scroll-mt-28 lg:col-span-7">
        <ul class="space-y-3" data-reveal="stagger">
          {% for zone in data.zones %}
          <li class="zone-row rounded-box bg-base-200 p-6" data-zips="{{ zone.zips | join: ' ' }}" data-zone="{{ zone.id }}">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="text-[1.5rem]">{{ zone.name }}</h3>
              <p class="mono-md figures"><span class="font-semibold">{{ zone.fee }}</span> · {% if zone.same_day %}same day{% else %}next day only{% endif %}{% if zone.note != blank and zone.same_day %} · {{ zone.note }}{% endif %}</p>
            </div>
            <p class="body-copy mt-2">{{ zone.neighborhoods }}</p>
            <p class="mono figures mt-3 text-base-content/75">{{ zone.zips | join: " · " }}</p>
          </li>
          {% endfor %}
        </ul>
        <p class="body-copy mt-5">Zone 1 is free when the order comes to $150 or more. Outside the zones, pick up at the shop.</p>
      </div>
    </div>
  </div>
</section>
