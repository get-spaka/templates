      <details class="month scroll-mt-28 border-b border-base-300" id="aug" data-month-row="aug" >
        <summary class="grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-5 md:grid-cols-[13rem_1fr] md:pb-3">
