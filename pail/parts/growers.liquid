<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="mono text-base-content/75">Seven stems in ten, May to October</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">Who grows them</h2>
      <p class="body-copy mt-5 max-w-[38ch]">In winter we buy from a wholesaler and say where each stem came from, on its plate.</p>
    </div>
    <ul class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:col-span-8" data-reveal="stagger">
      {% for grower in data.growers %}
      <li class="border-t border-base-content pt-5">
        <p class="mono text-base-content/75">{{ grower.place }} · {{ grower.distance }}</p>
        <h3 class="mt-2 text-[1.5rem]">{{ grower.title }}</h3>
        <p class="mt-2 font-medium">{{ grower.what }}</p>
        <p class="body-copy mt-2">{{ grower.text }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
