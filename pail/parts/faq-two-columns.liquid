<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="mono text-base-content/75">Questions</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">{{ title }}</h2>
    </div>
    <dl class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2" data-reveal="stagger">
      {% for q in items %}
      <div class="border-t border-base-300 pt-5">
        <dt class="text-[1.125rem] font-medium">{{ q.question }}</dt>
        <dd class="body-copy mt-2">{{ q.answer }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
