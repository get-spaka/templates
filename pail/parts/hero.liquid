<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] items-end gap-12 px-5 pt-14 pb-20 md:px-8 md:pt-20 md:pb-24 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7 lg:pb-10" data-reveal>
      <p class="mono text-base-content/75">Flower shop &amp; studio · South Side, Pittsburgh</p>
      <h1 class="mt-5 text-[clamp(3rem,6.5vw+1rem,6.75rem)] leading-[0.98] tracking-[-0.015em]">Picked this morning. On your table by tonight.</h1>
      <p class="body-copy mt-7 max-w-[54ch] text-[1.125rem]">Flowers from growers within a hundred miles from May to October, chosen by the stem, wrapped by hand, and driven across the rivers in our van.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/flowers#order" class="btn btn-primary btn-lg whitespace-nowrap">Order flowers</a>
        <a href="#this-week" class="btn btn-outline btn-lg whitespace-nowrap">See what's in</a>
      </div>
      <p class="mono-md mt-9 text-[1.0625rem] font-medium">{% render 'order-by' %}</p>
    </div>
    {% assign week = data.stems | where: "this_week" %}
    {% assign tall = week | where: "height", "tall" %}
    {% assign medium = week | where: "height", "medium" %}
    <div class="hero-pails lg:col-span-5" data-pails>
      {% if medium[0] %}{% render 'pail', stem: medium[0] %}{% endif %}
      {% if tall[0] %}{% render 'pail', stem: tall[0] %}{% endif %}
      {% if medium[1] %}{% render 'pail', stem: medium[1] %}{% endif %}
    </div>
  </div>
</section>
