<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 text-base-content">
  <div class="bg-neutral text-neutral-content">
    <div class="mono mx-auto flex max-w-[80rem] items-center justify-between gap-4 px-5 py-1.5 md:px-8">
      <p class="min-w-0">{% render 'order-by' %}</p>
      <a href="/delivery#zip" class="hidden whitespace-nowrap underline decoration-1 underline-offset-[3px] hover:decoration-2 sm:inline">Do we deliver to you?</a>
    </div>
  </div>
  <div class="mx-auto flex h-[4.5rem] max-w-[80rem] items-center justify-between gap-6 px-5 md:px-8">
    {% render 'logo' %}
    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1 whitespace-nowrap">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
        <li><a href="{{ item.href }}" class="rounded-full px-3.5 py-2 font-medium hover:bg-base-200 aria-[current=page]:bg-base-200" {% if page.url contains item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/flowers#order" class="btn btn-primary hidden whitespace-nowrap sm:inline-flex">Order flowers</a>
      <details class="site-menu xl:hidden">
        <summary class="btn btn-ghost relative z-[60] px-3" aria-label="Menu">
          <span class="menu-open inline-flex items-center gap-2"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>Menu</span><span class="menu-close">Close</span>
        </summary>
        <nav aria-label="Main" class="fixed inset-0 z-50 flex flex-col justify-between overflow-y-auto bg-base-100 px-6 pt-32 pb-10 text-base-content">
          <ul class="space-y-2">
            {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
            <li><a href="{{ item.href }}" class="font-heading text-[2.5rem] font-light leading-[1.15]" {% if page.url contains item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endif %}{% endfor %}
          </ul>
          <div class="mt-12 flex flex-col gap-4">
            <a href="/flowers#order" class="btn btn-primary btn-lg">Order flowers</a>
            <a href="/delivery#zip" class="btn btn-outline btn-lg">Do we deliver to you?</a>
            <p class="mono text-base-content/75">37 Mercer Steps · South Side · Pittsburgh, PA</p>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
