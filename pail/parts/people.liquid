<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="mono text-base-content/75">Behind the counter</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">The people</h2>
    </div>
    <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {% for person in data.team %}
      <li>
        {% if person.photo %}<img src="{{ person.photo }}" class="aspect-square w-full rounded-box object-cover">{% else %}{% assign parts = person.name | split: " " %}<div class="grid aspect-square w-full place-items-center rounded-box bg-secondary text-secondary-content" aria-hidden="true"><span class="wordmark text-[clamp(3rem,6vw,4.5rem)]">{{ parts[0] | slice: 0 }}{{ parts[1] | slice: 0 }}</span></div>{% endif %}
        <h3 class="mt-5 text-[1.375rem]">{{ person.name }}</h3>
        <p class="mono mt-1 text-base-content/75">{{ person.role }}</p>
        <p class="body-copy mt-3">{{ person.bio }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
