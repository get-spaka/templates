<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="max-w-[40rem]" data-reveal>
      <p class="mono text-base-content/75">The florist's choice</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">Three sizes, built from what came in</h2>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-3" data-reveal="stagger">
      {% for size in data.sizes %}
      <li class="flex flex-col rounded-box border {% if size.featured %}border-base-content bg-secondary text-secondary-content{% else %}border-base-300 bg-base-100{% endif %} p-7 md:p-8">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="text-[1.5rem]">{{ size.name }}</h3>
          {% if size.featured %}<p class="mono whitespace-nowrap">Most asked for</p>{% endif %}
        </div>
        <p class="figure-serif mt-6 text-[clamp(2.5rem,3vw+1rem,3.5rem)]">{{ size.price }}</p>
        <p class="mono mt-3">{{ size.stems }}</p>
        <p class="body-copy mt-3">{{ size.suits }}</p>
        <a href="/flowers?size={{ size.id }}#order" class="btn {% if size.featured %}btn-primary{% else %}btn-outline{% endif %} mt-8 self-start whitespace-nowrap">Order a{% if size.name == "Armful" %}n{% endif %} {{ size.name }}</a>
      </li>
      {% endfor %}
    </ul>
    <p class="body-copy mt-8">Wrapped in paper, or in a vase for $18 more. Same price whatever's in season.</p>
  </div>
</section>
