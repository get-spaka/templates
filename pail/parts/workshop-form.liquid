<section id="seat" class="scroll-mt-28 bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="mono text-base-content/75">Twelve seats a night</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">Save your seats</h2>
      <p class="body-copy mt-5">You pay at the door; cancel by text two days before.</p>
    </div>
    <form hx-post="/_data/workshop-requests" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#seat-problems swap:innerHTML" class="grid grid-cols-1 gap-x-5 gap-y-3 sm:grid-cols-2 lg:col-span-8" data-prefill>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">The workshop</legend>
        <select name="workshop" class="select w-full" required>
          {% for w in data.workshops %}<option value="{{ w.title }}, {{ w.date | date: '%B %-d' }}" data-id="{{ w.id }}">{{ w.title }}, {{ w.date | date: "%B %-d" }}</option>{% endfor %}
        </select>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">How many seats</legend>
        <input name="seats" type="number" class="input w-full" required min="1" max="12" value="1">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">Your name</legend>
        <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your email</legend>
        <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your phone</legend>
        <input name="phone" type="tel" class="input w-full" maxlength="30" autocomplete="tel">
      </fieldset>
      <div id="seat-problems" class="sm:col-span-2"></div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 sm:col-span-2">
        <button class="btn btn-primary btn-lg whitespace-nowrap">Save my seats</button>
        <p class="mono text-base-content/75">You pay at the door; cancel by text two days before.</p>
      </div>
    </form>
  </div>
</section>
