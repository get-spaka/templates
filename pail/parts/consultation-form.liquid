<section id="consultation" class="scroll-mt-28 bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="mono text-base-content/75">The 2027 season is booking</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">Ask for a consultation</h2>
      <p class="body-copy mt-5">Nia writes back within two working days to find an hour, in the shop or by video.</p>
      <div class="mt-8 rounded-box bg-base-200 p-6">
        <p class="font-heading text-[1.375rem]">What's in on your date?</p>
        <p class="body-copy mt-2">The year in stems shows what will be in the pails, month by month.</p>
        <a href="/season" class="text-link mt-3 inline-block font-medium">See the season</a>
      </div>
    </div>
    <form hx-post="/_data/consultations" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#consultation-problems swap:innerHTML" class="grid grid-cols-1 gap-x-5 gap-y-3 sm:grid-cols-2 lg:col-span-8">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">The date</legend>
        <input name="date" type="date" class="input w-full" required>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">How many guests</legend>
        <input name="guests" type="number" class="input w-full" min="1" max="2000">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">The venue</legend>
        <input name="venue" type="text" class="input w-full" maxlength="300">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">Full service or market pails</legend>
        <div class="flex flex-wrap gap-x-8 gap-y-2 pt-1">
          <label class="flex items-center gap-3 text-[1rem]"><input type="radio" name="service" value="full service" class="radio radio-sm" required checked> Full service</label>
          <label class="flex items-center gap-3 text-[1rem]"><input type="radio" name="service" value="market pails" class="radio radio-sm"> Market pails</label>
          <label class="flex items-center gap-3 text-[1rem]"><input type="radio" name="service" value="not sure yet" class="radio radio-sm"> Not sure yet</label>
        </div>
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">Your budget for flowers</legend>
        <select name="budget" class="select w-full">
          <option value="under $1,000">Under $1,000</option>
          <option value="$1,000 to $2,800">$1,000 to $2,800</option>
          <option value="$2,800 to $5,000" selected>$2,800 to $5,000</option>
          <option value="over $5,000">Over $5,000</option>
        </select>
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">The colors and stems you love</legend>
        <textarea name="notes" class="textarea w-full rounded-box" rows="4" maxlength="3000"></textarea>
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">Your names</legend>
        <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your email</legend>
        <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your phone</legend>
        <input name="phone" type="tel" class="input w-full" maxlength="30" autocomplete="tel">
      </fieldset>
      <div id="consultation-problems" class="sm:col-span-2"></div>
      <div class="sm:col-span-2"><button class="btn btn-primary btn-lg whitespace-nowrap">Ask for a consultation</button></div>
    </form>
  </div>
</section>
