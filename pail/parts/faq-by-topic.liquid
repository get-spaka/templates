<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="mono text-base-content/75">Questions</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">About the van</h2>
    </div>
    {% assign topics = items | map: "topic" | uniq %}
    <div class="mt-12 grid gap-12 lg:grid-cols-3">
      {% for topic in topics %}
      <div>
        <p class="mono text-base-content/75">{{ topic }}</p>
        <div class="mt-4 divide-y divide-base-300 border-y border-base-300">
          {% for q in items %}{% if q.topic == topic %}
          <details class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3.5 font-medium [&::-webkit-details-marker]:hidden">
              <span>{{ q.question }}</span>
              <svg class="size-4 flex-none transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <div class="body-copy pb-4">{{ q.answer }}</div>
          </details>
          {% endif %}{% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
