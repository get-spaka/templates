<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28">
    <div class="border-t border-base-content pt-8" data-reveal>
      <p class="mono text-base-content/75">The wedding book</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">Four weddings, four seasons</h2>
    </div>
    <ul class="mt-14 space-y-20 md:space-y-28">
      {% for wedding in data.weddings %}
      <li class="grid items-center gap-8 md:grid-cols-12 md:gap-10" data-reveal>
        <a href="/weddings/{{ wedding.id }}" class="block overflow-hidden rounded-box md:col-span-6 {% cycle '', 'md:order-2 md:col-start-7' %}">
          {% if wedding.cover %}<img src="{{ wedding.cover }}" class="aspect-[4/5] w-full object-cover">{% else %}<div class="aspect-[4/5] w-full bg-gradient-to-b from-secondary to-primary/40"></div>{% endif %}
        </a>
        <div class="md:col-span-5 {% cycle 'md:col-start-8', 'md:col-start-1 md:row-start-1' %}">
          <p class="mono text-base-content/75">{{ wedding.venue }} · {{ wedding.date | date: "%B" }} · {{ wedding.service | capitalize }}</p>
          <h3 class="mt-3 text-[clamp(2rem,2.5vw+1rem,3rem)] font-light">{{ wedding.title }}</h3>
          <p class="body-copy mt-4 max-w-[44ch]">{{ wedding.summary }}</p>
          <div class="mt-6">{% render 'stem-chips', names: wedding.stems, stems: data.stems %}</div>
          <a href="/weddings/{{ wedding.id }}" class="text-link mt-7 inline-block font-medium">See this wedding</a>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
