{%- comment -%} Numbered steps on a line: pass items, label and title. {%- endcomment -%}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <div data-reveal>
      <p class="mono text-base-content/75">{{ label }}</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">{{ title }}</h2>
    </div>
    <ol class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {% for step in items %}
      <li class="border-t border-base-content pt-5">
        <p class="figure-serif text-[2.5rem] font-light">{{ forloop.index }}</p>
        <h3 class="mt-4 text-[1.375rem]">{{ step.title }}</h3>
        <p class="body-copy mt-2">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
