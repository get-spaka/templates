<section id="visit" class="scroll-mt-28 bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5" data-reveal>
      <p class="mono text-base-content/75">Visit</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">37 Mercer Steps</h2>
      <address class="body-copy mt-5 not-italic">South Side Flats, a block off East Carson Street<br>Pittsburgh, PA 15203</address>
      <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2"><a href="https://www.openstreetmap.org/search?query=37%20Mercer%20Steps%2C%20Pittsburgh%2C%20PA%2015203" class="text-link font-medium" rel="noopener" target="_blank">Get directions</a><a href="tel:+14125550147" class="text-link whitespace-nowrap font-medium">(412) 555-0147</a></p>
      <p class="body-copy mt-8 max-w-[40ch]">The pails are on the sidewalk from April to October; in winter, in the window.</p>
    </div>
    <table class="w-full lg:col-span-7">
      <tbody class="divide-y divide-base-300 border-y border-base-300">
        {% for day in data.hours %}
        <tr>
          <th scope="row" class="py-3.5 pr-4 text-left font-medium">{{ day.day }}</th>
          <td class="mono-md figures py-3.5 pr-4">{{ day.hours }}</td>
          <td class="mono py-3.5 text-right text-base-content/75">{{ day.note }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
