<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="mono text-base-content/75">At home</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">Looking after them</h2>
    </div>
    <ol class="divide-y divide-base-300 border-y border-base-300 lg:col-span-8" data-reveal="stagger">
      {% for tip in data.care-tips %}
      <li class="grid gap-x-6 gap-y-1 py-5 sm:grid-cols-[2.5rem_14rem_1fr]">
        <span class="mono text-base-content/75">{{ forloop.index }}</span>
        <h3 class="text-[1.25rem]">{{ tip.title }}</h3>
        <p class="body-copy">{{ tip.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
