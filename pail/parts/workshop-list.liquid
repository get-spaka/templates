<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-24">
    <ul class="divide-y divide-base-300 border-y border-base-content" data-reveal="stagger">
      {% for w in data.workshops %}
      <li class="grid gap-5 py-8 sm:grid-cols-[6.5rem_1fr] md:grid-cols-[7.5rem_1fr_auto] md:items-center md:gap-8">
        <p class="flex items-baseline gap-3 sm:block"><span class="figure-serif block text-[3rem] font-light">{{ w.date | date: "%-d" }}</span><span class="mono block">{{ w.date | date: "%B %Y" }}</span></p>
        <div>
          <h2 class="text-[1.75rem] font-normal">{{ w.title }}</h2>
          <p class="mono mt-2 text-base-content/75">{{ w.time }} · {{ w.seats }} seats · {{ w.price }}</p>
          <p class="body-copy mt-3 max-w-[58ch]">{{ w.summary }}</p>
        </div>
        <a href="{{ w.booking }}" class="btn btn-outline self-start whitespace-nowrap sm:col-start-2 md:col-start-auto md:self-center">Save a seat</a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
