<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="mono text-base-content/75">One shop, four doors</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">Beyond the counter</h2>
      <p class="body-copy mt-6 max-w-[38ch]">The same pails, the same cooler and the same van, for the days that need more than a bunch.</p>
    </div>
    <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:col-span-8" data-reveal="stagger">
      {% for door in data.home-doors %}
      <li class="border-t border-base-content pt-6">
        <h3 class="text-[1.5rem]">{{ door.title }}</h3>
        <p class="body-copy mt-3">{{ door.text }}</p>
        <a href="{{ door.href }}" class="text-link mt-4 inline-block font-medium">{{ door.link }}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
