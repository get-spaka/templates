<footer class="bg-neutral text-neutral-content" data-tz="America/Chicago">
  <div class="mx-auto max-w-[80rem] px-5 pt-20 pb-10 md:px-8 md:pt-24">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-end gap-2 whitespace-nowrap" aria-label="Oriel, home">
  <svg class="logo-cup h-11 w-11 shrink-0" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <g data-steam fill="currentColor" opacity="0.55">
      <ellipse class="puff" cx="14" cy="9" rx="2.6" ry="3.6" style="filter: blur(0.6px)"/>
      <ellipse class="puff" cx="20" cy="6.5" rx="2.6" ry="3.8" style="filter: blur(0.6px)"/>
      <ellipse class="puff" cx="26" cy="9" rx="2.6" ry="3.6" style="filter: blur(0.6px)"/>
    </g>
    <path d="M8 17h22v6.5a9.5 9.5 0 0 1-9.5 9.5h-3A9.5 9.5 0 0 1 8 23.5V17Z" fill="currentColor"/>
    <path d="M30 19.5h1.8a3.7 3.7 0 0 1 0 7.4H29" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    <ellipse cx="19" cy="35.5" rx="15" ry="2.5" class="fill-primary"/>
  </svg>
  <span class="font-heading leading-none text-[2.5rem]">Oriel</span>
</a>
        <p class="mt-6 max-w-[30ch] text-neutral-content/80">Breakfast, lunch and coffee in an old corner pharmacy in Marquette, Madison. Walk in, order at the counter.</p>
        <p class="typed mt-6 flex items-center gap-2"><span class="dot now-dot" aria-hidden="true"></span><span><span data-when="plain">Open 7 to 3, Wednesday to Monday</span><span data-when="before">Opening today at <span data-slot="opens"></span></span><span data-when="breakfast">Serving breakfast till <span data-slot="until"></span></span><span data-when="lunch">Serving lunch till <span data-slot="until"></span></span><span data-when="coffee">Coffee and the bakery case till <span data-slot="until"></span></span><span data-when="after">Closed for the day · back <span data-slot="next_day"></span> at <span data-slot="next_opens"></span></span><span data-when="closed">Closed today · back <span data-slot="next_day"></span> at <span data-slot="next_opens"></span></span></span></p>
      </div>
      <div class="lg:col-span-4">
        <p class="typed text-neutral-content/70">The hours</p>
        <ul class="typed-md mt-4 space-y-1.5">
          <li class="grid grid-cols-[7.5rem_1fr] gap-x-3" data-hours-row data-weekday="monday" data-day="Monday" data-opens="07:00" data-lunch-from="11:30" data-kitchen-closes="14:30" data-closes="15:00"><span>Monday</span><span><span data-time="opens">7&nbsp;am</span> – <span data-time="closes">3&nbsp;pm</span><span hidden data-time="lunch-from">11:30&nbsp;am</span><span hidden data-time="kitchen-closes">2:30&nbsp;pm</span></span></li>
          <li class="grid grid-cols-[7.5rem_1fr] gap-x-3" data-hours-row data-weekday="tuesday" data-day="Tuesday" data-opens="" data-lunch-from="" data-kitchen-closes="" data-closes=""><span>Tuesday</span><span class="text-neutral-content/70">Closed</span></li>
          <li class="grid grid-cols-[7.5rem_1fr] gap-x-3" data-hours-row data-weekday="wednesday" data-day="Wednesday" data-opens="07:00" data-lunch-from="11:30" data-kitchen-closes="14:30" data-closes="15:00"><span>Wednesday</span><span><span data-time="opens">7&nbsp;am</span> – <span data-time="closes">3&nbsp;pm</span><span hidden data-time="lunch-from">11:30&nbsp;am</span><span hidden data-time="kitchen-closes">2:30&nbsp;pm</span></span></li>
          <li class="grid grid-cols-[7.5rem_1fr] gap-x-3" data-hours-row data-weekday="thursday" data-day="Thursday" data-opens="07:00" data-lunch-from="11:30" data-kitchen-closes="14:30" data-closes="15:00"><span>Thursday</span><span><span data-time="opens">7&nbsp;am</span> – <span data-time="closes">3&nbsp;pm</span><span hidden data-time="lunch-from">11:30&nbsp;am</span><span hidden data-time="kitchen-closes">2:30&nbsp;pm</span></span></li>
          <li class="grid grid-cols-[7.5rem_1fr] gap-x-3" data-hours-row data-weekday="friday" data-day="Friday" data-opens="07:00" data-lunch-from="11:30" data-kitchen-closes="14:30" data-closes="15:00"><span>Friday</span><span><span data-time="opens">7&nbsp;am</span> – <span data-time="closes">3&nbsp;pm</span><span hidden data-time="lunch-from">11:30&nbsp;am</span><span hidden data-time="kitchen-closes">2:30&nbsp;pm</span></span></li>
          <li class="grid grid-cols-[7.5rem_1fr] gap-x-3" data-hours-row data-weekday="saturday" data-day="Saturday" data-opens="08:00" data-lunch-from="" data-kitchen-closes="14:30" data-closes="15:00"><span>Saturday</span><span><span data-time="opens">8&nbsp;am</span> – <span data-time="closes">3&nbsp;pm</span><span hidden data-time="kitchen-closes">2:30&nbsp;pm</span></span></li>
          <li class="grid grid-cols-[7.5rem_1fr] gap-x-3" data-hours-row data-weekday="sunday" data-day="Sunday" data-opens="08:00" data-lunch-from="" data-kitchen-closes="14:30" data-closes="15:00"><span>Sunday</span><span><span data-time="opens">8&nbsp;am</span> – <span data-time="closes">3&nbsp;pm</span><span hidden data-time="kitchen-closes">2:30&nbsp;pm</span></span></li>
        </ul>
        <p class="typed mt-5 text-neutral-content/70">Gift cards at the counter.</p>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 lg:col-span-4">
        <div>
          <p class="typed text-neutral-content/70">Find us</p>
          <address class="mt-4 not-italic leading-relaxed">2 Larkspur Row<br>Marquette, Madison, WI&nbsp;53703</address>
          <p class="mt-3"><a href="https://www.openstreetmap.org/search?query=2%20Larkspur%20Row%2C%20Madison%2C%20WI" class="text-link" rel="noopener" target="_blank">Get directions</a></p>
          <p class="mt-3"><a href="tel:+16085550147" class="text-link whitespace-nowrap">(608) 555-0147</a></p>
        </div>
        <div>
          <p class="typed text-neutral-content/70">Oriel</p>
          <nav aria-label="Footer" class="mt-4">
            <ul class="space-y-1.5">
              {% for item in data.navigation %}{% if item.place != "social" %}
              <li><a href="{{ item.href }}" class="text-link">{{ item.label }}</a></li>
              {% endif %}{% endfor %}
              {% for item in data.navigation %}{% if item.place == "social" %}
              <li><a href="{{ item.href }}" class="text-link" rel="noopener" target="_blank">{{ item.label }}</a></li>
              {% endif %}{% endfor %}
            </ul>
          </nav>
        </div>
      </div>
    </div>
    <p class="typed mt-16 border-t border-neutral-content/20 pt-6 text-neutral-content/70">Oriel · Breakfast and lunch at the old corner pharmacy since 2018 · © 2026</p>
  </div>
</footer>
