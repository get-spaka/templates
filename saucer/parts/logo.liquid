{%- comment -%} The café's name in Caprasimo beside its cup, whose steam rises on load and when the logo is hovered. {%- endcomment -%}
<a href="/" class="inline-flex items-center gap-2 whitespace-nowrap" aria-label="Oriel, home">
  <svg class="logo-cup {{ size | default: 'h-9 w-9' }} shrink-0" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <g data-steam class="fill-base-300">
      <ellipse class="puff" cx="14" cy="9" rx="2.6" ry="3.6" style="filter: blur(0.8px)"/>
      <ellipse class="puff" cx="20" cy="6.5" rx="2.6" ry="3.8" style="filter: blur(0.8px)"/>
      <ellipse class="puff" cx="26" cy="9" rx="2.6" ry="3.6" style="filter: blur(0.8px)"/>
    </g>
    <path d="M8 17h22v6.5a9.5 9.5 0 0 1-9.5 9.5h-3A9.5 9.5 0 0 1 8 23.5V17Z" fill="currentColor"/>
    <path d="M30 19.5h1.8a3.7 3.7 0 0 1 0 7.4H29" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    <ellipse cx="19" cy="35.5" rx="15" ry="2.5" class="fill-primary"/>
  </svg>
  <span class="font-heading leading-none {{ text | default: 'text-[1.875rem]' }}">Oriel</span>
</a>
