<section class="tabletop bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-16 md:px-8 md:py-20">
    <p class="typed text-base-content/75">Specials</p>
    <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">This week</h2>
    <ul class="mt-10 grid gap-12 md:grid-cols-2 md:gap-10" data-plates>
      {% for dish in data.menu %}{% if dish.special %}
      <li class="grid grid-cols-[minmax(0,10rem)_1fr] items-center gap-6 sm:grid-cols-[minmax(0,13rem)_1fr] sm:gap-8">
        {% render 'dish-plate', dish: dish %}
        <div>
          {% if dish.note != blank %}<p class="typed"><span class="rounded-full bg-primary px-2.5 py-1 text-primary-content">{{ dish.note }}</span></p>{% endif %}
          <h3 class="mt-4 text-[1.5rem] leading-[1.1]">{{ dish.name }}</h3>
          <p class="dish-line mt-2 text-base-content/75">{{ dish.description }}</p>
          <p class="price dish-name mt-3">{{ dish.price }}</p>
        </div>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
