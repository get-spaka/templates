{%- comment -%} Questions in an accordion. Pass `items` (a list with question and answer), `label` and `title`; `columns: true` sets them in two columns. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4" data-reveal>
        <p class="typed text-base-content/75">{{ label }}</p>
        <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">{{ title }}</h2>
      </div>
      <div class="lg:col-span-8 {% if columns %}grid gap-x-10 md:grid-cols-2{% endif %}">
        {% for item in items %}
        <details class="group border-b border-base-300 {% if columns %}md:first:border-t md:[&:nth-child(2)]:border-t{% else %}first:border-t{% endif %}">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 dish-name [&::-webkit-details-marker]:hidden">
            <span>{{ item.question }}</span>
            <svg class="mt-1 size-4 shrink-0 transition-transform group-open:rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 2v12M2 8h12"/></svg>
          </summary>
          <div class="body-copy pb-6 [&_a]:underline [&_a]:decoration-primary [&_a]:decoration-2 [&_p+p]:mt-3">{{ item.answer }}</div>
        </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
