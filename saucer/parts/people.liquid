<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <div data-reveal>
      <p class="typed text-base-content/75">The people</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">Who you&rsquo;ll meet at the counter</h2>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4" data-reveal="stagger">
      {% for person in data.team %}
      <li class="flex flex-col items-center text-center">
        <span class="plate w-[min(100%,12rem)] !bg-base-100" style="--rim: 5%">{% if person.photo %}<img src="{{ person.photo }}" class="object-cover">{% else %}<span class="plate-empty font-heading text-[2.75rem]" aria-hidden="true">{{ person.name | slice: 0 }}</span>{% endif %}</span>
        <h3 class="mt-6 text-[1.5rem] leading-[1.1]">{{ person.name }}</h3>
        <p class="typed mt-1 text-base-content/75">{{ person.role }}</p>
        <p class="body-copy mt-3 max-w-[28ch]">{{ person.bio }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
