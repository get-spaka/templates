{%- comment -%} Who we cook with: the suppliers, typed, with what and where. Pass `long: true` to add each one's sentence (the story page), `link: false` to leave out "Our story". {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="typed text-base-content/75">From the market</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">Who we cook with</h2>
      <p class="body-copy mt-5 max-w-[40ch]">Most of what we cook comes from within a morning&rsquo;s drive. Tessa shops the farmers&rsquo; market on the Capitol Square every Saturday, before the café fills up.</p>
      {% if link != false %}<a href="/story" class="btn btn-outline mt-8 border-base-content text-base-content hover:bg-base-content hover:text-base-100">Our story</a>{% endif %}
    </div>
    <ul class="lg:col-span-7 lg:col-start-6" data-reveal="stagger">
      {% for supplier in data.suppliers %}
      <li class="grid grid-cols-[4rem_1fr] items-center gap-5 border-t border-base-300 py-5 last:border-b sm:grid-cols-[5rem_1fr]">
        <span class="plate" style="--rim: 7%">{% if supplier.image %}<img src="{{ supplier.image }}" class="object-cover">{% else %}<span class="plate-empty" aria-hidden="true"></span>{% endif %}</span>
        <div>
          <p class="dish-name"><span>{{ supplier.what }}</span> · <span>{{ supplier.name }}</span></p>
          <p class="typed mt-1 text-base-content/75"><span>{{ supplier.where }}</span>{% if supplier.distance != blank %} · <span>{{ supplier.distance }}</span>{% endif %}</p>
          {% if long %}<p class="body-copy mt-2 max-w-[56ch]">{{ supplier.text }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
