{%- comment -%} A page's title: a typed label, the title in Caprasimo and a sentence. Pass `label`, `title` and `text`. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pt-14 pb-12 md:px-8 md:pt-20 md:pb-16" data-reveal>
    <p class="typed text-base-content/75">{{ label }}</p>
    <h1 class="mt-4 text-[clamp(2.75rem,5vw+1rem,5rem)] leading-[1]">{{ title }}</h1>
    <p class="body-copy mt-6 max-w-[60ch] text-[1.125rem]">{{ text }}</p>
  </div>
</section>
