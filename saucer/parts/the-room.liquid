<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28">
    <div data-reveal>
      <p class="typed text-base-content/75">The room</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">Thirty-eight seats and a bench</h2>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6" data-reveal="stagger">
      {% for photo in data["story-room"] %}
      <li>
        <figure>
          {% if photo.image %}<img src="{{ photo.image }}" class="aspect-square w-full rounded-box object-cover">{% else %}<div class="aspect-square w-full rounded-box bg-linear-to-br from-secondary to-base-200"></div>{% endif %}
          <figcaption class="typed mt-3 text-base-content/80"><span class="font-medium text-base-content">{{ photo.title }}</span>{% if photo.caption != blank %} · {{ photo.caption }}{% endif %}</figcaption>
        </figure>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
