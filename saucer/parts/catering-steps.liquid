<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <div data-reveal>
      <p class="typed text-base-content/75">How it works</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">Four steps, two days ahead</h2>
    </div>
    <ol class="mt-12 grid gap-10 md:grid-cols-4 md:gap-6" data-reveal="stagger">
      {% for step in data["catering-steps"] %}
      <li class="relative md:pt-2">
        <div class="flex items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-primary font-heading text-[1.5rem] text-primary-content">{{ forloop.index }}</span>
          <span class="hidden h-px flex-1 border-t-2 border-dotted border-base-300 md:block" aria-hidden="true"></span>
        </div>
        <p class="dish-name mt-5">{{ step.title }}</p>
        <p class="body-copy mt-2">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
