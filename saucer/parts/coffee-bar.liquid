<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 pb-20 md:px-8 md:pb-28 lg:grid-cols-12 lg:gap-10">
    <div class="rounded-box bg-secondary p-8 text-secondary-content sm:p-12 lg:col-span-5 lg:self-start" data-reveal>
      <p class="typed">The counter</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">Coffee from the first pour</h2>
      <p class="mt-5 max-w-[42ch] leading-relaxed">Espresso and a pour-over of the week from Ledgerock Coffee, roasted across the isthmus on Tuesdays. Amir pulls the first shot at seven; the counter stays open after the kitchen closes, until three.</p>
      <p class="typed mt-8 border-t border-secondary-content/25 pt-5">Counter open 7 am – 3 pm on weekdays, from 8 am at weekends</p>
    </div>
    <div class="lg:col-span-6 lg:col-start-7 lg:self-center">
      <p class="typed text-base-content/75">Coffee &amp; drinks</p>
      <ul class="mt-3 divide-y divide-dashed divide-base-300">
        {% for dish in data.menu %}{% if dish.course == "drinks" %}{% render 'menu-row', dish: dish, plate: false %}{% endif %}{% endfor %}
      </ul>
      <p class="marks mt-4 text-base-content/70">Oat or whole milk at no extra cost · an extra shot 1</p>
    </div>
  </div>
</section>
