<section id="request" class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 pb-20 md:px-8 md:pb-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4">
      <div class="rounded-box bg-base-200 p-8 lg:sticky lg:top-32">
        <p class="typed text-base-content/75">The request</p>
        <h2 class="mt-3 text-[clamp(2rem,2vw+1rem,2.75rem)]">Tell us what you need</h2>
        <p class="body-copy mt-5">We answer within one working day; nothing is ready until we confirm.</p>
        <p class="body-copy mt-4">In a hurry? Call us at <a href="tel:+16085550147" class="text-link whitespace-nowrap">(608) 555-0147</a> between 7 and 3.</p>
      </div>
    </div>
    <form hx-post="/_data/catering-requests" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#catering-form-problems swap:innerHTML" class="grid grid-cols-1 gap-x-5 gap-y-3 sm:grid-cols-2 lg:col-span-8">
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">Your name</legend>
        <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your email</legend>
        <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your phone</legend>
        <input name="phone" type="tel" class="input w-full" required maxlength="30" autocomplete="tel">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">The date</legend>
        <input name="date" type="date" class="input w-full" required>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">The time</legend>
        <input name="time" type="text" class="input w-full" required maxlength="40" placeholder="8:30 am">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">Pickup or delivery</legend>
        <div class="flex flex-wrap gap-x-8 gap-y-2 pt-1">
          <label class="flex items-center gap-3 text-[1rem]"><input type="radio" name="how" value="pickup" class="radio radio-sm" required checked> Pickup, from 6:30 am</label>
          <label class="flex items-center gap-3 text-[1rem]"><input type="radio" name="how" value="delivery" class="radio radio-sm"> Delivery, within three miles</label>
        </div>
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">The address, for a delivery</legend>
        <input name="address" type="text" class="input w-full" maxlength="300" autocomplete="street-address">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">What you would like</legend>
        <div class="grid gap-x-6 gap-y-2.5 pt-1 sm:grid-cols-2">
          <label class="flex items-center gap-3 text-[1rem]"><input type="checkbox" name="items" value="pastry box" class="checkbox checkbox-sm"> The pastry box</label>
          <label class="flex items-center gap-3 text-[1rem]"><input type="checkbox" name="items" value="breakfast sandwich tray" class="checkbox checkbox-sm"> Breakfast sandwich tray</label>
          <label class="flex items-center gap-3 text-[1rem]"><input type="checkbox" name="items" value="yogurt and granola jars" class="checkbox checkbox-sm"> Yogurt and granola jars</label>
          <label class="flex items-center gap-3 text-[1rem]"><input type="checkbox" name="items" value="boxed lunches" class="checkbox checkbox-sm"> Boxed lunches</label>
          <label class="flex items-center gap-3 text-[1rem]"><input type="checkbox" name="items" value="coffee traveler" class="checkbox checkbox-sm"> Coffee traveler</label>
        </div>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">How many people</legend>
        <input name="people" type="number" class="input w-full" required min="1" max="500">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">A note <span class="font-normal text-base-content/70">(allergies, how many vegan or gluten-free)</span></legend>
        <textarea name="note" class="textarea w-full rounded-box" rows="4" maxlength="3000"></textarea>
      </fieldset>
      <div id="catering-form-problems" class="empty:hidden sm:col-span-2"></div>
      <div class="mt-3 sm:col-span-2">
        <button type="submit" class="btn btn-primary btn-lg">Send the request</button>
      </div>
    </form>
  </div>
</section>
