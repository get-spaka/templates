<section id="hours" class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 pb-20 md:px-8 md:pb-28 lg:grid-cols-12 lg:items-start lg:gap-10">
    <div class="lg:col-span-7">
      {% render 'door', hours: data.hours, note: "Closed Tuesdays, and on the first week of January" %}
    </div>
    <div class="lg:col-span-4 lg:col-start-9 lg:pt-10" data-reveal>
      <p class="typed text-base-content/75">The hours</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.5rem)]">Open from seven, Wednesday to Monday</h2>
      <p class="body-copy mt-5">On weekdays the kitchen serves breakfast until half past eleven, then lunch until half past two; the counter keeps pouring coffee until three. At weekends we open at eight and serve breakfast all day.</p>
      <p class="body-copy mt-4">The card on the door tells you whether we&rsquo;re open right now. Tap it to read the other side.</p>
    </div>
  </div>
</section>
