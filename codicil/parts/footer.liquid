<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-7xl px-5 pt-16 md:px-8 md:pt-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" class="font-heading text-[2rem] leading-tight">Kesler Lund &amp; Carrow</a>
        <p class="sc mt-2 text-neutral-content/70">Attorneys at law · Since 2009</p>
        <p class="mt-6 max-w-xs text-base leading-relaxed text-neutral-content/80">A brick townhouse in Church Hill, ten minutes from the courts downtown. The meeting room is on the ground floor, step-free through the garden gate.</p>
      </div>
      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8">
        <div>
          <h2 class="sc text-neutral-content/60">The office</h2>
          <address class="mt-4 leading-relaxed not-italic">23 Haverly Street<br>Church Hill, Richmond, <span class="whitespace-nowrap">VA 23223</span></address>
          <a href="https://www.google.com/maps/search/?api=1&amp;query=Church+Hill+Richmond+VA" class="mt-3 inline-flex font-medium underline underline-offset-4">Get directions</a>
          <p class="mt-6 leading-relaxed"><a href="tel:+18045550123" class="tabular-nums hover:underline">(804) 555-0123</a><br><a href="mailto:office@keslerlundcarrow.com" class="break-all hover:underline">office@keslerlundcarrow.com</a></p>
        </div>
        <div>
          <h2 class="sc text-neutral-content/60">Hours</h2>
          <ul class="mt-4 space-y-3 text-[0.9375rem] tabular-nums">
            {% for row in data.hours %}
            <li><span class="block">{{ row.day }}</span><span class="block text-neutral-content/70">{% if row.opens != blank %}{{ row.opens }} to {{ row.closes }}{% if row.note != blank %}, {{ row.note | downcase }}{% endif %}{% else %}{{ row.note }}{% endif %}</span></li>
            {% endfor %}
          </ul>
        </div>
        <nav aria-label="Footer">
          <h2 class="sc text-neutral-content/60">Pages</h2>
          <ul class="mt-4 space-y-2">
            {% for item in data.navigation %}{% unless item.place == "header" or item.place == "social" %}
            <li><a href="{{ item.href }}" class="hover:underline">{{ item.label }}</a></li>
            {% endunless %}{% endfor %}
          </ul>
        </nav>
      </div>
    </div>
    <div class="mt-16 grid gap-4 border-t border-neutral-content/15 py-7 text-[0.8125rem] leading-relaxed text-neutral-content/70 md:grid-cols-12">
      <p class="md:col-span-9">Attorney advertising. Writing to us does not make us your lawyers, and we can't act for you until we've checked for conflicts: please don't send confidential details until we confirm.</p>
      <p class="md:col-span-3 md:text-right">© 2026 Kesler Lund &amp; Carrow, PLLC</p>
    </div>
  </div>
</footer>
