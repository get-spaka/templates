{% assign areas = data["practice-areas"] %}
<section id="what-we-do" class="bg-base-100 text-base-content" {% unless full %}data-clause{% endunless %} data-index>
  <div class="mx-auto max-w-7xl px-5 {% if full %}pt-4 pb-20 md:pt-6 md:pb-28{% else %}py-20 md:py-28{% endif %}">
    {% unless full %}
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="sc clause text-base-content/70">What we do</p>
        <h2 class="mt-4 text-[clamp(2rem,2.5vw+1rem,3.25rem)] leading-[1.08] tracking-[-0.01em] text-balance">Six areas, one firm</h2>
      </div>
      <p class="max-w-[52ch] text-[1.0625rem] leading-relaxed text-base-content/80 lg:col-span-5">Each area is led by a partner who stays with your matter from the first meeting to the last letter. Choose a tab to bring its sheet to the front.</p>
    </div>
    {% endunless %}
    <div class="index-file relative {% unless full %}mt-12{% endunless %}" style="--tabs: {{ areas.size }}">
      {% for area in areas %}
      <input type="radio" name="practice-index" id="area-{{ area.id }}" class="index-input sr-only" {% if forloop.first %}checked{% endif %}>
      <label for="area-{{ area.id }}" class="index-tab"><span class="index-no meta">{{ forloop.index | prepend: "0" | slice: -2, 2 }}</span><span class="sc text-[0.9375rem] leading-tight">{% if area.short != blank %}{{ area.short }}{% else %}{{ area.name }}{% endif %}</span></label>
      <article class="index-sheet" data-sheet="{{ area.id }}" aria-label="{{ area.name }}">
        <div class="grid gap-10 p-6 sm:p-8 lg:grid-cols-12 lg:gap-12 lg:p-12">
          <div class="lg:col-span-7">
            <h3 class="text-[clamp(1.75rem,1.5vw+1rem,2.5rem)] leading-tight">{{ area.name }}</h3>
            <p class="mt-4 max-w-[56ch] text-[1.0625rem] leading-relaxed text-base-content/80">{{ area.summary }}</p>
            {% if area.handles.size > 0 %}
            <h4 class="sc mt-9 text-base-content/60">We handle</h4>
            <ul class="mt-3 grid gap-x-8 border-t border-base-300 sm:grid-cols-2">
              {% for item in area.handles %}<li class="flex gap-3 border-b border-base-300 py-2.5 text-[0.9375rem] leading-snug"><span class="mt-[0.55em] size-1.5 shrink-0 bg-accent" aria-hidden="true"></span>{{ item }}</li>{% endfor %}
            </ul>
            {% endif %}
          </div>
          <div class="flex flex-col gap-8 lg:col-span-5">
            {% if area.situations.size > 0 %}
            <div>
              <h4 class="sc text-base-content/60">When to call us</h4>
              <ul class="mt-3 space-y-3">
                {% for line in area.situations %}<li class="font-heading text-[1.25rem] leading-snug italic">“{{ line }}”</li>{% endfor %}
              </ul>
            </div>
            {% endif %}
            <div class="mt-auto flex items-center gap-4 border-t border-base-300 pt-6">
              {% if area.lead_photo %}
              <img src="{{ area.lead_photo }}" class="size-16 shrink-0 object-cover">
              {% else %}
              {% assign words = area.lead | split: " " %}
              <span class="flex size-16 shrink-0 items-center justify-center bg-secondary font-heading text-[1.5rem] text-secondary-content" aria-hidden="true">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
              {% endif %}
              <div class="min-w-0">
                <p class="meta text-base-content/60">Led by</p>
                <p class="text-[1.0625rem] font-medium">{{ area.lead }}</p>
                {% if area.lead_role != blank %}<p class="meta text-base-content/70">{{ area.lead_role }}</p>{% endif %}
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
              {% if area.fee_from != blank %}<p class="text-[1.0625rem] tabular-nums">{{ area.fee_from }}</p>{% endif %}
              <a href="/practice/{{ area.id }}" class="inline-flex items-center gap-2 font-medium text-primary underline decoration-base-300 underline-offset-[0.3em] hover:decoration-accent">More about {{ area.name | downcase }}<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></a>
            </div>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
