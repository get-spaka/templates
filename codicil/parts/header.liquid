<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 text-base-content backdrop-blur">
  <div class="hidden border-b border-base-300 bg-base-200 md:block">
    <div class="mx-auto flex h-9 max-w-7xl items-center gap-6 px-5 text-[0.8125rem] whitespace-nowrap md:px-8">
      <a href="tel:+18045550123" class="font-medium tabular-nums hover:underline">(804) 555-0123</a>
      <span class="text-base-content/70">Church Hill, Richmond · By appointment</span>
      <span class="ml-auto hidden text-base-content/70 tabular-nums lg:inline">Monday to Friday, 8:30 am to 5:30 pm · Thursdays until 7 pm</span>
    </div>
  </div>
  <div class="mx-auto flex h-[4.5rem] max-w-7xl items-center gap-6 px-5 md:px-8">
    <a href="/" class="flex min-w-0 shrink-0 items-baseline gap-4" aria-label="Kesler Lund &amp; Carrow, attorneys at law, home">
      <span class="font-heading text-[1.375rem] leading-none whitespace-nowrap sm:text-[1.625rem] lg:text-[1.375rem] xl:text-[1.625rem]">Kesler Lund &amp; Carrow</span>
      <span class="sc hidden border-l border-base-300 pl-4 text-[0.875rem] whitespace-nowrap text-base-content/70 xl:inline">Attorneys at law</span>
    </a>
    <nav aria-label="Main" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-5 text-[0.9375rem] xl:gap-7 font-medium whitespace-nowrap">
        {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
        <li><a href="{{ item.href }}" class="py-2 underline-offset-[0.45em] hover:underline {% if page.url contains item.href %}underline decoration-accent decoration-[1.5px]{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endunless %}{% endfor %}
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2 lg:ml-4">
      <a href="/consultation" class="btn btn-primary hidden whitespace-nowrap sm:inline-flex">Request a consultation</a>
      <div class="dropdown dropdown-end lg:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Open the menu">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
        </div>
        <div tabindex="0" class="dropdown-content z-50 mt-3 w-72 border border-base-300 bg-base-100 p-3">
          <ul class="menu w-full p-0 text-base">
            {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
            <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endunless %}{% endfor %}
          </ul>
          <div class="mt-2 flex flex-col gap-2 border-t border-base-300 px-1 pt-3">
            <a href="/consultation" class="btn btn-primary">Request a consultation</a>
            <a href="tel:+18045550123" class="btn btn-ghost">Call (804) 555-0123</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
