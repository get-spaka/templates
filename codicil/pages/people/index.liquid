<!doctype html>
<html lang="en">
<head>
<title>People — Kesler Lund &amp; Carrow, Richmond</title>
<meta name="description" content="The four partners of Kesler Lund &amp; Carrow and the lawyers who work with them, with their areas, admissions and a page each.">
<meta property="og:title" content="People — Kesler Lund &amp; Carrow">
<meta property="og:description" content="Every matter has a partner from the first meeting to the last letter.">
</head>
<body>
{% render 'header', page: page %}
<main class="bg-base-100 text-base-content">
<section>
  <div class="mx-auto max-w-7xl px-5 pt-14 pb-12 md:px-8 md:pt-20 md:pb-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-8">
        <p class="sc text-base-content/70">People</p>
        <h1 class="mt-5 text-[clamp(2.5rem,4vw+1rem,4.5rem)] leading-[1.04] tracking-[-0.01em] text-balance">The partners, and the lawyers who work with them</h1>
      </div>
      <p class="max-w-[52ch] text-[1.125rem] leading-relaxed text-base-content/80 lg:col-span-4 lg:pb-2">Every matter has a partner from the first meeting to the last letter.</p>
    </div>
  </div>
</section>
<section id="partners" data-clause>
  <div class="mx-auto max-w-7xl px-5 pb-20 md:px-8 md:pb-28">
    <h2 class="sc clause text-base-content/70">The partners</h2>
    <div class="mt-6">{% render 'people-rows', partners: true %}</div>
  </div>
</section>
<section id="associates" data-clause>
  <div class="mx-auto max-w-7xl px-5 pb-20 md:px-8 md:pb-28">
    <h2 class="sc clause text-base-content/70">The associates</h2>
    <div class="mt-6">{% render 'people-rows', partners: false %}</div>
  </div>
</section>
<section id="also-at-the-firm" class="bg-base-200" data-clause>
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 md:px-8 md:py-20 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 class="sc clause text-base-content/70">Also at the firm</h2>
      <p class="mt-4 max-w-[40ch] text-[1.0625rem] leading-relaxed text-base-content/80">The people who answer the phone, keep the files and make sure nothing is missed.</p>
    </div>
    <ul class="border-t border-base-content/15 lg:col-span-8">
      {% for person in data["firm-staff"] %}
      <li class="grid gap-1 border-b border-base-content/15 py-4 sm:grid-cols-[14rem_minmax(0,1fr)] sm:gap-6"><span class="font-heading text-[1.375rem] leading-snug">{{ person.name }}</span><span class="text-[1.0625rem] leading-relaxed text-base-content/80">{{ person.role }}</span></li>
      {% endfor %}
    </ul>
  </div>
</section>
{% render 'request-band' %}
</main>
{% render 'footer' %}
</body>
</html>
