<!doctype html>
<html lang="en">
<head>
<title>{{ record.name }} — Kesler Lund &amp; Carrow, Richmond</title>
<meta name="description" content="{{ record.name }}, {{ record.role }} at Kesler Lund &amp; Carrow in Richmond, Virginia. {{ record.bio }}">
<meta property="og:title" content="{{ record.name }} — Kesler Lund &amp; Carrow">
<meta property="og:description" content="{{ record.bio }}">
</head>
<body>
{% render 'header', page: page %}
{% assign words = record.name | split: " " %}
<main class="bg-base-100 text-base-content">
<article class="mx-auto grid max-w-7xl gap-x-16 gap-y-10 px-5 pt-12 pb-20 md:px-8 md:pt-16 md:pb-28 lg:grid-cols-12 lg:grid-rows-[auto_auto_1fr]">
  <div class="lg:col-span-12">
    <a href="/people" class="meta inline-flex items-center gap-2 text-primary hover:underline"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M19 12H5"/><path d="m11 18-6-6 6-6"/></svg>People</a>
  </div>
  <div class="order-3 lg:order-none lg:col-span-4 lg:row-span-2 lg:row-start-2" data-reveal>
    <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-5 sm:grid-cols-[10rem_minmax(0,1fr)] lg:block">
      <div class="border border-base-300 p-1.5 sm:p-2">
        {% if record.photo %}
        <img src="{{ record.photo }}" class="aspect-[3/4] w-full object-cover">
        {% else %}
        <div class="flex aspect-[3/4] w-full items-center justify-center bg-secondary text-secondary-content" aria-hidden="true"><span class="font-heading text-[2.5rem] sm:text-[4rem] lg:text-[6rem]">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span></div>
        {% endif %}
      </div>
      <dl class="min-w-0 border-t border-base-300 text-[0.9375rem] lg:mt-8">
        {% if record.areas.size > 0 %}<div class="border-b border-base-300 py-3"><dt class="sc text-base-content/60">Areas</dt><dd class="mt-1">{{ record.areas | join: ", " }}</dd></div>{% endif %}
        {% if record.admitted.size > 0 %}<div class="border-b border-base-300 py-3"><dt class="sc text-base-content/60">Admitted</dt><dd class="mt-1"><ul>{% for item in record.admitted %}<li>{{ item }}</li>{% endfor %}</ul></dd></div>{% endif %}
        {% if record.education.size > 0 %}<div class="hidden border-b border-base-300 py-3 sm:block"><dt class="sc text-base-content/60">Education</dt><dd class="mt-1"><ul class="space-y-1">{% for item in record.education %}<li>{{ item }}</li>{% endfor %}</ul></dd></div>{% endif %}
        {% if record.languages != blank %}<div class="border-b border-base-300 py-3"><dt class="sc text-base-content/60">Languages</dt><dd class="mt-1">{{ record.languages }}</dd></div>{% endif %}
        {% if record.before != blank %}<div class="hidden border-b border-base-300 py-3 sm:block"><dt class="sc text-base-content/60">Before the firm</dt><dd class="mt-1">{{ record.before }}</dd></div>{% endif %}
      </dl>
    </div>
    <dl class="mt-0 border-b border-base-300 text-[0.9375rem] sm:hidden">
      {% if record.education.size > 0 %}<div class="border-b border-base-300 py-3"><dt class="sc text-base-content/60">Education</dt><dd class="mt-1"><ul class="space-y-1">{% for item in record.education %}<li>{{ item }}</li>{% endfor %}</ul></dd></div>{% endif %}
      {% if record.before != blank %}<div class="py-3"><dt class="sc text-base-content/60">Before the firm</dt><dd class="mt-1">{{ record.before }}</dd></div>{% endif %}
    </dl>
  </div>
  <div class="order-2 lg:order-none lg:col-span-8 lg:col-start-5 lg:row-start-2 lg:pt-4">
    <div data-reveal>
      <h1 class="text-[clamp(2.5rem,4vw+1rem,4.5rem)] leading-[1.04] tracking-[-0.01em] text-balance">{{ record.name }}</h1>
      {% if record.role != blank %}<p class="sc mt-4 text-[1.0625rem] text-base-content/70">{{ record.role }}</p>{% endif %}
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-[1.0625rem]">
        {% if record.phone != blank %}<a href="tel:{{ record.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | prepend: '+1' }}" class="tabular-nums underline decoration-base-300 underline-offset-4 hover:decoration-accent">{{ record.phone }}</a>{% endif %}
        {% if record.email != blank %}<a href="mailto:{{ record.email }}" class="break-all underline decoration-base-300 underline-offset-4 hover:decoration-accent">{{ record.email }}</a>{% endif %}
      </p>
      {% if record.bio != blank %}<p class="mt-10 max-w-[40ch] font-heading text-[1.625rem] leading-snug text-balance">{{ record.bio }}</p>{% endif %}
    </div>
  </div>
  <div class="order-4 lg:order-none lg:col-span-8 lg:col-start-5 lg:row-start-3">
    {% if record.body != blank %}<div class="prose-codicil max-w-[64ch] border-t border-base-300 pt-10" data-reveal>{{ record.body }}</div>{% endif %}
    <div class="mt-12 flex flex-wrap items-center gap-4" data-reveal>
      <a href="/consultation?with={{ record.id }}" class="btn btn-primary btn-lg h-auto min-h-14 py-3">Request a consultation with {{ words.first }}</a>
    </div>
  </div>
</article>

{% assign their_posts = data.blog | where: "author", record.name %}
{% if their_posts.size > 0 %}
<section class="border-t border-base-300">
  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-20">
    <h2 class="text-[clamp(1.75rem,1.5vw+1rem,2.5rem)] leading-tight" data-reveal>Articles by {{ words.first }}</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-2" data-reveal="stagger">
      {% for post in their_posts limit: 4 %}{% render 'memo-slip', post: post, summary: true %}{% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="bg-base-200">
  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-20">
    <h2 class="sc text-base-content/60">The other partners</h2>
    <ul class="mt-6 grid gap-x-8 border-t border-base-content/15 sm:grid-cols-2 lg:grid-cols-4">
      {% for member in data.team %}{% if member.partner and member.id != record.id %}
      <li class="border-b border-base-content/15"><a href="/people/{{ member.id }}" class="group block py-4"><span class="block font-heading text-[1.375rem] leading-snug group-hover:text-primary">{{ member.name }}</span><span class="meta block text-base-content/70">{{ member.role }}</span></a></li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
