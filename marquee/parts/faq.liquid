{% if only %}{% assign topics = only | split: "," %}{% else %}{% assign topics = data.faq | map: "topic" | compact | uniq %}{% endif %}
<section class="bg-base-100 text-base-content" id="questions">
  <div class="mx-auto max-w-[90rem] px-4 py-16 md:px-10 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-[clamp(3rem,9vw,8rem)]" data-rise>Questions</h2>
      <p class="max-w-sm text-pretty">Something not here? Write to <a href="mailto:hello@hotstatic.fr" class="underline decoration-2 underline-offset-4">hello@hotstatic.fr</a>; we answer within two days.</p>
    </div>
    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-x-16">
      {% for topic in topics %}
      {% assign questions = data.faq | where: "topic", topic %}
      <div>
        <h3 class="tag text-base">{{ topic }}</h3>
        <div class="mt-3 divide-y-2 divide-base-content border-y-2 border-base-content">
          {% for item in questions %}
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-xl font-semibold [&::-webkit-details-marker]:hidden">
              <span>{{ item.question }}</span>
              <span class="flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-base-content text-xl transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="max-w-2xl space-y-2 pb-6 text-pretty text-base-content/85">{{ item.answer }}</div>
          </details>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
