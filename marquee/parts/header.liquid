<header class="pointer-events-none sticky top-0 z-50 -mb-[4.5rem] px-3 pt-3 md:-mb-[5rem] md:px-5 md:pt-4">
  <div class="pointer-events-auto mx-auto flex max-w-[90rem] items-center justify-between gap-3 rounded-full border-2 border-neutral bg-neutral py-2 pr-2 pl-5 text-neutral-content md:pl-6">
    <a href="/" class="flex items-baseline gap-3 whitespace-nowrap">
      <span class="tag text-base md:text-lg" style="--wdth: 110">Hot Static</span>
      <span class="tag hidden text-neutral-content/70 sm:inline">09—11.07.27</span>
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="whitespace-nowrap flex items-center gap-7">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
        <li><a href="{{ item.href }}" class="tag text-sm transition-colors hover:text-primary {% if page.url == item.href %}text-primary{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="flex items-center gap-1">
      <a href="/tickets" class="btn btn-primary btn-sm tag md:btn-md">Get passes</a>
      <div class="dropdown dropdown-end lg:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-sm text-neutral-content" aria-label="Open menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h16"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-20 mt-3 w-56 rounded-box border-2 border-base-content bg-base-100 p-2 text-base-content">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
          <li><a href="{{ item.href }}" class="tag text-base" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</header>
