<section class="bg-base-200 text-base-content" id="acts">
  <div class="mx-auto max-w-[90rem] px-4 py-16 md:px-10 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-[clamp(3rem,9vw,8rem)]" data-rise>Every act</h2>
      <p class="max-w-sm text-pretty">The twelve sets to plan your days around. The rest of the forty-one are on the bill above, and in the timetable.</p>
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for act in data.acts %}
      {% assign day = data.days | where: "title", act.day | first %}
      <li data-day="{{ act.day }}">
        <a href="/lineup/{{ act.id }}" class="group flex h-full flex-col overflow-hidden rounded-box border-2 border-base-content bg-base-100 transition-transform hover:-translate-y-1">
          <div class="{% cycle 'duotone', 'duotone-secondary' %} aspect-[4/3] border-b-2 border-base-content">
            {% if act.image %}<img src="{{ act.image }}" class="size-full object-cover">{% endif %}
          </div>
          <div class="flex flex-1 flex-col gap-3 p-5">
            <p class="tag text-xs">{{ act.day | slice: 0, 3 }} {{ day.date | date: "%d" }} · {{ act.start }} · {{ act.stage }}</p>
            <h3 class="text-4xl group-hover:text-primary">{{ act.name }}</h3>
            <p class="text-pretty text-base-content/80">{{ act.summary }}</p>
            <p class="tag mt-auto flex flex-wrap justify-between gap-2 pt-2 text-xs"><span>{{ act.genre }}</span><span>{{ act.origin }}</span></p>
          </div>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
