<section class="relative z-20 -mt-12 overflow-x-clip py-4 md:-mt-16" aria-label="Hot Static in short">
  <div class="tape-band -mx-8 border-y-2 border-base-content bg-primary py-3 text-primary-content md:py-4" style="--tilt: -3deg">
    <ul class="flex w-max items-center whitespace-nowrap" data-tape>
      {% for item in data["home-tape"] %}
      <li class="tag flex items-center gap-6 pr-6 text-3xl md:gap-8 md:pr-8 md:text-4xl" style="--wdth: 90">{{ item.label }}<span aria-hidden="true">✺</span></li>
      {% endfor %}
    </ul>
  </div>
  <div class="tape-band relative -mx-8 -mt-1 border-y-2 border-neutral bg-neutral py-3 text-neutral-content md:-mt-16 md:py-4" style="--tilt: 2deg" aria-hidden="true">
    <ul class="flex w-max items-center whitespace-nowrap" data-tape data-reverse>
      {% for item in data["home-tape"] %}
      <li class="tag flex items-center gap-6 pr-6 text-3xl md:gap-8 md:pr-8 md:text-4xl" style="--wdth: 90">{{ item.label }}<span aria-hidden="true">✺</span></li>
      {% endfor %}
    </ul>
  </div>
</section>
