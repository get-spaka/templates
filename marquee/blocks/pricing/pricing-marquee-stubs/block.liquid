<section class="bg-base-100 text-base-content" id="passes">
  <div class="mx-auto max-w-[90rem] px-4 py-16 md:px-10 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-[clamp(3rem,9vw,8rem)]" data-rise>Passes</h2>
      <p class="max-w-sm text-pretty">One day, the weekend, or the weekend and the water. With an access card, the person who comes with you gets in free.</p>
    </div>
    <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6" data-tilt>
      {% for pass in data.passes %}
      <li>
        <div class="stub-turn h-full">
          <article class="stub flex h-full flex-col rounded-box {% if pass.status == "sold out" %}bg-base-200 text-base-content/70{% else %}bg-secondary text-secondary-content{% endif %}">
            <div class="flex h-56 flex-col p-6">
              <div class="flex items-start justify-between gap-3">
                <p class="tag text-sm">No. 0{{ forloop.index }} · Hot Static 27</p>
                {% if pass.status %}<span class="stamp tag text-sm {% if pass.status == "few left" %}bg-accent text-accent-content{% endif %}">{{ pass.status }}</span>{% endif %}
              </div>
              <h3 class="mt-auto text-3xl md:text-4xl">{{ pass.name }}</h3>
              <p class="poster mt-2 text-6xl" style="--wdth: 70">{{ pass.price }}</p>
            </div>
            <div class="stub-tear mx-6 opacity-50" aria-hidden="true"></div>
            <div class="flex flex-1 flex-col p-6">
              <p class="tag text-sm">{{ pass.note }}</p>
              <ul class="mt-4 flex-1 space-y-2">
                {% for line in pass.includes %}<li class="flex gap-2"><span aria-hidden="true">✺</span><span>{{ line }}</span></li>{% endfor %}
              </ul>
              {% if pass.status == "sold out" %}
              <span class="btn btn-disabled tag mt-6 text-base" aria-disabled="true">Sold out</span>
              {% else %}
              <a href="{{ pass.link }}" class="btn btn-neutral tag mt-6 text-base">Get {{ pass.name }}</a>
              {% endif %}
            </div>
          </article>
        </div>
      </li>
      {% endfor %}
    </ul>
    <p class="tag mt-10 text-sm">Prices include fees. Under 26? Half price on Sunday.</p>
  </div>
</section>
