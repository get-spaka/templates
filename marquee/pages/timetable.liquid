<!doctype html>
<html lang="en">
<head>
<title>Timetable — Hot Static 2027</title>
<meta name="description" content="Who plays where and when at Hot Static, 9 to 11 July 2027: every set on the four stages of La Raffinerie, day by day.">
<meta property="og:title" content="Timetable — Hot Static 2027">
<meta property="og:description" content="Who plays where and when at Hot Static, 9 to 11 July 2027: every set on the four stages of La Raffinerie, day by day.">
</head>
<body>
{% render 'header' %}
<main>
<section class="relative overflow-hidden text-secondary-content" data-halftone>
  <div class="relative z-10 mx-auto max-w-[90rem] px-4 pt-28 pb-12 md:px-10 md:pt-36 md:pb-16">
    <p class="tag text-sm md:text-base">Four stages · Three days</p>
    <h1 class="poster mt-3 text-[clamp(3rem,14.5vw,12.5rem)]" data-stretch>Timetable</h1>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-12 md:px-10 md:py-16">
    <div role="tablist" class="tabs tabs-border gap-2" aria-label="Day">
      {% for day in data.days %}
      <input type="radio" name="timetable-day" role="tab" class="tab tag h-auto rounded-full border-2 border-base-content px-5 py-2 text-base! checked:bg-base-content checked:text-base-100" aria-label="{{ day.title }} {{ day.date | date: '%d' }}" {% if forloop.first %}checked{% endif %}>
      <div role="tabpanel" class="tab-content order-last w-full pt-8">
        {% assign acts = data.acts | where: "day", day.title %}
        {% assign gates = day.gates | split: ":" %}
        {% assign g = gates[0] | plus: 0 | times: 4 %}
        {% assign gm = gates[1] | plus: 0 | divided_by: 15 %}
        {% assign g = g | plus: gm %}
        {% assign curfew = day.curfew | split: ":" %}
        {% assign c = curfew[0] | plus: 0 | times: 4 %}
        {% assign cm = curfew[1] | plus: 0 | divided_by: 15 %}
        {% assign c = c | plus: cm %}
        {% if c <= g %}{% assign c = c | plus: 96 %}{% endif %}
        {% assign rows = c | minus: g %}
        <div class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-base-content pb-4">
          <h2 class="text-[clamp(2.75rem,7vw,6rem)]">{{ day.title }}</h2>
          <p class="tag text-sm md:text-base">{{ day.date | date: "%d.%m.%Y" }} · Gates {{ day.gates }} · Last set {{ day.curfew }}</p>
        </div>

        <div class="mt-6 hidden md:grid grid-cols-[4rem_repeat(4,minmax(0,1fr))] gap-x-3" style="grid-template-rows: 3rem repeat({{ rows }}, 1rem)">
          {% for stage in data.stages %}
          <p class="tag flex items-center justify-center rounded-full bg-base-content text-sm text-base-100" style="grid-row: 1; grid-column: {{ forloop.index | plus: 1 }}">{{ stage.name }}</p>
          {% endfor %}
          {% for q in (0..rows) %}{% assign m = q | modulo: 4 %}{% if m == 0 and q < rows %}
          {% assign h = q | divided_by: 4 | plus: gates[0] | modulo: 24 %}
          <span class="tag border-t-2 border-base-content/25 pt-1 text-xs" style="grid-row: {{ q | plus: 2 }} / span 4; grid-column: 1">{% if h < 10 %}0{% endif %}{{ h }}:00</span>
          <span class="border-t-2 border-dashed border-base-content/20" style="grid-row: {{ q | plus: 2 }} / span 4; grid-column: 2 / -1" aria-hidden="true"></span>
          {% endif %}{% endfor %}
          {% for act in acts %}
          {% assign col = 2 %}
          {% for stage in data.stages %}{% if stage.name == act.stage %}{% assign col = forloop.index | plus: 1 %}{% endif %}{% endfor %}
          {% assign t = act.start | split: ":" %}
          {% assign s = t[0] | plus: 0 | times: 4 %}{% assign sm = t[1] | plus: 0 | divided_by: 15 %}{% assign s = s | plus: sm %}
          {% if s < g %}{% assign s = s | plus: 96 %}{% endif %}
          {% assign t = act.end | split: ":" %}
          {% assign e = t[0] | plus: 0 | times: 4 %}{% assign em = t[1] | plus: 0 | divided_by: 15 %}{% assign e = e | plus: em %}
          {% if e <= s %}{% assign e = e | plus: 96 %}{% endif %}
          <a href="/lineup/{{ act.id }}" class="relative z-10 m-0.5 flex flex-col gap-1 overflow-hidden rounded-box border-2 border-base-content p-3 transition-transform hover:-translate-y-0.5 {% case act.billing %}{% when "headliner" %}bg-primary text-primary-content{% when "main" %}bg-secondary text-secondary-content{% else %}bg-accent text-accent-content{% endcase %}" style="grid-row: {{ s | minus: g | plus: 2 }} / {{ e | minus: g | plus: 2 }}; grid-column: {{ col }}">
            <span class="tag text-xs">{{ act.start }}—{{ act.end }}</span>
            <span class="font-heading text-2xl leading-[0.9] font-extrabold uppercase" style="font-stretch: 70%">{{ act.name }}</span>
            {% assign length = e | minus: s %}{% if length > 5 %}<span class="text-sm">{{ act.genre }}</span>{% endif %}
          </a>
          {% endfor %}
        </div>

        <div class="mt-6 space-y-8 md:hidden">
          {% for stage in data.stages %}
          {% assign sets = acts | where: "stage", stage.name | sort: "start" %}
          {% if sets.size > 0 %}
          <div>
            <h3 class="tag text-base">{{ stage.name }}</h3>
            <ul class="mt-3 divide-y-2 divide-base-content border-y-2 border-base-content">
              {% for act in sets %}
              <li><a href="/lineup/{{ act.id }}" class="flex items-baseline gap-4 py-4"><span class="tag w-24 shrink-0 text-sm">{{ act.start }}—{{ act.end }}</span><span><span class="block font-heading text-2xl leading-[0.9] font-extrabold uppercase" style="font-stretch: 70%">{{ act.name }}</span><span class="text-sm text-base-content/80">{{ act.genre }}</span></span></a></li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
          {% endfor %}
        </div>
        {% if day.more.size > 0 %}
        <p class="mt-10 max-w-3xl text-pretty"><span class="tag text-sm">And also on {{ day.title }}, times announced in June</span><br>{{ day.more | join: " · " }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% render 'alert' %}
</main>
{% render 'footer' %}
</body>
</html>
