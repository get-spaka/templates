<!doctype html>
<html lang="en">
<head>
<title>Info — Hot Static 2027</title>
<meta name="description" content="The stages of La Raffinerie, how to get to the north docks of Marseille, access, and the answers to your questions about Hot Static.">
<meta property="og:title" content="Info — Hot Static 2027">
<meta property="og:description" content="The stages of La Raffinerie, how to get to the north docks of Marseille, access, and the answers to your questions about Hot Static.">
</head>
<body>
{% render 'header' %}
<main>
<section class="relative overflow-hidden text-secondary-content" data-halftone>
  <div class="relative z-10 mx-auto max-w-[90rem] px-4 pt-28 pb-12 md:px-10 md:pt-36 md:pb-16">
    <p class="tag text-sm md:text-base">La Raffinerie · Quai Nord, Marseille</p>
    <h1 class="poster mt-3 text-[clamp(3rem,17vw,12.5rem)] md:text-[14vw] 2xl:text-[12.5rem]" data-stretch>Info</h1>
    <nav aria-label="On this page" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        <li><a href="#stages" class="btn btn-outline tag border-secondary-content text-secondary-content">Stages</a></li>
        <li><a href="#getting-there" class="btn btn-outline tag border-secondary-content text-secondary-content">Getting there</a></li>
        <li><a href="#access" class="btn btn-outline tag border-secondary-content text-secondary-content">Access</a></li>
        <li><a href="#questions" class="btn btn-outline tag border-secondary-content text-secondary-content">Questions</a></li>
        <li><a href="#contact" class="btn btn-outline tag border-secondary-content text-secondary-content">Contact</a></li>
      </ul>
    </nav>
  </div>
</section>
{% render 'stages' %}
{% render 'travel' %}
{% render 'access' %}
{% render 'faq' %}
{% render 'partners' %}
<section class="bg-secondary text-secondary-content" id="contact">
  <div class="mx-auto max-w-[90rem] px-4 py-16 md:px-10 md:py-24">
    <h2 class="text-[clamp(3rem,9vw,8rem)]" data-rise>Contact</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      <div class="rounded-box border-2 border-secondary-content p-6">
        <p class="tag text-sm">General questions</p>
        <a href="mailto:hello@hotstatic.fr" class="mt-3 block text-2xl font-semibold break-words hover:underline">hello@hotstatic.fr</a>
        <p class="mt-2 text-pretty">Tickets, the site, volunteering. We answer within two days.</p>
      </div>
      <div class="rounded-box border-2 border-secondary-content p-6">
        <p class="tag text-sm">Access team</p>
        <a href="mailto:access@hotstatic.fr" class="mt-3 block text-2xl font-semibold break-words hover:underline">access@hotstatic.fr</a>
        <p class="mt-2 text-pretty">+33 4 91 00 27 09, weekdays 10:00 to 18:00, and on site at the info points.</p>
      </div>
      <div class="rounded-box border-2 border-secondary-content p-6">
        <p class="tag text-sm">Press</p>
        <a href="mailto:press@hotstatic.fr" class="mt-3 block text-2xl font-semibold break-words hover:underline">press@hotstatic.fr</a>
        <p class="mt-2 text-pretty">Accreditation closes on 15 June. Photos and the press kit on request.</p>
      </div>
    </div>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
