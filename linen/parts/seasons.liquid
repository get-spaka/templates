<section class="bg-secondary text-secondary-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 md:grid-cols-12 md:gap-10 md:px-10 md:py-28">
    <div class="md:col-span-4">
      <p class="tag text-accent">When to come</p>
      <h2 class="mt-5 text-[clamp(2.5rem,4.6vw,4.25rem)] leading-[1.02] text-balance">A year in the <em>valley</em></h2>
      <p class="prose-linen mt-6 text-lg">Oaxaca is good all year. These are the weeks people ask us about, and the ones to book early.</p>
    </div>
    <ol class="border-l-[1.5px] border-dashed border-accent md:col-span-7 md:col-start-6">
      {% for season in data["around-seasons"] %}
      <li class="relative pb-12 pl-8 last:pb-0 md:pl-12" data-settle>
        <span class="absolute top-2.5 -left-[0.45rem] size-3.5 rounded-full bg-accent" aria-hidden="true"></span>
        {% if season.when != blank %}<p class="tag text-accent">{{ season.when }}</p>{% endif %}
        <h3 class="mt-2 text-3xl">{{ season.title }}</h3>
        {% if season.text != blank %}<p class="mt-2 max-w-xl text-secondary-content/85">{{ season.text }}</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
