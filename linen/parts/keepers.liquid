<section class="text-base-content">
  <div class="mx-auto max-w-6xl px-4 py-20 md:px-10 md:py-28">
    <div class="max-w-2xl">
      <p class="tag text-primary">Who keeps it</p>
      <h2 class="mt-5 text-[clamp(2.5rem,4.6vw,4.25rem)] leading-[1.02] text-balance">Four people and a <em>courtyard</em></h2>
      <p class="prose-linen mt-6 text-lg">The house is small enough to be kept by the same four people all year. You will know all of them by your second day.</p>
    </div>
    <div class="mt-14 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-8 sm:gap-y-14 lg:grid-cols-4">
      {% for member in data.team %}
      <article data-settle>
        {% if member.photo %}
        <img src="{{ member.photo }}" class="aspect-[4/5] w-full rounded-t-[999px] rounded-b-box object-cover" data-sun>
        {% else %}
        {% assign words = member.name | split: " " %}
        <div class="dyed flex aspect-[4/5] w-full items-center justify-center rounded-t-[999px] rounded-b-box outline outline-1 outline-offset-[-0.6rem] outline-dashed outline-current/40" data-tint="{{ member.tint | default: 'primary' }}">
          <span class="script text-5xl sm:text-7xl">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
        </div>
        {% endif %}
        <h3 class="mt-5 text-xl sm:text-2xl">{{ member.name }}</h3>
        {% if member.role %}<p class="tag mt-1 text-primary">{{ member.role }}</p>{% endif %}
        {% if member.bio %}<p class="mt-3 text-sm text-base-content/80 sm:text-base">{{ member.bio }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
