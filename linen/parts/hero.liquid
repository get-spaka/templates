<section class="text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 pt-6 pb-14 md:px-10 md:pt-8 md:pb-20">
    <div class="text-center">
      <p class="tag text-base-content/70">Guesthouse · Jalatlaco, Oaxaca</p>
      <h1 class="mx-auto mt-4 max-w-[17ch] text-[clamp(3rem,7vw,7rem)] leading-[0.98] tracking-[-0.015em] text-balance md:mt-5">Five rooms around a <em>courtyard</em> in old Oaxaca</h1>
    </div>
    <div class="casing mx-auto mt-8 max-w-[72rem] md:mt-10">
      <figure class="window aspect-[4/5] sm:aspect-[16/9] md:aspect-[2.6/1]" data-sheer-window data-sun>
        <img src="/media/courtyard.jpg">
        <canvas data-sheer aria-hidden="true"></canvas>
      </figure>
    </div>
    <form action="/book#request" method="get" class="relative z-10 mx-auto mt-4 grid max-w-[60rem] grid-cols-2 gap-px overflow-hidden rounded-box border border-base-300 bg-base-300 md:-mt-11 md:grid-cols-[1fr_1fr_0.8fr_auto]">
      <label class="flex flex-col gap-1 bg-base-100 px-5 pt-3.5 pb-2.5">
        <span class="tag text-base-content/70">Arrive</span>
        <input type="date" name="arrival" class="w-full border-0 bg-transparent p-0 text-lg outline-none" data-arrival>
      </label>
      <label class="flex flex-col gap-1 bg-base-100 px-5 pt-3.5 pb-2.5">
        <span class="tag text-base-content/70">Leave</span>
        <input type="date" name="departure" class="w-full border-0 bg-transparent p-0 text-lg outline-none" data-departure>
      </label>
      <label class="col-span-2 flex flex-col gap-1 bg-base-100 px-5 pt-3.5 pb-2.5 md:col-span-1">
        <span class="tag text-base-content/70">Guests</span>
        <select name="guests" class="w-full border-0 bg-transparent p-0 text-lg outline-none">
          <option value="1">1 guest</option>
          <option value="2" selected>2 guests</option>
          <option value="3">3 guests</option>
          <option value="4">4 guests</option>
          <option value="6">5 or 6 guests</option>
          <option value="11">The whole house, up to 11</option>
        </select>
      </label>
      <div class="col-span-2 flex items-center bg-base-100 p-2.5 md:col-span-1">
        <button type="submit" class="btn btn-primary btn-lg w-full">Ask for these dates</button>
      </div>
    </form>
    <p class="mt-5 text-center text-base-content/70">We answer every request ourselves, within a day.</p>
  </div>
</section>
