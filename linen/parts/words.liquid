<section class="text-base-content">
  <div class="mx-auto max-w-6xl px-4 pt-8 pb-24 md:px-10 md:pb-32">
    <p class="tag text-primary">Guests' words</p>
    {% for item in data.testimonials limit: 1 %}
    <figure class="mt-8 max-w-5xl" data-settle>
      <blockquote>
        <p class="display text-[clamp(2rem,3.8vw,3.5rem)] leading-[1.12] text-balance"><span class="text-primary" aria-hidden="true">“</span>{{ item.quote }}<span class="text-primary" aria-hidden="true">”</span></p>
      </blockquote>
      <figcaption class="mt-8 flex items-center gap-4">
        <span class="h-px w-12 border-t border-dashed border-primary" aria-hidden="true"></span>
        <p><span class="font-medium">{{ item.name }}</span>, {{ item.from }} <span class="tag ml-2 text-base-content/70">{{ item.room }} · {{ item.month }}</span></p>
      </figcaption>
    </figure>
    {% endfor %}
    {% if data.testimonials.size > 1 %}
    <div class="mt-16 grid gap-10 border-t border-base-300 pt-12 md:grid-cols-3 md:gap-12">
      {% for item in data.testimonials offset: 1 limit: 3 %}
      <figure>
        <blockquote>
          <p class="text-lg leading-relaxed text-base-content/85">“{{ item.quote }}”</p>
        </blockquote>
        <figcaption class="mt-5">
          <p class="font-medium">{{ item.name }}, {{ item.from }}</p>
          <p class="tag mt-1 text-base-content/70">{{ item.room }} · {{ item.month }}</p>
        </figcaption>
      </figure>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
