<header class="site-header sticky top-0 z-50 text-base-content">
  <div class="mx-auto flex h-[4.5rem] max-w-[90rem] items-center justify-between gap-4 px-4 md:h-[5.25rem] md:px-10 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 xl:gap-9">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
        <li><a href="{{ item.href }}" class="tag whitespace-nowrap underline-offset-[0.5em] transition-colors hover:text-primary hover:underline {% if page.url == item.href %}text-primary underline decoration-dashed{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <a href="/" class="flex items-center gap-3 text-sm font-medium tracking-[0.3em] whitespace-nowrap uppercase md:text-base">
      <svg class="size-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M3 15c3 0 5-1 6.5-3.5C11 9 10.2 5.5 8.6 6 7 6.5 8 11 11 13s7 2 10 2" stroke-dasharray="2.5 2.2"/></svg>
      <span>Casa Hilo</span>
    </a>
    <div class="flex items-center justify-end gap-2">
      <a href="/book#request" class="btn btn-primary hidden lg:inline-flex">Book a room</a>
      <details class="site-menu lg:hidden">
        <summary class="btn btn-ghost btn-square relative z-[70]" aria-label="Menu">
          <svg class="menu-open size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16"/><path d="M4 15h16" stroke-dasharray="3 2.5"/></svg>
          <svg class="menu-close size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6 6 18"/></svg>
        </summary>
        <nav aria-label="Main" class="weave fixed inset-0 z-[60] flex flex-col justify-between overflow-y-auto bg-base-100 px-6 pt-28 pb-10 text-base-content">
          <ul class="space-y-3">
            {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
            <li><a href="{{ item.href }}" class="display block text-5xl leading-tight transition-colors hover:text-primary {% if page.url == item.href %}text-primary{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endif %}{% endfor %}
          </ul>
          <div class="mt-12 space-y-5">
            <a href="/book#request" class="btn btn-primary btn-lg w-full">Book a room</a>
            <p class="tag text-base-content/70">Calle del Telar 14 · Jalatlaco, Oaxaca</p>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
