<section class="text-base-content" id="rooms">
  <div class="mx-auto max-w-[90rem] px-4 pt-10 pb-20 md:px-10 md:pb-28">
    {% unless bare %}
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <h2 class="text-[clamp(2.5rem,4.6vw,4.25rem)] leading-[1.02] text-balance md:col-span-7">Five rooms, each dyed its own <em>color</em></h2>
      <p class="prose-linen text-lg md:col-span-4 md:col-start-9">Each room is named after a dye once boiled in the courtyard, and its linen is woven on the Bautista family's looms in Teotitlán.</p>
    </div>
    {% endunless %}
    <div class="{% unless bare %}mt-14 md:mt-20{% endunless %}" data-keyboard>
      <ol class="keyboard-rail -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-x-5 overflow-x-auto px-4 pb-4 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-16 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-5">
        {% for room in data.rooms %}
        <li class="key-rail w-[74%] shrink-0 snap-start sm:w-auto" data-key-card>
          <a href="/rooms/{{ room.id }}" class="group block">
            <div class="flex justify-center text-base">{% render 'key', room: room %}</div>
            <div class="mt-6 aspect-[4/5] overflow-hidden rounded-box bg-base-200" data-sun>
              {% if room.photo %}<img src="{{ room.photo }}" class="size-full object-cover motion-safe:transition-transform motion-safe:duration-700 group-hover:scale-[1.03]">{% else %}<div class="dyed size-full opacity-80" data-tint="{{ room.tint }}"></div>{% endif %}
            </div>
            <h3 class="mt-5 text-3xl group-hover:text-primary">{{ room.name }}</h3>
            <p class="tag mt-2 text-base-content/70">Sleeps {{ room.sleeps }} · {{ room.bed }} · {{ room.view }}</p>
            {% if room.price %}<p class="mt-3 text-base-content/80">from <span class="tag text-base-content">${{ room.price }}</span> a night</p>{% endif %}
          </a>
        </li>
        {% endfor %}
      </ol>
    </div>
    {% unless bare %}
    <div class="mt-16 flex justify-center">
      <a href="/rooms" class="btn btn-outline">All the rooms</a>
    </div>
    {% endunless %}
  </div>
</section>
