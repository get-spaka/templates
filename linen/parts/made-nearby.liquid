<section class="weave bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 md:grid-cols-2 md:gap-16 md:px-10 md:py-28">
    <div>
      <p class="tag text-primary">Made nearby</p>
      <h2 class="mt-5 text-[clamp(2.5rem,4.6vw,4.25rem)] leading-[1.02] text-balance">Everything in the house has an <em>address</em></h2>
      <p class="prose-linen mt-6 max-w-md text-lg">Almost nothing in the rooms came from farther than an hour away. Ask and we will send you to the people who made it.</p>
    </div>
    <ol class="divide-y divide-base-300 border-y border-base-300">
      {% for item in data["story-makers"] %}
      <li class="grid grid-cols-[2.5rem_1fr] gap-4 py-6" data-settle>
        <span class="figure pt-1 text-2xl text-primary">{{ forloop.index }}</span>
        <div>
          <h3 class="text-2xl">{{ item.title }}</h3>
          {% if item.place != blank %}<p class="tag mt-1 text-base-content/70">{{ item.place }}</p>{% endif %}
          {% if item.text != blank %}<p class="mt-2 text-base-content/80">{{ item.text }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
