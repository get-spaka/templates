{%- comment -%} The home page's board over `menu`: three dishes to order first in square photos (the first featured dishes with a photo), then the asphalt board with every featured dish and the week's special on its card. {%- endcomment -%}
<section id="board" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="sign-label text-base-content/75">The menu</p>
        <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">On the board</h2>
      </div>
      <a href="/menu" class="btn btn-outline">The whole menu</a>
    </div>
    {%- assign featured = data.menu | where: "featured", true -%}
    <ul class="mt-12 grid gap-6 sm:grid-cols-3" data-reveal="stagger">
      {%- assign shown = 0 -%}
      {%- for dish in featured -%}{%- if dish.image and shown < 3 -%}{%- assign shown = shown | plus: 1 %}
      <li>
        <img src="{{ dish.image }}" class="aspect-square w-full rounded-box object-cover">
        <div class="mt-4 flex items-baseline justify-between gap-4">
          <h3 class="text-[1.5rem]">{{ dish.name }}</h3>
          <span class="mono whitespace-nowrap">{{ dish.price }}</span>
        </div>
        <p class="body-copy mt-1 text-[0.9375rem]">{{ dish.description }}</p>
      </li>
      {%- endif -%}{%- endfor %}
    </ul>
    <div class="board mt-16 px-6 pt-10 pb-8 md:px-10 md:pt-12" data-reveal>
      <div class="mb-8 lg:mb-0">{% render 'special-card' %}</div>
      <div class="lg:min-h-[7.5rem] lg:pr-[20rem]">
        <p class="sign-label text-neutral-content/70">At the window</p>
        <p class="mt-3 font-heading text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-[1.02] text-primary">Order these first</p>
      </div>
      <ul class="mt-6 grid gap-x-12 md:grid-cols-2">
        {%- for dish in featured %}
        <li class="border-t border-dashed border-neutral-content/30 py-4">
          <div class="flex items-baseline justify-between gap-4">
            <p class="board-dish">{{ dish.name }}</p>
            <span class="board-price">{{ dish.price }}</span>
          </div>
          <p class="board-line mt-1">{{ dish.description }} {% render 'marks', tags: dish.tags %}</p>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
