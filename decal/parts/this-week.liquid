{%- comment -%} The home page's week: the heading and the parking row over `stops`, then a link to the whole week. {%- endcomment -%}
<section id="week" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28">
    <div class="grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-10" data-reveal>
      <div class="lg:col-span-6">
        <p class="sign-label text-base-content/75">This week</p>
        <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">Find the truck</h2>
      </div>
      <p class="body-copy max-w-[52ch] lg:col-span-5 lg:col-start-8">Tuesday to Saturday, rain or shine. If plans change, it&rsquo;s on Instagram by 9 am.</p>
    </div>
    <div class="mt-12">
      {% render 'parking-row', stops: data.stops %}
    </div>
    <p class="mt-8"><a href="/where" class="text-link font-semibold">The whole week, with notes</a></p>
  </div>
</section>
