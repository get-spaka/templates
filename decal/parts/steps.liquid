{%- comment -%} How booking works, over `book-steps`: numbered markers on a dashed lane line. {%- endcomment -%}
<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="sign-label text-neutral-content/70">How it works</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">From a request to the window opening</h2>
    </div>
    <ol class="relative mt-14 grid gap-10 md:grid-cols-4 md:gap-8" data-reveal="stagger">
      {%- for step in data["book-steps"] %}
      <li class="relative">
        <div class="flex items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-field border-2 border-base-content bg-primary font-heading text-[1.5rem] text-primary-content">{{ forloop.index }}</span>
          <span class="lane-dash flex-1 {% if forloop.last %}hidden{% endif %} max-md:hidden" aria-hidden="true"></span>
        </div>
        <h3 class="plain-heading mt-5 text-[1.125rem] font-bold">{{ step.title }}</h3>
        <p class="mt-2 max-w-[32ch] text-[0.9375rem] text-neutral-content/80">{{ step.text }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
