{%- comment -%} Three ways to serve, over `book-plans`: each a row with its name, what it is, what it includes and its price a guest. {%- endcomment -%}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="max-w-[46rem]" data-reveal>
      <p class="sign-label text-base-content/75">Ways to serve</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">From the window, on the counter or down a long table</h2>
    </div>
    <ul class="mt-12 overflow-hidden rounded-box border-2 border-base-content bg-base-100" data-reveal="stagger">
      {%- for plan in data["book-plans"] %}
      <li class="grid gap-6 border-base-content p-6 md:p-8 lg:grid-cols-12 lg:gap-10 {% unless forloop.first %}border-t-2{% endunless %} {% if plan.featured %}bg-primary/25{% endif %}">
        <div class="lg:col-span-4">
          <h3 class="text-[1.75rem]">{{ plan.name }}</h3>
          <p class="body-copy mt-2">{{ plan.description }}</p>
        </div>
        <ul class="grid content-start gap-x-8 gap-y-2 text-[0.9375rem] sm:grid-cols-2 lg:col-span-5">
          {%- for feature in plan.features %}
          <li class="flex gap-2.5"><svg class="mt-1 size-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 8.5 3.2 3L13 4.5"/></svg><span>{{ feature }}</span></li>
          {%- endfor %}
        </ul>
        <div class="flex flex-wrap items-center justify-between gap-4 lg:col-span-3 lg:flex-col lg:items-end lg:justify-start">
          <p class="lg:text-right"><span class="mono text-[2rem] leading-none">{{ plan.price }}</span> <span class="mono block text-[0.8125rem] text-base-content/75">{{ plan.period }}</span></p>
          <a href="{{ plan.href }}" class="btn {% if plan.featured %}btn-primary{% else %}btn-outline{% endif %}">{{ plan.cta }}</a>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
