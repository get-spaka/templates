{%- comment -%} The dishes seen close: the dishes of `menu` that have a photo, in squares with their names and prices. Pass `limit`. {%- endcomment -%}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="sign-label text-base-content/75">Seen close</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">What comes out of the window</h2>
    </div>
    <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
      {%- assign shown = 0 -%}
      {%- for dish in data.menu -%}{%- if dish.image and shown < limit -%}{%- assign shown = shown | plus: 1 %}
      <li>
        <img src="{{ dish.image }}" class="aspect-square w-full rounded-box object-cover">
        <div class="mt-4 flex items-baseline justify-between gap-4">
          <h3 class="text-[1.5rem]">{{ dish.name }}</h3>
          <span class="mono whitespace-nowrap">{{ dish.price }}</span>
        </div>
        <p class="body-copy mt-1 text-[0.9375rem]">{{ dish.description }}</p>
      </li>
      {%- endif -%}{%- endfor %}
    </ul>
  </div>
</section>
