{%- comment -%} A time of the stops ("11:00", "17:30") as the truck's visitors read it: 11 am, 5:30 pm. For a site in French, German or most of Europe, write {{ t }} as it is (11:00, 17:30). {%- endcomment -%}
{%- assign hm = t | split: ":" -%}
{%- assign h = hm[0] | plus: 0 -%}
{%- assign m = hm[1] | default: "00" -%}
{%- if h >= 12 -%}{%- assign half = "pm" -%}{%- else -%}{%- assign half = "am" -%}{%- endif -%}
{%- assign h12 = h | modulo: 12 -%}
{%- if h12 == 0 -%}{%- assign h12 = 12 -%}{%- endif -%}
{%- if h == 12 and m == "00" -%}noon{%- else -%}{{ h12 }}{% if m != "00" %}:{{ m }}{% endif %}&nbsp;{{ half }}{%- endif -%}
