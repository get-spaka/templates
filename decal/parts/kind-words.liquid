{%- comment -%} Kind words, over `testimonials`: a card each with its headline, the quote and who said it. {%- endcomment -%}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="sign-label text-base-content/75">Kind words</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">From the people who booked us</h2>
    </div>
    <ul class="mt-12 grid gap-6 lg:grid-cols-3" data-reveal="stagger">
      {%- for item in data.testimonials %}
      <li class="flex flex-col rounded-box border-2 border-base-content bg-base-100 p-7">
        <h3 class="text-[1.5rem]">{{ item.headline }}</h3>
        <blockquote class="body-copy mt-4 flex-1">{{ item.quote }}</blockquote>
        <div class="mt-7 flex items-center gap-3 border-t border-base-300 pt-5">
          {%- assign parts = item.name | split: " " %}
          <span class="grid size-11 shrink-0 place-items-center rounded-full bg-primary font-heading text-[1.0625rem] text-primary-content" aria-hidden="true">{{ parts.first | slice: 0 }}{{ parts.last | slice: 0 }}</span>
          <div>
            <p class="font-bold">{{ item.name }}</p>
            <p class="text-[0.875rem] text-base-content/75">{{ item.role }}</p>
          </div>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
