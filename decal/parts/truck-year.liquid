{%- comment -%} The truck's year in six photos, over `gallery`, each square with its title and where it was. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="sign-label text-base-content/75">On the road</p>
      <h2 class="mt-3 text-[clamp(2rem,3vw+1rem,3.25rem)]">The truck&rsquo;s year</h2>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 md:gap-x-6 lg:grid-cols-3" data-reveal="stagger">
      {%- for photo in data.gallery %}
      <li>
        {%- if photo.image %}
        <img src="{{ photo.image }}" class="aspect-square w-full rounded-box object-cover">
        {%- else %}
        <div class="aspect-square w-full rounded-box bg-neutral"></div>
        {%- endif %}
        <p class="mt-3 font-bold leading-snug">{{ photo.title }}</p>
        <p class="mono text-[0.8125rem] text-base-content/70">{{ photo.category }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
