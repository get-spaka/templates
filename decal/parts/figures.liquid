{%- comment -%} The truck's figures, over `book-stats`, in a row split by ink rules. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <p class="sign-label text-base-content/75" data-reveal>Since 2021</p>
    <dl class="mt-8 grid border-y-2 border-base-content sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {%- for stat in data["book-stats"] %}
      <div class="border-base-content py-7 sm:px-6 {% unless forloop.first %}border-t sm:border-t-0{% endunless %} sm:[&:nth-child(2n)]:border-l lg:[&:not(:first-child)]:border-l">
        <dt class="sign-label text-base-content/75">{{ stat.label }}</dt>
        <dd class="mt-3 font-heading text-[clamp(2.5rem,3vw+1rem,3.5rem)] leading-none">{{ stat.value }}</dd>
        <dd class="mt-3 text-[0.9375rem] text-base-content/75">{{ stat.note }}</dd>
      </div>
      {%- endfor %}
    </dl>
  </div>
</section>
