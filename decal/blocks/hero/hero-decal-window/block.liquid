<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-14 px-5 pt-12 pb-20 md:px-8 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-16 lg:pb-28">
    <div class="lg:col-span-7">
      <p class="sign-label text-base-content/75">Filipino street food · Durham, NC</p>
      <h1 class="mt-5 text-[clamp(2.75rem,5.5vw+1rem,6rem)] leading-[0.98] tracking-[-0.005em]">Lola&rsquo;s recipes, parked somewhere new every day.</h1>
      <p class="body-copy mt-7 max-w-[52ch] text-[1.1875rem]">Garlic rice, pork barbecue skewers and Lola Nena&rsquo;s lumpia from a yellow truck, at seven Durham stops a week.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#week" class="btn btn-primary btn-lg">Where we are this week</a>
        <a href="/book" class="btn btn-outline btn-lg">Book the truck</a>
      </div>
    </div>
    <div class="lg:col-span-5 lg:col-start-8">
      {%- assign image = '/media/window.jpg' -%}<div class="truck-window" data-window>
  <div class="awning" aria-hidden="true"></div>
  <div class="window-panel">
    <div class="window-opening mt-5 aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5]">
      <img src="{{ image }}" class="h-full w-full object-cover object-[30%_50%]">
    </div>
    <div class="ledge" aria-hidden="true"></div>
    <div class="mt-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-1">
      <p class="font-heading text-[2.25rem] leading-none">Pasada</p>
      <p class="sign-label pb-1">Order here · (919) 555-0148</p>
    </div>
  </div>
</div>
    </div>
  </div>
</section>
