<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-[80rem] px-5 pt-20 pb-10 md:px-8 md:pt-24">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-7">
        <p class="font-heading text-[clamp(2.75rem,4vw+1.5rem,4.5rem)] leading-[0.98]">Follow the truck</p>
        <p class="mt-4 text-[1.0625rem] text-neutral-content/80">Changes go up on Instagram by 9 am.</p>
      </div>
      <div class="lg:col-span-5">
        <a href="https://www.instagram.com/" class="btn btn-primary" rel="noopener" target="_blank">Pasada on Instagram</a>
      </div>
    </div>
    <div class="mt-12"><div class="flex flex-col gap-5 rounded-box border border-neutral-content/25 p-5 md:flex-row md:items-center md:justify-between md:p-6">
  <div class="flex items-center gap-4">
    <svg class="size-7 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
    <div>
      <h2 class="plain-heading text-[1.0625rem] font-bold">Get the week&rsquo;s stops by email on Mondays</h2>
      <p class="text-[0.9375rem] text-neutral-content/75">One short email a week, with any change and the special.</p>
    </div>
  </div>
  <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#email-strip-problems swap:innerHTML" class="w-full md:max-w-md">
    <div class="flex w-full gap-2">
      <label class="sr-only" for="email-strip-email">Email address</label>
      <input id="email-strip-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input w-full min-w-0 border-neutral-content/40 bg-neutral text-neutral-content">
      <button type="submit" class="btn btn-primary">Sign up</button>
    </div>
    <div id="email-strip-problems" class="mt-2 empty:hidden"></div>
  </form>
</div></div>
    <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        {%- assign text = 'text-[2rem]' -%}<a href="/" class="inline-flex items-center gap-2.5 whitespace-nowrap" aria-label="Pasada, home">
  <span class="relative inline-block h-[1.25rem] w-[3rem] shrink-0" aria-hidden="true"><span class="absolute top-1/2 left-1/2 block h-[3rem] w-[1.25rem] -translate-x-1/2 -translate-y-1/2 rotate-90"><svg viewBox="0 0 48 116" fill="none" aria-hidden="true" focusable="false">
  <rect x="1" y="16" width="3.5" height="7" rx="1.2" class="fill-base-content"/>
  <rect x="43.5" y="16" width="3.5" height="7" rx="1.2" class="fill-base-content"/>
  <rect x="4" y="2" width="40" height="112" rx="8" class="fill-primary stroke-base-content" stroke-width="2"/>
  <path d="M8 13.5c0-3 2.4-5.5 5.4-5.5h21.2c3 0 5.4 2.5 5.4 5.5V20H8z" class="fill-neutral"/>
  <path d="M4 26h40" class="stroke-base-content" stroke-width="2"/>
  <rect x="15" y="32" width="18" height="11" rx="2" class="fill-base-100 stroke-base-content" stroke-width="2"/>
  <rect x="15" y="91" width="18" height="11" rx="2" class="fill-base-100 stroke-base-content" stroke-width="2"/>
  <text x="24" y="67" transform="rotate(90 24 67)" text-anchor="middle" dominant-baseline="central" class="fill-base-content" style="font-family: var(--font-heading); font-size: 10px; letter-spacing: 0.04em">PASADA</text>
  <rect class="truck-tail fill-accent" x="7.5" y="109" width="8" height="3.5" rx="1"/>
  <rect class="truck-tail fill-accent" x="32.5" y="109" width="8" height="3.5" rx="1"/>
</svg></span></span>
  <span class="font-heading leading-none {{ text | default: 'text-[1.75rem]' }}">Pasada</span>
</a>
        <p class="mt-5 max-w-[34ch] text-neutral-content/80">Filipino street food from a yellow truck called Nena, around Durham, Tuesday to Saturday.</p>
      </div>
      <div class="lg:col-span-4">
        <p class="sign-label text-neutral-content/70">Book the truck</p>
        <p class="mt-4"><a href="tel:+19195550148" class="text-link whitespace-nowrap">(919) 555-0148</a></p>
        <p class="mt-2"><a href="mailto:events@pasadatruck.com" class="text-link">events@pasadatruck.com</a></p>
        <p class="mt-5 max-w-[34ch] text-[0.9375rem] text-neutral-content/75">Home base: a shared kitchen east of downtown (no service there).</p>
      </div>
      <nav aria-label="Footer" class="lg:col-span-4">
        <p class="sign-label text-neutral-content/70">Pasada</p>
        <ul class="mt-4 space-y-1.5">
          {% for item in data.navigation %}{% if item.place != "social" %}
          <li><a href="{{ item.href }}" class="text-link">{{ item.label }}</a></li>
          {% endif %}{% endfor %}
          {% for item in data.navigation %}{% if item.place == "social" %}
          <li><a href="{{ item.href }}" class="text-link" rel="noopener" target="_blank">{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </nav>
    </div>
    <p class="sign-label mt-16 border-t border-neutral-content/20 pt-6 text-neutral-content/70">Pasada · Durham, North Carolina · Since 2021 · © 2026</p>
  </div>
</footer>
