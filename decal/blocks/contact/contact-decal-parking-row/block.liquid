    <p class="sign-label text-base-content/75">{%- assign d = stop.day -%}{%- assign form = nil -%}{%- if form == "short" -%}
{%- case d -%}{%- when "mon" -%}Mon{%- when "tue" -%}Tue{%- when "wed" -%}Wed{%- when "thu" -%}Thu{%- when "fri" -%}Fri{%- when "sat" -%}Sat{%- when "sun" -%}Sun{%- endcase -%}
{%- else -%}
{%- case d -%}{%- when "mon" -%}Monday{%- when "tue" -%}Tuesday{%- when "wed" -%}Wednesday{%- when "thu" -%}Thursday{%- when "fri" -%}Friday{%- when "sat" -%}Saturday{%- when "sun" -%}Sunday{%- endcase -%}
{%- endif -%}</p>
    <h3 class="bay-place mt-1">{{ stop.place }}</h3>
    <p class="mono text-[0.875rem]"><span data-time="starts">{%- assign t = stop.starts -%}{%- assign hm = t | split: ":" -%}
{%- assign h = hm[0] | plus: 0 -%}
{%- assign m = hm[1] | default: "00" -%}
{%- if h >= 12 -%}{%- assign half = "pm" -%}{%- else -%}{%- assign half = "am" -%}{%- endif -%}
{%- assign h12 = h | modulo: 12 -%}
{%- if h12 == 0 -%}{%- assign h12 = 12 -%}{%- endif -%}
{%- if h == 12 and m == "00" -%}noon{%- else -%}{{ h12 }}{% if m != "00" %}:{{ m }}{% endif %}&nbsp;{{ half }}{%- endif -%}</span> – <span data-time="ends">{%- assign t = stop.ends -%}{%- assign hm = t | split: ":" -%}
{%- assign h = hm[0] | plus: 0 -%}
{%- assign m = hm[1] | default: "00" -%}
{%- if h >= 12 -%}{%- assign half = "pm" -%}{%- else -%}{%- assign half = "am" -%}{%- endif -%}
{%- assign h12 = h | modulo: 12 -%}
{%- if h12 == 0 -%}{%- assign h12 = 12 -%}{%- endif -%}
{%- if h == 12 and m == "00" -%}noon{%- else -%}{{ h12 }}{% if m != "00" %}:{{ m }}{% endif %}&nbsp;{{ half }}{%- endif -%}</span></p>
    {%- if stop.area != blank %}
    <p class="text-[0.9375rem] leading-snug text-base-content/75">{{ stop.area }}</p>
    {%- endif %}
    {%- if stop.off %}
    <p class="mt-1 text-[0.9375rem] leading-snug font-semibold">Not this week{% if stop.note != blank %}: {{ stop.note }}{% endif %}</p>
    {%- else %}
    {%- if full and stop.address != blank %}
    <p class="mono mt-2 text-[0.8125rem] leading-snug text-base-content/80">{{ stop.address }}</p>
    {%- endif %}
    {%- if full and stop.note != blank %}
    <p class="mt-2 text-[0.9375rem] leading-snug text-base-content/80">{{ stop.note }}</p>
    {%- endif %}
    {%- if stop.map != blank %}
    <a href="{{ stop.map }}" class="text-link mt-2 text-[0.9375rem] font-semibold" target="_blank" rel="noopener">Directions</a>
    {%- endif %}
    {%- endif %}
  </div>
</li>
{%- else -%}
{%- case d -%}
{%- when "mon" -%}{%- assign note = "Prep day" -%}{%- assign line = "At home base, cooking for the week." -%}
{%- when "sun" -%}{%- assign note = "Family day" -%}{%- assign line = "No service. We're back on Tuesday." -%}
{%- else -%}{%- assign note = "No stop" -%}{%- assign line = "The truck stays at home base." -%}
{%- endcase -%}
<li class="bay keep-clear">
  <div class="bay-asphalt" aria-hidden="true">
    <span class="clear-plate">{{ note }}</span>
  </div>
  <div class="bay-details">
    <p class="sign-label text-base-content/75">{%- assign d = d -%}{%- assign form = nil -%}{%- if form == "short" -%}
{%- case d -%}{%- when "mon" -%}Mon{%- when "tue" -%}Tue{%- when "wed" -%}Wed{%- when "thu" -%}Thu{%- when "fri" -%}Fri{%- when "sat" -%}Sat{%- when "sun" -%}Sun{%- endcase -%}
{%- else -%}
{%- case d -%}{%- when "mon" -%}Monday{%- when "tue" -%}Tuesday{%- when "wed" -%}Wednesday{%- when "thu" -%}Thursday{%- when "fri" -%}Friday{%- when "sat" -%}Saturday{%- when "sun" -%}Sunday{%- endcase -%}
{%- endif -%}</p>
    <h3 class="bay-place mt-1">{{ note }}</h3>
    <p class="text-[0.9375rem] leading-snug text-base-content/75">{{ line }}</p>
  </div>
</li>
{%- endif -%}{%- endif -%}
    {%- endif -%}
    {%- endfor %}
    {%- assign bottom = cells | minus: top -%}
    {%- if bottom < top %}
    <li class="bay bay-empty" aria-hidden="true"><div class="bay-asphalt"></div><div class="bay-details"></div></li>
    {%- endif %}
  </ol>
</div>
    </div>
    <p class="mt-8"><a href="/where" class="text-link font-semibold">The whole week, with notes</a></p>
  </div>
</section>
