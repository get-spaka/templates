<!doctype html>
<html lang="en">
<head>
<title>Menu — Marlow Street Bakery</title>
<meta name="description" content="Our breads, pastries, coffee and cakes to order, with their prices.">
<meta property="og:title" content="Menu — Marlow Street Bakery">
<meta property="og:description" content="Our breads, pastries, coffee and cakes to order, with their prices.">
</head>
<body>
{% render 'header' %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 pt-12 pb-10 md:px-8 md:pt-20">
    <p class="font-mono text-xs tracking-[0.25em] uppercase text-base-content/70" data-reveal>Menu · Prices include tax</p>
    <h1 class="mt-6 text-[clamp(3.5rem,12vw,9rem)] leading-[0.82] font-extrabold tracking-tight uppercase" data-reveal>What's in<br><em>the oven.</em></h1>
    <p class="mt-8 max-w-xl text-lg text-pretty text-base-content/80" data-reveal>Everything is baked here, from four in the morning. When a tray is gone it is gone: come early for the rye and the croissants.</p>
  </div>
</section>
{% assign categories = "Bread,Pastries,Coffee,Cakes to order" | split: "," %}
{% for category in categories %}
{% assign items = data.menu | where: "category", category %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-8 border-t border-base-300 px-5 py-12 md:grid-cols-12 md:px-8 md:py-16">
    <h2 class="text-5xl leading-none font-extrabold uppercase md:col-span-4 md:text-6xl" data-reveal>{{ category }}</h2>
    <ul class="space-y-8 md:col-span-8">
      {% for item in items %}
      <li data-reveal>
        <div class="flex items-baseline gap-3">
          <h3 class="text-xl font-extrabold uppercase md:text-2xl">{{ item.name }}</h3>
          <span class="min-w-6 flex-1 border-b-2 border-dotted border-base-content/30" aria-hidden="true"></span>
          {% if item.price %}<span class="font-mono text-lg tabular-nums">{{ item.price }}</span>{% endif %}
        </div>
        {% if item.description %}<p class="mt-2 max-w-xl text-pretty text-base-content/75">{{ item.description }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
{% endfor %}
{% render 'hours' %}
</main>
{% render 'footer' %}
</body>
</html>
