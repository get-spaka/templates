<section id="roadmap" class="border-y border-base-300 bg-base-200/40 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="font-mono text-[0.6875rem] tracking-[0.08em] text-primary uppercase" data-reveal>Fig. 08 · Where we are</p>
        <h2 class="mt-5 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] tracking-tight text-balance" data-reveal>Shipping in the open. <span class="text-base-content/45">Here is how far we are.</span></h2>
      </div>
      <p class="max-w-md leading-relaxed text-pretty text-base-content/70 md:col-span-5 md:justify-self-end" data-reveal>Every two weeks a new version reaches the beta, and its notes go on the <a href="/updates" class="text-base-content underline decoration-base-content/30 underline-offset-4 hover:decoration-primary">updates page</a>.</p>
    </div>
    <ol class="mt-14 grid md:mt-20 md:gap-x-0" style="--nodes: {{ data["home-milestones"].size }}" data-track data-reveal>
      {% for milestone in data["home-milestones"] %}
      <li class="pb-10 pl-9 md:pt-10 md:pr-6 md:pb-0 md:pl-0">
        <span class="beacon-node {% if milestone.state == "done" %}bg-primary{% elsif milestone.state == "now" %}bg-accent{% else %}border border-base-content/30 bg-base-100{% endif %}" data-state="{{ milestone.state }}" aria-hidden="true"></span>
        {% unless forloop.last %}<span data-track-seg aria-hidden="true">{% if milestone.state == "done" %}<span data-track-lit></span>{% endif %}</span>{% endunless %}
        <p class="font-mono text-[0.6875rem] tracking-[0.08em] uppercase {% if milestone.state == "now" %}text-accent{% else %}text-base-content/50{% endif %}">{{ milestone.when }}{% if milestone.state == "now" %} · Now{% endif %}</p>
        <h3 class="mt-2 text-xl tracking-tight {% if milestone.state == "next" %}text-base-content/70{% endif %}">{{ milestone.title }}</h3>
        {% if milestone.note %}<p class="mt-2 max-w-[15rem] text-sm leading-relaxed text-pretty text-base-content/55">{{ milestone.note }}</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
