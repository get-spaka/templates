<footer class="border-t border-neutral-content/10 bg-neutral text-neutral-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 pt-16 pb-10 md:grid-cols-12 md:px-8">
    <div class="md:col-span-4">
      <a href="/" class="flex items-center gap-2.5">
        <svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10.25" opacity="0.45"/><circle cx="12" cy="12" r="6.25" opacity="0.75"/><circle cx="12" cy="12" r="2.25" fill="currentColor" stroke="none"/></svg>
        <span class="text-[1.0625rem] font-medium tracking-tight">Nightjar</span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-neutral-content/60">Uptime and job monitoring that stays quiet until something really needs a person.</p>
      <p class="mt-6 flex items-center gap-2 font-mono text-[0.6875rem] tracking-[0.08em] text-neutral-content/70 uppercase"><span class="inline-block size-1.5 rounded-full bg-success" aria-hidden="true"></span>All systems normal</p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-8">
      {% for item in data.navigation %}{% if item.place == "footer" %}
      <div>
        <p class="font-mono text-[0.6875rem] tracking-[0.08em] text-neutral-content/50 uppercase">{{ item.label }}</p>
        <ul class="mt-4 space-y-2.5 text-sm">
          {% for link in item.links %}<li><a href="{{ link.href }}" class="text-neutral-content/80 transition-colors hover:text-primary">{{ link.label }}</a></li>{% endfor %}
        </ul>
      </div>
      {% endif %}{% endfor %}
    </nav>
  </div>
  <div class="mx-auto flex max-w-7xl flex-col gap-4 border-t border-neutral-content/10 px-5 py-6 font-mono text-[0.6875rem] tracking-[0.08em] text-neutral-content/50 uppercase sm:flex-row sm:items-center sm:justify-between md:px-8">
    <p>© 2026 Nightjar Labs, Rotterdam</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <ul class="flex gap-6">
        {% for item in data.navigation %}{% if item.place == "social" %}
        <li><a href="{{ item.href }}" class="transition-colors hover:text-primary">{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
      <p data-spaka-credits><a href="/credits" class="transition-colors hover:text-primary">Image credits</a></p>
    </div>
  </div>
</footer>
