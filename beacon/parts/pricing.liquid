<section id="pricing" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-mono text-[0.6875rem] tracking-[0.08em] text-primary uppercase" data-reveal>Fig. 09 · Pricing</p>
      <h2 class="mt-5 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] tracking-tight text-balance" data-reveal>Free while it is in beta. <span class="text-base-content/45">Fair once it is not.</span></h2>
    </div>
    <a href="#waitlist" class="group mx-auto mt-10 flex max-w-2xl flex-wrap items-center justify-center gap-x-4 gap-y-2 rounded-box border border-accent/40 bg-accent/10 px-5 py-3 text-center text-sm" data-reveal>
      <span class="rounded-full bg-accent px-2.5 py-0.5 font-mono text-[0.625rem] tracking-[0.08em] text-accent-content uppercase">Founding offer</span>
      <span>Join before 1.0: Team at half price for a year.</span>
      <span class="beacon-arrow text-base-content/60" aria-hidden="true">→</span>
    </a>
    <ul class="mx-auto mt-12 grid max-w-6xl gap-4 md:grid-cols-3 md:items-stretch">
      {% for plan in data["home-plans"] %}
      <li class="flex flex-col rounded-box border bg-base-200/60 p-7 md:p-8 {% if plan.highlighted %}border-primary/70 bg-base-200{% else %}border-base-300{% endif %}" data-glow {% if plan.highlighted %}data-lit{% endif %} data-reveal>
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg tracking-tight">{{ plan.name }}</h3>
          {% if plan.highlighted %}<span class="rounded-full border border-primary/60 px-2.5 py-0.5 font-mono text-[0.625rem] tracking-[0.08em] text-primary uppercase">Most teams</span>{% endif %}
        </div>
        <p class="mt-6 flex items-baseline gap-2"><span class="font-mono text-[clamp(2.75rem,4vw,3.5rem)] leading-none font-light tracking-[-0.04em]">{{ plan.price }}</span><span class="font-mono text-[0.6875rem] tracking-[0.08em] text-base-content/50 uppercase">{{ plan.period }}</span></p>
        {% if plan.description %}<p class="mt-4 text-sm leading-relaxed text-pretty text-base-content/70">{{ plan.description }}</p>{% endif %}
        <ul class="mt-7 flex-1 space-y-3 border-t border-base-300 pt-6 text-sm">
          {% for feature in plan.features %}
          <li class="flex gap-3"><svg class="mt-0.5 size-4 shrink-0 {% if plan.highlighted %}text-primary{% else %}text-base-content/50{% endif %}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7"/></svg>{{ feature }}</li>
          {% endfor %}
        </ul>
        <a href="#waitlist" class="btn mt-8 font-medium {% if plan.highlighted %}btn-primary{% else %}btn-outline border-base-300 hover:border-base-content hover:bg-base-content hover:text-base-100{% endif %}">{{ plan.button }}</a>
      </li>
      {% endfor %}
    </ul>
    <p class="mt-8 text-center font-mono text-[0.6875rem] tracking-[0.08em] text-base-content/50 uppercase" data-reveal>Prices in US dollars, before tax · Cancel any time</p>
  </div>
</section>
