<!doctype html>
<html lang="en">
<head>
<title>{{ record.title }} (v{{ record.version }}) — Nightjar updates</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.title }} — Nightjar updates">
<meta property="og:description" content="{{ record.summary }}">
{% if record.cover %}<meta property="og:image" content="{{ record.cover }}">{% endif %}
</head>
<body>
{% render 'header' %}
<main class="bg-base-100 text-base-content">
<article>
  <div class="mx-auto max-w-3xl px-5 pt-12 md:px-8 md:pt-20">
    <a href="/updates" class="group inline-flex items-center gap-2 font-mono text-[0.6875rem] tracking-[0.08em] text-base-content/60 uppercase hover:text-primary"><span aria-hidden="true">←</span> All updates</a>
    <p class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[0.6875rem] tracking-[0.08em] text-base-content/60 uppercase" data-reveal>
      {% if record.version %}<span class="text-base-content">v{{ record.version }}</span>{% endif %}
      {% if record.date %}<time datetime="{{ record.date }}">{{ record.date | date: "%B %-d, %Y" }}</time>{% endif %}
      {% if record.tag %}<span class="rounded-full border px-2.5 py-0.5 text-[0.625rem] {% if record.tag == "New" %}border-primary/60 text-primary{% elsif record.tag == "Fixed" %}border-base-300 text-base-content/70{% else %}border-accent/50 text-accent{% endif %}">{{ record.tag }}</span>{% endif %}
    </p>
    <h1 class="mt-5 text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.03] font-medium tracking-tight text-balance" data-split>{{ record.title }}</h1>
    {% if record.summary %}<p class="mt-6 text-lg leading-relaxed text-pretty text-base-content/70" data-reveal>{{ record.summary }}</p>{% endif %}
  </div>
  {% if record.cover %}
  <div class="mx-auto mt-12 max-w-5xl px-5 md:mt-16 md:px-8" data-reveal>
    <img src="{{ record.cover }}" class="aspect-[16/9] w-full rounded-box border border-base-300 object-cover">
  </div>
  {% endif %}
  <div class="beacon-prose mx-auto mt-12 max-w-3xl px-5 text-[1.0625rem] leading-relaxed text-pretty text-base-content/80 md:mt-16 md:px-8" data-reveal>{{ record.body }}</div>
  {% for item in data.updates %}{% if item.id == record.id %}{% assign at = forloop.index0 %}{% endif %}{% endfor %}
  {% assign newer_at = at | minus: 1 %}
  {% assign older_at = at | plus: 1 %}
  {% assign newer = nil %}{% if at > 0 %}{% assign newer = data.updates[newer_at] %}{% endif %}
  {% assign older = data.updates[older_at] %}
  <nav aria-label="Other updates" class="mx-auto mt-20 grid max-w-3xl gap-3 px-5 pb-24 sm:grid-cols-2 md:mt-28 md:px-8 md:pb-32">
    {% if older %}
    <a href="/updates/{{ older.id }}" class="group rounded-box border border-base-300 bg-base-200/60 p-5 transition-colors hover:border-primary/60" data-glow>
      <span class="font-mono text-[0.6875rem] tracking-[0.08em] text-base-content/50 uppercase">← Previous · v{{ older.version }}</span>
      <span class="mt-2 block text-lg tracking-tight">{{ older.title }}</span>
    </a>
    {% else %}<span class="hidden sm:block"></span>{% endif %}
    {% if newer %}
    <a href="/updates/{{ newer.id }}" class="group rounded-box border border-base-300 bg-base-200/60 p-5 text-right transition-colors hover:border-primary/60" data-glow>
      <span class="font-mono text-[0.6875rem] tracking-[0.08em] text-base-content/50 uppercase">Next · v{{ newer.version }} →</span>
      <span class="mt-2 block text-lg tracking-tight">{{ newer.title }}</span>
    </a>
    {% endif %}
  </nav>
</article>
</main>
{% render 'footer' %}
</body>
</html>
