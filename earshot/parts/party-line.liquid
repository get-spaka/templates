<section id="party-line" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <div class="grid items-center gap-10 overflow-hidden rounded-box bg-base-100 p-6 sm:p-10 lg:grid-cols-12 lg:p-14" data-reveal>
      <div class="lg:col-span-7">
        <p class="mono flex items-center gap-2 text-base-content/65"><span class="lamp" aria-hidden="true"></span>Members</p>
        <h2 class="mt-4 text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1.02]">Join the Party Line</h2>
