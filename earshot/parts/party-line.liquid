        <p class="flex items-end gap-3"><span class="poster text-[clamp(6rem,14vw,10rem)] leading-[0.8] text-primary">$5</span><span class="mono pb-2 text-base-content/65">a month<br>or $50 a year</span></p>
        {% render 'soundprint', n: 5, to: 39, class: "mt-8 h-12 text-primary/40" %}
      </div>
    </div>
  </div>
