        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://example.com/party-line" class="btn btn-primary whitespace-nowrap">Join the Party Line</a>
          <a href="/listen#party-line" class="btn btn-ghost whitespace-nowrap">What members get</a>
