{%- comment -%} Reviews as the apps show them: stars, a line, the reviewer's nickname and where. Pass limit. {%- endcomment -%}
<section id="reviews" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <h2 class="caption-title text-[clamp(2.25rem,4.5vw,3.75rem)]"><span class="caption-box">What listeners say</span></h2>
      <p class="mono text-base-content/65">From the apps' reviews</p>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
      {%- for review in data.reviews limit: limit %}
      <li class="flex flex-col rounded-box border border-base-300 bg-base-100 p-6 md:p-7">
        <p class="stars" aria-label="{{ review.stars }} stars out of 5">{% for s in (1..5) %}<svg class="size-5{% if s > review.stars %} off{% endif %}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.8l2.8 6 6.5.6-4.9 4.4 1.4 6.4L12 16.9l-5.8 3.3 1.4-6.4-4.9-4.4 6.5-.6z"/></svg>{% endfor %}</p>
        <p class="mt-4 flex-1 text-[1.125rem] leading-relaxed font-bold">{{ review.text }}</p>
        <p class="mono mt-6 text-[0.75rem] text-base-content/65">{{ review.name }}{% if review.where != blank %}, {{ review.where }}{% endif %}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
