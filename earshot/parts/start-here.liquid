<section id="start-here" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <h2 class="caption-title text-[clamp(2.25rem,4.5vw,3.75rem)] lg:col-span-8"><span class="caption-box">New here?</span><br><span class="caption-box">Start with these three</span></h2>
      <p class="max-w-[42ch] text-[1.0625rem] leading-relaxed text-base-content/80 lg:col-span-4">The episodes listeners send their friends first. Each stands on its own: no need to start at the beginning.</p>
    </div>
    <ul class="mt-12 grid gap-5 md:grid-cols-3" data-reveal="stagger">
      {%- for ep in data.episodes %}{% if ep.starter %}
      <li>
        <a href="/episodes/{{ ep.id }}" class="tone-fill flex h-full flex-col rounded-box p-6 md:p-7" data-tone="{{ ep.tone }}" data-ripple>
          <span class="flex items-start justify-between gap-4">
            <span class="poster text-[4.5rem] leading-[0.85]">{{ ep.number }}</span>
            <span class="mono pt-2 text-right text-[0.75rem] opacity-80">{{ ep.minutes }} min<br>{{ ep.topic }}</span>
          </span>
          <span class="mt-6 block font-heading text-[1.625rem] leading-[1.1] font-bold tracking-[-0.015em] text-balance">{{ ep.title }}</span>
          <span class="mt-3 block flex-1 text-[1rem] leading-relaxed opacity-90">{{ ep.starter_note }}</span>
          {% render 'soundprint', n: ep.number, to: 39, class: "mt-8 h-10 text-current" %}
        </a>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>
