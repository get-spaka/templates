<section id="how-its-made" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <h2 class="caption-title text-[clamp(2.25rem,4.5vw,3.75rem)] lg:col-span-7"><span class="caption-box">How an episode</span><br><span class="caption-box">gets made</span></h2>
      <img src="/media/mixing-desk.jpg" class="aspect-[16/9] w-full rounded-box object-cover lg:col-span-5" data-studio>
    </div>
    <ol class="relative mt-14 grid gap-8 md:grid-cols-5 md:gap-6" data-reveal="stagger">
      {%- for step in data["about-steps"] %}
      <li class="relative border-t-2 border-base-content pt-5 md:pr-2">
        <span class="mono absolute -top-3 left-0 rounded-full bg-neutral px-2 py-0.5 text-[0.6875rem] text-neutral-content">0{{ forloop.index }}</span>
        <h3 class="mt-3 text-[1.375rem] leading-tight">{{ step.title }}</h3>
        <p class="mt-3 leading-relaxed text-base-content/80">{{ step.text }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
