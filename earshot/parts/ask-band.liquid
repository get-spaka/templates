<section id="ask-us" class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5" data-reveal>
      <h2 class="caption-title text-[clamp(2.25rem,4.5vw,3.75rem)]"><span class="caption-box">Got a word</span><br><span class="caption-box">that bugs you?</span></h2>
      <p class="mt-6 max-w-[44ch] text-[1.0625rem] leading-relaxed text-base-content/80">Every fourth Tuesday is the Mailbag, made from your questions. Write one below, or call and leave it on the line.</p>
      <p class="mono mt-10 text-base-content/65">The voicemail line</p>
      <a href="tel:+14125550142" class="poster mt-2 block text-[clamp(2.25rem,5vw,3.75rem)] leading-none whitespace-nowrap text-primary hover:underline">(412) 555-0142</a>
      <p class="mt-3 text-base-content/80">Up to two minutes. We might play it on the show.</p>
    </div>
    <div class="lg:col-span-7" data-reveal>
      {% render 'question-form', id: "ask-band" %}
    </div>
  </div>
</section>
