<section id="ask-us" class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5" data-reveal>
      <h2 class="caption-title text-[clamp(2.25rem,4.5vw,3.75rem)]"><span class="caption-box">Got a word</span><br><span class="caption-box">that bugs you?</span></h2>
      <p class="mt-6 max-w-[44ch] text-[1.0625rem] leading-relaxed text-base-content/80">Every fourth Tuesday is the Mailbag, made from your questions. Write one below, or call and leave it on the line.</p>
      <p class="mono mt-10 text-base-content/65">The voicemail line</p>
      <a href="tel:+14125550142" class="poster mt-2 block text-[clamp(2.25rem,5vw,3.75rem)] leading-none whitespace-nowrap text-primary hover:underline">(412) 555-0142</a>
      <p class="mt-3 text-base-content/80">Up to two minutes. We might play it on the show.</p>
    </div>
    <div class="lg:col-span-7" data-reveal>
      <form hx-post="/_data/questions" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#forms-earshot-ask-problems swap:innerHTML" class="grid grid-cols-1 gap-x-4 gap-y-1 rounded-box border border-base-300 bg-base-100 p-5 sm:grid-cols-2 sm:p-7">
        <fieldset class="fieldset sm:col-span-2">
          <legend class="fieldset-legend text-[0.9375rem]">Your question</legend>
          <textarea name="question" class="textarea w-full rounded-box text-base" rows="3" required maxlength="2000" placeholder="Why does my grandmother say 'warsh'?"></textarea>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend text-[0.9375rem]">Your first name</legend>
          <input name="name" type="text" class="input w-full" required maxlength="100" autocomplete="given-name">
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend text-[0.9375rem]">Where you're from</legend>
          <input name="town" type="text" class="input w-full" maxlength="100" placeholder="Bloomfield, Pittsburgh">
        </fieldset>
        <fieldset class="fieldset sm:col-span-2">
          <legend class="fieldset-legend text-[0.9375rem]">Your email</legend>
          <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
        </fieldset>
        <label class="mt-3 flex cursor-pointer items-start gap-3 text-[0.9375rem] sm:col-span-2">
          <input name="on_air" type="checkbox" value="true" class="checkbox checkbox-primary mt-0.5" checked>
          <span>You can read my question on the show, with my first name and town.</span>
        </label>
        <div id="forms-earshot-ask-problems" class="sm:col-span-2"></div>
        <div class="mt-4 sm:col-span-2">
          <button type="submit" class="btn btn-primary w-full whitespace-nowrap sm:w-auto">Send your question</button>
        </div>
      </form>
    </div>
  </div>
</section>
