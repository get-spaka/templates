{%- assign first = record.name | default: "" | split: " " | first -%}
<div class="rounded-box border border-base-300 bg-base-100 p-6 sm:p-8" role="status">
  <p class="mono flex items-center gap-2 text-base-content/65"><span class="lamp" aria-hidden="true"></span>In the mailbag</p>
  <p class="mt-4 font-heading text-[clamp(1.5rem,2.6vw,2rem)] leading-tight font-bold text-balance">Thank you{% if first != blank %}, {{ first }}{% endif %}. Your question is in the mailbag.</p>
  <p class="mt-3 max-w-[56ch] leading-relaxed text-base-content/80">The Mailbag comes every fourth Tuesday. If we use your question, Hana will write to you before it goes out.</p>
</div>
