<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-7xl px-4 pt-16 md:px-8 md:pt-24">
    <h2 class="caption-title text-[clamp(2rem,4.5vw,3.5rem)] leading-tight"><span class="caption-box">Listen wherever you listen</span></h2>
    <ul class="mt-10 grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
      <li><a href="https://podcasts.apple.com/" class="group flex items-center justify-between gap-4 border-b border-neutral-content/15 py-3 font-heading text-[clamp(1.5rem,2.6vw,2.125rem)] font-bold leading-tight tracking-[-0.02em] hover:text-secondary">Apple Podcasts<svg class="size-6 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></li>
      <li><a href="https://open.spotify.com/" class="group flex items-center justify-between gap-4 border-b border-neutral-content/15 py-3 font-heading text-[clamp(1.5rem,2.6vw,2.125rem)] font-bold leading-tight tracking-[-0.02em] hover:text-secondary">Spotify<svg class="size-6 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></li>
      <li><a href="https://www.youtube.com/" class="group flex items-center justify-between gap-4 border-b border-neutral-content/15 py-3 font-heading text-[clamp(1.5rem,2.6vw,2.125rem)] font-bold leading-tight tracking-[-0.02em] hover:text-secondary">YouTube<svg class="size-6 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></li>
      <li><a href="https://pocketcasts.com/" class="group flex items-center justify-between gap-4 border-b border-neutral-content/15 py-3 font-heading text-[clamp(1.5rem,2.6vw,2.125rem)] font-bold leading-tight tracking-[-0.02em] hover:text-secondary">Pocket Casts<svg class="size-6 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></li>
      <li><a href="https://overcast.fm/" class="group flex items-center justify-between gap-4 border-b border-neutral-content/15 py-3 font-heading text-[clamp(1.5rem,2.6vw,2.125rem)] font-bold leading-tight tracking-[-0.02em] hover:text-secondary">Overcast<svg class="size-6 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></li>
      <li><a href="https://feeds.example.com/say-again" class="group flex items-center justify-between gap-4 border-b border-neutral-content/15 py-3 font-heading text-[clamp(1.5rem,2.6vw,2.125rem)] font-bold leading-tight tracking-[-0.02em] hover:text-secondary">RSS feed<svg class="size-6 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg></a></li>
    </ul>
    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="text-[1.25rem] leading-snug font-bold text-balance">The show notes and the week's best voicemail, every Tuesday.</p>
        <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#footer-earshot-newsletter-problems swap:innerHTML" class="mt-5 max-w-md">
          <label for="footer-earshot-newsletter-email" class="sr-only">Email address</label>
          <div class="flex flex-col gap-2 sm:flex-row">
            <input id="footer-earshot-newsletter-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input w-full border-neutral-content/30 bg-neutral text-neutral-content">
            <button type="submit" class="btn btn-secondary whitespace-nowrap">Sign me up</button>
          </div>
          <div id="footer-earshot-newsletter-problems" class="mt-2"></div>
        </form>
      </div>
      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-7">
        <div>
          <h3 class="mono text-neutral-content/60">Leave a voicemail</h3>
          <a href="tel:+14125550142" class="mt-3 block text-[1.25rem] font-bold whitespace-nowrap tabular-nums hover:text-secondary">(412) 555-0142</a>
          <p class="mt-2 text-[0.9375rem] leading-relaxed text-neutral-content/75">Up to two minutes. We might play it on the show.</p>
        </div>
        <nav aria-label="Footer">
          <h3 class="mono text-neutral-content/60">The show</h3>
          <ul class="mt-3 space-y-2">
            {%- for item in data.navigation -%}{%- if item.place == "both" or item.place == "footer" %}
            <li><a href="{{ item.href }}" class="hover:underline">{{ item.label }}</a></li>
            {%- endif -%}{%- endfor %}
          </ul>
        </nav>
        <div>
          <h3 class="mono text-neutral-content/60">Follow</h3>
          <ul class="mt-3 space-y-2">
            {%- for item in data.navigation -%}{%- if item.place == "social" %}
            <li><a href="{{ item.href }}" class="hover:underline">{{ item.label }}</a></li>
            {%- endif -%}{%- endfor %}
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-16 flex flex-col gap-3 border-t border-neutral-content/15 py-7 text-[0.875rem] text-neutral-content/70 md:flex-row md:items-center md:justify-between">
      <p class="flex items-center gap-2"><span class="lamp" aria-hidden="true"></span>Recorded in an old switchboard room in Lawrenceville, Pittsburgh.</p>
      <p>© 2026 Say Again? · A new episode every Tuesday at 6 am.</p>
    </div>
  </div>
</footer>
