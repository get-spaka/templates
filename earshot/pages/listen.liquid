<!doctype html>
<html lang="en">
<head>
<title>Listen — Say Again?</title>
<meta name="description" content="Listen to Say Again? on Apple Podcasts, Spotify, YouTube, Pocket Casts, Overcast or by RSS, join the Party Line for an ad-free feed, and hear the show live in Pittsburgh.">
<meta property="og:title" content="Listen — Say Again?">
<meta property="og:description" content="Every app that plays Say Again?, the Party Line membership and the next live tapings.">
</head>
<body>
{% render 'header', page: page %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-4 pt-14 pb-12 md:px-8 md:pt-20 md:pb-16">
    <p class="mono text-base-content/65" data-reveal>New episodes every Tuesday at 6 am Eastern</p>
    <h1 class="caption-title mt-5 text-[clamp(3rem,7.5vw,6.5rem)] leading-[1.15]" data-reveal><span class="caption-box">Wherever you listen</span></h1>
  </div>
</section>
{% render 'platforms' %}
<section id="party-line" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="mono flex items-center gap-2 text-base-content/65"><span class="lamp" aria-hidden="true"></span>Members</p>
        <h2 class="caption-title mt-5 text-[clamp(2.25rem,4.5vw,3.75rem)]"><span class="caption-box">The Party Line</span></h2>
      </div>
      <p class="max-w-[44ch] text-[1.0625rem] leading-relaxed text-base-content/80 lg:col-span-5">On the old telephone lines, a party line was shared by the whole street. Ours is shared by the listeners who keep the show going.</p>
    </div>
    <div class="mt-12 grid gap-5 lg:grid-cols-12">
      <div class="grid gap-5 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1" data-reveal>
        <div class="rounded-box bg-base-100 p-6 md:p-8">
          <p class="mono text-base-content/65">Monthly</p>
          <p class="mt-3 flex items-end gap-2"><span class="poster text-[4.5rem] leading-[0.85] text-primary">$5</span><span class="pb-1 text-base-content/80">a month</span></p>
          <a href="https://example.com/party-line" class="btn btn-primary mt-6 w-full whitespace-nowrap">Join the Party Line</a>
        </div>
        <div class="rounded-box bg-neutral p-6 text-neutral-content md:p-8">
          <p class="mono text-neutral-content/70">Yearly · two months free</p>
          <p class="mt-3 flex items-end gap-2"><span class="poster text-[4.5rem] leading-[0.85] text-secondary">$50</span><span class="pb-1 text-neutral-content/80">a year</span></p>
          <a href="https://example.com/party-line" class="btn btn-secondary mt-6 w-full whitespace-nowrap">Join for a year</a>
        </div>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:col-span-7" data-reveal="stagger">
        {%- for perk in data["listen-perks"] %}
        <li class="rounded-box border border-base-300 bg-base-100 p-6">
          <svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <h3 class="mt-4 text-[1.375rem] leading-tight">{{ perk.title }}</h3>
          <p class="mt-2 leading-relaxed text-base-content/80">{{ perk.text }}</p>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
<section id="live" class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-5" data-reveal>
      <h2 class="caption-title text-[clamp(2.25rem,4.5vw,3.75rem)]"><span class="caption-box">Hear it live</span></h2>
      <p class="mt-6 max-w-[42ch] text-[1.0625rem] leading-relaxed text-base-content/80">Twice a year we record in front of an audience in Lawrenceville: a guest, the Mailbag read aloud, and your questions from the seats.</p>
      <img src="/media/small-room-audience.jpg" class="mt-10 aspect-[3/2] w-full rounded-box object-cover" data-studio>
    </div>
    <ul class="self-center border-b border-base-300 lg:col-span-7" data-reveal="stagger">
      {%- for taping in data.tapings %}
      <li class="grid gap-5 border-t border-base-300 py-8 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-8">
        <p class="flex flex-row items-baseline gap-3 sm:flex-col sm:gap-1"><span class="mono text-primary">{{ taping.date | date: "%b" }}</span><span class="poster text-[3.5rem] leading-[0.85]">{{ taping.date | date: "%-d" }}</span><span class="mono text-base-content/65">{{ taping.date | date: "%Y" }}</span></p>
        <div>
          <h3 class="text-[clamp(1.5rem,2.6vw,2rem)] leading-tight">{{ taping.title }}</h3>
          <p class="mono mt-2 text-base-content/65">{{ taping.date | date: "%A" }} · {{ taping.time }} · {{ taping.venue }}</p>
          <p class="mt-3 max-w-[56ch] leading-relaxed text-base-content/80">{{ taping.note }}</p>
          {%- if taping.link %}
          <a href="{{ taping.link }}" class="btn btn-outline btn-sm mt-5 whitespace-nowrap">Get tickets</a>
          {%- endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
<section class="border-y border-base-300 bg-base-200 text-base-content">
  <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 py-10 md:flex-row md:items-center md:justify-between md:px-8" data-reveal>
    <div>
      <h2 class="text-[1.5rem] leading-tight">The Tuesday email</h2>
      <p class="mt-1 text-base-content/80">The show notes and the week's best voicemail, every Tuesday.</p>
    </div>
    <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#listen-newsletter-problems swap:innerHTML" class="w-full md:max-w-md">
      <label class="sr-only" for="listen-newsletter-email">Email address</label>
      <div class="flex flex-col gap-2 sm:flex-row">
        <input id="listen-newsletter-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="you@example.com" class="input w-full">
        <button type="submit" class="btn btn-primary whitespace-nowrap">Sign me up</button>
      </div>
      <div id="listen-newsletter-problems" class="mt-2"></div>
    </form>
  </div>
</section>
{% render 'faq', items: data["listen-faq"], title: "Questions about listening", columns: true %}
</main>
{% render 'footer' %}
</body>
</html>
