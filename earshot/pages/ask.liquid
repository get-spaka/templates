<!doctype html>
<html lang="en">
<head>
<title>Ask us — Say Again?</title>
<meta name="description" content="Got a word that bugs you? Send Say Again? your question or leave it on the voicemail line, (412) 555-0142. Every fourth Tuesday is the Mailbag.">
<meta property="og:title" content="Ask us — Say Again?">
<meta property="og:description" content="Send your question about how people talk, or call the voicemail line. The best ones are played on the show.">
</head>
<body>
{% render 'header', page: page %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-4 pt-14 pb-16 md:px-8 md:pt-20 md:pb-20">
    <p class="mono text-base-content/65" data-reveal>Ask us</p>
    <h1 class="caption-title mt-5 text-[clamp(3rem,7.5vw,6.5rem)] leading-[1.15]" data-reveal><span class="caption-box">Got a word</span><br><span class="caption-box">that bugs you?</span></h1>
    <p class="mt-8 max-w-[56ch] text-[1.1875rem] leading-relaxed text-base-content/80" data-reveal>Every fourth Tuesday is the Mailbag: an episode made entirely from your questions and voicemails. Most of our other episodes started as one, too.</p>
  </div>
</section>
<section id="voicemail" class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 pb-20 md:px-8 md:pb-28 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7" data-reveal>
      <p class="mono text-base-content/65">The voicemail line, open all week</p>
      <a href="tel:+14125550142" class="poster mt-3 block text-[clamp(2.25rem,5vw,4.75rem)] leading-[0.95] whitespace-nowrap text-primary hover:underline">(412) 555&#8209;0142</a>
      <p class="mt-5 text-[1.1875rem] text-base-content/80">Up to two minutes. We might play it on the show.</p>
    </div>
    <figure class="rounded-box bg-neutral p-6 text-neutral-content sm:p-8 lg:col-span-5" data-reveal>
      <figcaption class="mono flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.75rem] text-neutral-content/75"><span class="rounded-[0.2rem] border border-neutral-content/40 px-1.5 text-[0.6875rem]">CC</span><span class="flex items-center gap-2">Voicemail · Dana, Erie<span data-level aria-hidden="true"><i></i><i></i><i></i></span></span><a href="/episodes/mailbag-is-literally-ruined" class="text-secondary hover:underline">Played in ep. 140</a></figcaption>
      <blockquote class="mt-5"><p data-readalong class="caption-text text-[clamp(1.375rem,2.4vw,2rem)]">Hi, this is Dana from Erie. My boss has banned the word "literally" in meetings. Can she do that? Literally asking.</p></blockquote>
      {% render 'soundprint', n: 140, to: 39, class: "mt-8 h-10 text-secondary" %}
    </figure>
  </div>
</section>
<section id="send-a-question" class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <h2 class="text-[clamp(2rem,3.6vw,3rem)] leading-[1.05]">Or write it down</h2>
      <p class="mt-5 max-w-[40ch] text-[1.0625rem] leading-relaxed text-base-content/80">Tell us what you say, or what you hear, and where. A sentence is plenty. We read every one.</p>
      <img src="/media/headphones-on-table.jpg" class="mt-10 aspect-[4/3] w-full rounded-box object-cover" data-studio>
    </div>
    <div class="lg:col-span-8" data-reveal>
      {% render 'question-form', id: "ask-page", full: true %}
    </div>
  </div>
</section>
<section id="answered" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <h2 class="caption-title text-[clamp(2.25rem,4.5vw,3.75rem)]" data-reveal><span class="caption-box">Answered on air</span></h2>
    <ul class="mt-12 border-b border-base-300" data-reveal="stagger">
      {%- for item in data["ask-answered"] %}
      {%- assign ep = data.episodes | where: "id", item.episode | first %}
      <li class="grid gap-3 border-t border-base-300 py-7 md:grid-cols-[minmax(0,1fr)_16rem] md:items-center md:gap-10">
        <div>
          <p class="caption-text text-[clamp(1.25rem,2.2vw,1.75rem)] text-balance">{{ item.question }}</p>
          <p class="mono mt-2 text-[0.75rem] text-base-content/65">{{ item.name }}{% if item.town != blank %}, {{ item.town }}{% endif %}</p>
        </div>
        {%- if ep %}
        <a href="/episodes/{{ ep.id }}" class="group flex items-center gap-3 md:justify-end" data-tone="{{ ep.tone }}" data-ripple>
          <span class="poster tone-number text-[2.5rem] leading-none">{{ ep.number }}</span>
          <span class="font-bold leading-snug group-hover:underline">{{ ep.title }}</span>
        </a>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{% render 'faq', items: data["ask-faq"], title: "Questions about questions" %}
</main>
{% render 'footer' %}
</body>
</html>
