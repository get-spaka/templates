{%- assign first = record.name | default: "" | split: " " | first -%}
<div class="rounded-box border border-base-300 bg-base-100 p-6 sm:p-8 lg:col-span-7" role="status">
  <p class="mono text-base-content/65">Sent</p>
  <p class="mt-4 font-heading text-[clamp(1.5rem,2.6vw,2rem)] leading-tight font-bold text-balance">Thank you{% if first != blank %}, {{ first }}{% endif %}. Your message is with Hana.</p>
  <p class="mt-3 max-w-[56ch] leading-relaxed text-base-content/80">She reads every one and writes back within a week, to {{ record.email }}.</p>
</div>
