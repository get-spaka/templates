<!doctype html>
<html lang="en">
<head>
<title>News — Ocampo Hale Architects, Tucson</title>
<meta name="description" content="What Ocampo Hale Architects is building, what it has won, where its partners speak, and who it is hiring.">
<meta property="og:title" content="News — Ocampo Hale Architects">
<meta property="og:description" content="What we're building, and where to find us.">
</head>
<body>
{% render 'header', page: page, data: data %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pt-14 pb-16 md:px-10 md:pt-20">
    <h1 class="font-heading text-[clamp(4rem,12vw,10rem)] font-extrabold leading-[0.86] tracking-[-0.01em]" data-cast style="--cast: 0.14em">News</h1>
    <p class="mt-8 max-w-[30em] text-[1.375rem] leading-snug text-base-content/80 md:text-[1.625rem]">What we're building, and where to find us.</p>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pb-20 md:px-10 md:pb-28">
    {% render 'news-lines', notes: data.news, limit: 50, summaries: true, covers: true %}
  </div>
</section>
{% render 'brief-band' %}
</main>
{% render 'footer', data: data %}
</body>
</html>
