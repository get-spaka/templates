<!doctype html>
<html lang="en">
<head>
<title>{{ record.title }} — Ocampo Hale Architects</title>
<meta name="description" content="{{ record.thesis }}. {{ record.title }}, {{ record.place }}, {{ record.town }}, by Ocampo Hale Architects.">
<meta property="og:title" content="{{ record.title }} — Ocampo Hale Architects">
<meta property="og:description" content="{{ record.thesis }}.">
</head>
<body>
{% render 'header', page: page, data: data %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pt-12 pb-12 md:px-10 md:pt-16">
    <p class="spec flex flex-wrap gap-x-3 text-base-content/70"><a href="/projects" class="text-base-content underline underline-offset-4">Projects</a><span>{{ record.number }}</span><span class="whitespace-nowrap"><span class="status-dot" data-status="{{ record.status }}"></span>{% case record.status %}{% when "built" %}Built{% when "on-site" %}On site,{% when "in-design" %}In design,{% endcase %} {{ record.year }}</span></p>
    <h1 class="mt-6 max-w-[12em] font-heading text-[clamp(4rem,9vw,8rem)] font-extrabold leading-[0.86] tracking-[-0.01em] text-balance" data-cast style="--cast: 0.14em">{{ record.title }}</h1>
    <p class="mt-8 max-w-[30em] text-[1.375rem] leading-snug text-base-content/80 md:text-[1.75rem]">{{ record.thesis }}</p>
  </div>
</section>
<section class="bg-base-100">
  <div class="mx-auto max-w-[90rem] px-5 md:px-10">
    {% render 'opening', src: record.cover, class: "aspect-[4/3] w-full md:aspect-[16/8]", cast: true %}
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-5 py-20 md:px-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2 class="font-heading text-[2.5rem] font-bold leading-[0.9]" data-cast>The building</h2>
      <dl class="mt-6 border-b border-base-content/25">
        {% capture kind %}{% case record.type %}{% when "house" %}House{% when "addition" %}Addition{% when "restoration" %}Restoration{% when "public" %}Public building{% when "shade" %}Shade{% endcase %}{% endcapture %}
        <div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Type</dt><dd>{{ kind }}</dd></div>
        <div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Place</dt><dd>{{ record.place }}, {{ record.town }}</dd></div>
        {% if record.area %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Area</dt><dd>{{ record.area }}</dd></div>{% endif %}
        {% if record.client %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Client</dt><dd>{{ record.client }}</dd></div>{% endif %}
        {% if record.team %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Team</dt><dd>{{ record.team }}</dd></div>{% endif %}
        {% if record.engineer %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Structure</dt><dd>{{ record.engineer }}</dd></div>{% endif %}
        {% if record.builder %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Builder</dt><dd>{{ record.builder }}</dd></div>{% endif %}
        {% if record.photographer %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Photographs</dt><dd>{{ record.photographer }}</dd></div>{% endif %}
      </dl>
    </div>
    {% if record.faces or record.shade or record.energy or record.walls %}
    <div>
      <h2 class="font-heading text-[2.5rem] font-bold leading-[0.9]" data-cast>The sun</h2>
      <dl class="mt-6 border-b border-base-content/25">
        {% if record.faces %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Faces</dt><dd>{{ record.faces }}</dd></div>{% endif %}
        {% if record.shade %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Shade</dt><dd>{{ record.shade }}</dd></div>{% endif %}
        {% if record.energy %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Energy</dt><dd>{{ record.energy }}</dd></div>{% endif %}
        {% if record.walls %}<div class="grid grid-cols-[9rem_1fr] gap-4 border-t border-base-content/25 py-3"><dt class="spec pt-1 text-base-content/70">Walls</dt><dd>{{ record.walls }}</dd></div>{% endif %}
      </dl>
    </div>
    {% endif %}
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pb-20 md:px-10">
    <div class="story mx-auto max-w-[36em] text-[1.125rem] leading-relaxed text-base-content/85">{{ record.body }}</div>
  </div>
</section>
{% render 'strata' %}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-x-8 gap-y-12 px-5 py-20 md:grid-cols-12 md:px-10 md:py-28">
    <div class="md:col-span-7">{% render 'opening', src: record.photo_1, class: "aspect-[4/3] w-full", cast: true %}</div>
    <div class="w-[72%] justify-self-end md:col-span-4 md:col-start-9 md:mt-28 md:w-full">{% render 'opening', src: record.photo_2, class: "aspect-[3/4] w-full", cast: true %}</div>
    <div class="w-[72%] md:col-span-4 md:col-start-2 md:w-full">{% render 'opening', src: record.photo_4, class: "aspect-[3/4] w-full", cast: true %}</div>
    <div class="md:col-span-6 md:col-start-7 md:mt-20">{% render 'opening', src: record.photo_3, class: "aspect-[4/3] w-full", cast: true %}</div>
  </div>
</section>
{% if record.quote %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-10 md:py-24">
    <figure class="mx-auto max-w-4xl border-t border-base-content/25 pt-10" data-rise>
      <blockquote class="text-[1.5rem] leading-snug md:text-[1.75rem]">“{{ record.quote }}”</blockquote>
      <figcaption class="mt-6 text-base-content/75">{{ record.quote_by }}</figcaption>
    </figure>
  </div>
</section>
{% endif %}
{% assign next = nil %}{% assign take = false %}
{% for project in data.projects %}{% if take and next == nil %}{% assign next = project %}{% endif %}{% if project.id == record.id %}{% assign take = true %}{% endif %}{% endfor %}
{% if next == nil %}{% assign next = data.projects | first %}{% endif %}
<section class="border-t border-base-300 bg-base-100 text-base-content">
  <a href="/projects/{{ next.id }}" class="group mx-auto grid max-w-[90rem] items-center gap-8 px-5 py-16 md:grid-cols-12 md:px-10 md:py-20">
    <div class="md:col-span-9">
      <p class="spec text-base-content/70">Next project · {{ next.number }}</p>
      <p class="mt-4 font-heading text-[clamp(3rem,7vw,6rem)] font-extrabold leading-[0.88] underline-offset-8 group-hover:underline" data-cast style="--cast: 0.16em">{{ next.title }}</p>
    </div>
    <div class="w-40 md:col-span-3 md:w-full md:max-w-56 md:justify-self-end">{% render 'opening', src: next.cover, class: "aspect-square w-full" %}</div>
  </a>
</section>
{% render 'brief-band' %}
</main>
{% render 'footer', data: data %}
</body>
</html>
