<!doctype html>
<html lang="en">
<head>
<title>Projects — Ocampo Hale Architects, Tucson</title>
<meta name="description" content="Houses, restorations, a library and a mile of shade: every project of Ocampo Hale Architects, built, on site and in design, all within two hours of Tucson.">
<meta property="og:title" content="Projects — Ocampo Hale Architects">
<meta property="og:description" content="Built, on site and on the drawing table, all within two hours of Tucson.">
</head>
<body>
{% render 'header', page: page, data: data %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pt-14 pb-16 md:px-10 md:pt-20">
    <h1 class="flex items-start gap-4 font-heading text-[clamp(4rem,12vw,10rem)] font-extrabold leading-[0.86] tracking-[-0.01em]" data-cast style="--cast: 0.14em">Projects <span class="figure text-[0.45em] leading-none text-primary">{{ data.projects.size }}</span></h1>
    <p class="mt-8 max-w-[30em] text-[1.375rem] leading-snug text-base-content/80 md:text-[1.625rem]">Built, on site and on the drawing table, all within two hours of Tucson.</p>
  </div>
</section>
{% render 'strata' %}
{% render 'project-wall', data: data %}
{% render 'brief-band' %}
</main>
{% render 'footer', data: data %}
</body>
</html>
