<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pb-20 md:px-10 md:pb-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="spec text-base-content/70">News</p>
        <h2 class="mt-3 font-heading text-[clamp(2.75rem,6vw,5rem)] font-bold leading-[0.9]" data-cast>From the ice house</h2>
      </div>
      <a href="/news" class="btn btn-outline whitespace-nowrap border-base-content/40 bg-base-100" data-cast>All news</a>
    </div>
    <div class="mt-12">{% render 'news-lines', notes: data.news, limit: 3, summaries: false, covers: false %}</div>
  </div>
</section>
