<section id="day" class="bg-secondary text-secondary-content">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-10 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="font-heading text-[clamp(2.75rem,6vw,5rem)] font-bold leading-[0.9] lg:col-span-7" data-cast>A summer day in one of our houses</h2>
      <p class="max-w-[36em] text-[1.125rem] leading-relaxed text-secondary-content/80 lg:col-span-5">{{ intro }}</p>
    </div>
    <ol class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {% for day in days %}
      <li class="grid grid-cols-[8.5rem_1fr] bg-base-100 sm:flex sm:flex-col text-base-content outline-offset-2 focus-visible:outline-2 focus-visible:outline-accent" data-day-card tabindex="0">
        {% render 'model', sun: day.sun %}
        <div class="flex flex-1 flex-col border-l border-base-300 p-5 sm:border-t sm:border-l-0">
          <p class="figure text-[2.5rem] sm:text-[3.25rem]">{{ day.hour }}</p>
          <h3 class="mt-3 font-heading text-[1.625rem] font-bold leading-[1]">{{ day.title }}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-base-content/75">{{ day.text }}</p>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
