<section id="practice" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pb-20 md:px-10 md:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="w-[78%] sm:w-[60%] lg:col-span-4 lg:w-full">
        {% render 'opening', src: "/media/ice-house-door.jpg", class: "aspect-[4/5] w-full" %}
        <p class="spec mt-4 border-t border-base-content/25 pt-3 text-base-content/70">The studio · A 1928 adobe ice house, 418 South Meyer Avenue</p>
      </div>
      <div class="lg:col-span-7 lg:col-start-6" data-rise>
        <p class="spec text-base-content/70">The practice</p>
        <p class="mt-5 font-heading text-[clamp(2rem,3.4vw,3.25rem)] font-bold leading-[1.02]">Ocampo Hale is six people in an old ice house in Barrio Viejo. Since 2014 we have finished 41 buildings, all within two hours of Tucson, and every one was drawn around the sun before anything else. We take on six to eight projects a year, so the partners draw each of them.</p>
        <div class="mt-8 flex flex-wrap items-end justify-between gap-6">
          <p class="text-[1.0625rem] leading-relaxed text-base-content/75"><span class="block font-heading text-[2rem] font-semibold leading-none text-base-content">Lucía Ocampo and Peter Hale</span>Partners, AIA</p>
          <a href="/practice" class="btn btn-outline whitespace-nowrap border-base-content/40 bg-base-100" data-cast>About the practice</a>
        </div>
      </div>
    </div>
    <dl class="mt-20 grid grid-cols-2 gap-x-6 gap-y-10 md:gap-x-10 lg:grid-cols-4">
      {% for stat in data["home-stats"] %}
      <div class="border-t border-base-content/25 pt-4">
        <dt class="spec text-base-content/70">{{ stat.label }}</dt>
        <dd class="figure mt-3 text-[clamp(3.5rem,6vw,6rem)]" data-cast style="--cast: 0.1em">{{ stat.value }}</dd>
        <dd class="mt-2 text-[0.9375rem] text-base-content/70">{{ stat.note }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
