<section id="design" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-10 md:py-28">
    <p class="spec text-base-content/70">What we design</p>
    <h2 class="mt-3 max-w-[14em] font-heading text-[clamp(2.75rem,6vw,5rem)] font-bold leading-[0.9]" data-cast>Four kinds of building, one climate</h2>
    <ul class="mt-14 grid gap-x-12 gap-y-12 lg:grid-cols-2">
      {% for service in data.services %}
      {% assign count = 0 %}
      {% for project in data.projects %}{% if service.types contains project.type %}{% assign count = count | plus: 1 %}{% endif %}{% endfor %}
      <li class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-6 border-t border-base-content/25 pt-6 sm:grid-cols-[8.5rem_minmax(0,1fr)]">
        {% render 'opening', src: service.image, class: "aspect-square w-full" %}
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-heading text-[1.875rem] font-bold leading-[0.95] md:text-[2.25rem]">{{ service.name }}</h3>
            <p class="spec shrink-0 text-base-content/70"><span class="figure text-[2rem] text-base-content">{{ count }}</span> {% if count == 1 %}project{% else %}projects{% endif %}</p>
          </div>
          <p class="mt-3 leading-relaxed text-base-content/75">{{ service.summary }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
