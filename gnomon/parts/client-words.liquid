{% assign words = data.testimonials | first %}
{% if words %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pb-20 md:px-10 md:pb-28">
    <figure class="mx-auto max-w-4xl border-t border-base-content/25 pt-10" data-rise>
      <p class="spec text-base-content/70">In their words</p>
      <blockquote class="mt-6 text-[1.5rem] leading-snug md:text-[1.75rem]">“{{ words.quote }}”</blockquote>
      <figcaption class="mt-6 text-base-content/75"><span class="font-semibold text-base-content">{{ words.name }}</span> · {{ words.project }}</figcaption>
    </figure>
  </div>
</section>
{% endif %}
