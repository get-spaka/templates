<footer class="on-dark bg-neutral text-neutral-content">
  <div data-strata aria-hidden="true"></div>
  <div class="mx-auto max-w-[90rem] px-5 pt-16 md:px-10 md:pt-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="font-heading text-[clamp(3rem,6vw,4.5rem)] font-extrabold leading-[0.9]" data-cast style="--cast: 0.14em">Ocampo Hale</a>
        <p class="spec mt-4 text-neutral-content/70">Architects · Tucson, Arizona · Since 2014</p>
        <p class="mt-6 max-w-sm leading-relaxed text-neutral-content/80">Houses, additions and small public buildings for the Sonoran Desert, designed around the sun.</p>
      </div>
      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-7">
        <div>
          <h2 class="spec text-neutral-content/60">The studio</h2>
          <address class="mt-4 leading-relaxed not-italic">418 South Meyer Avenue<br>Barrio Viejo, Tucson<br>AZ 85701</address>
          <p class="mt-4 leading-relaxed"><a href="tel:+15205550173" class="tabular-nums hover:underline">(520) 555-0173</a><br><a href="mailto:studio@ocampohale.com" class="break-all hover:underline">studio@ocampohale.com</a></p>
        </div>
        <div>
          <h2 class="spec text-neutral-content/60">Hours</h2>
          <p class="mt-4 leading-relaxed">Visits by appointment</p>
          <p class="mt-4 leading-relaxed text-neutral-content/80"><span data-sunset data-lat="32.2155" data-lng="-110.9747" data-tz="America/Phoenix"><span data-sunset-plain>Studio open weekdays 8:30 to 5:30</span><span data-sunset-line hidden>Sunset in Tucson today: <span data-sunset-time class="whitespace-nowrap">7:33 pm</span></span></span></p>
        </div>
        <nav aria-label="Footer">
          <h2 class="spec text-neutral-content/60">Pages</h2>
          <ul class="mt-4 space-y-2">
            {% for item in data.navigation %}{% if item.place == "both" or item.place == "footer" %}
            <li><a href="{{ item.href }}" class="hover:underline">{{ item.label }}</a></li>
            {% endif %}{% endfor %}
            {% for item in data.navigation %}{% if item.place == "social" %}
            <li><a href="{{ item.href }}" class="text-neutral-content/80 hover:underline">{{ item.label }}</a></li>
            {% endif %}{% endfor %}
          </ul>
        </nav>
      </div>
    </div>
    <div class="mt-14 flex flex-wrap justify-between gap-3 border-t border-neutral-content/15 py-7 text-[0.8125rem] text-neutral-content/70">
      <p>Ocampo Hale Architects PLLC · Arizona registered architects</p>
      <p>© 2026 Ocampo Hale Architects</p>
    </div>
  </div>
</footer>
