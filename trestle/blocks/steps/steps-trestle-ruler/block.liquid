<section class="border-t border-base-300 bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 lg:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="mono text-base-content/70">How it works</p>
        <h2 class="mt-5 text-4xl font-light md:text-6xl">From the first visit to the year after</h2>
      </div>
      <p class="text-lg text-pretty text-base-content/80 lg:col-span-5">The same five steps for a window seat as for a whole house. The first two cost you nothing.</p>
    </div>
    <ol data-ruler class="ruler-steps mt-14 grid gap-y-12 lg:mt-20 lg:auto-cols-fr lg:grid-flow-col" style="--steps: {{ data.steps.size }}">
      {% for step in data.steps %}
      <li style="--step: {{ forloop.index0 }}">
        <p class="figure text-4xl text-base-content/80 md:text-5xl">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</p>
        <p class="mono mt-5 text-base-content/70">{{ step.when }}</p>
        <h3 class="mt-2 text-xl leading-tight">{{ step.title }}</h3>
        <p class="mt-3 text-base text-pretty text-base-content/80">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
