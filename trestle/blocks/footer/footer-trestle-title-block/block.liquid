<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-7xl px-5 pt-16 pb-10 md:px-8 md:pt-20">
    <div class="flex flex-wrap items-end justify-between gap-8 pb-12">
      <p class="max-w-2xl text-3xl leading-[1.1] font-light tracking-[-0.02em] text-balance md:text-4xl">Joinery and renovation for the old houses of the Hudson Valley.</p>
      <a href="/quote#request" class="btn btn-accent whitespace-nowrap">Request a visit</a>
    </div>
    <div class="title-block grid-cols-2 md:grid-cols-6">
      <div class="col-span-2 flex flex-col justify-between gap-8 p-5 md:row-span-2">
        <p class="mono text-neutral-content/70">Drawn and made by</p>
        <div>
          <p class="text-4xl leading-none font-light tracking-[-0.03em] md:text-5xl">Ostrom &amp; Kemp</p>
          <p class="mono mt-4 text-neutral-content/70">Joinery and renovation · Since 2013</p>
        </div>
      </div>
      <div class="col-span-2 p-5">
        <p class="mono text-neutral-content/70">Workshop</p>
        <address class="mt-3 not-italic">61 Union Street<br>Hudson, NY 12534</address>
        <a href="https://www.openstreetmap.org/search?query=61%20Union%20Street%2C%20Hudson%2C%20NY" class="mono mt-3 inline-block link-hover text-accent">Get directions</a>
      </div>
      <div class="col-span-2 p-5">
        <p class="mono text-neutral-content/70">Hours</p>
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
          <dt>Monday to Friday</dt><dd class="text-right tabular-nums text-neutral-content/80">8 am – 5 pm</dd>
          <dt>Saturday</dt><dd class="text-right tabular-nums text-neutral-content/80">9 am – noon</dd>
          <dt>Sunday</dt><dd class="text-right tabular-nums text-neutral-content/80">Closed</dd>
        </dl>
      </div>
      <div class="col-span-2 p-5">
        <p class="mono text-neutral-content/70">Call or write</p>
        <p class="mt-3"><a href="tel:+15185550161" class="link-hover">(518) 555-0161</a><br><a href="mailto:office@ostromkemp.com" class="link-hover break-all">office@ostromkemp.com</a></p>
      </div>
      <div class="col-span-2 p-5">
        <p class="mono text-neutral-content/70">Certified and insured</p>
        <p class="mt-3 text-neutral-content/80">EPA lead-safe certified firm<br>General liability and workers' compensation</p>
      </div>
      <nav aria-label="Footer" class="col-span-2 p-5">
        <p class="mono text-neutral-content/70">Pages</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "footer" %}
          <li><a href="{{ item.href }}" class="link-hover">{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </nav>
      <div class="p-5">
        <p class="mono text-neutral-content/70">Follow</p>
        <ul class="mt-3 space-y-1">
          {% for item in data.navigation %}{% if item.place == "social" %}
          <li><a href="{{ item.href }}" class="link-hover">{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      <div class="p-5">
        <p class="mono text-neutral-content/70">Scale</p>
        <p class="mt-3">Full size</p>
      </div>
      <div class="col-span-2 p-5">
        <p class="mono text-neutral-content/70">Sheet</p>
        <p class="mt-3 tabular-nums">© 2026</p>
      </div>
    </div>
  </div>
</footer>
