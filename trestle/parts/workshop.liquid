<section class="border-t border-base-300 bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
      <img src="/media/workshop-barn.jpg" class="aspect-[5/4] w-full object-cover lg:col-span-6" data-reveal>
      <div class="lg:col-span-6" data-reveal>
        <p class="mono text-base-content/70">The workshop</p>
        <h2 class="mt-5 text-4xl font-light md:text-5xl">Everything we fit, we make ourselves, ten minutes from your house</h2>
        <p class="mt-6 text-lg text-pretty text-base-content/80">Four of us work at the benches in a brick carriage barn on Union Street, with timber racks of oak, ash and cherry from a sawmill upstate and pine saved from old barns. Come and see a kitchen being made on a Saturday morning.</p>
        <a href="/workshop" class="btn btn-outline mt-10 whitespace-nowrap">Visit the workshop</a>
      </div>
    </div>
    <dl class="mt-16 grid grid-cols-2 gap-x-6 gap-y-12 lg:mt-24 lg:grid-cols-4 lg:gap-x-10">
      {% for figure in data["home-figures"] %}
      <div data-reveal>
        <dt data-measure class="text-base-content/70">{{ figure.label }}</dt>
        <dd class="figure mt-5 text-5xl md:text-6xl">{{ figure.value }}</dd>
        {% if figure.note %}<dd class="mt-3 text-sm text-pretty text-base-content/70">{{ figure.note }}</dd>{% endif %}
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
