<section class="border-t border-base-300 bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 lg:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="mono text-base-content/70">What we do</p>
        <h2 class="mt-5 text-4xl font-light md:text-6xl">A few things, done ourselves</h2>
      </div>
      <p class="text-lg text-pretty text-base-content/80 lg:col-span-5">What can be made at a bench, we make in our workshop. The rest we do in your house, with the plumbers and electricians we have worked with for years.</p>
    </div>
    <div class="mt-14 grid gap-14 lg:mt-16 lg:grid-cols-2 lg:gap-16">
      {% assign columns = "workshop|on site" | split: "|" %}
      {% for made in columns %}
      {% assign rows = data.services | where: "made", made %}
      {% if rows.size > 0 %}
      <div data-reveal>
        <h3 class="text-2xl">{% if made == "workshop" %}Made in our workshop{% else %}Done in your house{% endif %}</h3>
        <ul class="mt-6 border-t border-base-300">
          {% for service in rows %}
          <li class="border-b border-base-300">
            <a href="/services#{{ service.id }}" class="group grid grid-cols-[5.5rem_minmax(0,1fr)_auto] items-center gap-5 py-5 transition-colors hover:bg-base-200 sm:grid-cols-[7rem_minmax(0,1fr)_auto] sm:px-3 sm:-mx-3">
              {% if service.image %}<img src="{{ service.image }}" class="aspect-[4/3] w-full object-cover">{% else %}<div class="aspect-[4/3] w-full bg-base-200"></div>{% endif %}
              <span>
                <span class="block text-lg leading-tight">{{ service.name }}</span>
                <span class="mt-1 block text-sm text-pretty text-base-content/70">{{ service.summary }}</span>
              </span>
              <svg class="size-5 text-base-content/50 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15"/><path d="m13 6 6 6-6 6"/></svg>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
