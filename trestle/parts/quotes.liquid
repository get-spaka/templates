<section class="border-t border-base-300 bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 lg:py-28">
    <div class="flex flex-wrap items-center justify-between gap-6" data-reveal>
      <p class="mono text-base-content/70">Said by clients</p>
      <a href="/reviews" class="btn btn-ghost btn-sm whitespace-nowrap">All reviews</a>
    </div>
    {% for item in data.testimonials limit: 1 %}
    <figure class="mt-10 max-w-5xl" data-reveal>
      <blockquote class="text-[clamp(1.5rem,2.7vw,2.25rem)] leading-[1.3] font-light tracking-[-0.015em] text-pretty"><p>“{{ item.quote }}”</p></blockquote>
      <figcaption class="mt-10 flex items-center gap-4">
        <span data-measure class="w-16 shrink-0" aria-hidden="true"></span>
        <span><span class="font-medium">{{ item.name }}</span><span class="mono ml-3 text-base-content/70">{{ item.role }}</span></span>
      </figcaption>
    </figure>
    {% endfor %}
    <div class="mt-20 grid gap-12 border-t border-base-300 pt-10 md:grid-cols-3 md:gap-10">
      {% for item in data.testimonials offset: 1 limit: 3 %}
      <figure data-reveal>
        {% if item.headline %}<h3 class="text-xl leading-tight">{{ item.headline }}</h3>{% endif %}
        <blockquote class="mt-3 text-pretty text-base-content/80"><p>“{{ item.quote }}”</p></blockquote>
        <figcaption class="mt-5"><span class="block text-sm font-medium">{{ item.name }}</span><span class="mono mt-1 block text-base-content/70">{{ item.role }}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
