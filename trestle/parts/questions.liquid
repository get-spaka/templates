<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 md:px-8 lg:grid-cols-12 lg:gap-16 lg:py-28">
    <div class="lg:col-span-4" data-reveal>
      <p class="mono text-base-content/70">Questions</p>
      <h2 class="mt-5 text-4xl font-light md:text-5xl">Before you ask</h2>
      <p class="mt-6 text-lg text-pretty text-base-content/80">What people most often want to know about working on an old house with us.</p>
    </div>
    <ol class="border-t border-base-300 lg:col-span-8" data-reveal>
      {% for item in data["services-faq"] %}
      <li class="border-b border-base-300">
        <details class="group">
          <summary class="flex cursor-pointer list-none items-baseline gap-5 py-5 md:gap-8 [&::-webkit-details-marker]:hidden">
            <span class="mono w-6 shrink-0 text-base-content/70">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="flex-1 text-xl leading-snug">{{ item.question }}</span>
            <svg class="size-5 shrink-0 self-center text-base-content/60 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
          </summary>
          <div class="pb-6 pl-11 text-pretty text-base-content/80 md:pr-12 md:pl-14 [&_a]:link [&_p+p]:mt-3">{{ item.answer }}</div>
        </details>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
