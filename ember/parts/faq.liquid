<section class="bg-base-100 text-base-content" id="questions">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-4 py-24 md:grid-cols-12 md:gap-10 md:px-10 md:py-32">
    <div class="md:col-span-4" data-reveal>
      <p class="tag text-primary">Questions</p>
      <h2 class="mt-6 text-5xl text-balance md:text-6xl">Before you come</h2>
      <p class="prose-ember mt-6">Anything else, write to <a href="mailto:evenings@wick.example" class="text-primary hover:underline">evenings@wick.example</a>.</p>
    </div>
    <div class="border-t border-base-300 md:col-span-7 md:col-start-6" data-reveal>
      {% for item in data["visit-faq"] %}
      <div class="collapse collapse-plus rounded-none border-b border-base-300">
        <input type="radio" name="visit-faq" id="visit-faq-{{ forloop.index }}" {% if forloop.first %}checked{% endif %} aria-label="{{ item.question }}">
        <div class="collapse-title px-0 py-6 pe-10 font-[family-name:var(--font-heading)] text-2xl md:text-3xl">{{ item.question }}</div>
        <div class="collapse-content prose-ember px-0">{{ item.answer }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
