<header class="site-header sticky top-0 z-50 -mb-[4.5rem] text-neutral-content md:-mb-[5.25rem]">
  <div class="mx-auto flex h-[4.5rem] max-w-[90rem] items-center justify-between gap-6 px-4 md:h-[5.25rem] md:px-10">
    <a href="/" class="kern-first display inline-block text-3xl leading-none md:text-4xl">Wick</a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-9">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
        <li><a href="{{ item.href }}" class="tag transition-colors hover:text-primary {% if page.url == item.href %}text-primary{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/visit#reserve" class="btn btn-outline btn-primary btn-sm tag md:btn-md">Reserve</a>
      <details class="site-menu lg:hidden">
        <summary class="btn btn-ghost btn-circle relative z-[70] text-neutral-content" aria-label="Menu">
          <svg class="menu-open size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 9h16"/><path d="M4 15h16"/></svg>
          <svg class="menu-close size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6 6 18"/></svg>
        </summary>
        <nav aria-label="Main" class="fixed inset-0 z-[60] flex flex-col justify-between overflow-y-auto bg-neutral px-6 pt-28 pb-10 text-neutral-content">
          <ul class="space-y-2">
            {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
            <li><a href="{{ item.href }}" class="display block text-5xl leading-tight transition-colors hover:text-primary sm:text-6xl {% if page.url == item.href %}text-primary{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endif %}{% endfor %}
          </ul>
          <div class="mt-12 space-y-5">
            <a href="/visit#reserve" class="btn btn-primary btn-lg tag w-full">Reserve a table</a>
            <p class="tag text-neutral-content/70">62 Chandler Lane · Portland, Maine</p>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>
