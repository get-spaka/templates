{% assign styles = "sparkling,white,skin-contact,rosé,red,sweet" | split: "," %}
{% assign poured = data.wines | where: "by_the_glass", true %}
<section class="bg-base-100 text-base-content" id="by-the-glass">
  <div class="mx-auto max-w-[90rem] px-4 py-20 md:px-10 md:py-28">
    <div class="grid gap-6 md:grid-cols-2 md:items-end">
      <div>
        <p class="tag text-primary">By the glass</p>
        <h2 class="mt-6 text-5xl md:text-7xl">Poured tonight</h2>
      </div>
      <p class="tag text-base-content/70 md:text-right">Glass (5 oz) · bottle</p>
    </div>
    <div class="mt-14 grid gap-x-16 gap-y-14 lg:grid-cols-2">
      {% for style in styles %}
      {% assign wines = poured | where: "style", style %}
      {% if wines.size > 0 %}
      <div data-reveal>
        <h3 class="tag border-b border-base-content/40 pb-3 text-primary">{% case style %}{% when "sparkling" %}Sparkling{% when "white" %}White{% when "skin-contact" %}Skin contact{% when "rosé" %}Rosé{% when "red" %}Red{% else %}Sweet{% endcase %}</h3>
        <ul class="divide-y divide-base-300">
          {% for wine in wines %}
          <li class="py-6">
            <div class="flex items-end gap-4">
              <p class="display grow text-2xl md:text-[1.75rem]">{{ wine.name }}</p>
              <p class="tag shrink-0 whitespace-nowrap"><span class="text-primary">{{ wine.glass }}</span> · {{ wine.bottle }}</p>
            </div>
            <p class="tag mt-2 text-base-content/70">{{ wine.producer }} · {{ wine.region }} · {{ wine.vintage }}</p>
            {% if wine.note %}<p class="prose-ember mt-3 max-w-lg">{{ wine.note }}</p>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
