{% assign featured = data.wines | where: "featured", true %}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-4 py-24 md:grid-cols-[1fr_1.3fr] md:gap-20 md:px-10 md:py-32">
    <div data-reveal>
      <p class="tag text-primary">By the glass</p>
      <h2 class="mt-6 text-5xl text-balance md:text-6xl">Fourteen open bottles, every night</h2>
      <p class="prose-ember mt-6 max-w-md">Mostly from small growers in the Loire, the Jura, Piedmont and the Finger Lakes. Julien changes a few each week; ask for a taste before you choose.</p>
      <a href="/wine" class="btn btn-outline btn-primary tag mt-10">The cellar</a>
    </div>
    <ul class="divide-y divide-base-300 border-y border-base-300" data-reveal>
      {% for wine in featured limit: 5 %}
      <li class="py-6">
        <div class="flex items-end">
          <h3 class="text-2xl md:text-3xl">{{ wine.name }}</h3>
          <span class="leader" aria-hidden="true"></span>
          <span class="tag text-sm whitespace-nowrap text-primary">{{ wine.glass }}</span>
        </div>
        <p class="tag mt-2 text-base-content/70">{{ wine.producer }} · {{ wine.region }} · {{ wine.vintage }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
