<section class="relative bg-neutral text-neutral-content">
  <figure class="candle h-[min(78svh,40rem)] min-h-[28rem] md:h-[min(86svh,48rem)] md:min-h-[36rem]" data-candlelight data-grade>
    <div class="candle-media" data-fade-in>
      <img src="/media/room.jpg" class="object-[50%_60%]">
      <canvas data-shader aria-hidden="true"></canvas>
    </div>
    <figcaption class="absolute right-4 bottom-[22%] z-10 hidden max-w-[14rem] text-right md:right-10 md:block">
      <span class="tag block text-neutral-content/80">Since 2021, in an 1868 ship chandler's warehouse</span>
    </figcaption>
  </figure>
  <div class="relative z-10 mx-auto max-w-[90rem] px-4 pb-16 md:px-10 md:pb-24">
    <h1 class="kern-first -mt-[0.52em] text-[clamp(5.5rem,24vw,22rem)] leading-[0.8] tracking-[-0.04em]" data-flicker>Wick</h1>
    <div class="mt-8 grid gap-8 md:mt-10 md:grid-cols-[1.2fr_1fr] md:items-end md:gap-12">
      <div>
        <p class="display max-w-xl text-3xl text-balance md:text-4xl">Wine, fire and a late kitchen on Chandler Lane</p>
        <p class="tag mt-6 inline-flex items-center gap-3 text-neutral-content/80" data-tonight data-open="Open now · kitchen until {kitchen}" data-bar="Open now · the bar until {closes}" data-midnight="midnight" data-later="Open tonight from {opens}" data-next="Closed tonight · back {day} at {opens}">
          <span class="tonight-dot size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          <span data-tonight-text>Tuesday to Saturday, 5 pm till late</span>
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href="/visit#reserve" class="btn btn-primary btn-lg tag">Reserve a table</a>
        <a href="/menu" class="btn btn-outline btn-primary btn-lg tag">See the menu</a>
      </div>
    </div>
  </div>
</section>
