{% assign featured = data.menu | where: "featured", true %}
<section class="overflow-hidden bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-24 md:px-10 md:py-36">
    <div class="grid items-center md:grid-cols-12">
      <div class="aspect-[4/5] md:col-span-7 md:col-start-1 md:row-start-1 md:aspect-[5/6]" data-drift data-grade>
        <img src="/media/hake.jpg" class="size-full object-cover">
      </div>
      <div class="menu-card relative z-10 -mt-12 px-6 py-10 sm:mx-6 md:col-span-6 md:col-start-7 md:row-start-1 md:mx-0 md:-ml-6 md:-rotate-2 md:px-12 md:py-14 lg:px-14" data-reveal>
        <p class="tag text-base-100/70">Tonight's menu card</p>
        <h2 class="mt-4 text-4xl md:text-5xl">What the fire is cooking</h2>
        <ul class="mt-8 divide-y divide-base-100/15 border-y border-base-100/15">
          {% for item in featured limit: 4 %}
          <li class="py-5">
            <div class="flex items-end">
              <h3 class="text-2xl">{{ item.name }}</h3>
              <span class="leader" aria-hidden="true"></span>
              <span class="tag text-sm whitespace-nowrap">{{ item.price }}</span>
            </div>
            {% if item.description %}<p class="mt-1.5 text-base leading-relaxed text-base-100/75">{{ item.description }}</p>{% endif %}
          </li>
          {% endfor %}
        </ul>
        <a href="/menu" class="btn btn-outline tag mt-8 border-base-100 text-base-100 hover:bg-base-100 hover:text-base-content">The whole menu</a>
      </div>
    </div>
  </div>
</section>
