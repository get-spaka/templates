<section class="border-t border-base-300 bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[84rem] gap-8 px-5 py-16 md:px-8 md:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end">
    <div>
      <h2 class="text-3xl md:text-[2.75rem]">Hear about the next exhibition first</h2>
      <p class="mt-3 text-base-content/80">A letter four times a year, with the program and the first look at what comes after Long Light.</p>
    </div>
    <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#letter-problems swap:innerHTML" class="flex flex-col gap-3">
      <div class="flex flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="letter-email">Your email</label>
        <input id="letter-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="Your email" class="input input-lg w-full min-w-0 border-base-content">
        <button class="btn btn-primary btn-lg">Sign up</button>
      </div>
      <div id="letter-problems" class="empty:hidden"></div>
    </form>
  </div>
</section>
