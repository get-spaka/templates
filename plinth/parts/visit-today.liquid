{%- comment -%} Today at the museum: the open today line, the week's hours, admission in one line, the address and Buy tickets. {%- endcomment -%}
{%- assign tickets = data.navigation | where: "place", "tickets" | first -%}
<section class="bg-base-100 text-base-content" id="visit">
  <div class="mx-auto grid max-w-[84rem] gap-14 px-5 py-24 md:px-8 md:py-36 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:gap-20">
    <div>
      <p class="ui text-base-content/70" data-rise>Visit</p>
      {% render 'today', class: "mt-6 font-heading text-2xl font-medium tracking-[-0.01em] md:text-[2rem] [&_.today-dot]:size-3" %}
      <address class="mt-10 font-heading text-[2.5rem] leading-[1.02] font-medium tracking-[-0.03em] not-italic md:text-[3.75rem]">Pier 7, foot of 7th&nbsp;Street<br>Astoria, Oregon</address>
      <p class="mt-6 max-w-[30em] text-base-content/80">A 1911 cannery warehouse on pilings over the Columbia River, a few minutes' walk from downtown along the Riverwalk.</p>
      <div class="mt-10 flex flex-wrap gap-3">
        {% if tickets %}<a href="{{ tickets.href }}" target="_blank" rel="noopener" class="btn btn-primary btn-lg">{{ tickets.label }}</a>{% endif %}
        <a href="/visit" class="btn btn-outline btn-lg border-base-content">Plan your visit</a>
      </div>
    </div>
    <div>
      <table class="w-full ui-lg">
        <caption class="sr-only">Opening hours</caption>
        <tbody>
          {%- for h in data.hours %}
          <tr class="border-t border-base-300">
            <th scope="row" class="py-3 text-left font-medium">{{ h.day }}</th>
            <td class="py-3 text-right tabular-nums">{% if h.opens != blank %}{% render 'clock', time: h.opens %} to {% render 'clock', time: h.closes %}{% if h.note != blank %}<span class="block ui text-base-content/70">{{ h.note }}</span>{% endif %}{% else %}<span class="text-base-content/70">Closed</span>{% endif %}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
      <p class="mt-8 border-t border-base-content pt-6 text-base-content/80">Admission $16, $12 for seniors and students, free under 18 and for members. Free for everyone on Thursdays after 5.</p>
    </div>
  </div>
</section>
