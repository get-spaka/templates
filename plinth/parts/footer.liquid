<footer class="bg-neutral text-neutral-content" data-wall="neutral">
  <div class="mx-auto max-w-[84rem] px-5 pt-24 pb-14 md:px-8 md:pt-32">
    <p class="ui text-neutral-content/70">Colophon</p>
    <p class="mt-6 max-w-[38em] font-body text-[1.375rem] leading-[1.45] font-light md:text-[1.625rem]"><cite>Long Light: Nordic Painters of the Evening, 1885–1915</cite> is organized by the Hallgren Museum of Art and curated by Signe Aaltonen, curator of Nordic art. It is supported by the Lindqvist Family Foundation, the Columbia Pacific Arts Fund, the Nordic Heritage Society of the Lower Columbia and the members of the Hallgren.</p>
    <div class="mt-16 grid gap-10 border-t border-neutral-content/20 pt-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class="ui text-neutral-content/70">Hallgren Museum of Art</h2>
        <address class="mt-3 ui-lg not-italic">Pier 7, foot of 7th&nbsp;Street<br>Astoria, Oregon 97103</address>
        <p class="mt-3 ui-lg"><a href="tel:+15035550147" class="ink-link">(503) 555-0147</a><br><a href="mailto:visit@hallgren.example" class="ink-link">visit@hallgren.example</a></p>
      </div>
      <div>
        <h2 class="ui text-neutral-content/70">Hours</h2>
        <ul class="mt-3 space-y-1 ui-lg">
          {% for h in data.hours %}{% if h.opens != blank %}
          <li class="flex justify-between gap-4"><span>{{ h.day }}</span><span class="tabular-nums">{% render 'clock', time: h.opens %} to {% render 'clock', time: h.closes %}</span></li>
          {% endif %}{% endfor %}
          <li class="text-neutral-content/70">Closed Monday and Tuesday</li>
        </ul>
      </div>
      <div>
        <h2 class="ui text-neutral-content/70">The exhibition</h2>
        <ul class="mt-3 space-y-1 ui-lg">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "footer" %}
          <li><a href="{{ item.href }}" class="ink-link">{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      <div>
        <h2 class="ui text-neutral-content/70">Follow</h2>
        <ul class="mt-3 space-y-1 ui-lg">
          {% for item in data.navigation %}{% if item.place == "social" %}
          <li><a href="{{ item.href }}" target="_blank" rel="noopener" class="ink-link">{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
        {%- assign tickets = data.navigation | where: "place", "tickets" | first -%}
        {% if tickets %}<a href="{{ tickets.href }}" target="_blank" rel="noopener" class="btn btn-wall mt-6">{{ tickets.label }}</a>{% endif %}
      </div>
    </div>
    <p class="mt-16 ui text-neutral-content/70">© 2027 Hallgren Museum of Art. The paintings in Long Light belong to the collections named on their labels.</p>
  </div>
</footer>
