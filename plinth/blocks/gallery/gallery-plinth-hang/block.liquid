<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-24 md:px-8 md:py-32">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="ui text-base-content/70">On the wall</p>
        <h2 class="mt-4 display">Hung to scale</h2>
      </div>
      <p class="max-w-[26em] text-base-content/80">Every work at its real size relative to the others, on one center line. Switch to the list for the checklist.</p>
    </div>
    {%- assign tallest = 0 -%}
    {%- for w in data.works -%}{%- if w.height > tallest -%}{%- assign tallest = w.height -%}{%- endif -%}{%- endfor %}
    <div class="hang mt-16" data-view>
      <div class="mb-14 flex justify-end ui">
        <fieldset class="switch">
          <legend class="sr-only">Show the works</legend>
          <label><input type="radio" name="view" value="wall" checked>On the wall</label>
          <label><input type="radio" name="view" value="list">As a list</label>
        </fieldset>
      </div>
      <ul class="hang-wall" data-hang-wall style="--tallest: {{ tallest }}">
        {%- for work in data.works %}
        <li class="bay-cell" style="--h: {{ work.height }}; --w: {{ work.width }}">
          <a href="/works/{{ work.id }}" class="bay" data-hang>
            {%- if work.image %}<img src="{{ work.image }}" class="frame" data-vt style="--vt: work-{{ work.id }}" loading="lazy">{% else %}<span class="frame frame-blank" data-vt style="--vt: work-{{ work.id }}" aria-hidden="true"></span>{% endif -%}
          </a>
          <p class="plaque" data-hang-label>
            <span class="block muted">Cat. {% if work.number < 10 %}0{% endif %}{{ work.number }}</span>
            <span class="plaque-title"><i>{{ work.title }}</i>, {{ work.year }}</span>
            <span class="block muted">{{ work.height }} × {{ work.width }} cm</span>
          </p>
        </li>
        {%- endfor %}
      </ul>
      <ol class="checklist border-b border-base-300">
        {%- for work in data.works %}
        <li class="check-row">
          <span class="ui lg:font-heading lg:text-3xl lg:leading-none lg:tracking-[-0.04em]">{% if work.number < 10 %}0{% endif %}{{ work.number }}</span>
          <a href="/works/{{ work.id }}" class="check-thumb-link" tabindex="-1" aria-hidden="true">{% if work.image %}<img src="{{ work.image }}" class="check-thumb" data-vt style="--vt: work-{{ work.id }}" loading="lazy">{% else %}<span class="check-thumb frame-blank block" data-vt style="--vt: work-{{ work.id }}"></span>{% endif %}</a>
          <p class="leading-snug lg:col-span-2"><a href="/works/{{ work.id }}" class="ink-link text-lg"><i>{{ work.title }}</i></a>, {{ work.year }}</p>
          <p class="ui">{{ work.medium }}<span class="block">{{ work.height }} × {{ work.width }} cm</span></p>
          <p class="ui muted">{{ work.collection }}</p>
        </li>
        {%- endfor %}
      </ol>
      <div class="hang-legend mt-16 flex flex-wrap items-end justify-between gap-6 ui muted">
        <p class="flex items-center gap-3"><span class="line-mark" aria-hidden="true"></span>Hung on a center line at 145 cm (57 in.) from the floor.</p>
        <p class="flex flex-col items-end gap-1"><span class="scale-bar" aria-hidden="true"></span>1 m</p>
      </div>
    </div>
  </div>
</section>
