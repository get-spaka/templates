<section class="bg-base-200">
  <div class="mx-auto flex max-w-[90rem] flex-col gap-6 px-5 py-12 md:flex-row md:items-center md:justify-between md:px-8">
    <div>
      <h2 class="text-[clamp(2rem,4vw,3rem)] leading-[0.95]">Fresh flash</h2>
      <p class="mt-2 max-w-[36rem] text-base-content/80">An email when a new sheet goes up, with first pick before it reaches the wall.</p>
    </div>
    <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#fresh-problems swap:innerHTML" class="flex w-full max-w-md flex-col gap-3 sm:flex-row">
      <label class="sr-only" for="fresh-email">Your email</label>
      <input id="fresh-email" name="email" type="email" required maxlength="200" placeholder="you@example.com" class="input w-full">
      <button class="btn btn-primary whitespace-nowrap">Send me the flash</button>
      <div id="fresh-problems"></div>
    </form>
  </div>
</section>
