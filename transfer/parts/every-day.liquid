{% comment %}render 'every-day', items: data.aftercare-dos{% endcomment %}
<section class="bg-base-200" data-print-card>
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 md:py-24">
    <p class="caps text-secondary">Every day</p>
    <h2 class="mt-3 text-[clamp(2.5rem,5vw,4.25rem)] leading-[0.95]" data-rise>For the first two weeks</h2>
    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="sans text-xl font-semibold">Do</h3>
        <ul class="mt-4">{% for i in items %}{% if i.kind == "do" %}<li class="check-do flex gap-3 border-t border-base-300 py-4 leading-relaxed text-secondary"><span class="text-base-content">{{ i.text }}</span></li>{% endif %}{% endfor %}</ul>
      </div>
      <div>
        <h3 class="sans text-xl font-semibold">Don't</h3>
        <ul class="mt-4">{% for i in items %}{% if i.kind == "dont" %}<li class="check-dont flex gap-3 border-t border-base-300 py-4 leading-relaxed text-primary"><span class="text-base-content">{{ i.text }}</span></li>{% endif %}{% endfor %}</ul>
      </div>
    </div>
    <p class="caps mt-10 text-base-content/60" data-print-hide>Print this page to keep the list and the doctor's signs on one card.</p>
  </div>
</section>
