{% comment %}render 'prices', prices: data.book-prices{% endcomment %}
<section class="bg-base-100">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4">
      <p class="caps text-secondary">Prices</p>
      <h2 class="mt-3 text-[clamp(2.5rem,5vw,4.25rem)] leading-[0.95]" data-rise>What it costs</h2>
      <p class="mt-5 leading-relaxed text-base-content/80">Your quote comes with the dates. Prices include the drawing, the stencil and a free touch-up within three months.</p>
    </div>
    <ul class="lg:col-span-8">
      {% for p in prices %}
      <li class="border-b border-base-300 py-5 first:border-t-2 first:border-t-base-content">
        <div class="flex items-baseline gap-3"><span class="text-lg font-semibold">{{ p.name }}</span><span class="leader" aria-hidden="true"></span><span class="gothic text-[1.875rem] leading-none text-primary">{{ p.price }}</span></div>
        {% if p.note %}<p class="mt-1 text-[0.9375rem] text-base-content/70">{{ p.note }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
