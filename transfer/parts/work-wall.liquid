{% comment %}An artist's work: render 'work-wall', artist: record{% endcomment %}
<section class="bg-base-100">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 md:py-24">
    <p class="caps text-secondary">Their work</p>
    <h2 class="mt-3 text-[clamp(2.5rem,5vw,4.25rem)] leading-[0.95]" data-rise>Fresh and healed</h2>
    <ul class="mt-12 columns-1 gap-5 sm:columns-2 lg:columns-3">
      {% if artist.work_1 %}<li class="mb-5 break-inside-avoid"><img src="{{ artist.work_1 }}" class="w-full rounded-box" width="1200" height="900"><p class="caps mt-2 text-base-content/70">{{ artist.work_1_caption }}</p></li>{% endif %}
      {% if artist.work_2 %}<li class="mb-5 break-inside-avoid"><img src="{{ artist.work_2 }}" class="w-full rounded-box" width="1200" height="900"><p class="caps mt-2 text-base-content/70">{{ artist.work_2_caption }}</p></li>{% endif %}
      {% if artist.work_3 %}<li class="mb-5 break-inside-avoid"><img src="{{ artist.work_3 }}" class="w-full rounded-box" width="1200" height="900"><p class="caps mt-2 text-base-content/70">{{ artist.work_3_caption }}</p></li>{% endif %}
      {% if artist.work_4 %}<li class="mb-5 break-inside-avoid"><img src="{{ artist.work_4 }}" class="w-full rounded-box" width="1200" height="900"><p class="caps mt-2 text-base-content/70">{{ artist.work_4_caption }}</p></li>{% endif %}
    </ul>
  </div>
</section>
