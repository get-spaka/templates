<section class="bg-base-200" id="apply">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <p class="caps text-secondary">Guest at Lost Wax</p>
      <h2 class="mt-3 text-[clamp(2.5rem,5vw,4.25rem)] leading-[0.95]">Want the chair?</h2>
      <p class="mt-5 max-w-[32rem] leading-relaxed text-base-content/80">We host one artist at a time, four or five days each, and book guests three to six months ahead. Send your work and the dates you have in mind; we answer every application.</p>
    </div>
    <form hx-post="/_data/guest-applications" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#apply-problems swap:innerHTML" class="grid gap-4 rounded-box border border-base-300 bg-base-100 p-6 sm:grid-cols-2 md:p-8 lg:col-span-7">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your name</legend>
        <input name="name" class="input w-full" required maxlength="200" autocomplete="name">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your email</legend>
        <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Home studio</legend>
        <input name="studio" class="input w-full" maxlength="200">
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">City</legend>
        <input name="city" class="input w-full" required maxlength="200">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">Portfolio link</legend>
        <input name="portfolio" type="url" class="input w-full" required maxlength="500">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">Dates you'd like</legend>
        <input name="dates" class="input w-full" maxlength="200" placeholder="Early June, or any week in September">
      </fieldset>
      <fieldset class="fieldset sm:col-span-2">
        <legend class="fieldset-legend">A short note</legend>
        <textarea name="note" class="textarea rounded-box min-h-28 w-full" maxlength="2000"></textarea>
      </fieldset>
      <div id="apply-problems" class="sm:col-span-2"></div>
      <button class="btn btn-primary btn-lg whitespace-nowrap sm:col-span-2 sm:justify-self-start">Send the application</button>
    </form>
  </div>
</section>
