{% comment %}The wall with its filters (CSS only): render 'flash-wall', flash: data.flash, artists: data.artists{% endcomment %}
{% assign style_list = "" %}{% for d in flash %}{% for s in d.styles %}{% assign key = "|" | append: s | append: "|" %}{% unless style_list contains key %}{% assign style_list = style_list | append: key %}{% endunless %}{% endfor %}{% endfor %}
{% assign styles = style_list | remove_first: "|" | split: "||" %}{% assign last = styles | last | remove: "|" %}
<section class="bg-base-100" data-filter>
  <div class="mx-auto max-w-[90rem] px-5 pb-20 md:px-8 md:pb-28">
    <fieldset class="flex flex-wrap items-center gap-2 border-t border-base-300 pt-6">
      <legend class="caps float-left mr-3 text-base-content/60">Artist</legend>
      <input type="radio" name="artist" id="artist-all" class="chip-input sr-only" checked><label for="artist-all" class="chip">All</label>
      {% for a in artists %}<input type="radio" name="artist" id="artist-{{ a.id }}" data-n="{{ forloop.index }}" class="chip-input sr-only"><label for="artist-{{ a.id }}" class="chip">{{ a.name }}</label>{% endfor %}
    </fieldset>
    <fieldset class="mt-4 flex flex-wrap items-center gap-2">
      <legend class="caps float-left mr-3 text-base-content/60">Style</legend>
      <input type="radio" name="style" id="style-all" class="chip-input sr-only" checked><label for="style-all" class="chip">All</label>
      {% for s in styles %}{% assign sname = s | remove: "|" %}<input type="radio" name="style" id="style-{{ forloop.index }}" data-n="{{ forloop.index }}" class="chip-input sr-only"><label for="style-{{ forloop.index }}" class="chip">{{ sname | capitalize }}</label>{% endfor %}
      <span class="mx-2 hidden h-6 w-px bg-base-300 sm:block" aria-hidden="true"></span>
      <input type="checkbox" id="available-only" class="chip-input avail-input sr-only"><label for="available-only" class="chip"><span class="dot" aria-hidden="true"></span>Available only</label>
    </fieldset>
    <ul class="mt-10 grid grid-cols-2 gap-3 md:gap-5 lg:grid-cols-4">
      {% for design in flash %}
      {% assign a_n = 0 %}{% for a in artists %}{% if a.id == design.artist %}{% assign a_n = forloop.index %}{% endif %}{% endfor %}
      {% assign s_n = "|" %}{% for s in styles %}{% assign sname = s | remove: "|" %}{% if design.styles contains sname %}{% assign s_n = s_n | append: forloop.index | append: "|" %}{% endif %}{% endfor %}
      <li data-card data-status="{{ design.status }}" data-a="{{ a_n }}" data-s="{{ s_n }}">{% render 'flash-card', design: design, artists: artists %}</li>
      {% endfor %}
    </ul>
  </div>
</section>
