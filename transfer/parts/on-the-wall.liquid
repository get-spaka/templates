{% assign total = data.flash.size %}{% assign available = 0 %}{% for d in data.flash %}{% if d.status == "available" %}{% assign available = available | plus: 1 %}{% endif %}{% endfor %}
<section class="bg-base-100">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="caps text-secondary">On the wall</p>
        <h2 class="mt-3 text-[clamp(2.5rem,5vw,4.25rem)] leading-[0.95]" data-rise>Flash to claim</h2>
      </div>
      <p class="max-w-[28rem] leading-relaxed text-base-content/80">Each design is priced and numbered. Claim one with a $50 deposit; one-and-done designs are tattooed once.</p>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-3 md:gap-5 lg:grid-cols-4">
      {% for design in data.flash %}{% if design.featured %}
      <li>{% render 'flash-card', design: design, artists: data.artists %}</li>
      {% endif %}{% endfor %}
    </ul>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-base-300 pt-6">
      <p class="gothic text-[1.75rem] leading-none">All {{ total }} designs · {{ available }} available</p>
      <a href="/flash" class="btn btn-primary whitespace-nowrap">See the wall</a>
    </div>
  </div>
</section>
