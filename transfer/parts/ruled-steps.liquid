{% comment %}Steps on a ruled line: render 'ruled-steps', steps: data.home-steps, title: …, eyebrow: …, photo: …, cta: true{% endcomment %}
<section class="bg-base-100">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="caps text-secondary">{{ eyebrow }}</p>
        <h2 class="mt-3 max-w-[48rem] text-[clamp(2.5rem,5vw,4.25rem)] leading-[0.95]" data-rise>{{ title }}</h2>
      </div>
      {% if photo %}<img src="{{ photo }}" class="aspect-[16/9] w-full rounded-box object-cover lg:col-span-5" width="1200" height="675">{% endif %}
    </div>
    <ol class="ruled-steps mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 {% if steps.size > 4 %}lg:grid-cols-5{% else %}lg:grid-cols-4{% endif %}">
      {% for step in steps %}
      <li class="pt-6">
        <div class="flex items-start justify-between gap-4">
          <span class="gothic text-[3rem] leading-none text-secondary">{{ forloop.index }}</span>
          {% if step.icon %}<figure class="w-16" data-transfer><img src="{{ step.icon }}" class="aspect-square w-full" width="400" height="400"></figure>{% endif %}
        </div>
        <h3 class="sans mt-5 text-lg font-semibold">{{ step.title }}</h3>
        <p class="mt-2 leading-relaxed text-base-content/80">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
    {% if cta %}<a href="/book" class="btn btn-primary mt-14 whitespace-nowrap">Request a tattoo</a>{% endif %}
  </div>
</section>
