{% comment %}The artists on ink: render 'roster', artists: data.artists, flash: data.flash, full: true{% endcomment %}
<section class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 md:py-28">
    {% unless full %}
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="caps text-neutral-content/60">Who tattoos here</p>
        <h2 class="mt-3 text-[clamp(2.5rem,5vw,4.25rem)] leading-[0.95]" data-rise>Four artists and an apprentice</h2>
      </div>
      <a href="/artists" class="btn btn-outline border-neutral-content/40 text-neutral-content whitespace-nowrap hover:bg-neutral-content hover:text-neutral">All the artists</a>
    </div>
    {% endunless %}
    <ul class="{% unless full %}mt-12{% endunless %}">
      {% for artist in artists %}
      {% assign mark = nil %}{% for d in flash %}{% if d.id == artist.mark %}{% assign mark = d %}{% endif %}{% endfor %}
      <li class="roster-row">
        <a href="/artists/{{ artist.id }}" class="group grid items-center gap-x-8 gap-y-4 py-8 md:grid-cols-12 md:py-10" data-lift>
          <div class="md:col-span-7">
            <h3 class="text-[clamp(3rem,7vw,5rem)] leading-[0.9] group-hover:text-primary">{{ artist.name }}</h3>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              {% for s in artist.styles %}<span class="pill text-neutral-content/80">{{ s }}</span>{% endfor %}
            </div>
            {% if full %}<p class="mt-5 max-w-[40rem] leading-relaxed text-neutral-content/75">{{ artist.summary }}</p>{% endif %}
          </div>
          <div class="flex flex-col gap-2 md:col-span-3">
            <p class="caps flex items-center gap-2">
              {% if artist.books == "open" %}<span class="dot" aria-hidden="true"></span>Books open{% elsif artist.books == "waitlist" %}Waitlist{% elsif artist.books == "closed" %}Books closed{% else %}Flash only{% endif %}
            </p>
            {% if artist.role == "apprentice" %}<p class="text-[0.9375rem] text-neutral-content/70">Apprentice prices on Saturdays</p>{% elsif full %}<p class="text-[0.9375rem] text-neutral-content/70">{{ artist.books_note }}</p>{% endif %}
            {% if full %}<span class="mt-2 text-[0.9375rem] font-semibold underline underline-offset-4">See their work →</span>{% endif %}
          </div>
          <div class="md:col-span-2 md:justify-self-end">
            {% if mark %}
            <figure class="w-28 rounded-box bg-base-200 p-2 md:w-32" data-transfer data-stencil="{{ mark.outline }}"><img src="{{ mark.image }}" class="aspect-square w-full object-contain" width="400" height="400"></figure>
            {% elsif artist.portrait %}
            <img src="{{ artist.portrait }}" class="aspect-square w-28 rounded-box object-cover md:w-32" width="400" height="400">
            {% endif %}
          </div>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
