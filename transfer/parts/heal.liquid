{% comment %}The heal, a dial of days: render 'heal', heal: data.heal{% endcomment %}
<section class="bg-base-100" data-heal>
  <div class="mx-auto grid max-w-[90rem] gap-10 px-5 pb-20 md:px-8 md:pb-28 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-7">
      <div class="heal-stage">
        <img src="/media/skin-shoulder.jpg" class="heal-skin" width="1600" height="1200">
        <div class="heal-tattoo" style="--ink: url(/media/rose.svg)">
          <span class="heal-layer heal-halo" aria-hidden="true"></span>
          <figure data-transfer data-stencil="/media/rose-stencil.svg"><img src="/media/rose.svg" class="heal-ink" width="400" height="400"></figure>
          <span class="heal-layer heal-veil" aria-hidden="true"></span>
          <span class="heal-layer heal-film" aria-hidden="true"></span>
          <span class="heal-layer heal-gloss" aria-hidden="true"></span>
        </div>
      </div>
      <fieldset class="dial mt-8">
        <legend class="sr-only">Day</legend>
        {% for h in heal %}
        <input type="radio" name="heal-day" id="heal-{{ h.id }}" value="{{ h.stage }}" class="sr-only" {% if forloop.first %}checked{% endif %}><label for="heal-{{ h.id }}"><span class="caps">{{ h.day }}</span><span class="hidden text-[0.8125rem] sm:block">{{ h.title }}</span></label>
        {% endfor %}
      </fieldset>
    </div>
    <div class="lg:col-span-5">
      {% for h in heal %}
      <div class="heal-panel" data-panel="{{ h.stage }}">
        <p class="caps text-secondary">{{ h.day }}</p>
        <h2 class="mt-3 text-[clamp(2.5rem,5vw,4rem)] leading-[0.95]">{{ h.title }}</h2>
        <h3 class="sans caps mt-8 text-base-content/60">What you'll see</h3>
        <p class="mt-2 text-lg leading-relaxed">{{ h.see }}</p>
        <h3 class="sans caps mt-6 text-base-content/60">What to do</h3>
        <p class="mt-2 text-lg leading-relaxed">{{ h.todo }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
