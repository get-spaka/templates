<!doctype html>
<html lang="en">
<head>
<title>No. {{ record.number }}, {{ record.name }} — Lost Wax Tattoo flash</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="No. {{ record.number }}, {{ record.name }} — Lost Wax Tattoo flash">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header', data: data, page: page %}
{% assign artist = nil %}{% for a in data.artists %}{% if a.id == record.artist %}{% assign artist = a %}{% endif %}{% endfor %}
{% assign number = record.number %}{% if record.number < 10 %}{% assign number = "0" | append: record.number %}{% endif %}
<main>
<section class="bg-base-100">
  <div class="mx-auto grid max-w-[90rem] gap-10 px-5 pt-10 pb-16 md:px-8 md:pt-14 lg:grid-cols-12 lg:items-center lg:gap-14">
    <div class="ruled relative rounded-box border border-base-300 p-6 md:p-10 lg:col-span-7" data-lift>
      <div class="flex items-baseline justify-between gap-4">
        <p class="gothic text-[clamp(3rem,7vw,6rem)] leading-[0.85]">No. {{ number }}</p>
        {% if record.status == "claimed" %}<p class="gothic text-[clamp(2.5rem,6vw,5rem)] leading-[0.85] text-primary">Claimed</p>{% else %}<p class="gothic text-[clamp(3rem,7vw,6rem)] leading-[0.85] text-primary">${{ record.price }}</p>{% endif %}
      </div>
      <figure class="mx-auto mt-6 aspect-square w-full max-w-[34rem]" data-transfer="load" data-stencil="{{ record.outline }}"><img src="{{ record.image }}" class="h-full w-full object-contain" width="800" height="800"></figure>
    </div>
    <div class="lg:col-span-5">
      <p class="caps text-secondary"><a href="/flash" class="hover:underline">The wall</a>{% if record.new %} · <span class="inline-flex items-center gap-1.5 text-base-content"><span class="dot" aria-hidden="true"></span>New</span>{% endif %}</p>
      <h1 class="mt-3 text-[clamp(3rem,6vw,5rem)] leading-[0.9]">{{ record.name }}</h1>
      <p class="mt-5 text-lg leading-relaxed text-base-content/85">{{ record.summary }}</p>
      <dl class="mt-8 border-t-2 border-base-content">
        <div class="flex justify-between gap-6 border-b border-base-300 py-3"><dt class="caps text-base-content/60">Artist</dt><dd>{% if artist %}<a href="/artists/{{ artist.id }}" class="font-semibold underline underline-offset-4">{{ artist.name }}</a>{% endif %}</dd></div>
        <div class="flex justify-between gap-6 border-b border-base-300 py-3"><dt class="caps text-base-content/60">Size</dt><dd>{{ record.size }}</dd></div>
        <div class="flex justify-between gap-6 border-b border-base-300 py-3"><dt class="caps text-base-content/60">Styles</dt><dd class="text-right">{{ record.styles | join: ", " }}</dd></div>
        <div class="flex justify-between gap-6 border-b border-base-300 py-3"><dt class="caps text-base-content/60">Sits best on</dt><dd class="text-right">{{ record.placements | join: ", " }}</dd></div>
        <div class="flex justify-between gap-6 border-b border-base-300 py-3"><dt class="caps text-base-content/60">Kind</dt><dd>{% if record.kind == "one-and-done" %}One and done{% else %}Repeatable{% endif %}</dd></div>
      </dl>
      {% if record.status == "claimed" %}<a href="#claim" class="btn btn-outline btn-lg mt-8 whitespace-nowrap">Ask for something like it</a>{% else %}<a href="#claim" class="btn btn-primary btn-lg mt-8 whitespace-nowrap">Claim No. {{ number }}</a>{% endif %}
    </div>
  </div>
</section>
{% render 'try-on', design: record, placements: data.placements %}
{% render 'claim-form', design: record, artist: artist %}
{% assign more = data.flash | where: "artist", record.artist %}
{% if more.size > 1 %}
<section class="bg-base-100">
  <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="text-[clamp(2.5rem,5vw,4.25rem)] leading-[0.95]" data-rise>More by {{ artist.name | split: " " | first }}</h2>
      <a href="/flash" class="btn btn-outline whitespace-nowrap">The whole wall</a>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-3 md:gap-5 lg:grid-cols-4">
      {% assign shown = 0 %}{% for design in more %}{% if design.id != record.id and shown < 4 %}{% assign shown = shown | plus: 1 %}<li>{% render 'flash-card', design: design, artists: data.artists %}</li>{% endif %}{% endfor %}
    </ul>
  </div>
</section>
{% endif %}
</main>
{% render 'footer', data: data %}
</body>
</html>
