{%- assign y = "now" | date: "%Y" | plus: 0 -%}
{%- assign tonight = nil -%}
{%- for wine in data.products -%}{%- if wine.featured and wine.available and wine.ready_from and wine.best_until -%}{%- if y >= wine.ready_from and y < wine.best_until -%}{%- assign tonight = wine -%}{%- break -%}{%- endif -%}{%- endif -%}{%- endfor -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 pt-10 pb-20 md:px-8 md:pt-12 lg:grid-cols-12 lg:gap-12 lg:pb-28">
    <div class="flex flex-col lg:col-span-7 lg:pt-8" data-reveal="stagger">
      <p class="eyebrow text-base-content/75">Leelanau Peninsula · Michigan · since 1998</p>
      <h1 class="mt-5 max-w-[13ch] text-[clamp(2.75rem,5.5vw+1rem,6rem)] leading-[1.02] tracking-[-0.005em]">Wine from the south side of one hill.</h1>
      <p class="body-copy mt-7 max-w-[52ch] text-[1.1875rem]">Riesling, Blaufränkisch and seven more grapes, grown on twenty-two acres of glacial gravel above Lake Leelanau and poured in the stone barn at the top.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/visit#book" class="btn btn-primary btn-lg">Book a tasting</a>
        <a href="/wines" class="btn btn-ink btn-lg">See the wines</a>
      </div>
    </div>
    <div class="lg:col-span-5">
      <figure>
        <img src="/media/hero-slope.jpg" class="aspect-[4/3] w-full rounded-box object-cover">
        <figcaption class="mono-sm mt-2 text-base-content/70">Kettle Block, the steepest rows, in early September.</figcaption>
      </figure>
      {% if tonight %}
      <div class="mt-5 rounded-box bg-base-200 p-6 md:p-7">
        <p class="eyebrow text-base-content/75">Open tonight</p>
        <div class="mt-2 flex items-baseline justify-between gap-4">
          <p class="font-heading text-[1.625rem] leading-[1.15]"><a href="/wines/{{ tonight.id }}" class="hover:underline hover:decoration-1 hover:underline-offset-4">{{ tonight.name }}</a></p>
          <p class="price text-[1.0625rem]">{{ tonight.price }}</p>
        </div>
        {% render 'hill', wine: tonight %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
