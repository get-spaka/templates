<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-6">
        <p class="eyebrow text-base-content/75">Sold out</p>
        <h2 class="mt-4 text-[clamp(2rem,2.6vw+1rem,3.25rem)]">From the library</h2>
      </div>
      <p class="body-copy max-w-[52ch] lg:col-span-6">Vintages we no longer sell by the bottle. We pour them at library tastings, and their hills show how they're drinking.</p>
    </div>
    <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {% for wine in data.products %}{% unless wine.available %}{% render 'wine-card', wine: wine, size: 'sm' %}{% endunless %}{% endfor %}
    </div>
  </div>
</section>
