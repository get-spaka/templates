<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-16 md:px-8 md:py-20">
    <h2 class="sr-only">The hill in figures</h2>
    <dl class="grid grid-cols-2 gap-y-10 border-y border-base-300 py-10 sm:grid-cols-3 lg:grid-cols-5 lg:divide-x lg:divide-base-300" data-reveal="stagger">
      {% for figure in data["home-stats"] %}
      <div class="flex flex-col gap-1 lg:px-6 lg:first:pl-0">
        <dt class="order-2 font-semibold">{{ figure.label }}</dt>
        <dd class="order-1 font-heading text-[clamp(2.5rem,3vw+1rem,3.5rem)] leading-none">{{ figure.value }}</dd>
        {% if figure.note %}<dd class="order-3 text-[0.9375rem] text-base-content/75">{{ figure.note }}</dd>{% endif %}
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
