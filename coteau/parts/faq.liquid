{%- comment -%} Questions (adapted from faq-accordion). Pass items, label and title. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow text-base-content/75">{{ label }}</p>
      <h2 class="mt-4 text-[clamp(2rem,2.6vw+1rem,3.25rem)]">{{ title }}</h2>
    </div>
    <div class="border-t border-base-300 lg:col-span-7 lg:col-start-6">
      {% for item in items %}
      <details class="group border-b border-base-300">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.1875rem] font-semibold [&::-webkit-details-marker]:hidden">{{ item.question }}<span class="font-heading text-[1.5rem] leading-none text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
        <div class="body-copy max-w-[60ch] pb-6 [&_a]:text-link">{{ item.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
