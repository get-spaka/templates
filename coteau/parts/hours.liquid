{%- comment -%} Hours by season (adapted from contact-hours-table over `hours`). {%- endcomment -%}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow text-base-content/75">The barn is open</p>
      <h2 class="mt-4 text-[clamp(2rem,2.6vw+1rem,3.25rem)]">Hours by season</h2>
      <p class="body-copy mt-5">Last pours half an hour before we close.</p>
    </div>
    <div class="lg:col-span-7 lg:col-start-6" data-reveal>
      {% render 'season-hours', hours: data.hours, wide: true %}
      <p class="mt-8 border-t border-base-300 pt-5 body-copy">Closed Thanksgiving, Christmas Day and New Year's Day, and the first two weeks of March, when the wine is bottled.</p>
    </div>
  </div>
</section>
