{%- comment -%} Every wine for sale, with the stage chips and the style chips, grouped by style (adapted from products-tall-minimal). {%- endcomment -%}
{%- assign kinds = "sparkling,white,pink,red,sweet" | split: "," -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 md:pb-28" data-filter>
    <div class="flex flex-col gap-3 border-y border-base-300 py-5 lg:flex-row lg:items-center lg:justify-between">
      <fieldset class="flex flex-wrap gap-2">
        <legend class="sr-only">When to open it</legend>
        <input type="radio" class="chip-input" name="stage-wines" id="stage-wines-all" value="all" checked><label for="stage-wines-all" class="chip">All</label>
        <input type="radio" class="chip-input" name="stage-wines" id="stage-wines-tonight" value="tonight"><label for="stage-wines-tonight" class="chip"><span class="stage-dot" data-dot="open" aria-hidden="true"></span>Open tonight</label>
        <input type="radio" class="chip-input" name="stage-wines" id="stage-wines-cellar" value="cellar"><label for="stage-wines-cellar" class="chip"><span class="stage-dot" aria-hidden="true"></span>For the cellar</label>
      </fieldset>
      <fieldset class="flex flex-wrap gap-2">
        <legend class="sr-only">Style</legend>
        <input type="radio" class="chip-input" name="kind-wines" id="kind-wines-all" value="every" checked><label for="kind-wines-all" class="chip">All styles</label>
        <input type="radio" class="chip-input" name="kind-wines" id="kind-wines-sparkling" value="sparkling"><label for="kind-wines-sparkling" class="chip">Sparkling</label>
        <input type="radio" class="chip-input" name="kind-wines" id="kind-wines-white" value="white"><label for="kind-wines-white" class="chip">White</label>
        <input type="radio" class="chip-input" name="kind-wines" id="kind-wines-pink" value="pink"><label for="kind-wines-pink" class="chip">Rosé &amp; skin contact</label>
        <input type="radio" class="chip-input" name="kind-wines" id="kind-wines-red" value="red"><label for="kind-wines-red" class="chip">Red</label>
        <input type="radio" class="chip-input" name="kind-wines" id="kind-wines-sweet" value="sweet"><label for="kind-wines-sweet" class="chip">Sweet</label>
      </fieldset>
    </div>
    {% for kind in kinds %}
    {%- assign count = 0 -%}
    {%- for wine in data.products -%}{%- if wine.available -%}{%- case wine.style -%}{%- when "rosé", "skin-contact" -%}{%- assign k = "pink" -%}{%- else -%}{%- assign k = wine.style -%}{%- endcase -%}{%- if k == kind -%}{%- assign count = count | plus: 1 -%}{%- endif -%}{%- endif -%}{%- endfor -%}
    {% if count > 0 %}
    <div class="mt-14 grid gap-x-8 gap-y-8 border-t border-base-300 pt-8 lg:grid-cols-4" data-group="{{ kind }}">
      <div>
        <h2 class="text-[1.75rem] leading-[1.1]">{% case kind %}{% when "sparkling" %}Sparkling{% when "white" %}White{% when "pink" %}Rosé &amp; skin contact{% when "red" %}Red{% when "sweet" %}Sweet{% endcase %}</h2>
        <p class="mono-sm mt-2 text-base-content/75">{{ count }} {% if count == 1 %}wine{% else %}wines{% endif %}</p>
      </div>
      <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:col-span-3 lg:grid-cols-3">
      {% for wine in data.products %}{% if wine.available %}{% case wine.style %}{% when "rosé", "skin-contact" %}{% assign k = "pink" %}{% else %}{% assign k = wine.style %}{% endcase %}{% if k == kind %}{% render 'wine-card', wine: wine, size: 'sm' %}{% endif %}{% endif %}{% endfor %}
      </div>
    </div>
    {% endif %}
    {% endfor %}
    <p class="filter-empty body-copy mt-10">No wine of ours fits both. Choose All to see them again.</p>
  </div>
</section>
