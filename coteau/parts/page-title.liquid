<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pt-14 pb-10 md:px-8 md:pt-20 md:pb-14" data-reveal="stagger">
    <p class="eyebrow text-base-content/75">{{ label }}</p>
    <h1 class="mt-4 text-[clamp(2.75rem,4.5vw+1rem,5rem)] leading-[1.02]">{{ title }}</h1>
    <p class="body-copy mt-6 max-w-[58ch] text-[1.1875rem]">{{ text }}</p>
  </div>
</section>
