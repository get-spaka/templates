{%- comment -%} A wine without a photo is its label: the estate, its name, its vintage and block, a band in its style's tone. Pass wine. {%- endcomment -%}
<div class="wine-label" data-style="{{ wine.style }}" role="img" aria-label="The label of the {{ wine.name }}">
  <div class="wine-label-paper">
    <div class="flex flex-col items-center">
      <p class="wine-label-estate">Vossberg Hill</p>
      {% render 'mark', class: 'wine-label-mark' %}
    </div>
    <p class="wine-label-name">{{ wine.wine }}</p>
    <div class="flex flex-col items-center gap-[2cqi]">
      <p class="wine-label-vintage">{{ wine.vintage }}</p>
      <p class="wine-label-place">{{ wine.block }} · Leelanau Peninsula</p>
    </div>
    <p class="wine-label-band">{% case wine.style %}{% when "sparkling" %}Sparkling wine{% when "white" %}White wine{% when "skin-contact" %}Skin contact{% when "rosé" %}Rosé{% when "red" %}Red wine{% when "sweet" %}Ice wine{% endcase %}</p>
  </div>
</div>
