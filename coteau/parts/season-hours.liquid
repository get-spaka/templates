{%- comment -%} The hours by season, two short tables from `hours`. Pass hours, wide: true where the two seasons stand side by side, and tone: "dark" on the cellar. {%- endcomment -%}
{%- assign seasons = "summer,winter" | split: "," -%}
<div class="grid gap-8 {% if wide %}sm:grid-cols-2{% else %}sm:grid-cols-2 lg:grid-cols-1{% endif %}">
  {% for season in seasons %}
  <div>
    <p class="eyebrow {% if tone == 'dark' %}text-neutral-content/75{% else %}text-base-content/75{% endif %}">{% if season == "summer" %}May to October{% else %}November to April{% endif %}</p>
    <dl class="mono mt-3 space-y-1">
      {% for row in hours %}{% if row.season == season %}
      <div class="grid grid-cols-[6rem_1fr] gap-x-3">
        <dt>{{ row.day }}</dt>
        <dd><span class="whitespace-nowrap">{{ row.hours }}</span>{% if row.note != blank %}<span class="block text-[0.75rem] {% if tone == 'dark' %}text-neutral-content/70{% else %}text-base-content/70{% endif %}">{{ row.note }}</span>{% endif %}</dd>
      </div>
      {% endif %}{% endfor %}
    </dl>
  </div>
  {% endfor %}
</div>
