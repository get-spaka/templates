<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 text-base-content">
  <div class="bg-base-200">
    <p class="mx-auto max-w-[80rem] truncate px-5 py-1.5 text-center text-[0.875rem] text-base-content/80 md:px-8">Tastings every day May to October<span class="hidden sm:inline"> <span aria-hidden="true">·</span> Thursday to Sunday in winter</span></p>
  </div>
  <div class="mx-auto grid h-[4.75rem] max-w-[80rem] grid-cols-[1fr_auto_1fr] items-center gap-4 px-5 md:px-8">
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 whitespace-nowrap">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
        <li><a href="{{ item.href }}" class="rounded-field px-3 py-2 font-semibold hover:bg-base-200 aria-[current=page]:underline aria-[current=page]:decoration-primary aria-[current=page]:underline-offset-8" {% if page.url contains item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="lg:hidden">
      <button type="button" class="btn btn-ghost -ml-3 px-3" commandfor="site-menu" command="show-modal" aria-label="Open the menu">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg><span class="hidden sm:inline">Menu</span>
      </button>
    </div>
    {% render 'logo' %}
    <div class="flex justify-end">
      <a href="/visit#book" class="btn btn-primary btn-sm sm:btn-md">Book a tasting</a>
    </div>
  </div>
  <dialog id="site-menu" class="site-menu" aria-label="Menu">
    <div class="flex min-h-full flex-col px-6 pt-6 pb-10">
      <div class="flex items-center justify-between">
        {% render 'logo' %}
        <button type="button" class="btn btn-ghost px-3" commandfor="site-menu" command="close">Close</button>
      </div>
      <ul class="mt-14 space-y-3">
        {% for item in data.navigation %}{% unless item.place == "social" %}
        <li><a href="{{ item.href }}" class="font-heading text-[2.5rem] leading-[1.15]" {% if page.url contains item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endunless %}{% endfor %}
      </ul>
      <div class="mt-auto flex flex-col gap-4 pt-12">
        <a href="/visit#book" class="btn btn-primary btn-lg">Book a tasting</a>
        <p class="mono text-base-content/75">3471 South Kettle Road · Lake Leelanau, Michigan</p>
      </div>
    </div>
  </dialog>
</header>
