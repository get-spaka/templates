{%- comment -%} The people (adapted from team-side-by-side over `team`): square portraits, or initials on verjus. {%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div data-reveal>
      <p class="eyebrow text-base-content/75">The people</p>
      <h2 class="mt-4 text-[clamp(2rem,2.6vw+1rem,3.25rem)]">A family and a crew of six</h2>
    </div>
    <ul class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {% for person in data.team %}
      <li class="flex items-start gap-5 sm:block">
        {% if person.photo %}<img src="{{ person.photo }}" class="aspect-square w-20 shrink-0 rounded-box object-cover sm:w-full">{% else %}{% assign words = person.name | split: " " %}<div class="flex aspect-square w-20 shrink-0 items-center justify-center rounded-box bg-secondary text-secondary-content sm:w-full" aria-hidden="true"><span class="wordmark text-[1.5rem] sm:text-[3rem]">{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span></div>{% endif %}
        <div>
          <h3 class="text-[1.5rem] leading-[1.15] sm:mt-5">{{ person.name }}</h3>
          <p class="font-semibold text-base-content/80">{{ person.role }}</p>
          <p class="body-copy mt-2">{{ person.bio }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
