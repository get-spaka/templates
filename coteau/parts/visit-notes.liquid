<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <p class="eyebrow text-base-content/75" data-reveal>Before you come</p>
    <ul class="mt-8 grid border-t border-base-300 md:grid-cols-2 md:gap-x-10" data-reveal="stagger">
      {% for note in data["visit-notes"] %}
      <li class="border-b border-base-300 py-6"><h3 class="text-[1.375rem]">{{ note.title }}</h3><p class="body-copy mt-2 max-w-[52ch]">{{ note.text }}</p></li>
      {% endfor %}
    </ul>
  </div>
</section>
