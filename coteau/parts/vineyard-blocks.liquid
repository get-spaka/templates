{%- comment -%} The five blocks as rows, each with the wines made from it (over `vineyard-blocks`). {%- endcomment -%}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="eyebrow text-base-content/75">Twenty-two acres</p>
        <h2 class="mt-4 text-[clamp(2rem,2.6vw+1rem,3.25rem)]">The five blocks</h2>
      </div>
      <p class="body-copy max-w-[48ch] lg:col-span-5">Named as the family names them, from the top of the hill to its foot.</p>
    </div>
    <div class="mt-12 border-t border-base-content/20">
      {% for block in data["vineyard-blocks"] %}
      <article id="{{ block.id }}" class="grid scroll-mt-32 gap-6 border-b border-base-content/20 py-8 md:grid-cols-12 md:gap-8" data-reveal>
        {% if block.image %}<img src="{{ block.image }}" class="aspect-[3/2] w-full rounded-box object-cover md:col-span-4">{% else %}<div class="aspect-[3/2] w-full rounded-box bg-secondary md:col-span-4"></div>{% endif %}
        <div class="md:col-span-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="text-[2rem] leading-none">{{ block.name }}</h3>
            <p class="mono text-base-content/80">{{ block.grape }}</p>
          </div>
          <p class="mono mt-3 text-base-content/75">Planted {{ block.planted }} · {{ block.acres }} acres · {{ block.soil }} · {{ block.slope }}</p>
          <p class="body-copy mt-3 max-w-[60ch]">{{ block.text }}</p>
          {%- assign made = data.products | where: "block", block.name | where: "available", true -%}
          {% if made.size > 0 %}
          <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1"><span class="eyebrow mr-1 text-base-content/75">Its wines</span>{% for wine in made %}<a href="/wines/{{ wine.id }}" class="text-link whitespace-nowrap">{{ wine.name }}</a>{% endfor %}</p>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
