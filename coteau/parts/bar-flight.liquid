{%- comment -%} At the bar this week (adapted from menu-tasting over `visit-flight`): the five pours, numbered in the order they're tasted. {%- endcomment -%}
<section id="at-the-bar" class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 py-16 md:px-8 md:py-20 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow text-base-content/75">Walk in, any day we're open</p>
      <h2 class="mt-4 text-[clamp(2rem,2.6vw+1rem,3.25rem)]">At the bar this week</h2>
      <p class="mono mt-5 text-base-content/80">$20 · about 30 minutes · waived with two bottles</p>
    </div>
    <ol class="border-t border-base-300 lg:col-span-7 lg:col-start-6" data-reveal="stagger">
      {% for pour in data["visit-flight"] %}
      <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-base-300 py-5">
        <span class="font-heading text-[1.75rem] leading-none text-primary">{{ forloop.index }}</span>
        <div>
          <p class="text-[1.25rem] font-semibold leading-snug">{{ pour.name }}</p>
          <p class="body-copy mt-1">{{ pour.description }}{% for tag in pour.tags %} <span class="mono-sm ml-1 whitespace-nowrap rounded-field border border-base-300 px-1.5 py-0.5 text-base-content/75">{{ tag }}</span>{% endfor %}</p>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
