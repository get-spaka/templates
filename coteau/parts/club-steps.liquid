{%- comment -%} How the club works (adapted from steps-numbered-line over `club-steps`). {%- endcomment -%}
<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 md:py-24">
    <div data-reveal>
      <p class="eyebrow text-base-content/75">How it works</p>
      <h2 class="mt-4 text-[clamp(2rem,2.6vw+1rem,3.25rem)]">A call, then two boxes a year</h2>
    </div>
    <ol class="mt-12 grid gap-8 border-t border-base-content/25 pt-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6" data-reveal="stagger">
      {% for step in data["club-steps"] %}
      <li><span class="font-heading text-[2.5rem] leading-none text-primary">{{ forloop.index }}</span><h3 class="mt-3 text-[1.375rem] leading-[1.15]">{{ step.title }}</h3><p class="body-copy mt-2">{{ step.text }}</p></li>
      {% endfor %}
    </ol>
  </div>
</section>
