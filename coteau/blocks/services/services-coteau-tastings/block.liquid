<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-14 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <div data-reveal>
        <p class="eyebrow text-base-content/75">Four ways to taste</p>
        <h2 class="mt-4 text-[clamp(2rem,2.6vw+1rem,3.25rem)]">Come up the hill</h2>
      </div>
      <ul class="mt-10 border-y border-base-300" data-reveal="stagger">
        {% for tasting in data.services %}
        <li class="grid gap-x-6 gap-y-3 border-base-300 py-6 not-first:border-t sm:grid-cols-[1fr_auto] sm:items-center">
          <div>
            <h3 class="text-[1.5rem] leading-[1.15]">{{ tasting.name }}</h3>
            <p class="body-copy mt-1.5 max-w-[48ch]">{{ tasting.summary }}</p>
            <p class="mono mt-2 text-base-content/75"><span class="whitespace-nowrap">{{ tasting.duration }}</span> · <span class="whitespace-nowrap">{{ tasting.price }}</span></p>
          </div>
          {% if tasting.walk_in == "walk-in" %}
          <p class="inline-flex items-center gap-2 font-semibold whitespace-nowrap"><span class="stage-dot" data-dot="walk-in" aria-hidden="true"></span>Walk in</p>
          {% else %}
          <a href="{{ tasting.href }}" class="btn btn-ink justify-self-start">Book</a>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
    <aside class="lg:col-span-4 lg:col-start-9 lg:pt-24" data-reveal>
      <p class="eyebrow text-base-content/75">The barn is open</p>
      <div class="mt-4"><div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-1">
        <div><p class="eyebrow text-base-content/75">May to October</p><p class="mono mt-3">Every day, 11 am – 6 pm<br>Fridays in July and August until 8 pm</p></div>
        <div><p class="eyebrow text-base-content/75">November to April</p><p class="mono mt-3">Thursday to Sunday, noon – 5 pm</p></div>
      </div></div>
      <p class="mt-8 eyebrow text-base-content/75">Find us</p>
      <address class="mt-3 not-italic leading-relaxed">3471 South Kettle Road<br>Lake Leelanau, Michigan&nbsp;49653</address>
      <p class="body-copy mt-2">Twenty-five minutes north-west of Traverse City.</p>
      <a href="/visit" class="text-link mt-4 inline-block font-semibold">Plan your visit</a>
    </aside>
  </div>
</section>
