<section class="bg-base-100 text-base-content" id="services">
  <div class="mx-auto max-w-[110rem] px-5 py-20 md:px-10 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="text-[clamp(2.75rem,8vw,7.5rem)]">What we do</h2>
      <p class="max-w-sm text-lg text-pretty text-base-content/75">Four things, often all at once. Most clients come for one of them and stay for the rest.</p>
    </div>
    <ul class="mt-12 border-t-2 border-base-content md:mt-16">
      {% for item in data.services %}
      <li class="border-b-2 border-base-content">
        <details class="group">
          <summary class="fill-row -mx-5 flex cursor-pointer list-none items-center gap-4 px-5 py-5 md:-mx-6 md:gap-10 md:px-6 md:py-7 [&::-webkit-details-marker]:hidden">
            <span class="narrow fill-muted w-12 shrink-0 text-4xl leading-none font-bold text-primary md:w-28 md:text-7xl">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <h3 class="min-w-0 flex-1 text-[clamp(1.625rem,6.2vw,6rem)] leading-[0.85]">{{ item.name }}</h3>
            <span class="shrink-0 text-4xl leading-none font-light group-open:rotate-45 motion-safe:transition-transform md:text-6xl" aria-hidden="true">+</span>
          </summary>
          <div class="grid gap-6 pt-2 pb-8 md:grid-cols-[7rem_1.2fr_1fr] md:gap-10 md:pb-12">
            <span class="hidden md:block" aria-hidden="true"></span>
            <p class="text-xl leading-snug text-pretty md:text-2xl">{{ item.summary }}</p>
            <ul class="meta space-y-2.5 text-base-content/80">
              {% for line in item.deliverables %}<li class="flex gap-3"><span class="text-primary" aria-hidden="true">—</span>{{ line }}</li>{% endfor %}
            </ul>
          </div>
        </details>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
