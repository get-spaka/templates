<section class="bg-base-100 text-base-content" aria-label="The studio in figures">
  <div class="mx-auto max-w-[110rem] px-5 pb-20 md:px-10 md:pb-28">
    <dl class="grid grid-cols-2 border-t-2 border-base-content lg:grid-cols-4">
      {% for item in figures %}
      <div class="flex flex-col-reverse justify-end border-b border-base-300 py-8 pr-4 even:pl-4 lg:border-b-0 lg:border-l lg:px-8 lg:py-10 lg:first:border-l-0 lg:first:pl-0">
        <dt class="meta mt-4 max-w-[16rem] text-base-content/75">{{ item.label }}</dt>
        <dd class="narrow text-[clamp(3.75rem,9vw,9rem)] leading-[0.8] font-bold tracking-[-0.02em] text-primary">{{ item.figure }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
