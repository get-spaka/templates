<section class="bg-base-100 text-base-content" id="brief">
  <div class="mx-auto grid max-w-[110rem] gap-14 px-5 pb-20 md:px-10 md:pb-28 lg:grid-cols-12 lg:gap-16">
    <form hx-post="/_data/briefs" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#brief-problems swap:innerHTML" class="space-y-14 lg:col-span-8">
      <fieldset class="border-t-2 border-base-content pt-6">
        <legend class="sr-only">01 You</legend>
        <p class="flex items-baseline gap-4" aria-hidden="true"><span class="narrow text-6xl leading-none font-bold text-primary">01</span><span class="wide text-2xl font-extrabold uppercase md:text-3xl">You</span></p>
        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <label class="flex flex-col gap-2"><span class="meta text-base-content/80">Your name</span><input name="name" type="text" required maxlength="200" autocomplete="name" class="input input-lg w-full border-base-300 bg-base-200"></label>
          <label class="flex flex-col gap-2"><span class="meta text-base-content/80">Your email</span><input name="email" type="email" required maxlength="200" autocomplete="email" class="input input-lg w-full border-base-300 bg-base-200"></label>
          <label class="flex flex-col gap-2 md:col-span-2"><span class="meta text-base-content/80">Company <span class="text-base-content/60">(optional)</span></span><input name="company" type="text" maxlength="200" autocomplete="organization" class="input input-lg w-full border-base-300 bg-base-200"></label>
        </div>
      </fieldset>
      <fieldset class="border-t-2 border-base-content pt-6">
        <legend class="sr-only">02 The project</legend>
        <p class="flex items-baseline gap-4" aria-hidden="true"><span class="narrow text-6xl leading-none font-bold text-primary">02</span><span class="wide text-2xl font-extrabold uppercase md:text-3xl">The project</span></p>
        <p class="meta mt-8 text-base-content/80" id="brief-needs">What you need</p>
        <div class="mt-3 flex flex-wrap gap-2.5" role="group" aria-labelledby="brief-needs">
          {% assign needs = "Brand identity,Motion system,Campaign film,Website,Not sure yet" | split: "," %}
          {% for need in needs %}
          <label class="pill-choice flex cursor-pointer items-center rounded-full border-2 border-base-300 px-5 py-2.5 font-bold motion-safe:transition-colors"><input type="checkbox" name="needs" value="{{ need }}" class="sr-only">{{ need }}</label>
          {% endfor %}
        </div>
        <label class="mt-8 flex flex-col gap-2"><span class="meta text-base-content/80">Tell us about it</span><textarea name="message" required maxlength="5000" rows="6" class="textarea textarea-lg w-full rounded-box border-base-300 bg-base-200" placeholder="Who you are, what is changing, and what you would like people to feel."></textarea></label>
      </fieldset>
      <fieldset class="border-t-2 border-base-content pt-6">
        <legend class="sr-only">03 Budget and timing</legend>
        <p class="flex items-baseline gap-4" aria-hidden="true"><span class="narrow text-6xl leading-none font-bold text-primary">03</span><span class="wide text-2xl font-extrabold uppercase md:text-3xl">Budget and timing</span></p>
        <p class="meta mt-8 text-base-content/80" id="brief-budget">Budget</p>
        <div class="mt-3 flex flex-wrap gap-2.5" role="radiogroup" aria-labelledby="brief-budget">
          {% assign budgets = "Under €20k,€20-50k,€50-100k,€100k+" | split: "," %}
          {% for budget in budgets %}
          <label class="pill-choice flex cursor-pointer items-center rounded-full border-2 border-base-300 px-5 py-2.5 font-bold motion-safe:transition-colors"><input type="radio" name="budget" value="{{ budget }}" class="sr-only">{{ budget }}</label>
          {% endfor %}
        </div>
        <p class="meta mt-8 text-base-content/80" id="brief-timing">Timing</p>
        <div class="mt-3 flex flex-wrap gap-2.5" role="radiogroup" aria-labelledby="brief-timing">
          {% assign timings = "ASAP,This quarter,Next quarter,Just exploring" | split: "," %}
          {% for timing in timings %}
          <label class="pill-choice flex cursor-pointer items-center rounded-full border-2 border-base-300 px-5 py-2.5 font-bold motion-safe:transition-colors"><input type="radio" name="timing" value="{{ timing }}" class="sr-only">{{ timing }}</label>
          {% endfor %}
        </div>
      </fieldset>
      <div id="brief-problems"></div>
      <button type="submit" class="btn btn-primary btn-lg">Send the brief <span aria-hidden="true">→</span></button>
    </form>
    <aside class="lg:col-span-4">
      <div class="space-y-8 lg:sticky lg:top-8">
        <div class="slab -rotate-[1.5deg] bg-accent p-6 text-accent-content md:-rotate-2 md:p-8" data-tilt>
          <p class="meta">New business</p>
          <p class="normal-width mt-3 text-3xl leading-none font-extrabold uppercase">Jonas Verhoef</p>
          <p class="mt-4 text-lg leading-snug font-medium">We reply within two working days, with a first call in the diary and the questions we would ask.</p>
        </div>
        <dl class="space-y-6">
          <div><dt class="meta text-base-content/60">Email</dt><dd class="mt-1"><a href="mailto:new@halfvolt.studio" class="text-xl font-bold hover:text-primary">new@halfvolt.studio</a></dd></div>
          <div><dt class="meta text-base-content/60">Phone</dt><dd class="mt-1"><a href="tel:+31103002014" class="text-xl font-bold hover:text-primary">+31 10 300 20 14</a></dd></div>
          <div><dt class="meta text-base-content/60">Studio</dt><dd class="mt-1 text-lg leading-snug">Keileweg 18<br>3029 BS Rotterdam<br><span class="text-base-content/70">Tram 4 to Marconiplein, then five minutes along the water</span></dd></div>
        </dl>
      </div>
    </aside>
  </div>
</section>
