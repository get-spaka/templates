<section class="overflow-x-clip bg-base-100 text-base-content" id="team">
  <div class="mx-auto max-w-[110rem] px-5 py-20 md:px-10 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="text-[clamp(2.75rem,8vw,7.5rem)]">The people</h2>
      <p class="max-w-sm text-lg text-pretty text-base-content/75">Fourteen of us under one roof. Here are six, and what they cannot stop talking about this month.</p>
    </div>
    <ul class="pile mt-12 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5 lg:flex lg:gap-0 lg:pt-8 lg:pb-16">
      {% for member in data.team %}
      <li class="lg:min-w-0 lg:flex-1">
        <article class="flex h-full flex-col rounded-box p-3 md:p-5 {% case member.tone %}{% when 'yellow' %}bg-accent text-accent-content{% when 'bone' %}bg-secondary text-secondary-content{% when 'graphite' %}bg-base-200 text-base-content{% else %}bg-primary text-primary-content{% endcase %}">
          {% if member.photo %}
          <img src="{{ member.photo }}" class="aspect-[4/5] w-full rounded-box object-cover">
          {% else %}
          {% assign words = member.name | split: " " %}
          <div class="flex aspect-[4/5] w-full items-end rounded-box border-2 border-current p-3 md:p-4" aria-hidden="true">
            <span class="wide text-6xl leading-[0.8] font-black tracking-[-0.04em] uppercase md:text-7xl">{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span>
          </div>
          {% endif %}
          <h3 class="normal-width mt-4 text-xl leading-none break-words md:text-2xl lg:text-xl xl:text-2xl">{{ member.name }}</h3>
          <p class="meta mt-2">{{ member.role }}</p>
          <p class="mt-4 border-t border-current pt-3 text-[0.9375rem] leading-snug"><span class="meta block opacity-75">Currently obsessed with</span>{{ member.obsession }}</p>
        </article>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
