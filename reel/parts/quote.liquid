<section class="overflow-x-clip bg-base-100 text-base-content">
  <div class="mx-auto max-w-[110rem] px-5 py-20 md:px-10 md:py-28">
    {% for item in data.testimonials limit: 1 %}
    <figure class="slab rotate-[1.5deg] bg-secondary p-7 text-secondary-content md:rotate-2 md:p-14 lg:px-20" data-tilt>
      <p class="wide text-[6rem] leading-[0.6] font-black md:text-[9rem]" aria-hidden="true">“</p>
      <blockquote class="mt-2">
        <p class="normal-width max-w-[22em] text-[clamp(1.75rem,4vw,4rem)] leading-[1] font-extrabold tracking-[-0.03em] text-balance">{{ item.quote }}</p>
      </blockquote>
      <figcaption class="meta mt-8 flex flex-wrap gap-x-3 gap-y-1"><span class="font-bold">{{ item.name }}</span><span>{{ item.role }}, {{ item.company }}</span></figcaption>
    </figure>
    {% endfor %}
    {% if data.testimonials.size > 1 %}
    <div class="mt-16 grid gap-12 md:mt-24 md:grid-cols-2 md:gap-16">
      {% for item in data.testimonials offset: 1 limit: 2 %}
      <figure class="border-t-2 border-base-content pt-6">
        <blockquote><p class="text-2xl leading-snug font-semibold text-pretty md:text-3xl">“{{ item.quote }}”</p></blockquote>
        <figcaption class="meta mt-5 text-base-content/70"><span class="text-base-content">{{ item.name }}</span> · {{ item.role }}, {{ item.company }}</figcaption>
      </figure>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
