<!doctype html>
<html lang="en">
<head>
<title>Studio — Halfvolt</title>
<meta name="description" content="Fourteen people in a former harbor warehouse on Keileweg, Rotterdam: designers, animators, filmmakers and developers. How we work, who we are, what we have won and the seats that are open.">
<meta property="og:title" content="Studio — Halfvolt">
<meta property="og:description" content="Fourteen people in a former harbor warehouse on Keileweg, Rotterdam.">
</head>
<body>
{% render 'header' %}
<main>
<section class="overflow-x-clip bg-base-100 text-base-content">
  <div class="mx-auto max-w-[110rem] px-5 pt-12 pb-4 md:px-10 md:pt-20">
    <p class="meta text-base-content/70">Halfvolt · Since 2014</p>
    <div class="mt-6 flex flex-col gap-10 md:mt-10 lg:flex-row lg:items-end lg:gap-12">
      <h1 class="min-w-0 flex-1 text-[clamp(2.75rem,8vw,7.75rem)] leading-[0.82] tracking-[-0.02em]" data-kinetic>
        <span data-drift="left">A studio</span>
        <span data-drift="right">of fourteen</span>
      </h1>
      <figure class="w-full shrink-0 rotate-[1.5deg] overflow-hidden rounded-box sm:w-2/3 lg:w-[24vw] lg:max-w-[26rem] lg:rotate-3" data-tilt>
        <img src="/media/studio.jpg" class="aspect-[4/5] w-full object-cover">
      </figure>
    </div>
  </div>
</section>
{% render 'statement' %}
{% render 'principles' %}
{% render 'services' %}
{% render 'team' %}
{% render 'figures', figures: data["studio-figures"] %}
{% render 'awards' %}
{% render 'clients' %}
{% render 'jobs' %}
</main>
{% render 'footer' %}
</body>
</html>
