<section id="clients" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <p class="eyebrow text-base-content/70" data-reveal>In clients' words</p>
    {% for item in data.testimonials limit: 1 %}
    <figure class="mt-8 max-w-4xl" data-reveal>
      <p class="font-heading text-[1.25rem] leading-snug">{{ item.headline }}</p>
      <blockquote class="mt-4 font-heading text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-[1.25] font-light italic text-balance">“{{ item.quote }}”</blockquote>
      <figcaption class="facts mt-6 text-base-content/70">{{ item.name }} · {{ item.neighborhood }} · {% if item.side == "sold" %}Sold with us{% else %}Bought with us{% endif %}</figcaption>
    </figure>
    {% endfor %}
    <div class="mt-14 grid gap-10 border-t border-base-300 pt-10 md:grid-cols-2" data-reveal="stagger">
      {% for item in data.testimonials offset: 1 limit: 2 %}
      <figure>
        <p class="font-heading text-[1.25rem] leading-snug">{{ item.headline }}</p>
        <blockquote class="mt-3 font-heading text-[1.25rem] leading-relaxed font-light italic text-base-content/85">“{{ item.quote }}”</blockquote>
        <figcaption class="facts mt-4 text-base-content/70">{{ item.name }} · {{ item.neighborhood }} · {% if item.side == "sold" %}Sold with us{% else %}Bought with us{% endif %}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
