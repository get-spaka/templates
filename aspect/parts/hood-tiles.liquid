<section id="where-we-sell" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow text-base-content/70">Six neighborhoods, mostly</p>
        <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3.25rem)] leading-[1.06] tracking-[-0.015em] text-balance">Where we sell</h2>
      </div>
      <a href="/neighborhoods" class="more">All the neighborhoods<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></a>
    </div>
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
      {% for hood in data.neighborhoods %}
      <li class="{% if forloop.first %}sm:col-span-2 lg:row-span-2{% endif %}">
        <a href="/neighborhoods#{{ hood.id }}" class="group flex h-full flex-col overflow-hidden rounded-box border border-base-300 bg-base-100">
          <div class="{% if forloop.first %}aspect-[16/9] lg:aspect-auto lg:min-h-0 lg:flex-1{% else %}aspect-[4/3]{% endif %} relative overflow-hidden bg-base-200">
            {% if hood.image %}<img src="{{ hood.image }}" class="{% if forloop.first %}lg:absolute lg:inset-0 {% endif %}h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]">{% endif %}
          </div>
          <div class="flex {% unless forloop.first %}flex-1{% endunless %} flex-col gap-2 p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <h3 class="text-[1.5rem] leading-tight">{{ hood.name }}</h3>
              {% if hood.price_range != blank %}<p class="price text-[1rem] text-primary">{{ hood.price_range }}</p>{% endif %}
            </div>
            <p class="text-base leading-relaxed text-base-content/75">{{ hood.summary }}</p>
          </div>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
