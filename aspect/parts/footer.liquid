<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-7xl px-5 pt-16 md:px-8 md:pt-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" class="font-heading text-[2rem] leading-tight">Halvorsen Pike</a>
        <p class="eyebrow mt-2 text-neutral-content/70">Real Estate · Since 2011</p>
        <p class="mt-6 max-w-xs text-base leading-relaxed text-neutral-content/80">An independent agency of five brokers in a brick storefront in Fairhaven, selling homes across Bellingham.</p>
      </div>
      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8">
        <div>
          <h2 class="eyebrow text-neutral-content/60">The office</h2>
          <address class="mt-4 leading-relaxed not-italic">214 Tidewater Lane<br>Fairhaven, Bellingham<br><span class="whitespace-nowrap">WA 98225</span></address>
          <a href="https://www.openstreetmap.org/search?query=Fairhaven%2C%20Bellingham%2C%20WA" class="mt-3 inline-flex font-semibold underline decoration-accent underline-offset-4">Get directions</a>
          <p class="mt-6 leading-relaxed"><a href="tel:+13605550140" class="tabular-nums hover:underline">(360) 555-0140</a><br><a href="mailto:hello@halvorsenpike.com" class="break-all hover:underline">hello@halvorsenpike.com</a></p>
        </div>
        <div>
          <h2 class="eyebrow text-neutral-content/60">Hours</h2>
          <ul class="mt-4 space-y-2 text-[0.9375rem] tabular-nums">
            {% for row in data.hours %}
            <li class="flex justify-between gap-4"><span>{{ row.day }}</span><span class="text-right text-neutral-content/70">{{ row.hours }}</span></li>
            {% endfor %}
          </ul>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-neutral-content/70">Viewings any day, by request.</p>
        </div>
        <nav aria-label="Footer">
          <h2 class="eyebrow text-neutral-content/60">Pages</h2>
          <ul class="mt-4 space-y-2">
            {% for item in data.navigation %}{% unless item.place == "header" %}
            <li><a href="{{ item.href }}" class="hover:underline">{{ item.label }}</a></li>
            {% endunless %}{% endfor %}
            <li><a href="/sell#valuation" class="hover:underline">Free valuation</a></li>
          </ul>
        </nav>
      </div>
    </div>
    <div class="mt-16 grid gap-3 border-t border-neutral-content/15 py-7 text-[0.8125rem] leading-relaxed text-neutral-content/70 md:grid-cols-12">
      <div class="space-y-1 md:col-span-9">
        <p>Halvorsen Pike Real Estate LLC · Licensed in Washington State · Member of the Northwest MLS</p>
        <p class="flex items-center gap-2"><svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M9 14h6"/><path d="M9 17h6"/></svg>Equal Housing Opportunity</p>
        <p>Listing information is provided by the sellers and believed reliable but not guaranteed.</p>
      </div>
      <p class="md:col-span-3 md:text-right">© 2026 Halvorsen Pike Real Estate</p>
    </div>
  </div>
</footer>
