{% assign lead = nil %}{% for listing in data.listings %}{% if listing.featured and listing.status != "sold" and lead == nil %}{% assign lead = listing %}{% endif %}{% endfor %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 pt-10 pb-20 md:px-8 md:pt-16 lg:grid-cols-12 lg:gap-16 lg:pb-28">
    <div class="lg:col-span-7" data-reveal="stagger">
      <p class="eyebrow text-base-content/70">Independent real estate · Bellingham, Washington</p>
      <h1 class="mt-6 text-[clamp(2.75rem,5vw+1rem,5.25rem)] leading-[1.04] tracking-[-0.015em] text-balance">Come in. We've walked through every home we sell.</h1>
      <p class="mt-7 max-w-[52ch] text-[1.1875rem] leading-relaxed text-base-content/80">Five brokers in Fairhaven, selling homes across Bellingham since 2011. Every listing is written by the broker who knows it, room by room.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/homes" class="btn btn-primary whitespace-nowrap">See the homes</a>
        <a href="/sell#valuation" class="btn btn-outline whitespace-nowrap">What's my home worth?</a>
      </div>
    </div>
    {% if lead %}
    <figure class="lg:col-span-5">
      <a href="/homes/{{ lead.id }}" class="group block">
        <div class="aspect-[4/5] overflow-hidden rounded-box bg-base-200" data-door="load">
          {% if lead.cover %}<img src="{{ lead.cover }}" class="h-full w-full object-cover" fetchpriority="high">{% endif %}
          {% render 'door', number: lead.number, paint: lead.door %}
        </div>
        <figcaption class="mt-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-base-300 pt-3">
          <span class="text-[1.125rem] group-hover:underline group-hover:underline-offset-4"><span class="font-heading">{{ lead.address }}</span><span class="text-base-content/65"> · {{ lead.neighborhood }}</span></span>
          <span class="price text-[1.25rem] text-primary">{{ lead.price }}</span>
        </figcaption>
      </a>
    </figure>
    {% endif %}
  </div>
</section>
