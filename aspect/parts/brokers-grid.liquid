<section id="brokers" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow text-base-content/70">The brokers</p>
        <h2 class="mt-4 max-w-[22ch] text-[clamp(1.875rem,2.5vw+1rem,3.25rem)] leading-[1.06] tracking-[-0.015em] text-balance">One broker from the first call to the keys</h2>
      </div>
      <a href="/brokers" class="more">Meet the brokers<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></a>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:grid-cols-3 lg:grid-cols-5" data-reveal="stagger">
      {% for member in data.team %}
      <li>
        <a href="/brokers/{{ member.id }}" class="group block">
          {% if member.photo %}
          <img src="{{ member.photo }}" class="aspect-[3/4] w-full rounded-box object-cover">
          {% else %}
          {% assign words = member.name | split: " " %}
          <div class="flex aspect-[3/4] w-full items-center justify-center rounded-box bg-base-200 text-base-content/70" aria-hidden="true"><span class="font-heading text-[3rem] font-light sm:text-[3.75rem]">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span></div>
          {% endif %}
          <h3 class="mt-4 text-[1.25rem] leading-tight group-hover:underline group-hover:underline-offset-4">{{ member.name }}</h3>
          {% if member.role != blank %}<p class="facts mt-1 text-base-content/70">{{ member.role }}</p>{% endif %}
          {% if member.knows.size > 0 %}<p class="facts mt-2 text-base-content/60">Knows best: {{ member.knows | join: ", " }}</p>{% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
