<!doctype html>
<html lang="en">
<head>
<title>{{ record.address }}, {{ record.neighborhood }} — Halvorsen Pike Real Estate</title>
<meta name="description" content="{{ record.kind }} in {{ record.neighborhood }}, Bellingham: {{ record.beds }} beds, {{ record.baths }} baths, {{ record.sqft }} sq ft. {{ record.quote }}">
<meta property="og:title" content="{{ record.address }}, {{ record.neighborhood }} — Halvorsen Pike Real Estate">
<meta property="og:description" content="{{ record.quote }}">
</head>
<body>
{% render 'header', page: page, data: data %}
<main>
{% assign hood = data.neighborhoods | where: "name", record.neighborhood | first %}
{% assign broker = data.team | where: "name", record.agent | first %}
{% assign closed = false %}{% if record.status == "sold" or record.status == "under-contract" %}{% assign closed = true %}{% endif %}
<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 pt-8 md:px-8 md:pt-12">
    <a href="/homes" class="inline-flex items-center gap-1.5 text-[0.9375rem] text-base-content/70 hover:text-base-content"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>All homes</a>
    <div class="mt-6 overflow-hidden rounded-box border border-base-300">
      {% render 'window-band', listing: record %}
      <div class="grid gap-6 p-6 md:p-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h1 class="text-[clamp(2.25rem,3.5vw+1rem,4rem)] leading-[1.04] tracking-[-0.015em] text-balance">{{ record.address }}</h1>
          <p class="mt-3 text-[1.0625rem] text-base-content/75">{% if hood %}<a href="/neighborhoods#{{ hood.id }}" class="underline decoration-base-300 underline-offset-4 hover:decoration-primary">{{ record.neighborhood }}</a>{% else %}{{ record.neighborhood }}{% endif %}, Bellingham{% if record.kind != blank %} · {{ record.kind }}{% endif %}</p>
        </div>
        <div class="lg:col-span-5 lg:text-right">
          {% if record.status == "sold" and record.sold_price != blank %}
          <p class="price text-[clamp(2.25rem,2vw+1.5rem,3rem)] leading-none">Sold for {{ record.sold_price }}</p>
          <p class="facts mt-3 text-base-content/70">Listed at {{ record.price }}{% if record.days_on_market %} · {{ record.days_on_market }} days{% endif %}</p>
          {% else %}
          <p class="facts text-base-content/70">Listed at</p>
          <p class="price mt-1 text-[clamp(2.25rem,2vw+1.5rem,3rem)] leading-none text-primary">{{ record.price }}</p>
          {% endif %}
        </div>
      </div>
      <dl class="facts grid grid-cols-2 border-t border-base-300 bg-base-200 sm:grid-cols-3 lg:grid-cols-6">
        {% if record.beds %}<div class="border-r border-b border-base-300 px-6 py-4 lg:border-b-0"><dt class="text-base-content/60">Bedrooms</dt><dd class="price mt-1 text-[1.375rem]">{{ record.beds }}</dd></div>{% endif %}
        {% if record.baths %}<div class="border-r border-b border-base-300 px-6 py-4 lg:border-b-0"><dt class="text-base-content/60">Bathrooms</dt><dd class="price mt-1 text-[1.375rem]">{{ record.baths }}</dd></div>{% endif %}
        {% if record.sqft != blank %}<div class="border-r border-b border-base-300 px-6 py-4 lg:border-b-0"><dt class="text-base-content/60">Square feet</dt><dd class="price mt-1 text-[1.375rem]">{{ record.sqft }}</dd></div>{% endif %}
        {% if record.lot != blank %}<div class="border-r border-b border-base-300 px-6 py-4 lg:border-b-0"><dt class="text-base-content/60">Lot</dt><dd class="price mt-1 text-[1.375rem]">{{ record.lot }}</dd></div>{% endif %}
        {% if record.built %}<div class="border-r border-b border-base-300 px-6 py-4 lg:border-b-0"><dt class="text-base-content/60">Built</dt><dd class="price mt-1 text-[1.375rem]">{{ record.built }}</dd></div>{% endif %}
        {% if record.open_house != blank and closed == false %}<div class="border-b border-base-300 bg-accent px-6 py-4 text-accent-content lg:border-b-0"><dt class="opacity-75">Open house</dt><dd class="price mt-1 text-[1.375rem]">{{ record.open_house }}</dd></div>{% endif %}
      </dl>
    </div>

    <div class="mt-8 aspect-[4/3] overflow-hidden rounded-box bg-base-200 md:aspect-[16/9]" data-door="load">
      {% if record.cover %}<img src="{{ record.cover }}" class="h-full w-full object-cover" fetchpriority="high">{% endif %}
      {% render 'door', number: record.number, paint: record.door %}
    </div>

    {% assign total = record.photos.size %}{% if record.cover %}{% assign total = total | plus: 1 %}{% endif %}
    {% if total > 1 %}
    <div class="strip mt-3 pb-3">
      {% for photo in record.photos %}
      <img src="{{ photo }}" class="aspect-[4/3] w-full rounded-box object-cover">
      {% endfor %}
    </div>
    <details class="group mt-2">
      <summary class="more cursor-pointer">See all {{ total }} photos<svg class="size-4 transition-transform group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></summary>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {% if record.cover %}<img src="{{ record.cover }}" class="aspect-[4/3] w-full rounded-box object-cover">{% endif %}
        {% for photo in record.photos %}
        <img src="{{ photo }}" class="aspect-[4/3] w-full rounded-box object-cover">
        {% endfor %}
      </div>
    </details>
    {% endif %}
  </div>

  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-[44rem]">
      <p class="eyebrow text-base-content/70">The walk-through</p>
      {% if record.quote != blank %}<blockquote class="mt-6 font-heading text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-[1.25] font-light italic text-balance">“{{ record.quote }}”</blockquote>{% endif %}
      <div class="prose-aspect prose-lead mt-8">{{ record.body }}</div>
      {% if broker %}<p class="mt-10 flex items-center gap-3 border-t border-base-300 pt-6 text-[0.9375rem] text-base-content/75"><span class="brass-mark" aria-hidden="true"></span><span>Written by <a href="/brokers/{{ broker.id }}" class="font-semibold text-base-content underline decoration-base-300 underline-offset-4 hover:decoration-primary">{{ broker.name }}</a>, who walked through it.</span></p>{% elsif record.agent != blank %}<p class="mt-10 border-t border-base-300 pt-6 text-[0.9375rem] text-base-content/75">Written by {{ record.agent }}, who walked through it.</p>{% endif %}
    </div>
  </div>

  {% if record.plan %}
  <section class="bg-base-200">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 md:px-8 md:py-20 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-4">
        <p class="eyebrow text-base-content/70">The floor plan</p>
        <h2 class="mt-4 text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-tight tracking-[-0.015em]">How the rooms fit together</h2>
        {% if record.tour != blank %}<a href="{{ record.tour }}" class="btn btn-outline mt-8 whitespace-nowrap">Take the 3D tour</a>{% endif %}
      </div>
      <div class="rounded-box border border-base-300 bg-base-100 p-4 md:p-6 lg:col-span-8">
        <img src="{{ record.plan }}" class="max-h-[40rem] w-full object-contain">
      </div>
    </div>
  </section>
  {% endif %}

  {% if record.details.size > 0 %}
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-20">
    <div class="grid gap-8 lg:grid-cols-12">
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-tight tracking-[-0.015em] lg:col-span-4">The details</h2>
      <dl class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
        {% for line in record.details %}{% assign parts = line | split: ": " %}
        <div class="flex justify-between gap-4 border-t border-base-300 py-3 text-[0.9375rem]"><dt class="text-base-content/65">{{ parts.first }}</dt><dd class="text-right font-medium tabular-nums">{{ parts | slice: 1, 9 | join: ": " }}</dd></div>
        {% endfor %}
      </dl>
    </div>
  </section>
  {% endif %}

  <section id="see-it" class="border-t border-base-300 bg-base-100">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-12">
      <div class="lg:col-span-4">
        {% if broker %}
        <div class="flex gap-5 lg:flex-col">
          {% if broker.photo %}<img src="{{ broker.photo }}" class="aspect-[3/4] w-28 rounded-box object-cover lg:w-40">{% else %}{% assign words = broker.name | split: " " %}<div class="flex aspect-[3/4] w-28 shrink-0 items-center justify-center rounded-box bg-base-200 lg:w-40" aria-hidden="true"><span class="font-heading text-[2.5rem] font-light text-base-content/70">{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span></div>{% endif %}
          <div>
            <p class="eyebrow text-base-content/70">Listing broker</p>
            <p class="mt-2 font-heading text-[1.5rem] leading-tight"><a href="/brokers/{{ broker.id }}" class="hover:underline hover:underline-offset-4">{{ broker.name }}</a></p>
            <p class="facts mt-1 text-base-content/70">{{ broker.role }}</p>
            <p class="mt-4 leading-relaxed"><a href="tel:+1{{ broker.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="tabular-nums hover:underline">{{ broker.phone }}</a><br><a href="mailto:{{ broker.email }}" class="break-all hover:underline">{{ broker.email }}</a></p>
          </div>
        </div>
        {% endif %}
      </div>
      <div class="lg:col-span-8">
        {% if closed %}
        <div class="rounded-box border border-base-300 bg-base-200 p-8 md:p-10">
          <h2 class="text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-tight tracking-[-0.015em]">Looking for something like it?</h2>
          <p class="mt-3 max-w-[52ch] text-[1.0625rem] leading-relaxed text-base-content/80">This one {% if record.status == "sold" %}has sold{% else %}is under contract{% endif %}. Tell us what you're looking for, and a broker will write when a home like it comes up.</p>
          <a href="/homes#wish-list" class="btn btn-primary mt-6 whitespace-nowrap">Tell us what you're looking for</a>
        </div>
        {% else %}
        {% render 'viewing-form', data: data, current: record.id, open: record.open_house %}
        {% endif %}
      </div>
    </div>
  </section>

  <section class="bg-base-100">
    <div class="mx-auto max-w-7xl border-t border-base-300 px-5 py-16 md:px-8 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-tight tracking-[-0.015em]">More homes</h2>
        <a href="/homes" class="more">All homes<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></a>
      </div>
      <ul class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-door-stagger>
        {% assign shown = 0 %}
        {% for listing in data.listings %}{% if listing.id != record.id and listing.neighborhood == record.neighborhood and shown < 3 %}{% assign shown = shown | plus: 1 %}{% render 'listing-card', listing: listing, small: true %}{% endif %}{% endfor %}
        {% for listing in data.listings %}{% if listing.id != record.id and listing.neighborhood != record.neighborhood and listing.status != "sold" and shown < 3 %}{% assign shown = shown | plus: 1 %}{% render 'listing-card', listing: listing, small: true %}{% endif %}{% endfor %}
      </ul>
    </div>
  </section>
</article>
</main>
{% render 'footer', data: data %}
</body>
</html>
