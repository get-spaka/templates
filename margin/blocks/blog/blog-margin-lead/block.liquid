<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 pt-10 pb-16 md:px-10 md:pt-14 md:pb-24">
    {% assign lead = data.blog | where: "featured" | first %}
    {% unless lead %}{% assign lead = data.blog.first %}{% endunless %}
    {% if lead %}
    <a href="/blog/{{ lead.id }}" class="group grid gap-7 md:grid-cols-12 md:items-center md:gap-10" data-reveal>
      {% if lead.cover %}
      <span class="block aspect-[3/2] rounded-box md:col-span-7" data-ink><img src="{{ lead.cover }}" class="size-full object-cover"></span>
      {% else %}
      <span class="block aspect-[3/2] rounded-box bg-base-200 md:col-span-7" aria-hidden="true"></span>
      {% endif %}
      <span class="block md:col-span-5">
        <span class="block font-sans text-xs font-semibold tracking-[0.08em] uppercase text-secondary lining-nums">{{ lead.category }} · No. {{ lead.number }}</span>
        <h2 class="mt-4 text-[clamp(2.25rem,4.4vw,3.75rem)] leading-[1.04] font-medium tracking-tight text-balance transition-colors group-hover:text-primary">{{ lead.title }}</h2>
        <span class="mt-5 block text-lg text-pretty text-base-content/75 md:text-xl">{{ lead.summary }}</span>
        <span class="mt-6 block font-sans text-sm text-base-content/70 lining-nums">{{ lead.author }} · <time datetime="{{ lead.date }}">{{ lead.date | date: "%-d %B %Y" }}</time> · {{ lead.minutes }} min</span>
        <span class="mt-7 inline-flex items-center gap-2 font-sans text-[0.9375rem] font-semibold text-primary underline decoration-1 underline-offset-4 group-hover:decoration-2">Read the letter <span aria-hidden="true">→</span></span>
      </span>
    </a>
    {% endif %}
    <div class="mt-16 md:mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b border-base-content pb-3" data-reveal>
        <h2 class="font-sans text-xs font-semibold tracking-[0.08em] uppercase">This season{% if lead.season %} · {{ lead.season }}{% endif %}</h2>
        <a href="/blog" class="font-sans text-sm font-medium hover:text-primary">All letters <span aria-hidden="true">→</span></a>
      </div>
      <ol>
        {% assign shown = 0 %}
        {% for post in data.blog %}{% if post.id != lead.id and shown < 5 %}{% assign shown = shown | plus: 1 %}
        <li data-reveal>
          <a href="/blog/{{ post.id }}" class="group grid grid-cols-[2.75rem_1fr] gap-x-4 border-b border-base-300 py-5 md:grid-cols-[4rem_1fr_9rem] md:gap-x-8 md:py-7">
            <span class="pt-1 font-sans text-sm font-semibold text-secondary lining-nums tabular-nums">{{ post.number }}</span>
            <span class="block">
              <h3 class="text-xl leading-snug font-medium text-balance transition-colors group-hover:text-primary md:text-2xl">{{ post.title }}</h3>
              <span class="mt-1.5 block text-pretty text-base-content/75">{{ post.summary }}</span>
              <span class="mt-3 block font-sans text-xs font-semibold tracking-[0.08em] uppercase text-base-content/65 lining-nums">{{ post.topics | join: " · " }} · {{ post.minutes }} min</span>
            </span>
            {% if post.cover %}<span class="hidden aspect-[4/3] rounded-box md:block" data-ink><img src="{{ post.cover }}" class="size-full object-cover"></span>{% endif %}
          </a>
        </li>
        {% endif %}{% endfor %}
      </ol>
    </div>
  </div>
</section>
