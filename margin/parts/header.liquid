<header class="sticky top-0 z-30 border-b border-base-300 bg-base-100 text-base-content" {% if progress %}data-progress{% endif %}>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-3 md:px-10">
    <a href="/" class="text-xl leading-none font-normal tracking-tight whitespace-nowrap md:text-2xl">The Long Way Round</a>
    <div class="flex items-center gap-6">
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="whitespace-nowrap flex gap-7 text-[0.9375rem] font-medium">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
          <li><a href="{{ item.href }}" class="hover:text-primary {% if page.url == item.href %}text-primary{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </nav>
      <a href="/newsletter" class="btn btn-primary btn-sm hidden sm:inline-flex">Subscribe</a>
      <details class="margin-menu relative lg:hidden">
        <summary class="btn btn-ghost btn-sm -mr-2 px-2 font-medium">Menu</summary>
        <ul class="menu absolute right-0 z-30 mt-2 w-56 rounded-box border border-base-300 bg-base-100 p-2">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
          <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
          <li class="sm:hidden"><a href="/newsletter" class="font-semibold text-primary">Subscribe</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>
