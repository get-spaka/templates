<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-10 md:py-24">
    <div class="grid gap-4 border-b border-base-content pb-6 md:grid-cols-12 md:items-end md:gap-10" data-reveal>
      <div class="md:col-span-7">
        <p class="font-sans text-xs font-semibold tracking-[0.08em] uppercase text-secondary">Topics</p>
        <h2 class="mt-3 text-3xl leading-[1.1] tracking-tight text-balance md:text-5xl">Five ways into the city</h2>
      </div>
      <p class="text-pretty text-base-content/75 md:col-span-5">Each plate is cut from an old map or engraving of Providence, printed in the same ink as the letters.</p>
    </div>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:mt-10 lg:grid-cols-5 lg:gap-6">
      {% for topic in data.topics %}
      <li data-reveal>
        <a href="/topics/{{ topic.id }}" class="group grid grid-cols-[6.5rem_1fr] items-center gap-5 lg:block">
          {% if topic.plate %}<span class="block aspect-[4/5] rounded-box" data-ink><img src="{{ topic.plate }}" class="size-full object-cover"></span>{% else %}<span class="block aspect-[4/5] rounded-box bg-base-200" aria-hidden="true"></span>{% endif %}
          <span class="block lg:mt-4">
            <h3 class="text-xl leading-tight font-medium transition-colors group-hover:text-primary md:text-2xl">{{ topic.title }}</h3>
            <span class="mt-1.5 block text-[0.9375rem] leading-snug text-pretty text-base-content/75">{{ topic.summary }}</span>
          </span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
