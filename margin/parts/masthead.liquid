<header class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 pt-5 md:px-10 md:pt-8">
    {% assign latest = data.blog.first %}
    <div class="flex items-baseline justify-between gap-4 border-b border-base-content pb-3 font-sans text-xs font-semibold tracking-[0.08em] uppercase text-base-content/70">
      <p>A weekly walk through one city<span class="hidden sm:inline"> · Providence, RI</span></p>
      <p class="whitespace-nowrap lining-nums">No. {{ latest.number }}<span class="hidden sm:inline"> · {{ latest.season }}</span></p>
    </div>
    <h1 class="py-7 text-center md:py-11"><a href="/" class="block text-[clamp(3rem,9vw,7.5rem)] leading-[0.95] font-normal tracking-tight text-balance">The Long Way Round</a></h1>
    <div class="flex items-center justify-between gap-4 border-y border-base-300 py-2.5">
      <p class="hidden w-48 font-sans text-xs font-semibold tracking-[0.08em] uppercase text-base-content/70 md:block">By Nell Ashby</p>
      <nav aria-label="Main" class="hidden lg:block">
        <ul class="whitespace-nowrap flex gap-9 text-[0.9375rem] font-medium">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
          <li><a href="{{ item.href }}" class="hover:text-primary {% if page.url == item.href %}text-primary{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </nav>
      <details class="margin-menu relative lg:hidden">
        <summary class="btn btn-ghost btn-sm -ml-2 px-2 font-medium">Menu</summary>
        <ul class="menu absolute left-0 z-30 mt-2 w-56 rounded-box border border-base-300 bg-base-100 p-2">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
          <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </details>
      <div class="flex justify-end md:w-48">
        <a href="/newsletter" class="btn btn-primary btn-sm">Subscribe</a>
      </div>
    </div>
  </div>
</header>
