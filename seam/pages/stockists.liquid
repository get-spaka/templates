<!doctype html>
<html lang="en">
<head>
<title>Stockists — Ourlet</title>
<meta name="description" content="Try Ourlet on at the studio in Mile End, open on Saturdays from 11 to 5, or at six shops in Montreal, Quebec City, Toronto, Vancouver, Brooklyn and Copenhagen.">
<meta property="og:title" content="Stockists — Ourlet">
<meta property="og:description" content="Try Ourlet on at the studio in Mile End, open on Saturdays from 11 to 5, or at six shops in Montreal, Quebec City, Toronto, Vancouver, Brooklyn and Copenhagen.">
</head>
<body>
{% render 'header' %}
<main class="bg-base-100 text-base-content">
  <section class="mx-auto max-w-[90rem] px-5 pt-16 pb-16 md:px-8 lg:pt-24 lg:pb-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end" data-reveal>
      <h1 class="page-title lg:col-span-7">Try them on</h1>
      <p class="body-text max-w-md text-lg lg:col-span-4 lg:col-start-9">At the studio, where every size and color hangs on one rail, or at six shops that carry us.</p>
    </div>
  </section>
  <section id="studio" class="scroll-mt-20 bg-base-100">
    <div class="mx-auto grid max-w-[90rem] gap-12 px-5 pb-24 md:px-8 lg:grid-cols-12 lg:pb-32">
      <div class="lg:col-span-5" data-reveal>
        <p class="type text-base-content/70">The studio</p>
        <h2 class="heading mt-3">Studio 405, Mile End</h2>
        <address class="mt-6 text-lg not-italic leading-relaxed">5590 Avenue de Gaspé, fourth floor<br>Montreal, Quebec H2T 2A3</address>
        <p class="body-text mt-5">Take the freight elevator to the fourth floor and follow the sound of the machines. Metro Rosemont is a ten-minute walk; there is street parking on De Gaspé on Saturdays.</p>
        <a href="https://www.openstreetmap.org/search?query=5590%20Avenue%20de%20Gasp%C3%A9%2C%20Montreal" class="ink-link mt-6 inline-block" rel="noopener" target="_blank">Open in Maps</a>
      </div>
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <table class="ruled w-full text-left">
          <tbody>
            {%- for item in data.hours %}
            <tr>
              <th class="py-5 pr-4 align-top font-heading text-[1.75rem] leading-tight font-normal">{{ item.day }}</th>
              <td class="type py-5 pr-4 align-top text-[0.875rem]">{{ item.hours }}</td>
              <td class="type py-5 align-top text-[0.875rem] text-base-content/70">{{ item.note }}</td>
            </tr>
            {%- endfor %}
          </tbody>
        </table>
        <p class="body-text mt-6">To book a Thursday fitting, write to <a href="mailto:studio@ourlet.ca?subject=A%20fitting" class="ink-link">studio@ourlet.ca</a> with the pieces you would like to try.</p>
      </div>
    </div>
  </section>
  <section class="border-t border-base-300 bg-base-100">
    <div class="mx-auto max-w-[90rem] px-5 py-24 md:px-8 lg:py-32">
      <div data-reveal>
        <p class="type text-base-content/70">The stockists</p>
        <h2 class="heading mt-3">Six shops that carry us</h2>
      </div>
      {%- assign regions = "Montreal,Elsewhere in Canada,United States,Europe" | split: "," %}
      {%- for region in regions %}{% assign shops = data.stockists | where: "region", region %}{% if shops.size > 0 %}
      <div class="mt-14">
        <h3 class="ui text-base-content/70" data-reveal>{{ region }}</h3>
        <ul class="mt-4 border-t border-base-300">
          {%- for shop in shops %}
          <li class="grid gap-x-8 gap-y-2 border-b border-base-300 py-6 md:grid-cols-12 md:items-baseline" data-reveal>
            <p class="type md:col-span-2">{{ shop.city }}</p>
            <p class="font-heading text-[2rem] leading-tight md:col-span-4">{% if shop.link %}<a href="{{ shop.link }}" class="hover:underline hover:decoration-1 hover:underline-offset-4" rel="noopener" target="_blank">{{ shop.name }}</a>{% else %}{{ shop.name }}{% endif %}</p>
            <div class="md:col-span-6">
              <p>{{ shop.address }}</p>
              <p class="type mt-1 text-base-content/70">{{ shop.carries }}{% if shop.note %} · {{ shop.note }}{% endif %}</p>
            </div>
          </li>
          {%- endfor %}
        </ul>
      </div>
      {%- endif %}{% endfor %}
    </div>
  </section>
  <section id="wholesale" class="scroll-mt-20 bg-base-100">
    <div class="mx-auto max-w-[90rem] px-5 pb-24 md:px-8 lg:pb-32">
      <div class="grid gap-10 bg-base-200 px-6 py-10 md:px-10 md:py-14 lg:grid-cols-12 lg:gap-12" data-reveal>
        <div class="lg:col-span-4">
          <p class="type text-base-content/70">Become a stockist</p>
          <h2 class="heading mt-3">Carry Ourlet in your shop</h2>
          <p class="body-text mt-5">We work with a few independent shops whose people know how clothes are made. Tell us about yours.</p>
          <p class="type mt-8 text-base-content/70">Wholesale and press</p>
          <p class="mt-1"><a href="mailto:wholesale@ourlet.ca" class="ink-link">wholesale@ourlet.ca</a></p>
        </div>
        <form hx-post="/_data/wholesale" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#wholesale-problems swap:innerHTML" class="grid gap-x-6 gap-y-5 sm:grid-cols-2 lg:col-span-8">
          <fieldset class="fieldset">
            <legend class="fieldset-legend type text-[0.8125rem] font-normal">Shop</legend>
            <input name="shop" required maxlength="160" class="input w-full border-base-content/30 bg-base-100">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend type text-[0.8125rem] font-normal">City</legend>
            <input name="city" required maxlength="120" class="input w-full border-base-content/30 bg-base-100">
          </fieldset>
          <fieldset class="fieldset sm:col-span-2">
            <legend class="fieldset-legend type text-[0.8125rem] font-normal">Website</legend>
            <input name="website" type="url" maxlength="300" placeholder="https://" class="input w-full border-base-content/30 bg-base-100">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend type text-[0.8125rem] font-normal">Your name</legend>
            <input name="name" required maxlength="120" autocomplete="name" class="input w-full border-base-content/30 bg-base-100">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend type text-[0.8125rem] font-normal">Email</legend>
            <input name="email" type="email" required maxlength="200" autocomplete="email" class="input w-full border-base-content/30 bg-base-100">
          </fieldset>
          <fieldset class="fieldset sm:col-span-2">
            <legend class="fieldset-legend type text-[0.8125rem] font-normal">Message</legend>
            <textarea name="message" rows="4" maxlength="3000" class="textarea w-full border-base-content/30 bg-base-100"></textarea>
          </fieldset>
          <div id="wholesale-problems" class="empty:hidden sm:col-span-2"></div>
          <div class="sm:col-span-2"><button class="btn btn-primary">Send</button></div>
        </form>
      </div>
    </div>
  </section>
</main>
{% render 'footer' %}
</body>
</html>
