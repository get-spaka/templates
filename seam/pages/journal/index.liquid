<!doctype html>
<html lang="en">
<head>
<title>Journal — Ourlet</title>
<meta name="description" content="Notes from Ourlet's studio in Mile End: how a collection is made, the mills we buy from, the people at the table and the pieces that come back to be mended.">
<meta property="og:title" content="Journal — Ourlet">
<meta property="og:description" content="Notes from Ourlet's studio in Mile End: how a collection is made, the mills we buy from, the people at the table and the pieces that come back to be mended.">
</head>
<body>
{% render 'header' %}
{%- assign latest = data.journal | first -%}
<main class="bg-base-100 text-base-content">
  <section class="mx-auto max-w-[90rem] px-5 pt-16 pb-16 md:px-8 lg:pt-24 lg:pb-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end" data-reveal>
      <h1 class="page-title lg:col-span-7">Journal</h1>
      <p class="body-text max-w-md text-lg lg:col-span-4 lg:col-start-9">Notes from the long table: the studio, the cloth, the people, and what comes back to be mended.</p>
    </div>
  </section>
  <section class="mx-auto max-w-[90rem] px-5 pb-24 md:px-8 lg:pb-32">
    <article class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
      <a href="/journal/{{ latest.id }}" class="block lg:col-span-8" tabindex="-1" aria-hidden="true">{% if latest.cover %}<figure data-pleat class="aspect-[3/2] bg-neutral"><img src="{{ latest.cover }}" class="size-full object-cover" data-print></figure>{% endif %}</a>
      <div class="lg:col-span-4" data-reveal>
        <p class="type text-base-content/70">{{ latest.category }} · {{ latest.date | date: "%B %-d, %Y" }}</p>
        <h2 class="mt-3 text-[clamp(2.25rem,3.6vw,3.25rem)]"><a href="/journal/{{ latest.id }}" class="hover:underline hover:decoration-1 hover:underline-offset-4">{{ latest.title }}</a></h2>
        <p class="body-text mt-4">{{ latest.summary }}</p>
        <a href="/journal/{{ latest.id }}" class="ink-link mt-6 inline-block">Read it</a>
      </div>
    </article>
    <ul class="mt-20 border-t border-base-300">
      {%- for post in data.journal offset: 1 %}
      <li class="border-b border-base-300" data-reveal>
        <a href="/journal/{{ post.id }}" class="group grid gap-x-8 gap-y-2 py-8 md:grid-cols-12 md:items-baseline">
          <p class="type text-base-content/70 md:col-span-3">{{ post.category }} · {{ post.date | date: "%B %-d, %Y" }}</p>
          <h2 class="text-[clamp(1.75rem,2.6vw,2.4rem)] group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4 md:col-span-5">{{ post.title }}</h2>
          <p class="body-text md:col-span-4">{{ post.summary }}</p>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </section>
</main>
{% render 'footer' %}
</body>
</html>
