<!doctype html>
<html lang="en">
<head>
<title>{{ record.title }} — Ourlet</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.title }} — Ourlet">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header' %}
<main class="bg-base-100 text-base-content">
  <article class="mx-auto max-w-[90rem] px-5 pt-16 pb-20 md:px-8 lg:pt-24 lg:pb-28">
    <header class="mx-auto max-w-4xl text-center" data-reveal>
      <p class="type text-base-content/70"><a href="/journal" class="ink-link">Journal</a> · {{ record.category }} · {{ record.date | date: "%B %-d, %Y" }}</p>
      <h1 class="mt-6 text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.95]">{{ record.title }}</h1>
      <p class="body-text mx-auto mt-6 max-w-2xl text-lg">{{ record.summary }}</p>
    </header>
    {% if record.cover %}<figure data-pleat class="mt-14 aspect-[3/2] bg-neutral lg:aspect-[16/8]"><img src="{{ record.cover }}" class="size-full object-cover" data-print></figure>{% endif %}
    <div class="record-text body-text mx-auto mt-14 max-w-[38rem] text-[1.0625rem]" data-reveal>{{ record.body }}</div>
  </article>
  <section class="border-t border-base-300 bg-base-100">
    <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <h2 class="heading">More from the journal</h2>
        <a href="/journal" class="btn btn-outline border-base-content">The journal</a>
      </div>
      <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-6">
        {%- assign shown = 0 %}
        {%- for post in data.journal %}{% if post.id != record.id and shown < 3 %}{% assign shown = shown | plus: 1 %}
        <li data-reveal>
          <a href="/journal/{{ post.id }}" class="group block">
            {% if post.cover %}<img src="{{ post.cover }}" class="aspect-[4/3] w-full object-cover" data-print>{% endif %}
            <p class="type mt-4 text-base-content/70">{{ post.category }} · {{ post.date | date: "%B %-d, %Y" }}</p>
            <h3 class="mt-2 text-[1.75rem] group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{{ post.title }}</h3>
          </a>
        </li>
        {%- endif %}{% endfor %}
      </ul>
    </div>
  </section>
</main>
{% render 'footer' %}
</body>
</html>
