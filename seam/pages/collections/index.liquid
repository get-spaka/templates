<!doctype html>
<html lang="en">
<head>
<title>Collections — Ourlet</title>
<meta name="description" content="Ourlet's collections, two a year and numbered, from Fieldwork (Fall–Winter 2026) back to the first, with the Uniform: three pieces we always make.">
<meta property="og:title" content="Collections — Ourlet">
<meta property="og:description" content="Ourlet's collections, two a year and numbered, from Fieldwork (Fall–Winter 2026) back to the first, with the Uniform: three pieces we always make.">
</head>
<body>
{% render 'header' %}
{%- assign current = data.collections | first -%}
<main class="bg-base-100 text-base-content">
  <section class="mx-auto max-w-[90rem] px-5 pt-16 pb-24 md:px-8 lg:pt-24 lg:pb-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end" data-reveal>
      <h1 class="page-title lg:col-span-7">Collections</h1>
      <p class="body-text max-w-md text-lg lg:col-span-4 lg:col-start-9">Two a year, numbered, each photographed on the streets around the studio. What we make keeps being made long after its season.</p>
    </div>
    <div class="mt-16 grid grid-cols-2 gap-2 sm:gap-3">
      {% if current.cover %}<figure data-pleat class="aspect-[2/3] bg-neutral"><img src="{{ current.cover }}" class="size-full object-cover" data-print></figure>{% endif %}
      {% if current.cover_2 %}<figure data-pleat class="aspect-[2/3] bg-neutral"><img src="{{ current.cover_2 }}" class="size-full object-cover" data-print></figure>{% endif %}
    </div>
    <div class="mt-10 grid gap-8 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-6">
        <p class="type text-base-content/70">Collection {{ current.number }} · {{ current.season }}</p>
        <h2 class="mt-3 text-[clamp(3.5rem,8vw,7rem)] leading-[0.88]">{{ current.title }}</h2>
      </div>
      <div class="lg:col-span-5 lg:col-start-8 lg:pt-8">
        <p class="body-text text-lg">{{ current.summary }}</p>
        <a href="/collections/{{ current.id }}" class="btn btn-primary mt-8">Open the lookbook</a>
      </div>
    </div>
  </section>
  <section class="border-t border-base-300 bg-base-100">
    <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-8 lg:py-28">
      <div data-reveal>
        <p class="type text-base-content/70">The archive</p>
        <h2 class="heading mt-3">Earlier, and always</h2>
      </div>
      <ul class="mt-12 border-t border-base-300">
        {%- for item in data.collections offset: 1 %}
        {%- assign count = data.looks | where: "collection", item.id %}
        <li class="border-b border-base-300" data-reveal>
          <a href="/collections/{{ item.id }}" class="group grid grid-cols-[3rem_1fr_4.5rem] items-center gap-x-4 gap-y-1 py-6 sm:grid-cols-[4rem_1fr_auto_6rem] md:gap-x-8">
            <span class="type text-base-content/70">{{ item.number }}</span>
            <span class="font-heading text-[clamp(2rem,4vw,3.25rem)] leading-none group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{{ item.title }}</span>
            <span class="type col-start-2 row-start-2 text-base-content/70 sm:col-start-3 sm:row-start-1">{{ item.season }} · {{ count.size }} looks</span>
            {% if item.cover %}<img src="{{ item.cover }}" class="col-start-3 row-span-2 row-start-1 aspect-[3/4] w-full object-cover sm:col-start-4 sm:row-span-1" data-print>{% endif %}
          </a>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </section>
</main>
{% render 'footer' %}
</body>
</html>
