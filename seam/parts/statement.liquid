<section class="pattern-paper bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[90rem] items-center gap-14 px-5 py-24 md:px-8 lg:grid-cols-12 lg:gap-10 lg:py-32">
    <div class="lg:col-span-7" data-reveal>
      <p class="type text-base-content/70">Ourlet · Mile End, Montreal · since 2019</p>
      <p class="statement mt-6 max-w-[24ch] text-[clamp(2rem,3.4vw,2.6rem)]">We make a few clothes, slowly, in one room in Mile End. Each piece is cut when someone asks for it. Then we mend it for as long as you wear it.</p>
      <a href="/studio" class="btn btn-outline mt-10 border-base-content">How we work</a>
    </div>
    <div class="lg:col-span-5" data-reveal>
      {% render 'pattern-piece', shape: "shirt-front", class: "mx-auto block w-full max-w-[22rem]" %}
    </div>
  </div>
</section>
