<section class="hero-diptych relative bg-base-100 text-base-content">
  <div class="relative grid grid-cols-2 gap-2 sm:gap-3 md:h-[min(calc(100svh-4.5rem),50rem)]">
    <div class="relative aspect-[2/3] md:aspect-auto">
      <figure data-pleat="load" class="absolute inset-0 bg-neutral"><img src="/media/fieldwork-01.jpg" class="size-full object-cover object-[50%_35%]" data-print></figure>
    </div>
    <div class="relative aspect-[2/3] md:aspect-auto">
      <figure data-pleat="load" class="absolute inset-0 bg-neutral"><img src="/media/fieldwork-02.jpg" class="size-full object-cover object-[50%_35%]" data-print></figure>
    </div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-3/5 bg-linear-to-t from-neutral/85 via-neutral/35 to-transparent md:block" aria-hidden="true"></div>
  </div>
  <div class="px-5 pt-8 pb-16 md:absolute md:inset-x-0 md:bottom-0 md:px-8 md:pt-0 md:pb-10 md:text-neutral-content">
    <div class="mx-auto max-w-[90rem]" data-reveal>
      <h1 class="poster">Fieldwork</h1>
      <div class="mt-6 flex flex-col gap-6 md:mt-8 lg:flex-row lg:items-end lg:justify-between">
        <p class="type max-w-md text-[0.875rem]">Collection 07 · Fall–Winter 2026 · Cut and sewn to order in Montreal</p>
        <div class="flex flex-wrap gap-3">
          <a href="/collections/fieldwork" class="btn btn-primary md:border-base-100 md:bg-base-100 md:text-base-content">See the lookbook</a>
          <a href="/pieces" class="btn btn-outline border-base-content md:border-neutral-content md:text-neutral-content md:hover:bg-neutral-content md:hover:text-neutral">All pieces</a>
        </div>
      </div>
    </div>
  </div>
  <div class="pointer-events-none absolute top-0 left-1/2 z-10 hidden -translate-x-1/2 sm:block">
    <span class="tag" style="--tilt: 6deg; --string: 4rem; margin-top: 4rem">
      <span class="tag-card text-center">
        <span class="tag-name">No. 07</span>
        <span class="block">Fieldwork</span>
        <span class="tag-rule"></span>
        <span class="block">12 pieces</span>
        <span class="block">made to order</span>
      </span>
    </span>
  </div>
</section>
