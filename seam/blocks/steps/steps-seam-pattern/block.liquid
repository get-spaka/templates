<section class="pattern-paper bg-secondary text-secondary-content">
  <div class="mx-auto max-w-[90rem] px-5 py-24 md:px-8 lg:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-6">
        <p class="type">How it's made</p>
        <h2 class="heading mt-3">Four steps, one pair of hands</h2>
      </div>
      <p class="body-text max-w-md lg:col-span-4 lg:col-start-9">From the paper pattern to the parcel, each piece stays with one of us.</p>
    </div>
    <ol class="mt-16 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-4">
      {%- for step in data.steps %}
      <li data-reveal>
        <div class="notch-rule" aria-hidden="true"></div>
        <svg viewBox="0 0 320 420" class="pattern-piece mt-8 block h-44 w-auto" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- case step.pattern -%}
{%- when "sleeve" -%}
  <path d="M30 390 L62 132 C88 62 136 36 160 36 C184 36 232 62 258 132 L290 390 C210 401 110 401 30 390 Z" stroke-width="1.8"/>
  <path d="M46 378 L76 140 C100 78 140 54 160 54 C180 54 220 78 244 140 L274 378 C202 387 118 387 46 378 Z" stroke-width="1" stroke-dasharray="6 5"/>
  <path d="M160 36 V50 M78 96 L88 106 M236 92 L226 102 M246 106 L236 116" stroke-width="1.8"/>
  <path d="M160 120 V330 M152 132 L160 120 L168 132 M152 318 L160 330 L168 318" stroke-width="1.3"/>
  <g fill="currentColor" stroke="none" font-family="Courier Prime, Courier New, monospace">
    <text x="116" y="218" font-size="22" letter-spacing="4">SLEEVE</text>
    <text x="126" y="244" font-size="13">Cut 2</text>
    <text x="100" y="364" font-size="12">Ourlet · 07 · Size 3</text>
  </g>
{%- when "cutting-layout" -%}
  <rect x="24" y="20" width="272" height="380" stroke-width="1.8"/>
  <path d="M36 20 V400 M284 20 V400" stroke-width="1" stroke-dasharray="2 5"/>
  <path d="M40 40 C58 39 70 30 74 18 L130 30 C126 52 132 72 144 82 L148 176 C112 182 76 184 40 180 Z" stroke-width="1.3" transform="translate(4 26)"/>
  <path d="M40 40 C58 39 70 30 74 18 L130 30 C126 52 132 72 144 82 L148 176 C112 182 76 184 40 180 Z" stroke-width="1.3" transform="translate(4 226)"/>
  <path d="M168 120 L182 58 C192 38 208 30 222 30 C236 30 252 38 262 58 L276 120 C240 124 204 124 168 120 Z" stroke-width="1.3" transform="translate(0 20)"/>
  <path d="M168 120 L182 58 C192 38 208 30 222 30 C236 30 252 38 262 58 L276 120 C240 124 204 124 168 120 Z" stroke-width="1.3" transform="translate(0 130)"/>
  <rect x="176" y="292" width="92" height="26" stroke-width="1.3"/>
  <rect x="176" y="332" width="40" height="44" stroke-width="1.3"/>
  <rect x="228" y="332" width="40" height="44" stroke-width="1.3"/>
  <path d="M100 96 V160 M95 104 L100 96 L105 104 M95 152 L100 160 L105 152 M100 296 V360 M95 304 L100 296 L105 304 M95 352 L100 360 L105 352" stroke-width="1.1"/>
  <g fill="currentColor" stroke="none" font-family="Courier Prime, Courier New, monospace">
    <text x="52" y="122" font-size="11">FRONT</text>
    <text x="52" y="322" font-size="11">BACK</text>
    <text x="203" y="112" font-size="11">SLV</text>
    <text x="203" y="222" font-size="11">SLV</text>
    <text x="196" y="309" font-size="11">COLLAR</text>
    <text x="26" y="414" font-size="11">150 cm · selvedge to selvedge</text>
  </g>
{%- when "hem" -%}
  <path d="M64 30 H256 L276 290 L290 392 H30 L44 290 Z" stroke-width="1.8"/>
  <path d="M78 46 H242 L260 290 L272 376 H48 L60 290 Z" stroke-width="1" stroke-dasharray="6 5"/>
  <path d="M36 344 H284" stroke-width="1" stroke-dasharray="14 4 2 4"/>
  <path d="M33 368 H287" stroke-width="1" stroke-dasharray="14 4 2 4"/>
  <path d="M44 290 L56 292 M276 290 L264 292 M40 314 L52 316 M280 314 L268 316" stroke-width="1.8"/>
  <path d="M160 70 V250 M152 82 L160 70 L168 82 M152 238 L160 250 L168 238" stroke-width="1.3"/>
  <g fill="currentColor" stroke="none" font-family="Courier Prime, Courier New, monospace">
    <text x="102" y="168" font-size="22" letter-spacing="4">TROUSER</text>
    <text x="114" y="194" font-size="13">Front · Cut 2</text>
    <text x="96" y="338" font-size="11">Fold 2 cm · press</text>
    <text x="96" y="362" font-size="11">Fold 3 cm · stitch</text>
  </g>
{%- else -%}
  <path d="M40 92 C80 90 108 70 118 40 L258 70 C250 120 262 170 292 196 L300 392 C220 404 120 408 40 400 Z" stroke-width="1.8"/>
  <path d="M54 106 C90 102 116 82 128 56 L246 82 C242 126 252 172 280 200 L286 380 C212 390 124 393 54 387 Z" stroke-width="1" stroke-dasharray="6 5"/>
  <path d="M262 138 L274 134 M300 296 L288 296 M300 310 L288 310 M118 40 L122 52" stroke-width="1.8"/>
  <path d="M58 150 H44 M48 146 L44 150 L48 154 M58 330 H44 M48 326 L44 330 L48 334 M58 150 V330" stroke-width="1.3"/>
  <path d="M190 140 V330 M182 152 L190 140 L198 152 M182 318 L190 330 L198 318" stroke-width="1.3"/>
  <g fill="currentColor" stroke="none" font-family="Courier Prime, Courier New, monospace">
    <text x="128" y="222" font-size="22" letter-spacing="4">FRONT</text>
    <text x="118" y="248" font-size="13">Cut 2 on fold</text>
    <text x="74" y="244" font-size="11" transform="rotate(-90 74 244)">PLACE ON FOLD</text>
    <text x="100" y="366" font-size="12">Ourlet · 07 · Size 3</text>
  </g>
{%- endcase -%}
</svg>

        <p class="type mt-6">{{ step.step }}</p>
        <h3 class="mt-1 text-[2rem]">{{ step.title }}</h3>
        <p class="body-text mt-3">{{ step.text }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
