<ul class="flex flex-wrap gap-3 {{ class }}">
  {% for item in data.stores %}
  <li>
    <a href="{{ item.url }}" class="store-pill lift {% if ghost %}store-pill-ghost{% endif %}">
      {% if item.store == "google-play" %}
      <svg class="size-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5v17a.5.5 0 0 0 .76.43l14.2-8.5a.5.5 0 0 0 0-.86L5.76 3.07A.5.5 0 0 0 5 3.5Z"/><path d="m5.3 3.3 9.2 8.7-9.2 8.7"/></svg>
      <span><small>Get it on</small><strong>{{ item.label }}</strong></span>
      {% else %}
      <svg class="size-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M10.5 5.5h3"/><path d="M12 10v6"/><path d="m9.5 13.5 2.5 2.5 2.5-2.5"/></svg>
      <span><small>Download on the</small><strong>{{ item.label }}</strong></span>
      {% endif %}
    </a>
  </li>
  {% endfor %}
</ul>
