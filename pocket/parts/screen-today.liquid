<div class="screen px-3.5 pt-1.5 pb-3" data-screen="today">
  <p class="text-[10px] font-semibold tracking-wide text-base-content/60 uppercase">Tuesday, November 17</p>
  <p class="mt-0.5 text-[17px] leading-tight font-bold tracking-tight">Good morning, Sam</p>
  <p class="mt-1 text-[11px] text-base-content/70">3 plants are thirsty today.</p>
  <ul class="mt-3 space-y-1.5">
    {% for plant in data.plants limit: 3 %}
    <li>
      <label class="flex items-center gap-2.5 rounded-2xl bg-base-200 p-2" data-water>
        {% if plant.photo %}<img src="{{ plant.photo }}" class="size-9 shrink-0 rounded-full object-cover">{% else %}<span class="size-9 shrink-0 rounded-full bg-linear-to-br from-secondary to-accent"></span>{% endif %}
        <span class="min-w-0 flex-1">
          <span class="plant-name block truncate text-[13px] font-bold">{{ plant.name }}</span>
          <span class="block truncate text-[10.5px] text-base-content/60">{{ plant.species }}</span>
        </span>
        <span class="ring">
          <input type="checkbox" class="sr-only" aria-label="Mark {{ plant.name }} as watered">
          <svg class="thirsty" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5s7 7.1 7 12a7 7 0 0 1-14 0c0-4.9 7-12 7-12Z"/></svg>
          <svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
          <svg class="drop-fall absolute -top-2.5 left-1/2 -ml-1 size-2 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5s7 7.1 7 12a7 7 0 0 1-14 0c0-4.9 7-12 7-12Z"/></svg>
        </span>
      </label>
    </li>
    {% endfor %}
  </ul>
  <p class="mt-4 text-[10px] font-semibold tracking-wide text-base-content/60 uppercase">Later this week</p>
  <ul class="mt-1.5 divide-y divide-base-300">
    {% for plant in data.plants offset: 3 limit: 3 %}
    <li class="flex items-center gap-2.5 py-1.5">
      {% if plant.photo %}<img src="{{ plant.photo }}" class="size-6 shrink-0 rounded-full object-cover">{% else %}<span class="size-6 shrink-0 rounded-full bg-linear-to-br from-secondary to-accent"></span>{% endif %}
      <span class="min-w-0 flex-1 truncate text-[12px] font-semibold">{{ plant.name }}</span>
      <span class="text-[10.5px] text-base-content/60">{{ plant.next_water | date: "%a" }}</span>
    </li>
    {% endfor %}
  </ul>
</div>
