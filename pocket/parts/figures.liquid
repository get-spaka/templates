<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
    <dl class="grid divide-y divide-base-300 rounded-box border border-base-300 bg-base-100 soft-shadow md:grid-cols-3 md:divide-x md:divide-y-0">
      {% for figure in data["home-figures"] %}
      <div class="flex flex-col gap-2 p-7 md:p-9" data-reveal>
        <dt class="order-2 text-lg font-semibold">{{ figure.label }}</dt>
        <dd class="numeral order-1 text-[clamp(3rem,6vw,4.75rem)] text-primary" data-count>{{ figure.value }}</dd>
        {% if figure.note %}<dd class="order-3 text-[0.9375rem] text-base-content/65">{{ figure.note }}</dd>{% endif %}
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
