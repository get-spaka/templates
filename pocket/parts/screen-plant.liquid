{% assign plant = data.plants.first %}
<div class="screen flex flex-col" data-screen="plant">
  <div class="relative h-[38%] shrink-0 overflow-hidden">
    {% if plant.photo %}<img src="{{ plant.photo }}" class="size-full object-cover">{% else %}<div class="size-full bg-linear-to-br from-secondary to-accent"></div>{% endif %}
    <span class="absolute top-2 left-3 grid size-7 place-items-center rounded-full bg-base-100/85" aria-hidden="true"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></span>
  </div>
  <div class="relative -mt-5 flex flex-1 flex-col rounded-t-3xl bg-base-100 px-3.5 pt-3 pb-3">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <p class="truncate text-[17px] leading-tight font-bold tracking-tight">{{ plant.name }}</p>
        <p class="truncate text-[10.5px] text-base-content/60 italic">{{ plant.species }}</p>
      </div>
      <div class="ring" style="--size: 2.75rem; --stroke: 4px; --fill: {{ plant.health | divided_by: 100.0 }}"><span class="relative text-[11px] font-bold text-base-content">{{ plant.health }}%</span></div>
    </div>
    <ul class="mt-2.5 flex flex-wrap gap-1 text-[10px] font-semibold">
      <li class="rounded-full bg-base-200 px-2 py-0.5">{% case plant.light %}{% when "low" %}Low light{% when "medium" %}Medium light{% else %}Bright light{% endcase %}</li>
      <li class="rounded-full bg-base-200 px-2 py-0.5">Every {{ plant.water_every }} days</li>
      <li class="rounded-full bg-base-200 px-2 py-0.5">{{ plant.room }}</li>
    </ul>
    <p class="mt-3 text-[10px] font-semibold tracking-wide text-base-content/60 uppercase">Care</p>
    <ol class="mt-1.5 space-y-2 border-l-2 border-secondary pl-3 text-[11px]">
      <li><span class="font-bold">Watered</span> <span class="text-base-content/60">· 6 days ago</span></li>
      <li><span class="font-bold">Fed</span> <span class="text-base-content/60">· October 28</span></li>
      <li><span class="font-bold">Repotted</span> <span class="text-base-content/60">· March</span></li>
    </ol>
    <span class="mt-auto flex h-8 items-center justify-center gap-1.5 rounded-full bg-primary text-[12px] font-bold text-primary-content" aria-hidden="true"><svg class="size-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5s7 7.1 7 12a7 7 0 0 1-14 0c0-4.9 7-12 7-12Z"/></svg>Water now</span>
  </div>
</div>
