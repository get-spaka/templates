<footer class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-6xl px-5 pt-16 pb-10 md:px-8 md:pt-20">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_2fr]">
      <div class="max-w-sm">
        <a href="/" class="flex items-center gap-2.5">
          <span class="grid size-10 place-items-center rounded-full bg-secondary text-secondary-content" aria-hidden="true"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V11"/><path d="M12 13c0-4.5 3-7.5 8-8-0.5 5-3.5 8-8 8Z"/><path d="M12 15c0-3.5-2.4-6-6.5-6.5.4 4.1 2.9 6.5 6.5 6.5Z"/></svg></span>
          <span class="font-heading text-[1.75rem] font-semibold tracking-tight">Fernway</span>
        </a>
        <p class="mt-4 leading-relaxed text-neutral-content/75">Houseplant care for iPhone and Android, made by five people and a great many plants in Utrecht.</p>
        <div class="mt-7">{% render 'store-buttons', ghost: true %}</div>
      </div>
      <div class="grid gap-10 sm:grid-cols-3">
        {% for item in data.navigation %}{% if item.links.size > 0 %}
        <nav aria-label="{{ item.label }}">
          <h2 class="kicker text-neutral-content/60">{{ item.label }}</h2>
          <ul class="mt-4 space-y-2.5">
            {% for link in item.links %}<li><a href="{{ link.href }}" class="hover:text-secondary" {% if page.url == link.href %}aria-current="page"{% endif %}>{{ link.label }}</a></li>{% endfor %}
          </ul>
        </nav>
        {% endif %}{% endfor %}
      </div>
    </div>
    <div class="mt-14 flex flex-col gap-4 border-t border-neutral-content/15 pt-6 text-[0.9375rem] text-neutral-content/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Fernway B.V., Utrecht</p>
      <nav aria-label="Legal and social" class="flex flex-wrap gap-x-6 gap-y-2">
        {% for item in data.navigation %}{% if item.place == "footer" or item.place == "social" %}{% unless item.links.size > 0 %}
        <a href="{{ item.href }}" class="hover:text-secondary" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endunless %}{% endif %}{% endfor %}
      </nav>
    </div>
  </div>
</footer>
