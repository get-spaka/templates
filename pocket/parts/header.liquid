<header class="sticky top-0 z-40 px-3 pt-3 text-base-content md:px-5 md:pt-4">
  <div class="navbar mx-auto min-h-0 max-w-5xl gap-2 rounded-full border border-base-300/80 bg-base-100/85 py-2 pr-2 pl-4 soft-shadow backdrop-blur-md md:pl-5">
    <div class="navbar-start">
      <a href="/" class="flex items-center gap-2 whitespace-nowrap">
        <span class="grid size-8 place-items-center rounded-full bg-secondary text-secondary-content" aria-hidden="true"><svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V11"/><path d="M12 13c0-4.5 3-7.5 8-8-0.5 5-3.5 8-8 8Z"/><path d="M12 15c0-3.5-2.4-6-6.5-6.5.4 4.1 2.9 6.5 6.5 6.5Z"/></svg></span>
        <span class="font-heading text-[1.375rem] font-semibold tracking-tight">Fernway</span>
      </a>
    </div>
    <nav aria-label="Main" class="navbar-center hidden lg:flex">
      <ul class="whitespace-nowrap flex items-center gap-1 text-[0.9375rem] font-medium">
        {% for item in data.navigation %}{% if item.place == "header" or item.place == "both" %}
        <li><a href="{{ item.href }}" class="rounded-full px-4 py-2 transition-colors hover:bg-base-200 {% if page.url == item.href %}bg-base-200{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="navbar-end gap-1">
      <a href="/#download" class="btn btn-primary btn-sm h-10 px-5 text-[0.9375rem]">Get the app</a>
      <div class="dropdown dropdown-end lg:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-sm size-10" aria-label="Open menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 9h14"/><path d="M5 15h14"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-50 mt-3 w-56 rounded-box border border-base-300 bg-base-100 p-2 soft-shadow">
          {% for item in data.navigation %}{% if item.place == "header" or item.place == "both" %}
          <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</header>
