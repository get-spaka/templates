<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl space-y-20 px-5 pb-20 md:space-y-28 md:px-8 md:pb-28">
    {% for item in data.treatments %}
    <article id="{{ item.id }}" class="grid items-center gap-8 md:grid-cols-12 md:gap-12" data-reveal>
      <a href="/treatments/{{ item.id }}" class="block md:col-span-6 {% cycle '', 'md:order-2' %}">
        {% if item.image %}
        <img src="{{ item.image }}" class="aspect-[4/3] w-full rounded-box object-cover">
        {% else %}
        <div class="aspect-[4/3] w-full rounded-box bg-secondary" aria-hidden="true"></div>
        {% endif %}
      </a>
      <div class="md:col-span-6 {% cycle 'md:pl-4', 'md:pr-4' %}">
        <p class="tag text-base-content/60">{{ forloop.index }} of {{ forloop.length }}</p>
        <h2 class="mt-3 text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-[1.1]"><a href="/treatments/{{ item.id }}" class="hover:text-primary">{{ item.name }}</a></h2>
        {% if item.summary != blank %}<p class="mt-4 max-w-[52ch] text-lg leading-relaxed text-base-content/80">{{ item.summary }}</p>{% endif %}
        <ul class="tag mt-6 flex flex-wrap gap-x-5 gap-y-2 text-base-content/80">
          <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>First visit {{ item.first_minutes }} min</li>
          <li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>From {{ item.price_from }}</li>
          {% if item.covered %}<li class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>Covered by most extended health plans</li>{% endif %}
        </ul>
        <a href="/treatments/{{ item.id }}" class="btn btn-outline btn-primary mt-8 h-auto min-h-10 max-w-full py-2.5 leading-snug whitespace-normal">About {{ item.name | downcase }}</a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
