<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <p class="tag text-primary">Before you come</p>
      <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3rem)] leading-[1.1] text-balance">What to wear and bring</h2>
      <p class="mt-5 max-w-[46ch] text-lg leading-relaxed text-base-content/80">Nothing special: comfortable clothes and a few papers. If you forget something, we'll manage.</p>
    </div>
    <ul class="divide-y divide-base-300 border-y border-base-300 lg:col-span-7" data-reveal="stagger">
      {% for item in data["what-to-bring"] %}
      <li class="flex gap-5 py-6">
        <span class="mt-1 flex size-7 shrink-0 items-center justify-center rounded-full bg-secondary text-secondary-content" aria-hidden="true"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
        <div>
          <h3 class="text-[1.3125rem] leading-snug">{{ item.title }}</h3>
          {% if item.text != blank %}<p class="mt-1.5 text-[1.0625rem] leading-relaxed text-base-content/80">{{ item.text }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
