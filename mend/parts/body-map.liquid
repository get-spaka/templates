  </g>
  <g class="joint" data-joint="shoulder-arm"><circle class="halo" cx="165" cy="154" r="6"/><circle class="dot" cx="165" cy="154" r="5.5"/><circle class="hit" cx="165" cy="154" r="15"/></g>
 </g>
   <g class="joint" data-joint="shoulder-arm"><circle class="halo" cx="83" cy="90" r="6"/><circle class="dot" cx="83" cy="90" r="5.5"/><circle class="hit" cx="83" cy="90" r="15"/></g>
   <g class="joint" data-joint="shoulder-arm"><circle class="halo" cx="157" cy="90" r="6"/><circle class="dot" cx="157" cy="90" r="5.5"/><circle class="hit" cx="157" cy="90" r="15"/></g>
   <g class="joint" data-joint="back"><circle class="halo" cx="120" cy="118" r="6"/><circle class="dot" cx="120" cy="118" r="5.5"/><circle class="hit" cx="120" cy="118" r="15"/></g>
  </g>
  <g class="joint" data-joint="back"><circle class="halo" cx="120" cy="170" r="6"/><circle class="dot" cx="120" cy="170" r="5.5"/><circle class="hit" cx="120" cy="170" r="15"/></g>
  <g class="joint" data-joint="hip-pelvis"><circle class="halo" cx="104" cy="216" r="6"/><circle class="dot" cx="104" cy="216" r="5.5"/><circle class="hit" cx="104" cy="216" r="15"/></g>
  <g class="joint" data-joint="hip-pelvis"><circle class="halo" cx="136" cy="216" r="6"/><circle class="dot" cx="136" cy="216" r="5.5"/><circle class="hit" cx="136" cy="216" r="15"/></g>
 </g>
 </g>
</svg>
      </div>
      <div class="lg:col-span-7 lg:pl-6">
        <div data-reveal>
          <p class="tag text-primary">Where does it hurt?</p>
          <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3rem)] leading-[1.1] text-balance">Choose a place, and see what we treat there</h2>
          <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-base-content/80">Most people come to us with one question: can you help with this? Open an area to see what we see there most often, and how we go about it.</p>
        </div>
        <div class="mt-10 border-t border-base-content/15" data-reveal="stagger">
          {% for area in data.areas %}
          <details name="body-areas" class="group border-b border-base-content/15" data-area="{{ area.joint }}" {% if forloop.first %}open{% endif %}>
            <summary class="flex cursor-pointer items-center gap-4 py-5 outline-offset-4">
              <span class="size-2.5 shrink-0 rounded-full bg-base-content/25 group-open:bg-accent" aria-hidden="true"></span>
              <span class="flex-1 font-heading text-[1.375rem] leading-tight md:text-[1.5rem]">{{ area.name }}</span>
              <span class="area-plus flex size-9 shrink-0 items-center justify-center rounded-full border border-base-content/20" aria-hidden="true"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg></span>
            </summary>
            <div class="pb-8 pl-[1.625rem] md:pr-10">
              <p class="tag text-base-content/60">Seen most</p>
              <ul class="mt-2 flex flex-wrap gap-x-2 gap-y-1 text-[1.0625rem] font-medium">
                {% for condition in area.conditions %}<li>{{ condition }}{% unless forloop.last %}<span class="ml-2 text-accent" aria-hidden="true">·</span>{% endunless %}</li>{% endfor %}
              </ul>
              {% if area.text != blank %}<p class="mt-4 max-w-[58ch] text-[1.0625rem] leading-relaxed text-base-content/80">{{ area.text }}</p>{% endif %}
              <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
                <a href="/book?area={{ area.joint }}" class="btn btn-primary h-auto min-h-12 max-w-full shrink py-3 text-left leading-snug whitespace-normal">Request an appointment about your {{ area.name | downcase }}</a>
                {% for link in area.links %}<a href="{{ link.href }}" class="text-[0.9375rem] font-semibold text-primary underline-offset-4 hover:underline">{{ link.label }}</a>{% endfor %}
              </div>
            </div>
          </details>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
