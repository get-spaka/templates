  </g>
  <g class="joint" data-joint="shoulder-arm"><circle class="halo" cx="75" cy="154" r="6"/><circle class="dot" cx="75" cy="154" r="5.5"/><circle class="hit" cx="75" cy="154" r="15"/></g>
 </g>
   <g data-part="arm-r" style="transform-origin: 157px 90px">
