  <g data-part="forearm-r" style="transform-origin: 165px 154px">
   <path class="limb" d="M158.5 154.4L164 212.3A5 5 0 0 0 174 211.7L171.5 153.6A6.5 6.5 0 0 0 158.5 154.4Z"/>
   <ellipse class="limb" cx="170" cy="227" rx="7" ry="12"/>
