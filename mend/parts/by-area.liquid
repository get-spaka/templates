<section id="by-area" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="tag text-primary">By area</p>
        <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3rem)] leading-[1.1] text-balance">Everything we treat, from head to foot</h2>
      </div>
      <p class="text-lg leading-relaxed text-base-content/80 lg:col-span-5">Don't see what's bothering you? Ask us: if it isn't for us, we'll tell you who it is for.</p>
    </div>
    <div class="mt-14 grid gap-x-8 gap-y-12 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-6" data-reveal="stagger">
      {% for area in data.areas %}
      <div id="{{ area.joint }}">
        <h3 class="flex items-center gap-3 border-b border-base-content/15 pb-4 text-[1.3125rem] leading-tight"><span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>{{ area.name }}</h3>
        <ul class="mt-4 space-y-2 text-base text-base-content/80">
          {% for condition in area.conditions %}<li>{{ condition }}</li>{% endfor %}
        </ul>
        <a href="/book?area={{ area.joint }}" class="mt-5 inline-block text-[0.9375rem] font-semibold text-primary underline-offset-4 hover:underline">Ask about this</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
