<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 text-base-content backdrop-blur">
  <div class="mx-auto flex h-[4.5rem] max-w-7xl items-center gap-6 px-5 md:px-8">
    <a href="/" class="flex shrink-0 items-center gap-4" aria-label="Tern Physiotherapy &amp; Osteopathy, home">
      <span class="font-heading text-[1.75rem] leading-none whitespace-nowrap">Tern<span class="text-accent">.</span></span>
      <span class="tag hidden border-l border-base-300 pl-4 whitespace-nowrap text-base-content/70 2xl:inline">Physiotherapy &amp; Osteopathy</span>
    </a>
    <nav aria-label="Main" class="ml-auto hidden xl:block">
      <ul class="flex items-center gap-7 text-[0.9375rem] font-medium whitespace-nowrap">
        {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
        <li><a href="{{ item.href }}" class="py-2 underline-offset-[0.4em] hover:underline {% if page.url contains item.href %}underline decoration-accent decoration-2{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endunless %}{% endfor %}
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-3 xl:ml-6">
      <a href="tel:+19025550148" class="hidden items-center gap-2 text-[0.9375rem] font-medium whitespace-nowrap min-[90rem]:inline-flex">
        <svg class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (902) 555-0148
      </a>
      <a href="/book" class="btn btn-primary hidden whitespace-nowrap sm:inline-flex">Request an appointment</a>
      <div class="dropdown dropdown-end xl:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Open the menu">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h16"/></svg>
        </div>
        <div tabindex="0" class="dropdown-content z-50 mt-3 w-72 rounded-box border border-base-300 bg-base-100 p-3 shadow-lg">
          <ul class="menu w-full p-0 text-base">
            {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
            <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endunless %}{% endfor %}
          </ul>
          <div class="mt-2 flex flex-col gap-2 border-t border-base-300 px-1 pt-3">
            <a href="/book" class="btn btn-primary">Request an appointment</a>
            <a href="tel:+19025550148" class="btn btn-ghost">Call (902) 555-0148</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
