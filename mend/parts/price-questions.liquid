<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4" data-reveal>
      <p class="tag text-primary">Questions</p>
      <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3rem)] leading-[1.1] text-balance">About fees and plans</h2>
    </div>
    <div class="border-t border-base-300 lg:col-span-8" data-reveal="stagger">
      {% for item in data["prices-faq"] %}
      <details class="group border-b border-base-300" name="prices-faq" {% if forloop.first %}open{% endif %}>
        <summary class="flex cursor-pointer items-center justify-between gap-6 py-6">
          <span class="font-heading text-[1.375rem] leading-snug">{{ item.question }}</span>
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-base-content/20 group-open:rotate-45 motion-safe:transition-transform" aria-hidden="true"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg></span>
        </summary>
        <div class="prose-mend max-w-[62ch] pb-7 text-[1.0625rem] text-base-content/80">{{ item.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
