<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="tag text-primary">Questions</p>
        <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3rem)] leading-[1.1] text-balance">What people ask before a first visit</h2>
      </div>
      <p class="text-lg leading-relaxed text-base-content/80 lg:col-span-5">Something else on your mind? Call us on <a href="tel:+19025550148" class="font-semibold text-primary underline underline-offset-4">(902) 555-0148</a>; we're happy to talk it through.</p>
    </div>
    <dl class="mt-14 grid gap-x-16 gap-y-10 md:grid-cols-2" data-reveal="stagger">
      {% for item in data["first-visit-faq"] %}
      <div class="border-t border-base-content/15 pt-6">
        <dt class="font-heading text-[1.375rem] leading-snug">{{ item.question }}</dt>
        <dd class="prose-mend mt-3 text-[1.0625rem] text-base-content/80">{{ item.answer }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
