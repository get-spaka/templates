<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="max-w-2xl" data-reveal>
      <p class="tag text-primary">How we work</p>
      <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3rem)] leading-[1.1] text-balance">Four things we promise every patient</h2>
    </div>
    <ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {% for item in data.promises %}
      <li>
        <span class="block size-3 rounded-full bg-accent" aria-hidden="true"></span>
        <h3 class="mt-6 text-[1.375rem] leading-snug">{{ item.title }}</h3>
        {% if item.text != blank %}<p class="mt-3 text-[1.0625rem] leading-relaxed text-base-content/80">{{ item.text }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
