<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 pb-20 md:px-8 md:pb-28">
    <div class="border-t border-base-300" data-reveal="stagger">
      {% for post in data.blog %}
      <article class="grid gap-6 border-b border-base-300 py-10 sm:grid-cols-[12rem_1fr] sm:items-center sm:gap-10 md:grid-cols-[16rem_1fr] md:py-12">
        <a href="/advice/{{ post.id }}" class="block">
          {% if post.cover %}
          <img src="{{ post.cover }}" class="aspect-[4/3] w-full rounded-box object-cover sm:aspect-square">
          {% else %}
          <div class="aspect-[4/3] w-full rounded-box bg-secondary sm:aspect-square" aria-hidden="true"></div>
          {% endif %}
        </a>
        <div>
          {% if post.category != blank %}<p class="tag flex items-center gap-2 text-primary"><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>{{ post.category }}</p>{% endif %}
          <h2 class="mt-3 max-w-[24ch] text-[clamp(1.625rem,1.5vw+1rem,2.25rem)] leading-[1.12] text-balance"><a href="/advice/{{ post.id }}" class="hover:text-primary">{{ post.title }}</a></h2>
          {% if post.summary != blank %}<p class="mt-3 max-w-[60ch] text-[1.0625rem] leading-relaxed text-base-content/80">{{ post.summary }}</p>{% endif %}
          <p class="tag mt-5 text-base-content/60">{{ post.author }}{% if post.minutes %} · {{ post.minutes }} min read{% endif %}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
