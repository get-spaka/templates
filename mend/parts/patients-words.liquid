<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <p class="tag text-primary" data-reveal>In our patients' words</p>
    {% for item in data.testimonials limit: 1 %}
    <figure class="mt-8 grid gap-8 lg:grid-cols-12" data-reveal>
      <div class="lg:col-span-7">
        {% if item.headline != blank %}<p class="font-heading text-[clamp(2rem,3vw+1rem,3.5rem)] leading-[1.08] text-balance"><span class="text-accent" aria-hidden="true">“</span>{{ item.headline }}<span class="text-accent" aria-hidden="true">”</span></p>{% endif %}
      </div>
      <div class="lg:col-span-5 lg:pt-3">
        <blockquote><p class="text-[1.1875rem] leading-relaxed text-base-content/80">{{ item.quote }}</p></blockquote>
        <figcaption class="mt-6 flex items-center gap-3"><span class="h-px w-8 bg-base-content/30" aria-hidden="true"></span><span class="font-semibold">{{ item.name }}</span>{% if item.role != blank %}<span class="text-base-content/70">{{ item.role }}</span>{% endif %}</figcaption>
      </div>
    </figure>
    {% endfor %}
    {% if data.testimonials.size > 1 %}
    <div class="mt-16 grid gap-10 border-t border-base-content/15 pt-10 md:grid-cols-2 md:gap-16" data-reveal="stagger">
      {% for item in data.testimonials offset: 1 limit: 2 %}
      <figure>
        {% if item.headline != blank %}<h3 class="text-[1.5rem] leading-snug">{{ item.headline }}</h3>{% endif %}
        <blockquote class="mt-3"><p class="text-[1.0625rem] leading-relaxed text-base-content/80">{{ item.quote }}</p></blockquote>
        <figcaption class="mt-5 text-base"><span class="font-semibold">{{ item.name }}</span>{% if item.role != blank %}<span class="text-base-content/70"> · {{ item.role }}</span>{% endif %}</figcaption>
      </figure>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
