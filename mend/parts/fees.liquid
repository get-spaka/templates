<section id="fees" class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 pb-20 md:px-8 md:pb-28 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4" data-reveal>
      <h2 class="text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-[1.1]">Fees per visit</h2>
      <p class="mt-4 text-lg leading-relaxed text-base-content/80">Every first visit is an hour, one to one. Follow-ups last 45 minutes. Paid at the clinic by card or debit.</p>
    </div>
    <div class="space-y-12 lg:col-span-8" data-reveal="stagger">
      {% assign groups = data.fees | map: "treatment" | uniq %}
      {% for group in groups %}
      <div>
        <h3 class="flex items-center gap-3 border-b border-base-300 pb-4 text-[1.5rem]"><span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>{{ group }}</h3>
        <ul>
          {% for fee in data.fees %}{% if fee.treatment == group %}
          <li class="border-b border-base-300 py-5">
            <div class="flex items-end gap-3">
              <p class="text-[1.125rem] font-semibold">{{ fee.visit }} <span class="tag ml-1 font-semibold text-base-content/60">{{ fee.minutes }} min</span></p>
              <span class="mb-1.5 min-w-6 flex-1 border-b-2 border-dotted border-base-content/25" aria-hidden="true"></span>
              <p class="display text-[1.875rem]">{{ fee.price }}</p>
            </div>
            {% if fee.note != blank %}<p class="mt-1 text-[0.9375rem] text-base-content/70">{{ fee.note }}</p>{% endif %}
          </li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
