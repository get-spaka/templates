<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="tag text-primary">Practitioners</p>
        <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3rem)] leading-[1.1] text-balance">The people you'll see</h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-lg leading-relaxed text-base-content/80">Physiotherapists and an osteopath under one roof, who talk to each other about your care, with your permission.</p>
      </div>
    </div>
    <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 sm:gap-y-12 lg:grid-cols-4" data-reveal="stagger">
      {% for member in data.team %}
      <a href="/team/{{ member.id }}" class="group block">
        {% if member.photo %}
        <img src="{{ member.photo }}" class="aspect-[4/5] w-full rounded-box object-cover">
        {% else %}
        {% assign words = member.name | split: " " %}
        <div class="flex aspect-[4/5] w-full items-center justify-center rounded-box bg-secondary text-secondary-content" aria-hidden="true">
          <span class="font-heading text-5xl sm:text-6xl">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
        </div>
        {% endif %}
        <h3 class="mt-4 text-[1.25rem] leading-tight group-hover:text-primary sm:mt-5 sm:text-[1.5rem]">{{ member.name }}</h3>
        {% if member.role != blank %}<p class="mt-1 text-[0.9375rem] text-base-content/70 sm:text-base">{{ member.role }}</p>{% endif %}
        {% if member.bio != blank %}
        <p class="tag mt-4 text-base-content/60">Sees most</p>
        <p class="mt-1 text-[0.9375rem] leading-relaxed text-base-content/80 sm:text-base">{{ member.bio }}</p>
        {% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</section>
