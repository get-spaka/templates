<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="tag text-primary">Treatments</p>
        <h2 class="mt-4 text-[clamp(1.875rem,2.5vw+1rem,3rem)] leading-[1.1] text-balance">How we treat</h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-lg leading-relaxed text-base-content/80">Hands-on treatment, exercise you'll actually do, and clear explanations. Most plans combine all three.</p>
      </div>
    </div>
    <ul class="mt-12 border-t border-base-300" data-reveal="stagger">
      {% for item in data.treatments %}
      <li class="border-b border-base-300">
        <a href="/treatments/{{ item.id }}" class="group grid items-center gap-5 py-6 sm:grid-cols-[10rem_1fr] md:grid-cols-[13rem_1fr_auto] md:gap-10">
          {% if item.image %}
          <img src="{{ item.image }}" class="aspect-[4/3] w-full rounded-[calc(var(--radius-box)*0.66)] object-cover">
          {% else %}
          <div class="aspect-[4/3] w-full rounded-[calc(var(--radius-box)*0.66)] bg-secondary" aria-hidden="true"></div>
          {% endif %}
          <div>
            <h3 class="text-[1.625rem] leading-tight group-hover:text-primary md:text-[1.875rem]">{{ item.name }}</h3>
            {% if item.summary != blank %}<p class="mt-2 max-w-[60ch] text-[1.0625rem] leading-relaxed text-base-content/80">{{ item.summary }}</p>{% endif %}
            <p class="tag mt-3 text-base-content/70">First visit {{ item.first_minutes }} min · from {{ item.price_from }}</p>
          </div>
          <span class="hidden size-12 items-center justify-center rounded-full border border-base-300 group-hover:border-primary motion-safe:transition-colors group-hover:bg-primary group-hover:text-primary-content md:flex" aria-hidden="true">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
