<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 pt-8 pb-14 md:px-8 md:pt-12 lg:grid-cols-12 lg:gap-14 lg:pb-20">
    <div class="flex flex-col justify-center lg:col-span-7 lg:py-10" data-reveal="stagger">
      <p class="tag text-primary">Physiotherapy &amp; osteopathy · North End, Halifax</p>
      <h1 class="mt-5 text-[clamp(2.5rem,5vw+1rem,5rem)] leading-[1.05] tracking-[-0.015em] text-balance">Unhurried care for the body you live in</h1>
      <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-pretty text-base-content/80">Physiotherapy and osteopathy in Halifax's North End. An hour for every first visit, a plan you understand, and no referral needed.</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="/book" class="btn btn-primary btn-lg whitespace-nowrap">Request an appointment</a>
        <a href="#where-it-hurts" class="btn btn-ghost btn-lg gap-2 whitespace-nowrap">
          Where does it hurt?
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </a>
      </div>
      <p class="tag mt-7 flex items-center gap-3 text-base-content/70"><span class="breath-dot" data-breath aria-hidden="true"></span>We reply within one working day</p>
    </div>
    <div class="lg:col-span-5" data-reveal>
      <img src="/media/hero.jpg" class="aspect-[4/5] w-full rounded-box object-cover max-lg:aspect-[4/3]">
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <ul class="grid border-t border-base-300 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {% for item in data.features %}
      <li class="border-b border-base-300 py-6 sm:odd:pr-6 sm:even:border-l sm:even:pl-6 lg:border-b-0 lg:border-l lg:px-6 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
        <h2 class="tag flex items-center gap-2.5 text-[0.9375rem] text-base-content"><span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>{{ item.title }}</h2>
        {% if item.text != blank %}<p class="mt-2 text-base leading-relaxed text-base-content/70">{{ item.text }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
