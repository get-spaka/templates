<!doctype html>
<html lang="en">
<head>
<title>{{ record.name }}, {{ record.role }} — Tern Physiotherapy &amp; Osteopathy</title>
<meta name="description" content="{{ record.name }}, {{ record.role }} at Tern Physiotherapy &amp; Osteopathy in Halifax. {{ record.bio }}">
<meta property="og:title" content="{{ record.name }} — Tern Physiotherapy &amp; Osteopathy">
<meta property="og:description" content="{{ record.bio }}">
</head>
<body>
{% assign first = record.name | split: " " | first %}
{% render 'header' %}
<main class="bg-base-100 text-base-content">
<article class="mx-auto grid max-w-7xl gap-12 px-5 pt-12 pb-20 md:px-8 md:pt-16 md:pb-28 lg:grid-cols-12 lg:gap-16">
  <div class="lg:col-span-5" data-reveal>
    <a href="/team" class="tag inline-flex items-center gap-2 text-primary hover:underline"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>Practitioners</a>
    <div class="mt-6 flex items-start gap-5 sm:gap-8 lg:block">
      {% if record.photo %}
      <img src="{{ record.photo }}" class="aspect-[4/5] w-2/5 shrink-0 rounded-box object-cover lg:w-full">
      {% else %}
      {% assign words = record.name | split: " " %}
      <div class="flex aspect-[4/5] w-2/5 shrink-0 items-center justify-center rounded-box bg-secondary text-secondary-content lg:w-full" aria-hidden="true"><span class="font-heading text-5xl sm:text-7xl lg:text-8xl">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span></div>
      {% endif %}
      <dl class="min-w-0 space-y-5 text-[0.9375rem] sm:text-[1.0625rem] lg:mt-8">
        {% if record.days != blank %}<div><dt class="tag text-base-content/60">In clinic</dt><dd class="mt-1">{{ record.days }}</dd></div>{% endif %}
        {% if record.languages != blank %}<div><dt class="tag text-base-content/60">Languages</dt><dd class="mt-1">{{ record.languages }}</dd></div>{% endif %}
        {% if record.registration != blank %}<div><dt class="tag text-base-content/60">Registration</dt><dd class="mt-1">{{ record.registration }}</dd></div>{% endif %}
      </dl>
    </div>
  </div>
  <div class="lg:col-span-7 lg:pt-12">
    <div data-reveal>
      <h1 class="text-[clamp(2.5rem,4vw+1rem,4.5rem)] leading-[1.05] tracking-[-0.015em] text-balance">{{ record.name }}</h1>
      {% if record.role != blank %}<p class="mt-3 text-xl text-base-content/70">{{ record.role }}</p>{% endif %}
      {% if record.bio != blank %}<p class="mt-8 font-heading text-[1.5rem] leading-snug text-balance">{{ record.bio }}</p>{% endif %}
    </div>
    {% if record.sees.size > 0 %}
    <div class="mt-10" data-reveal>
      <h2 class="tag text-base-content/60">Sees most</h2>
      <ul class="mt-3 flex flex-wrap gap-2">{% for item in record.sees %}<li class="rounded-full bg-base-200 px-4 py-2 text-base">{{ item }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    <div class="mt-12 border-t border-base-300 pt-10" data-reveal>
      <h2 class="tag text-base-content/60">In {{ first }}'s words</h2>
      <div class="prose-mend mt-5 text-base-content/85">{{ record.body }}</div>
    </div>
    {% if record.training.size > 0 %}
    <div class="mt-12 border-t border-base-300 pt-10" data-reveal>
      <h2 class="tag text-base-content/60">Training</h2>
      <ul class="mt-4 space-y-3 text-[1.0625rem]">{% for item in record.training %}<li class="flex gap-3"><span class="mt-[0.55em] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>{{ item }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4 rounded-box bg-base-200 p-6 md:p-8" data-reveal>
      <a href="/book?with={{ record.id }}" class="btn btn-primary btn-lg h-auto max-w-full shrink py-3 leading-snug whitespace-normal">Request an appointment with {{ first }}</a>
      <p class="flex items-center gap-3 text-base text-base-content/70"><span class="breath-dot" data-breath aria-hidden="true"></span>We reply within one working day</p>
    </div>
    {% assign notes = data.blog | where: "author", record.name %}
    {% if notes.size > 0 %}
    <div class="mt-16" data-reveal>
      <h2 class="tag text-base-content/60">{{ first }}'s advice notes</h2>
      <ul class="mt-4 divide-y divide-base-300 border-y border-base-300">
        {% for post in notes %}
        <li><a href="/advice/{{ post.id }}" class="group flex items-center justify-between gap-6 py-5"><span class="font-heading text-[1.3125rem] leading-snug group-hover:text-primary">{{ post.title }}</span><span class="tag shrink-0 text-base-content/60">{{ post.minutes }} min read</span></a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</article>
</main>
{% render 'footer' %}
</body>
</html>
