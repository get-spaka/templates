<!doctype html>
<html lang="en">
<head>
<title>{{ record.name }} — Tern Physiotherapy &amp; Osteopathy</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.name }} — Tern Physiotherapy &amp; Osteopathy">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header' %}
<main class="bg-base-100 text-base-content">
<section>
  <div class="mx-auto grid max-w-7xl gap-10 px-5 pt-12 pb-12 md:px-8 md:pt-16 lg:grid-cols-12 lg:items-center lg:gap-14">
    <div class="lg:col-span-6" data-reveal>
      <a href="/treatments" class="tag inline-flex items-center gap-2 text-primary hover:underline"><svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>Treatments</a>
      <h1 class="mt-5 text-[clamp(2.5rem,4vw+1rem,4.5rem)] leading-[1.05] tracking-[-0.015em] text-balance">{{ record.name }}</h1>
      {% if record.summary != blank %}<p class="mt-6 max-w-[48ch] text-xl leading-relaxed text-base-content/80">{{ record.summary }}</p>{% endif %}
      <a href="/book?treatment={{ record.id }}" class="btn btn-primary btn-lg mt-9">Request an appointment</a>
    </div>
    <div class="lg:col-span-6" data-reveal>
      {% if record.image %}
      <img src="{{ record.image }}" class="aspect-[4/3] w-full rounded-box object-cover">
      {% else %}
      <div class="aspect-[4/3] w-full rounded-box bg-secondary" aria-hidden="true"></div>
      {% endif %}
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <dl class="grid grid-cols-2 border-y border-base-300 lg:grid-cols-4" data-reveal="stagger">
      <div class="border-base-300 py-6 pr-4 max-lg:odd:border-r lg:border-r lg:px-6 lg:first:pl-0"><dt class="tag text-base-content/60">First visit</dt><dd class="display mt-2 text-[2.25rem]">{{ record.first_minutes }} <span class="font-body text-base">min</span></dd></div>
      <div class="border-base-300 py-6 pl-4 lg:border-r lg:px-6"><dt class="tag text-base-content/60">Follow-ups</dt><dd class="display mt-2 text-[2.25rem]">{{ record.follow_minutes }} <span class="font-body text-base">min</span></dd></div>
      <div class="border-t border-base-300 py-6 pr-4 max-lg:border-r lg:border-t-0 lg:border-r lg:px-6"><dt class="tag text-base-content/60">From</dt><dd class="display mt-2 text-[2.25rem]">{{ record.price_from }}</dd></div>
      <div class="border-t border-base-300 py-6 pl-4 lg:border-t-0 lg:px-6"><dt class="tag text-base-content/60">Insurance</dt><dd class="mt-3 text-[1.0625rem] leading-snug font-semibold">{% if record.covered %}Covered by most extended health plans{% else %}Paid at the clinic; a receipt by email{% endif %}</dd></div>
    </dl>
  </div>
</section>
<section>
  <div class="mx-auto grid max-w-7xl gap-14 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-12">
    <div class="prose-mend text-base-content/85 lg:col-span-7" data-reveal>{{ record.body }}</div>
    <aside class="space-y-12 lg:col-span-4 lg:col-start-9">
      <div data-reveal>
        <h2 class="tag text-base-content/60">Who does it</h2>
        <ul class="mt-4 space-y-3">
          {% for member in data.team %}{% if member.treats contains record.name %}
          <li>
            <a href="/team/{{ member.id }}" class="group flex items-center gap-4 rounded-box bg-base-200 p-3 pr-5">
              {% if member.photo %}<img src="{{ member.photo }}" class="size-16 shrink-0 rounded-[calc(var(--radius-box)*0.6)] object-cover">{% else %}{% assign words = member.name | split: " " %}<span class="flex size-16 shrink-0 items-center justify-center rounded-[calc(var(--radius-box)*0.6)] bg-secondary font-heading text-xl" aria-hidden="true">{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span>{% endif %}
              <span><span class="block font-heading text-[1.1875rem] leading-tight group-hover:text-primary">{{ member.name }}</span><span class="mt-0.5 block text-[0.9375rem] text-base-content/70">{{ member.role }}</span></span>
            </a>
          </li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      <div data-reveal>
        <h2 class="tag text-base-content/60">Where it helps</h2>
        {% assign target = "/treatments/" | append: record.id %}
        <ul class="mt-4 divide-y divide-base-300 border-y border-base-300">
          {% for area in data.areas %}{% assign fits = false %}{% for link in area.links %}{% if link.href == target %}{% assign fits = true %}{% endif %}{% endfor %}
          {% if fits %}<li><a href="/treatments#{{ area.joint }}" class="flex items-center gap-3 py-3.5 text-[1.0625rem] hover:text-primary"><span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>{{ area.name }}</a></li>{% endif %}
          {% endfor %}
        </ul>
      </div>
    </aside>
  </div>
</section>
<section class="px-3 md:px-5">
  <div class="mx-auto max-w-[90rem] rounded-box bg-secondary px-6 py-14 text-secondary-content md:px-12 md:py-16" data-reveal>
    <div class="mx-auto flex max-w-7xl flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-[clamp(1.75rem,2vw+1rem,2.5rem)] leading-tight text-balance">Request an appointment for {{ record.name | downcase }}</h2>
        <p class="mt-3 flex items-center gap-3 text-[1.0625rem] text-secondary-content/80"><span class="breath-dot" data-breath aria-hidden="true"></span>We reply within one working day</p>
      </div>
      <a href="/book?treatment={{ record.id }}" class="btn btn-primary btn-lg shrink-0 whitespace-nowrap">Request an appointment</a>
    </div>
  </div>
</section>
<section>
  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <h2 class="text-[1.75rem]">Other treatments</h2>
    <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4" data-reveal="stagger">
      {% for item in data.treatments %}{% if item.id != record.id %}
      <li>
        <a href="/treatments/{{ item.id }}" class="group block">
          {% if item.image %}<img src="{{ item.image }}" class="aspect-[4/3] w-full rounded-box object-cover">{% else %}<div class="aspect-[4/3] w-full rounded-box bg-secondary" aria-hidden="true"></div>{% endif %}
          <h3 class="mt-3 text-[1.125rem] leading-tight group-hover:text-primary sm:mt-4 sm:text-[1.3125rem]">{{ item.name }}</h3>
          <p class="tag mt-2 text-base-content/70">From {{ item.price_from }}</p>
        </a>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
