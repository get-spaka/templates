<!doctype html>
<html lang="en">
<head>
<title>Request an appointment — Tern Physiotherapy &amp; Osteopathy</title>
<meta name="description" content="Tell us what's going on and when suits you. We call or email within one working day to set a time; nothing is booked until we confirm.">
<meta property="og:title" content="Request an appointment — Tern Physiotherapy &amp; Osteopathy">
<meta property="og:description" content="Tell us what's going on and when suits you. We call or email within one working day to set a time.">
</head>
<body>
{% render 'header' %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-6 px-5 pt-14 pb-12 md:px-8 md:pt-20 md:pb-16 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7" data-reveal>
      <p class="tag text-primary">Appointments</p>
      <h1 class="mt-4 text-[clamp(2.5rem,4vw+1rem,4.5rem)] leading-[1.05] tracking-[-0.015em] text-balance">Request an appointment</h1>
    </div>
    <p class="max-w-[62ch] text-lg leading-relaxed text-base-content/80 lg:col-span-5" data-reveal>Tell us what's going on and when suits you. We call or email within one working day to set a time; nothing is booked until we confirm.</p>
  </div>
</section>
{% render 'request-form' %}
{% render 'find-us' %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-10 md:px-8">
    <p class="flex flex-wrap items-center justify-between gap-4 border-y border-base-300 py-6 text-[1.0625rem]"><span><span class="font-semibold">Need to cancel?</span> Call or email 24 hours ahead.</span><a href="mailto:hello@ternphysio.ca" class="font-semibold text-primary underline-offset-4 hover:underline">hello@ternphysio.ca</a></p>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
