<section class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-3 md:px-8 md:py-24">
    <div data-reveal>
      <p class="mono text-base-content/70">Questions</p>
      <h2 class="mt-3 text-[clamp(1.75rem,2.2vw+1rem,2.75rem)] leading-[1.08] tracking-[-0.01em] text-balance">What people ask first</h2>
      <p class="mt-4 text-base-content/75">Something else? Ask it in your message.</p>
    </div>
    <div class="divide-y divide-base-300 border-y border-base-300 md:col-span-2">
      {% for item in data["contact-faq"] %}
      <details class="collapse collapse-plus rounded-none" {% if forloop.first %}open{% endif %}>
        <summary class="collapse-title px-0 text-[1.125rem] font-semibold">{{ item.question }}</summary>
        <div class="collapse-content max-w-[62ch] space-y-2 px-0 leading-relaxed text-base-content/80">{{ item.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
