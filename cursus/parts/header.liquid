<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/95 text-base-content backdrop-blur">
  <div class="mx-auto flex h-[4.25rem] max-w-6xl items-center gap-6 px-5 md:px-8">
    <a href="/" class="flex min-w-0 shrink-0 items-center gap-3" aria-label="{% render 'contact-line', show: 'name' %}, home">
      <span class="monogram text-[0.875rem]" aria-hidden="true">HA</span>
      <span class="font-heading text-[1.375rem] leading-none whitespace-nowrap">{% render 'contact-line', show: 'name' %}</span>
      <span class="mono hidden border-l border-base-300 pl-3 whitespace-nowrap text-base-content/70 xl:inline">Operations lead</span>
    </a>
    <nav aria-label="Main" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-6 text-[0.9375rem] font-medium whitespace-nowrap">
        {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
        <li><a href="{{ item.href }}" class="py-2 underline-offset-[0.45em] hover:underline {% if page.url contains item.href %}underline decoration-primary decoration-[1.5px]{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endunless %}{% endfor %}
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-2 md:ml-2">
      <a href="/contact" class="btn btn-primary h-10 min-h-10 px-4 whitespace-nowrap">Get in touch</a>
      <div class="dropdown dropdown-end md:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Open the menu">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h16"/></svg>
        </div>
        <div tabindex="0" class="dropdown-content z-50 mt-3 w-72 rounded-box border border-base-300 bg-base-100 p-3 shadow-lg">
          <ul class="menu w-full p-0 text-base">
            {% for item in data.navigation %}{% unless item.place == "footer" or item.place == "social" %}
            <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endunless %}{% endfor %}
          </ul>
          <p class="mono mt-2 border-t border-base-300 px-3 pt-3 text-base-content/70">Operations lead · Cincinnati, Ohio</p>
        </div>
      </div>
    </div>
  </div>
</header>
