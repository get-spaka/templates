<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <p class="mono text-base-content/70">Write to me</p>
      <h2 class="mt-3 text-[clamp(1.75rem,2.2vw+1rem,3rem)] leading-[1.08] tracking-[-0.01em] text-balance">A role, a project or a question</h2>
      <p class="mt-6 text-[1.0625rem] leading-relaxed text-base-content/80 [&_a]:text-primary [&_a]:underline">{% render 'contact-line' %}</p>
      <dl class="mt-8 divide-y divide-base-300 border-y border-base-300">
        <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
          <dt class="mono text-base-content/70">Time zone</dt>
          <dd>Cincinnati, Ohio · Eastern time</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
          <dt class="mono text-base-content/70">References</dt>
          <dd>From two former managers, after a first conversation</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
          <dt class="mono text-base-content/70">Reply</dt>
          <dd>Within two working days, by email</dd>
        </div>
      </dl>
    </div>
    <form hx-post="/_data/contact" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#contact-form-problems swap:innerHTML" class="flex flex-col gap-1 rounded-box bg-base-200 p-6 md:p-9 lg:col-span-7">
      <div class="grid gap-x-5 sm:grid-cols-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Your name</legend>
          <input name="name" type="text" class="input w-full bg-base-100" required maxlength="200" autocomplete="name">
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Your email</legend>
          <input name="email" type="email" class="input w-full bg-base-100" required maxlength="200" autocomplete="email">
        </fieldset>
      </div>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your organization <span class="font-normal text-base-content/70">(optional)</span></legend>
        <input name="organization" type="text" class="input w-full bg-base-100" maxlength="200" autocomplete="organization">
      </fieldset>
      <div class="grid gap-x-5 sm:grid-cols-2">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">What it's about</legend>
          <select name="about" class="select w-full bg-base-100" required>
            <option value="role">A role</option>
            <option value="project">A project</option>
            <option value="speaking">Speaking or a panel</option>
            <option value="other">Something else</option>
          </select>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Starting when? <span class="font-normal text-base-content/70">(optional)</span></legend>
          <input name="when" type="text" class="input w-full bg-base-100" maxlength="200" placeholder="Spring 2027, or as soon as possible">
        </fieldset>
      </div>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Your message</legend>
        <textarea name="message" class="textarea w-full bg-base-100" rows="6" required maxlength="5000"></textarea>
      </fieldset>
      <div id="contact-form-problems"></div>
      <button type="submit" class="btn btn-primary mt-3 self-start whitespace-nowrap">Send</button>
    </form>
  </div>
</section>
