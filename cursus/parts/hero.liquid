<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-5 pt-14 pb-14 md:px-8 md:pt-20 lg:pb-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
      <div class="lg:col-span-7">
        <p class="mono text-base-content/70">Operations lead · Cincinnati, Ohio</p>
        <h1 class="mt-5 text-[clamp(2.5rem,4.5vw+1rem,5rem)] leading-[1.04] tracking-[-0.015em] text-balance">I keep food moving: trucks, warehouses, schedules, and the people who make them work.</h1>
        <p class="mt-7 max-w-[54ch] text-[1.125rem] leading-relaxed text-base-content/80">Thirteen years in operations and logistics, the last eight feeding people: a produce wholesaler, then a food-bank network of 140 pantries.</p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="/resume" class="btn btn-primary btn-lg whitespace-nowrap">Read the résumé</a>
          <a href="/contact" class="btn btn-outline btn-lg whitespace-nowrap">Get in touch</a>
        </div>
      </div>
      <div class="flex flex-col items-center lg:col-span-5 lg:items-end">
        <div class="flex flex-col items-center" data-sheet-mini>
          <div class="mini-paper">
            <div inert aria-hidden="true">{% render 'sheet', data: data, mini: true %}</div>
            <a href="/resume#one-page" class="absolute inset-0 rounded-[3px]" aria-label="The one-page résumé"></a>
          </div>
          <p class="mono mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-base-content/70"><span>One page · Updated November 2026</span><a href="/resume#one-page" class="ink-link font-medium whitespace-nowrap">Save as PDF</a></p>
        </div>
      </div>
    </div>
    <div class="mt-14 lg:mt-20" data-reveal>{% render 'terms', data: data %}</div>
  </div>
</section>
