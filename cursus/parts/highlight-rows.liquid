{% comment %}Highlights as rows led by their figure. featured: true shows only those marked for the home page; summary: true adds each one's sentence.{% endcomment %}
<div class="divide-y divide-base-300 border-y border-base-300" data-reveal="stagger">
  {% for item in data.highlights %}{% if featured and item.featured != true %}{% continue %}{% endif %}
  <article class="grid gap-6 py-8 md:grid-cols-[15rem_1fr] md:gap-10 md:py-10 lg:grid-cols-[17rem_1fr_9rem]">
    <a href="/highlights/{{ item.id }}" class="block" tabindex="-1" aria-hidden="true">
      <p class="font-heading text-[clamp(3.5rem,5vw+1rem,4.75rem)] leading-[0.95] tracking-[-0.02em] text-primary">{{ item.figure }}</p>
      <p class="mono mt-3 max-w-[22ch] text-base-content/70">{{ item.figure_label }}</p>
    </a>
    <div>
      <p class="mono text-base-content/70">{{ item.organization }} · {{ item.year }}</p>
      <h3 class="mt-2 text-[clamp(1.5rem,1.2vw+1rem,2rem)] leading-tight"><a href="/highlights/{{ item.id }}" class="hover:underline hover:decoration-1 hover:underline-offset-4">{{ item.title }}</a></h3>
      {% if item.summary != blank %}<p class="mt-3 max-w-[60ch] leading-relaxed text-base-content/80">{{ item.summary }}</p>{% endif %}
      <a href="/highlights/{{ item.id }}" class="ink-link mt-4 inline-flex items-center gap-1.5 font-medium">How<span class="sr-only">: {{ item.title }}</span><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></a>
    </div>
    {% if item.cover %}<a href="/highlights/{{ item.id }}" class="hidden lg:block" tabindex="-1" aria-hidden="true"><img src="{{ item.cover }}" class="aspect-square w-full rounded-box object-cover" data-photo loading="lazy"></a>{% endif %}
  </article>
  {% endfor %}
</div>
