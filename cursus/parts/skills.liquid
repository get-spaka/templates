<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <div class="max-w-2xl" data-reveal>
      <p class="mono text-base-content/70">Skills</p>
      <h2 class="mt-3 text-[clamp(1.75rem,2.2vw+1rem,3rem)] leading-[1.08] tracking-[-0.01em] text-balance">What I'm known for</h2>
    </div>
    <div class="mt-12 grid gap-12 md:grid-cols-3 md:gap-10" data-reveal="stagger">
      {% assign groups = "known-for,tools,languages" | split: "," %}
      {% for group in groups %}
      <div>
        <h3 class="mono border-b border-base-content/80 pb-3 text-base-content/75">{% if group == "known-for" %}Known for{% elsif group == "tools" %}Tools{% else %}Languages{% endif %}</h3>
        <ul class="divide-y divide-base-300">
          {% for skill in data.skills %}{% if skill.group == group %}
          <li class="py-3.5">
            <p class="font-semibold leading-snug">{{ skill.name }}</p>
            {% if skill.evidence != blank %}<p class="mt-0.5 text-[0.9375rem] text-base-content/70">{{ skill.evidence }}</p>{% endif %}
          </li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
