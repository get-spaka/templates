{% if tone == "room" %}{% assign surface = "bg-base-100 text-base-content" %}{% assign line = "border-base-300" %}{% assign soft = "text-base-content/75" %}{% else %}{% assign surface = "bg-neutral text-neutral-content" %}{% assign line = "border-neutral-content/20" %}{% assign soft = "text-neutral-content/75" %}{% endif %}
<section class="{{ surface }}">
  <div class="mx-auto max-w-[90rem] px-4 py-24 md:px-10 md:py-32">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="tag text-primary">What's on</p>
        <h2 class="mt-6 text-5xl md:text-7xl">Evenings to come</h2>
      </div>
      <p class="max-w-sm leading-relaxed {{ soft }}">Wine dinners, oyster nights and the year's last evening. We send them first to the monthly letter.</p>
    </div>
    <ul class="mt-14 border-t {{ line }}">
      {% assign shown = 0 %}
      {% for event in data.events %}{% if shown < 3 and event.id != skip %}{% assign shown = shown | plus: 1 %}
      <li class="grid gap-5 border-b {{ line }} py-9 md:grid-cols-12 md:items-center md:gap-8" data-reveal>
        <div class="flex items-baseline gap-4 md:col-span-3 md:flex-col md:gap-2">
          <span class="display text-5xl leading-none md:text-6xl">{{ event.date | date: "%-d %b" }}</span>
          <span class="tag {{ soft }}">{{ event.date | date: "%A" }}</span>
        </div>
        <div class="md:col-span-6">
          <h3 class="text-3xl text-balance md:text-4xl"><a href="/events/{{ event.id }}" class="transition-colors hover:text-primary">{{ event.title }}</a></h3>
          <p class="mt-3 max-w-xl leading-relaxed {{ soft }}">{{ event.summary }}</p>
        </div>
        <div class="flex flex-wrap items-center gap-4 md:col-span-3 md:flex-col md:items-end">
          <span class="tag text-primary">{{ event.price }}</span>
          <a href="/events/{{ event.id }}" class="btn btn-outline btn-primary btn-sm tag">Details</a>
        </div>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
