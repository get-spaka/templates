<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-24 md:px-10 md:py-32">
    <div class="max-w-2xl" data-reveal>
      <p class="tag text-primary">The people</p>
      <h2 class="mt-6 text-5xl md:text-6xl">Who keeps the fire</h2>
    </div>
    <ul class="mt-14 grid gap-x-12 border-t border-base-300 md:grid-cols-2">
      {% for member in data.team %}
      {% assign words = member.name | split: " " %}
      <li class="flex gap-6 border-b border-base-300 py-10 sm:gap-8" data-reveal>
        {% if member.photo %}
        <img src="{{ member.photo }}" class="aspect-square w-24 shrink-0 object-cover sm:w-32" data-grade>
        {% else %}
        <div class="flex aspect-square w-24 shrink-0 items-center justify-center bg-secondary text-secondary-content sm:w-32" aria-hidden="true">
          <span class="display text-4xl sm:text-5xl">{{ words.first | slice: 0 }}{% if words.size > 1 %}{{ words.last | slice: 0 }}{% endif %}</span>
        </div>
        {% endif %}
        <div class="min-w-0">
          <h3 class="text-3xl">{{ member.name }}</h3>
          {% if member.role %}<p class="tag mt-2 text-primary">{{ member.role }}</p>{% endif %}
          {% if member.bio %}<p class="prose-ember mt-4">{{ member.bio }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
