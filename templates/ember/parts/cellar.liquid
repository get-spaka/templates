{% assign styles = "sparkling,white,skin-contact,rosé,red,sweet" | split: "," %}
{% assign bottles = data.wines | where: "by_the_glass", false %}
<section class="bg-secondary text-secondary-content" id="cellar" data-candle>
  <div class="mx-auto grid max-w-[90rem] gap-14 px-4 py-24 md:grid-cols-12 md:gap-10 md:px-10 md:py-32">
    <div class="md:col-span-4" data-reveal>
      <p class="tag text-secondary-content/80">The cellar</p>
      <h2 class="mt-6 text-5xl text-balance md:text-6xl">From the vaults, by the bottle</h2>
      <p class="mt-6 max-w-sm leading-relaxed text-secondary-content/85">A few of the three hundred; every wine by the glass is also poured by the bottle. Ask for the full list at the table.</p>
      <div class="mt-10 aspect-[4/5] overflow-hidden" data-curtain data-grade><img src="/media/bottles.jpg" class="size-full object-cover"></div>
    </div>
    <div class="space-y-12 md:col-span-7 md:col-start-6">
      {% for style in styles %}
      {% assign wines = bottles | where: "style", style %}
      {% if wines.size > 0 %}
      <div data-reveal>
        <h3 class="tag border-b border-secondary-content/40 pb-3">{% case style %}{% when "sparkling" %}Sparkling{% when "white" %}White{% when "skin-contact" %}Skin contact{% when "rosé" %}Rosé{% when "red" %}Red{% else %}Sweet{% endcase %}</h3>
        <ul>
          {% for wine in wines %}
          <li class="py-4">
            <div class="flex items-end">
              <p class="display text-2xl">{{ wine.name }} <span class="tag align-middle text-secondary-content/75">{{ wine.vintage }}</span></p>
              <span class="leader" aria-hidden="true"></span>
              <span class="tag whitespace-nowrap">{{ wine.bottle }}</span>
            </div>
            <p class="mt-1 text-secondary-content/80">{{ wine.producer }}, {{ wine.region }}{% if wine.note %}. {{ wine.note }}{% endif %}</p>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% endfor %}
      <p class="display border-t border-secondary-content/30 pt-8 text-3xl text-balance" data-reveal>Bring your own bottle on Tuesdays, $25 corkage.</p>
    </div>
  </div>
</section>
