{% assign courses = "snacks,raw-bar,small-plates,hearth,sides,sweet" | split: "," %}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-20 md:px-10 md:py-28">
    <p class="tag text-base-content/70">V vegetarian · VG vegan · GF without gluten. Tell us about allergies when you sit down.</p>
    {% for course in courses %}
    {% assign dishes = data.menu | where: "course", course %}
    {% if dishes.size > 0 %}
    {% assign pictured = dishes | where: "image" | first %}
    <div class="grid gap-10 border-t border-base-300 py-16 md:grid-cols-12 md:gap-12 md:py-24" id="{{ course }}">
      <div class="md:col-span-7">
        <div class="flex items-baseline gap-6">
          <span class="display text-7xl leading-none text-primary md:text-8xl" aria-hidden="true">{{ forloop.index }}</span>
          <h2 class="text-4xl md:text-6xl">{% case course %}{% when "snacks" %}Snacks{% when "raw-bar" %}Raw bar{% when "small-plates" %}Small plates{% when "hearth" %}From the hearth{% when "sides" %}Sides{% else %}Sweet{% endcase %}</h2>
        </div>
        <ul class="mt-10 divide-y divide-base-300">
          {% for item in dishes %}
          <li class="py-6">
            <div class="flex items-end">
              <h3 class="text-2xl md:text-[1.75rem]">{{ item.name }}</h3>
              <span class="leader" aria-hidden="true"></span>
              <span class="tag text-sm whitespace-nowrap text-primary">{{ item.price }}</span>
            </div>
            {% if item.description %}<p class="prose-ember mt-2 max-w-xl">{{ item.description }}</p>{% endif %}
            {% if item.tags.size > 0 %}
            <p class="tag mt-3 flex gap-3 text-base-content/70">
              {% for tag in item.tags %}<abbr title="{{ tag }}" class="no-underline">{% case tag %}{% when "vegetarian" %}V{% when "vegan" %}VG{% else %}GF{% endcase %}</abbr>{% endfor %}
            </p>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </div>
      <div class="md:col-span-5">
        {% if pictured %}
        <figure class="md:sticky md:top-28">
          <div class="aspect-[4/5] overflow-hidden" data-grade><img src="{{ pictured.image }}" class="size-full object-cover"></div>
          <figcaption class="tag mt-4 text-base-content/70">{{ pictured.name }}</figcaption>
        </figure>
        {% endif %}
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
</section>
