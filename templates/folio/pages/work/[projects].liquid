<!doctype html>
<html lang="en">
<head>
<title>{{ record.title }} — Noor Haddad</title>
<meta name="description" content="{{ record.title }}, {{ record.location }}, {{ record.year }}: {{ record.role }}.">
<meta property="og:title" content="{{ record.title }} — Noor Haddad">
<meta property="og:description" content="{{ record.title }}, {{ record.location }}, {{ record.year }}: {{ record.role }}.">
{% if record.cover %}<meta property="og:image" content="{{ record.cover }}">{% endif %}
</head>
<body>
{% render 'header' %}
<main>
<article class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[96rem] px-5 pt-10 md:px-10 md:pt-16">
    <a href="/work" class="font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60 link-hover hover:text-primary"><span aria-hidden="true">←</span> Work · {{ record.category }}</a>
    <h1 class="mt-6 text-[clamp(3rem,10vw,9rem)] leading-[0.9] font-light tracking-tighter text-balance" data-split>{{ record.title }}</h1>
    <div class="mt-10 grid gap-10 border-t border-base-content pt-6 md:mt-14 md:grid-cols-12">
      <dl class="grid grid-cols-[7rem_1fr] gap-x-4 gap-y-2 text-sm md:col-span-5" data-reveal>
        {% if record.client %}<dt class="font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60">Client</dt><dd>{{ record.client }}</dd>{% endif %}
        {% if record.year %}<dt class="font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60">Year</dt><dd>{{ record.year }}</dd>{% endif %}
        {% if record.location %}<dt class="font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60">Place</dt><dd>{{ record.location }}</dd>{% endif %}
        {% if record.architect %}<dt class="font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60">Architect</dt><dd>{{ record.architect }}</dd>{% endif %}
        {% if record.role %}<dt class="font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60">Commission</dt><dd>{{ record.role }}</dd>{% endif %}
      </dl>
      <div class="max-w-2xl space-y-4 text-xl leading-relaxed font-light text-pretty md:col-span-7 md:text-2xl" data-reveal>{{ record.text }}</div>
    </div>
  </div>
  <div class="mx-auto mt-14 max-w-[96rem] space-y-4 px-5 md:mt-20 md:space-y-6 md:px-10">
    {% if record.cover %}<figure class="overflow-hidden" data-uncover><img src="{{ record.cover }}" class="mx-auto block h-auto max-h-[88vh] w-auto max-w-full" style="view-transition-name: project-{{ record.id }}"></figure>{% endif %}
    <div class="grid items-start gap-4 md:grid-cols-2 md:gap-6">
      {% if record.image_2 %}<figure class="overflow-hidden" data-uncover><img src="{{ record.image_2 }}" class="h-auto w-full"></figure>{% endif %}
      {% if record.image_3 %}<figure class="overflow-hidden md:mt-24" data-uncover><img src="{{ record.image_3 }}" class="h-auto w-full"></figure>{% endif %}
    </div>
    {% if record.image_4 %}<figure class="overflow-hidden md:mx-auto md:w-2/3" data-uncover><img src="{{ record.image_4 }}" class="h-auto w-full"></figure>{% endif %}
    {% if record.image_5 %}<figure class="overflow-hidden" data-uncover><img src="{{ record.image_5 }}" class="mx-auto block h-auto max-h-[88vh] w-auto max-w-full"></figure>{% endif %}
  </div>
  {% assign next = nil %}
  {% for item in data.projects %}{% if item.id == record.id %}{% assign at = forloop.index %}{% endif %}{% endfor %}
  {% assign next = data.projects[at] | default: data.projects.first %}
  {% if next and next.id != record.id %}
  <div class="mx-auto mt-20 max-w-[96rem] px-5 pb-20 md:mt-28 md:px-10 md:pb-28">
  <a href="/work/{{ next.id }}" class="group grid items-end gap-6 border-t border-base-content pt-6 md:grid-cols-12" data-reveal>
    <span class="font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60 md:col-span-3">Next project</span>
    <span class="text-4xl leading-[0.95] font-light tracking-tighter transition-colors group-hover:text-primary md:col-span-6 md:text-7xl">{{ next.title }} <span aria-hidden="true">→</span></span>
    {% if next.cover %}<img src="{{ next.cover }}" class="aspect-[4/3] w-40 object-cover md:col-span-3 md:w-full" style="view-transition-name: project-{{ next.id }}">{% endif %}
  </a>
  </div>
  {% endif %}
</article>
</main>
{% render 'footer' %}
</body>
</html>
