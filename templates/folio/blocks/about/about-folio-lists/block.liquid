<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[96rem] px-5 py-16 md:px-10 md:py-24">
    <dl class="grid md:grid-cols-12">
      <dt class="pb-6 font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60 md:col-span-3 md:pb-12" data-reveal>Services</dt>
      <dd class="pb-12 md:col-span-9" data-reveal>
        <ul class="grid gap-x-8 gap-y-3 text-xl font-light tracking-tight sm:grid-cols-2 md:text-2xl">
          <li>Architecture</li>
          <li>Interiors</li>
          <li>Hotels and restaurants</li>
          <li>Still lifes of objects</li>
          <li>Building documentation</li>
          <li>Editorial commissions</li>
        </ul>
      </dd>
      <dt class="border-t border-base-300 pt-12 pb-6 font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60 md:col-span-3 md:pb-12" data-reveal>Recognition</dt>
      <dd class="pb-12 md:col-span-9 md:border-t md:border-base-300 md:pt-12" data-reveal>
        <ul class="divide-y divide-base-300">
          {% for item in data.recognition %}
          <li class="grid grid-cols-[4rem_1fr] gap-x-4 gap-y-1 py-3 first:pt-0 md:grid-cols-[5rem_1fr_16rem]">
            <span class="font-mono text-xs text-base-content/60">{{ item.year }}</span>
            <span class="text-lg">{{ item.title }}</span>
            <span class="col-start-2 font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60 md:col-start-auto md:text-right">{{ item.by }}</span>
          </li>
          {% endfor %}
        </ul>
      </dd>
      <dt class="border-t border-base-300 pt-12 pb-6 font-mono text-[0.7rem] tracking-[0.12em] uppercase text-base-content/60 md:col-span-3" data-reveal>Represented by</dt>
      <dd class="md:col-span-9 md:border-t md:border-base-300 md:pt-12" data-reveal>
        <p class="text-xl font-light tracking-tight md:text-2xl">Atlântico Agency, for commercial work</p>
        <p class="mt-2 text-base-content/70"><a href="mailto:hello@atlantico.agency" class="link-hover hover:text-primary">hello@atlantico.agency</a> · +351 210 000 314</p>
      </dd>
    </dl>
  </div>
</section>
