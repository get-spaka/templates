<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[96rem] gap-8 border-t border-base-300 px-5 py-16 md:grid-cols-12 md:px-10 md:py-24">
    <h2 class="font-mono text-[0.7rem] font-normal tracking-[0.12em] uppercase text-base-content/60 md:col-span-3" data-reveal>Clients include</h2>
    <ul class="grid gap-x-8 gap-y-3 text-xl font-light tracking-tight sm:grid-cols-2 md:col-span-9 md:grid-cols-3 md:text-2xl" data-reveal>
      {% for item in data.clients %}
      <li>{% if item.link %}<a href="{{ item.link }}" class="link-hover hover:text-primary">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}</li>
      {% endfor %}
    </ul>
  </div>
</section>
