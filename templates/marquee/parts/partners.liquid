<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-4 py-14 md:px-10 md:py-20">
    <h2 class="tag text-center text-sm md:text-base">Made with</h2>
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-5 md:gap-x-14">
      {% for item in data.partners %}
      <li>
        <a href="{{ item.link }}" class="font-heading uppercase transition-colors hover:text-primary {% case item.tier %}{% when "presenting" %}text-4xl font-black md:text-5xl{% when "media" %}text-3xl font-bold md:text-4xl{% else %}text-3xl font-extrabold md:text-4xl{% endcase %}" style="font-stretch: {% case item.tier %}{% when "presenting" %}125%{% when "media" %}100%{% else %}80%{% endcase %}">{{ item.name }}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
