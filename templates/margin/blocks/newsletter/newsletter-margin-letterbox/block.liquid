<section class="bg-base-100 text-base-content" id="subscribe">
  <div class="mx-auto max-w-6xl px-5 py-10 md:px-10 md:py-14">
    <div class="grid gap-8 rounded-box bg-base-200 px-6 py-10 md:grid-cols-12 md:gap-10 md:px-12 md:py-14">
      <div class="md:col-span-5" data-reveal>
        <p class="font-sans text-xs font-semibold tracking-[0.08em] uppercase text-secondary">The newsletter</p>
        <h2 class="mt-3 text-3xl leading-[1.1] tracking-tight text-balance md:text-4xl">The letter comes on Sunday mornings</h2>
        <p class="mt-4 text-pretty text-base-content/75">One walk through the city each week, for people who would rather look up than down at their phones.</p>
      </div>
      <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#newsletter-margin-letterbox-problems swap:innerHTML" class="self-end md:col-span-7" data-reveal>
        <input type="hidden" name="topics" value="The Sunday letter">
        <div class="grid gap-x-3 sm:grid-cols-[1fr_1.5fr_auto] sm:items-end">
          <fieldset class="fieldset">
            <label class="fieldset-legend" for="newsletter-margin-letterbox-name">First name</label>
            <input id="newsletter-margin-letterbox-name" name="name" type="text" maxlength="200" autocomplete="given-name" class="input w-full bg-base-100">
          </fieldset>
          <fieldset class="fieldset">
            <label class="fieldset-legend" for="newsletter-margin-letterbox-email">Email address</label>
            <input id="newsletter-margin-letterbox-email" name="email" type="email" required maxlength="200" autocomplete="email" class="input w-full bg-base-100">
          </fieldset>
          <button type="submit" class="btn btn-primary mt-3 sm:mt-0 sm:mb-1">Subscribe</button>
        </div>
        <div id="newsletter-margin-letterbox-problems" class="mt-3"></div>
        <p class="mt-4 font-sans text-sm text-base-content/70">Read by 6,400 walkers. One letter a week, nothing else.</p>
      </form>
    </div>
  </div>
</section>
