<!doctype html>
<html lang="en">
<head>
<title>Newsletter — The Long Way Round</title>
<meta name="description" content="A free letter every Sunday morning about walking one city, read by 6,400 walkers. Choose what you receive: the Sunday letter, the seasonal long walks, the spring walking tours.">
<meta property="og:title" content="Newsletter — The Long Way Round">
<meta property="og:description" content="A free letter every Sunday morning about walking one city.">
</head>
<body>
{% render 'header' %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 pt-12 pb-12 md:px-10 md:pt-20 md:pb-16">
    <p class="font-sans text-xs font-semibold tracking-[0.08em] uppercase text-secondary" data-reveal>The newsletter · free, every Sunday</p>
    <h1 class="mt-5 max-w-5xl text-[clamp(2.75rem,6.5vw,5.75rem)] leading-[1] font-normal tracking-tight text-balance" data-reveal>One walk through the city, in your inbox on Sunday morning</h1>
    <p class="mt-7 max-w-2xl text-xl leading-snug text-pretty text-base-content/75 md:text-2xl" data-reveal>A street, a building or a river each week, about a ten-minute read with your coffee. Read by 6,400 walkers, and written for the ones who don't walk much yet.</p>
  </div>
</section>
<section class="bg-base-100 text-base-content" id="subscribe">
  <div class="mx-auto max-w-6xl px-5 pb-16 md:px-10 md:pb-24">
    <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#signup-problems swap:innerHTML" class="rounded-box bg-base-200 px-6 py-8 md:px-12 md:py-12" data-reveal>
      <div class="grid gap-x-4 sm:grid-cols-2">
        <fieldset class="fieldset">
          <label class="fieldset-legend" for="signup-name">First name</label>
          <input id="signup-name" name="name" type="text" maxlength="200" autocomplete="given-name" class="input input-lg w-full bg-base-100">
        </fieldset>
        <fieldset class="fieldset">
          <label class="fieldset-legend" for="signup-email">Email address</label>
          <input id="signup-email" name="email" type="email" required maxlength="200" autocomplete="email" class="input input-lg w-full bg-base-100">
        </fieldset>
      </div>
      <fieldset class="fieldset mt-6">
        <legend class="fieldset-legend">What you receive</legend>
        <div class="grid gap-3 md:grid-cols-3">
          <label class="margin-tile flex cursor-pointer items-start gap-3 rounded-box border border-base-300 bg-base-100 p-4 md:p-5">
            <input type="checkbox" name="topics" value="The Sunday letter" class="checkbox checkbox-primary checkbox-sm mt-1" checked>
            <span>
              <span class="block font-sans font-semibold">The Sunday letter</span>
              <span class="mt-1 block font-body text-[0.9375rem] leading-snug text-base-content/75">Every week, by eight in the morning.</span>
            </span>
          </label>
          <label class="margin-tile flex cursor-pointer items-start gap-3 rounded-box border border-base-300 bg-base-100 p-4 md:p-5">
            <input type="checkbox" name="topics" value="The seasonal long walks" class="checkbox checkbox-primary checkbox-sm mt-1">
            <span>
              <span class="block font-sans font-semibold">The seasonal long walks</span>
              <span class="mt-1 block font-body text-[0.9375rem] leading-snug text-base-content/75">Four whole-day routes a year, with a map to print.</span>
            </span>
          </label>
          <label class="margin-tile flex cursor-pointer items-start gap-3 rounded-box border border-base-300 bg-base-100 p-4 md:p-5">
            <input type="checkbox" name="topics" value="The spring walking tours" class="checkbox checkbox-primary checkbox-sm mt-1">
            <span>
              <span class="block font-sans font-semibold">The spring walking tours</span>
              <span class="mt-1 block font-body text-[0.9375rem] leading-snug text-base-content/75">News of the May tours, a week before anyone else.</span>
            </span>
          </label>
        </div>
      </fieldset>
      <div id="signup-problems" class="mt-4"></div>
      <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-sans text-sm text-base-content/70">Free. One click to leave, at the bottom of every letter.</p>
        <button type="submit" class="btn btn-primary btn-lg">Subscribe</button>
      </div>
    </form>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 pb-16 md:px-10 md:pb-24">
    <h2 class="border-b border-base-content pb-3 font-sans text-xs font-semibold tracking-[0.08em] uppercase" data-reveal>What arrives</h2>
    <ol>
      {% for feature in data["newsletter-features"] %}
      <li class="grid gap-2 border-b border-base-300 py-7 md:grid-cols-12 md:gap-10 md:py-9" data-reveal>
        <span class="text-5xl leading-none text-primary lining-nums md:col-span-2 md:text-6xl">{{ forloop.index }}</span>
        <h3 class="text-2xl leading-snug font-medium text-balance md:col-span-4 md:text-3xl">{{ feature.title }}</h3>
        <p class="text-lg text-pretty text-base-content/75 md:col-span-6">{{ feature.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 pb-16 md:px-10 md:pb-24">
    <div class="flex items-baseline justify-between gap-4 border-b border-base-content pb-3" data-reveal>
      <h2 class="font-sans text-xs font-semibold tracking-[0.08em] uppercase">The latest letters</h2>
      <a href="/blog" class="font-sans text-sm font-medium hover:text-primary">All letters <span aria-hidden="true">→</span></a>
    </div>
    <ol>
      {% for post in data.blog limit: 3 %}{% render 'letter-row', post: post %}{% endfor %}
    </ol>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 pb-20 md:px-10 md:pb-28">
    <div class="grid gap-8 md:grid-cols-12 md:gap-10">
      <h2 class="text-3xl leading-[1.1] tracking-tight text-balance md:col-span-4 md:text-4xl" data-reveal>Questions</h2>
      <div class="divide-y divide-base-300 border-y border-base-300 md:col-span-8">
        {% for item in data["newsletter-faq"] %}
        <details class="group py-1" {% if forloop.first %}open{% endif %} data-reveal>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-semibold md:text-xl">{{ item.question }}<span class="text-2xl leading-none font-normal text-primary transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
          <div class="max-w-[60ch] pb-5 text-pretty text-base-content/80" data-text>{{ item.answer }}</div>
        </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
