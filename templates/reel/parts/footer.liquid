<footer class="bg-base-100 text-base-content">
  {% unless page.url == "/contact" %}
  <div class="overflow-x-clip bg-primary text-primary-content">
    <div class="mx-auto max-w-[110rem] px-5 py-16 md:px-10 md:py-24">
      <p class="meta">New business · Jonas Verhoef</p>
      <p class="wide mt-6 text-[clamp(3.5rem,14.5vw,15rem)] leading-[0.8] font-black tracking-[-0.035em] uppercase">Got a<br>brief?</p>
      <div class="mt-10 flex flex-col gap-6 md:mt-14 md:flex-row md:items-end md:justify-between">
        <a href="mailto:new@halfvolt.studio" class="normal-width text-[clamp(1.5rem,4.2vw,3.75rem)] leading-none font-extrabold tracking-[-0.03em] break-all underline decoration-[0.06em] underline-offset-[0.14em] hover:decoration-[0.12em]">new@halfvolt.studio</a>
        <a href="/contact" class="btn btn-neutral btn-lg self-start md:self-auto">Start a project <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
  {% endunless %}
  <div class="mx-auto grid max-w-[110rem] gap-10 px-5 pt-14 pb-10 sm:grid-cols-2 md:px-10 lg:grid-cols-4">
    <div>
      <a href="/" class="wide text-3xl leading-none font-black tracking-[-0.03em] uppercase">Halfvolt</a>
      <p class="mt-4 text-base-content/75">Brand, motion and film studio<br>Keileweg 18, 3029 BS Rotterdam</p>
    </div>
    <nav aria-label="Footer">
      <p class="meta text-base-content/60">Pages</p>
      <ul class="mt-3 space-y-1.5">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "footer" %}
        <li><a href="{{ item.href }}" class="text-lg font-bold uppercase hover:text-primary">{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div>
      <p class="meta text-base-content/60">Elsewhere</p>
      <ul class="mt-3 space-y-1.5">
        {% for item in data.navigation %}{% if item.place == "social" %}
        <li><a href="{{ item.href }}" class="text-lg font-bold uppercase hover:text-primary">{{ item.label }} <span aria-hidden="true">↗</span></a></li>
        {% endif %}{% endfor %}
      </ul>
    </div>
    <div>
      <p class="meta text-base-content/60">Say hello</p>
      <a href="mailto:hello@halfvolt.studio" class="mt-3 block text-lg font-semibold hover:text-primary">hello@halfvolt.studio</a>
      <a href="tel:+31103002014" class="mt-1 block text-base-content/75 hover:text-primary">+31 10 300 20 14</a>
    </div>
  </div>
  <div class="mx-auto max-w-[110rem] px-5 md:px-10">
    <p class="meta border-t border-base-300 py-6 text-base-content/60">© 2026 Halfvolt B.V. · Made loud in Rotterdam</p>
  </div>
</footer>
