<header class="relative z-40 bg-neutral text-neutral-content">
  <div class="mx-auto flex max-w-[110rem] items-center justify-between gap-4 px-5 py-3 md:px-10 md:py-4">
    <a href="/" class="wide text-[1.375rem] leading-none font-black tracking-[-0.03em] uppercase md:text-[1.75rem]">Halfvolt</a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-9">
        {% assign n = 0 %}
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}{% assign n = n | plus: 1 %}
        <li><a href="{{ item.href }}" class="group flex items-baseline gap-2 text-[0.9375rem] font-bold tracking-[0.01em] uppercase transition-colors hover:text-primary {% if page.url == item.href %}text-primary{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}><span class="meta text-neutral-content/60 group-hover:text-primary">{% if n < 10 %}0{% endif %}{{ n }}</span><span>{{ item.label }}</span></a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="flex items-center gap-2 md:gap-3">
      <p class="meta hidden rounded-full bg-accent px-3.5 py-2 text-accent-content xl:block">Now booking spring 2027</p>
      <a href="/contact" class="btn btn-primary btn-sm md:btn-md">Start a project</a>
      <div class="dropdown dropdown-end lg:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-sm text-neutral-content md:btn-md" aria-label="Open menu">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h16"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-50 mt-3 w-64 rounded-box border-2 border-base-300 bg-base-200 p-3 text-base-content">
          {% assign n = 0 %}
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}{% assign n = n | plus: 1 %}
          <li><a href="{{ item.href }}" class="flex items-baseline gap-3 py-3 text-lg font-extrabold uppercase" {% if page.url == item.href %}aria-current="page"{% endif %}><span class="meta text-primary">{% if n < 10 %}0{% endif %}{{ n }}</span>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
          <li class="mt-2"><p class="meta pointer-events-none rounded-full bg-accent px-3.5 py-2 text-accent-content">Now booking spring 2027</p></li>
        </ul>
      </div>
    </div>
  </div>
</header>
