<section id="download" class="glow relative scroll-mt-24 overflow-hidden text-base-content" data-glow>
  <canvas data-aurora aria-hidden="true"></canvas>
  <div class="relative mx-auto grid max-w-6xl items-end gap-12 px-5 pt-20 md:px-8 md:pt-28 lg:grid-cols-[1.2fr_1fr]">
    <div class="pb-6 lg:pb-28">
      <p class="kicker text-primary" data-reveal>Get the app</p>
      <h2 class="mt-4 text-[clamp(3rem,7vw,6rem)] text-balance" data-reveal>Your plants are <mark>waiting</mark></h2>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-pretty text-base-content/75" data-reveal>Free for ten plants, with no ads and no account needed to start. Plus is two taps away when you want it.</p>
      <div class="mt-9" data-reveal><ul class="flex flex-wrap gap-3">
        <li><a href="https://apps.apple.com/" class="store-pill lift"><svg class="size-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M10.5 5.5h3"/><path d="M12 10v6"/><path d="m9.5 13.5 2.5 2.5 2.5-2.5"/></svg><span><small>Download on the</small><strong>App Store</strong></span></a></li>
        <li><a href="https://play.google.com/store/apps" class="store-pill lift"><svg class="size-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5v17a.5.5 0 0 0 .76.43l14.2-8.5a.5.5 0 0 0 0-.86L5.76 3.07A.5.5 0 0 0 5 3.5Z"/><path d="m5.3 3.3 9.2 8.7-9.2 8.7"/></svg><span><small>Get it on</small><strong>Google Play</strong></span></a></li>
      </ul></div>
      <div class="mt-6" data-reveal>{% render 'rating' %}</div>
    </div>
    <div class="relative mx-auto -mb-[9rem] w-fit md:-mb-[10rem]" data-reveal>
      <div class="absolute inset-x-[-1.25rem] -top-9 z-10 flex items-center gap-3 rounded-[1.375rem] border border-base-300/70 bg-base-100/90 p-3 pr-4 soft-shadow backdrop-blur-md md:inset-x-[-2.75rem]" data-notify role="status">
        <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-primary text-primary-content" aria-hidden="true"><svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5s7 7.1 7 12a7 7 0 0 1-14 0c0-4.9 7-12 7-12Z"/></svg></span>
        <span class="min-w-0 flex-1 text-[0.875rem] leading-snug"><b class="block font-semibold">Monty is thirsty</b><span class="text-base-content/70">Water today · Living room</span></span>
        <span class="self-start text-[0.8125rem] text-base-content/55">now</span>
      </div>
      {% render 'phone', screen: 'today', tilt: true %}
    </div>
  </div>
</section>
