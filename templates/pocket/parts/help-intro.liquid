<section class="glow relative -mt-[4.75rem] text-base-content md:-mt-20">
  <div class="relative mx-auto max-w-4xl px-5 pt-32 pb-16 text-center md:px-8 md:pt-40 md:pb-20">
    <p class="kicker text-primary" data-reveal>Help center</p>
    <h1 class="mt-4 text-[clamp(3rem,7vw,6rem)] text-balance" data-reveal>How can we <mark>help?</mark></h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-pretty text-base-content/75" data-reveal>Short answers, written by the people who make Fernway. Pick a topic, or write to us at the bottom of the page.</p>
    {% assign topics = data["help-articles"] | map: "topic" | compact | uniq %}
    <nav aria-label="Topics" class="mt-9" data-reveal>
      <ul class="flex flex-wrap justify-center gap-2">
        {% for topic in topics %}
        <li><a href="#topic-{{ topic | downcase | replace: " ", "-" }}" class="inline-flex h-11 items-center rounded-full border border-base-300 bg-base-100/85 px-5 font-semibold backdrop-blur transition-colors hover:border-primary hover:text-primary">{{ topic }}</a></li>
        {% endfor %}
        <li><a href="#support" class="inline-flex h-11 items-center rounded-full bg-neutral px-5 font-semibold text-neutral-content">Write to us</a></li>
      </ul>
    </nav>
  </div>
</section>
