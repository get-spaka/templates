<div class="screen flex flex-col px-3.5 pt-1.5 pb-3" data-screen="light">
  <p class="text-[17px] leading-tight font-bold tracking-tight">Light meter</p>
  
  <div class="relative mt-2.5 h-[7.5rem] shrink-0 overflow-hidden rounded-2xl bg-base-200">
    <img src="/media/windowsill.jpg" class="size-full object-cover">
    <span class="absolute inset-x-[30%] inset-y-[22%] rounded-xl border-2 border-dashed border-base-100" aria-hidden="true"></span>
    <span class="absolute bottom-2 left-2 rounded-full bg-base-100/90 px-2 py-0.5 text-[10px] font-bold">South-west window</span>
  </div>
  <div class="mt-2 flex items-center gap-3">
    <div class="relative w-[42%] shrink-0" aria-hidden="true">
      <svg viewBox="0 0 200 112" class="w-full" fill="none" stroke-linecap="round" stroke="currentColor">
        <path d="M16 104a84 84 0 0 1 168 0" stroke-width="16" class="text-base-200"/>
        <path d="M16 104a84 84 0 0 1 42-72.7" stroke-width="16" class="text-accent"/>
        <path d="M62 29a84 84 0 0 1 76 0" stroke-width="16" class="text-secondary"/>
        <path d="M142 31.3a84 84 0 0 1 42 72.7" stroke-width="16" class="text-primary" opacity="0.75"/>
      </svg>
      <svg viewBox="0 0 20 80" class="needle absolute bottom-[7%] left-1/2 -ml-[5%] h-[66%] w-[10%] text-base-content" style="--needle: 34deg" fill="currentColor"><path d="M10 0 13 72a3 3 0 0 1-6 0Z"/><circle cx="10" cy="72" r="7"/></svg>
    </div>
    <div class="min-w-0">
      <p class="text-[15px] leading-tight font-bold">Bright, indirect</p>
      <p class="mt-0.5 text-[11px] text-base-content/60">2,400 lx · steady</p>
    </div>
  </div>
  <p class="mt-3 text-[10px] font-semibold tracking-wide text-base-content/60 uppercase">Happy here</p>
  <ul class="mt-1.5 space-y-1.5">
    {% assign happy = data.plants | where_exp: "plant", "plant.light != 'low'" %}{% for plant in happy limit: 2 %}
    <li class="flex items-center gap-2.5 rounded-2xl bg-base-200 p-1.5 pr-2.5">
      {% if plant.photo %}<img src="{{ plant.photo }}" class="size-7 shrink-0 rounded-full object-cover">{% else %}<span class="size-7 shrink-0 rounded-full bg-linear-to-br from-secondary to-accent"></span>{% endif %}
      <span class="min-w-0 flex-1 truncate text-[12px] font-semibold">{{ plant.name }}</span>
      <svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
    </li>
    {% endfor %}
  </ul>
</div>
