<section id="privacy" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.6fr] lg:gap-16">
      <div>
        <p class="kicker text-primary" data-reveal>Privacy</p>
        <h2 class="mt-4 text-[clamp(2.5rem,5vw,4rem)] text-balance" data-reveal>Your plants are <mark>nobody's</mark> business.</h2>
        <p class="mt-5 text-lg leading-relaxed text-pretty text-base-content/75" data-reveal>We make our money from Plus, so we never need to make it from you.</p>
        <a href="/privacy" class="btn btn-outline mt-8 h-12 border-base-300 px-6 text-base hover:border-base-content hover:bg-base-content hover:text-base-100" data-reveal>Read the privacy page</a>
      </div>
      {% assign promises = data["privacy-points"] | where: "kind", "never" %}
      <ul class="grid gap-4 sm:grid-cols-3">
        {% for point in promises limit: 3 %}
        <li class="flex flex-col rounded-box p-6 {% cycle 'bg-secondary text-secondary-content', 'bg-accent text-accent-content', 'bg-base-200' %}" data-reveal>
          <span class="grid size-11 place-items-center rounded-full bg-base-100 text-primary" aria-hidden="true">
            {% case forloop.index %}
            {% when 1 %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            {% when 2 %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.7 5.1A10.7 10.7 0 0 1 12 5c7 0 10 7 10 7a13.2 13.2 0 0 1-1.7 2.7"/><path d="M6.6 6.6A13.5 13.5 0 0 0 2 12s3 7 10 7a9.7 9.7 0 0 0 5.4-1.6"/><path d="M14.1 14.1a3 3 0 1 1-4.2-4.2"/><path d="m2 2 20 20"/></svg>
            {% else %}<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg>
            {% endcase %}
          </span>
          <h3 class="mt-6 text-[1.5rem]">{{ point.title }}</h3>
          {% if point.text %}<p class="mt-2 text-[0.9375rem] leading-relaxed text-pretty opacity-80">{{ point.text }}</p>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
