<section id="features" class="scroll-mt-24 bg-base-200 text-base-content">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <div class="max-w-2xl">
      <p class="kicker text-primary" data-reveal>Features</p>
      <h2 class="mt-4 text-[clamp(2.5rem,5.5vw,4.5rem)] text-balance" data-reveal>Small tools that keep <mark>a jungle</mark> alive.</h2>
    </div>
    <ul class="mt-12 grid gap-4 md:grid-cols-3">
      {% for feature in data["home-features"] %}
      <li class="lift flex flex-col overflow-hidden rounded-box bg-base-100 soft-shadow {% if feature.size == "wide" %}md:col-span-2{% endif %}" data-reveal>
        <div class="relative grid h-52 place-items-center overflow-hidden bg-linear-to-br {% cycle 'from-secondary/60 to-base-200', 'from-accent/50 to-base-200', 'from-base-200 to-secondary/50' %}" aria-hidden="true">
          {% case feature.visual %}
          {% when "reminders" %}
          <div class="w-[min(22rem,84%)] space-y-2.5">
            <div class="flex items-center gap-3 rounded-2xl bg-base-100/90 p-3 text-[13px] soft-shadow backdrop-blur"><span class="grid size-8 shrink-0 place-items-center rounded-xl bg-primary text-primary-content"><svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5s7 7.1 7 12a7 7 0 0 1-14 0c0-4.9 7-12 7-12Z"/></svg></span><span class="min-w-0 flex-1"><b class="block">Pearl can wait</b><span class="block truncate text-base-content/65">Cloudy all week: moved to Thursday</span></span><span class="text-[11px] text-base-content/50">now</span></div>
            <div class="ml-6 flex items-center gap-3 rounded-2xl bg-base-100/70 p-3 text-[13px] backdrop-blur"><span class="grid size-8 shrink-0 place-items-center rounded-xl bg-accent"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span><span class="min-w-0 flex-1"><b class="block">Heat on Saturday</b><span class="block truncate text-base-content/65">Bram gets an extra drink</span></span></div>
          </div>
          {% when "light" %}
          <div class="relative w-44">
            <svg viewBox="0 0 200 112" class="w-full" fill="none" stroke-linecap="round" stroke="currentColor"><path d="M16 104a84 84 0 0 1 168 0" stroke-width="16" class="text-base-100"/><path d="M16 104a84 84 0 0 1 42-72.7" stroke-width="16" class="text-accent"/><path d="M62 29a84 84 0 0 1 76 0" stroke-width="16" class="text-secondary"/><path d="M142 31.3a84 84 0 0 1 42 72.7" stroke-width="16" class="text-primary"/></svg>
            <svg viewBox="0 0 20 80" class="needle needle-sway absolute bottom-[7%] left-1/2 -ml-[5%] h-[66%] w-[10%] text-base-content" fill="currentColor"><path d="M10 0 13 72a3 3 0 0 1-6 0Z"/><circle cx="10" cy="72" r="7"/></svg>
            <p class="numeral mt-2 text-center text-2xl">2,400 <span class="text-base text-base-content/60">lx</span></p>
          </div>
          {% when "identify" %}
          <div class="relative size-36 overflow-hidden rounded-3xl soft-shadow">
            <img src="/media/plant-pothos.jpg" class="size-full object-cover">
            <span class="absolute inset-3"><span class="absolute top-0 left-0 size-5 rounded-tl-lg border-t-[3px] border-l-[3px] border-base-100"></span><span class="absolute top-0 right-0 size-5 rounded-tr-lg border-t-[3px] border-r-[3px] border-base-100"></span><span class="absolute bottom-0 left-0 size-5 rounded-bl-lg border-b-[3px] border-l-[3px] border-base-100"></span><span class="absolute right-0 bottom-0 size-5 rounded-br-lg border-r-[3px] border-b-[3px] border-base-100"></span></span>
            <span class="scan-line scan-sweep"></span>
          </div>
          <span class="absolute bottom-5 rounded-full bg-base-100 px-3 py-1 text-[13px] font-semibold soft-shadow">Golden pothos · 96%</span>
          {% when "household" %}
          <div class="flex flex-col items-center gap-4">
            <div class="flex">
              <span class="grid size-14 place-items-center rounded-full bg-secondary text-lg font-bold ring-4 ring-base-100">S</span>
              <span class="-ml-3 grid size-14 place-items-center rounded-full bg-accent text-lg font-bold ring-4 ring-base-100">A</span>
              <span class="-ml-3 grid size-14 place-items-center rounded-full bg-primary text-lg font-bold text-primary-content ring-4 ring-base-100">J</span>
              <span class="-ml-3 grid size-14 place-items-center rounded-full bg-base-100 text-lg font-bold ring-4 ring-base-100">+2</span>
            </div>
            <span class="rounded-full bg-base-100 px-4 py-1.5 text-[13px] font-semibold soft-shadow"><b>Ana</b> watered Fig · 2 h ago</span>
          </div>
          {% when "vacation" %}
          <div class="w-[min(20rem,84%)] rounded-2xl bg-base-100/90 p-4 soft-shadow">
            <p class="flex justify-between text-[13px] font-bold"><span>August</span><span class="text-primary">Ana covers</span></p>
            <ol class="mt-3 grid grid-cols-7 gap-y-1.5 text-center text-[12px] font-semibold tabular-nums">
              {% for d in (10..23) %}<li class="py-1 {% if d >= 12 and d <= 19 %}bg-secondary {% if d == 12 %}rounded-l-full{% elsif d == 19 %}rounded-r-full{% endif %}{% else %}text-base-content/50{% endif %}">{{ d }}</li>{% endfor %}
            </ol>
          </div>
          {% when "widgets" %}
          <div class="grid w-40 grid-cols-3 gap-2 rounded-[1.75rem] bg-base-100/90 p-3.5 soft-shadow">
            <p class="col-span-3 text-[12px] font-bold">Today · 3 plants</p>
            <span class="ring" style="--fill: 1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
            <span class="ring" style="--fill: 0.36"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5s7 7.1 7 12a7 7 0 0 1-14 0c0-4.9 7-12 7-12Z"/></svg></span>
            <span class="ring" style="--fill: 0.12"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5s7 7.1 7 12a7 7 0 0 1-14 0c0-4.9 7-12 7-12Z"/></svg></span>
          </div>
          {% endcase %}
        </div>
        <div class="p-6 md:p-7">
          <h3 class="text-[1.625rem]">{{ feature.title }}</h3>
          {% if feature.text %}<p class="mt-2 max-w-lg leading-relaxed text-pretty text-base-content/70">{{ feature.text }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
