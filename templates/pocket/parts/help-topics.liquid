<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-5xl space-y-16 px-5 py-16 md:px-8 md:py-24">
    {% assign topics = data["help-articles"] | map: "topic" | compact | uniq %}
    {% for topic in topics %}
    {% assign articles = data["help-articles"] | where: "topic", topic %}
    <div id="topic-{{ topic | downcase | replace: " ", "-" }}" class="scroll-mt-28 grid gap-6 md:grid-cols-[14rem_1fr] md:gap-10">
      <div data-reveal>
        <h2 class="text-[2rem]">{{ topic }}</h2>
        <p class="mt-2 text-[0.9375rem] text-base-content/60">{{ articles.size }} article{% if articles.size != 1 %}s{% endif %}</p>
      </div>
      <ul class="grid gap-3">
        {% for article in articles %}
        <li data-reveal>
          <a href="/help/{{ article.id }}" class="lift group flex items-center gap-5 rounded-box border border-base-300 bg-base-100 p-5 md:p-6">
            <span class="min-w-0 flex-1">
              <span class="block text-[1.1875rem] font-semibold group-hover:text-primary">{{ article.title }}</span>
              {% if article.summary %}<span class="mt-1 block text-pretty text-base-content/70">{{ article.summary }}</span>{% endif %}
            </span>
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-base-200 transition-colors group-hover:bg-primary group-hover:text-primary-content" aria-hidden="true"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg></span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</section>
