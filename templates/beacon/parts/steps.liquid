<section id="how-it-works" class="border-y border-base-300 bg-base-200/40 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="font-mono text-[0.6875rem] tracking-[0.08em] text-primary uppercase" data-reveal>How it works</p>
        <h2 class="mt-5 text-[clamp(2.25rem,5.5vw,4.5rem)] leading-[1.02] tracking-tight" data-reveal>{% for step in data["home-steps"] %}{{ step.verb }}{% unless forloop.last %} {% endunless %}{% endfor %}</h2>
      </div>
      <p class="max-w-md leading-relaxed text-pretty text-base-content/70 md:col-span-5 md:justify-self-end" data-reveal>Five minutes from an address to a monitor that only speaks up when it should. No agent to install, no dashboard to keep open.</p>
    </div>
    <div class="relative mt-14 md:mt-20">
    <div class="absolute top-[0.875rem] right-0 left-0 hidden h-px bg-base-300 md:block" aria-hidden="true"></div>
    <ol class="relative grid gap-10 md:grid-cols-3 md:gap-8">
      {% for step in data["home-steps"] %}
      <li class="relative" data-reveal>
        <p class="grid size-7 place-items-center rounded-full border border-primary/60 bg-base-100 font-mono text-[0.625rem] text-primary">0{{ forloop.index }}</p>
        <h3 class="mt-6 text-xl tracking-tight md:text-2xl"><span class="text-primary">{{ step.verb }}</span> {{ step.title }}</h3>
        <p class="mt-3 leading-relaxed text-pretty text-base-content/70">{{ step.text }}</p>
        {% if step.example %}<p class="mt-5 inline-block max-w-full truncate rounded-field border border-base-300 bg-base-100 px-3 py-1.5 font-mono text-[0.75rem] text-base-content/80">{{ step.example }}</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
    </div>
  </div>
</section>
