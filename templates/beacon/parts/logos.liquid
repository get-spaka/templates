<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-6xl px-5 pb-16 md:px-8 md:pb-20">
    <p class="text-center font-mono text-[0.6875rem] tracking-[0.08em] text-base-content/50 uppercase" data-reveal>In the beta at</p>
    <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 text-base-content/55 md:gap-x-16" data-reveal>
      {% for logo in data["home-logos"] %}
      {% assign style = forloop.index0 | modulo: 4 %}
      <li class="transition-colors hover:text-base-content">
        {% if logo.logo %}<img src="{{ logo.logo }}" class="h-7 w-auto opacity-70 grayscale">{% else %}<span class="whitespace-nowrap {% if style == 0 %}text-xl font-semibold tracking-tight{% elsif style == 1 %}font-mono text-base font-medium tracking-[-0.04em] lowercase{% elsif style == 2 %}text-lg font-light tracking-[0.18em] uppercase{% else %}text-xl font-bold tracking-[-0.06em]{% endif %}">{{ logo.name }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
