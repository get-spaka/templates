<header class="sticky top-0 z-30 border-b border-base-300 bg-base-100/80 text-base-content backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-5 md:px-8">
    <a href="/" class="flex items-center gap-2.5 whitespace-nowrap">
      <svg class="size-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10.25" opacity="0.45"/><circle cx="12" cy="12" r="6.25" opacity="0.75"/><circle cx="12" cy="12" r="2.25" fill="currentColor" stroke="none"/></svg>
      <span class="text-[1.0625rem] font-medium tracking-tight">Nightjar</span>
    </a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-sm text-base-content/70">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
        <li><a href="{{ item.href }}" class="transition-colors hover:text-base-content {% if page.url == item.href %}text-base-content{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/#waitlist" class="btn btn-primary btn-sm font-medium">Join the waitlist</a>
      <div class="dropdown dropdown-end lg:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-square btn-sm" aria-label="Open menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h16"/></svg>
        </div>
        <ul tabindex="0" class="menu dropdown-content z-40 mt-3 w-56 rounded-box border border-base-300 bg-base-200 p-2">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
          <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</header>
