<section id="features" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="max-w-3xl">
      <p class="font-mono text-[0.6875rem] tracking-[0.08em] text-primary uppercase" data-reveal>Fig. 01–06 · What it does</p>
      <h2 class="mt-5 text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] tracking-tight text-balance" data-reveal>Everything you need at 3 am. <span class="text-base-content/45">Nothing you don't.</span></h2>
    </div>
    <ul class="mt-12 grid gap-4 md:mt-16 md:grid-cols-2 lg:grid-cols-12">
      {% for feature in data.features %}
      <li class="flex flex-col rounded-box border border-base-300 bg-base-200/60 p-6 md:p-8 {% if feature.wide %}md:col-span-2 lg:col-span-6 sm:grid sm:grid-cols-[minmax(0,1fr)_auto] sm:grid-rows-[auto_1fr] sm:gap-x-8{% else %}lg:col-span-3{% endif %}" data-glow data-reveal>
          <p class="font-mono text-[0.6875rem] tracking-[0.08em] text-base-content/50 uppercase">{{ feature.label }}</p>
          <div class="beacon-figure my-8 flex-1 {% if feature.wide %}sm:col-start-2 sm:row-span-2 sm:row-start-1 sm:my-0 sm:self-center sm:pl-4{% endif %}" aria-hidden="true">
            {% case feature.figure %}
            {% when "rings" %}
            <svg class="h-24 w-auto {% if feature.wide %}md:h-32{% endif %}" viewBox="0 0 120 120" fill="none" stroke="currentColor"><circle cx="60" cy="60" r="56"/><circle cx="60" cy="60" r="40"/><circle cx="60" cy="60" r="24"/><path class="lit" d="M60 4a56 56 0 0 1 48.5 28" stroke-width="2" stroke-linecap="round"/><circle class="lit" cx="60" cy="60" r="4" fill="currentColor" stroke="none"/><circle class="lit" cx="88" cy="40" r="3" fill="currentColor" stroke="none"/><circle cx="30" cy="78" r="2.5" fill="currentColor" stroke="none"/><circle cx="74" cy="92" r="2.5" fill="currentColor" stroke="none"/></svg>
            {% when "nodes" %}
            <svg class="h-24 w-auto {% if feature.wide %}md:h-32{% endif %}" viewBox="0 0 200 120" fill="none" stroke="currentColor"><path d="M40 24 100 60M40 96l60-36M160 20l-60 40M160 100l-60-40M100 60h60M16 60h84"/><circle cx="40" cy="24" r="6" fill="currentColor"/><circle cx="40" cy="96" r="6" fill="currentColor"/><circle cx="160" cy="20" r="6" fill="currentColor"/><circle cx="160" cy="100" r="6" fill="currentColor"/><circle cx="16" cy="60" r="6" fill="currentColor"/><circle cx="176" cy="60" r="6" fill="currentColor"/><circle class="lit" cx="100" cy="60" r="18"/><circle class="lit" cx="100" cy="60" r="9" fill="currentColor" stroke="none"/></svg>
            {% when "wave" %}
            <svg class="h-20 w-full max-w-60" viewBox="0 0 240 80" fill="none" stroke="currentColor"><path d="M0 40h240" stroke-dasharray="2 6"/><path class="lit" d="M0 40h52l8-22 10 44 8-34 6 12h66l8-22 10 44 8-34 6 12h66" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>
            {% when "stack" %}
            <svg class="h-24 w-auto" viewBox="0 0 160 110" fill="none" stroke="currentColor"><rect x="20" y="70" width="120" height="30" rx="6"/><rect x="12" y="42" width="136" height="30" rx="6" fill="var(--color-base-200)"/><rect class="lit" x="4" y="10" width="152" height="34" rx="6" fill="var(--color-base-200)" stroke-width="1.5"/><circle class="lit" cx="22" cy="27" r="5" fill="currentColor" stroke="none"/><path class="lit" d="M36 27h56" stroke-width="2" stroke-linecap="round"/></svg>
            {% when "grid" %}
            <svg class="h-24 w-auto" viewBox="0 0 168 104" fill="currentColor"><g opacity="0.9"><rect x="0" y="0" width="20" height="20" rx="3"/><rect x="28" y="0" width="20" height="20" rx="3"/><rect x="56" y="0" width="20" height="20" rx="3"/><rect x="84" y="0" width="20" height="20" rx="3"/><rect x="112" y="0" width="20" height="20" rx="3"/><rect x="140" y="0" width="20" height="20" rx="3"/><rect x="0" y="28" width="20" height="20" rx="3"/><rect x="28" y="28" width="20" height="20" rx="3"/><rect x="56" y="28" width="20" height="20" rx="3"/><rect class="lit" x="84" y="28" width="20" height="20" rx="3"/><rect x="112" y="28" width="20" height="20" rx="3"/><rect x="140" y="28" width="20" height="20" rx="3"/><rect x="0" y="56" width="20" height="20" rx="3"/><rect x="28" y="56" width="20" height="20" rx="3"/><rect x="56" y="56" width="20" height="20" rx="3"/><rect x="84" y="56" width="20" height="20" rx="3"/><rect x="112" y="56" width="20" height="20" rx="3"/><rect x="140" y="56" width="20" height="20" rx="3"/><rect x="0" y="84" width="20" height="20" rx="3"/><rect x="28" y="84" width="20" height="20" rx="3"/><rect class="lit" x="56" y="84" width="20" height="20" rx="3"/><rect x="84" y="84" width="20" height="20" rx="3"/><rect x="112" y="84" width="20" height="20" rx="3"/><rect x="140" y="84" width="20" height="20" rx="3"/></g></svg>
            {% else %}
            <svg class="h-24 w-auto" viewBox="0 0 172 100" fill="currentColor"><rect x="0" y="52" width="14" height="48" rx="2"/><rect x="22" y="40" width="14" height="60" rx="2"/><rect x="44" y="58" width="14" height="42" rx="2"/><rect x="66" y="30" width="14" height="70" rx="2"/><rect class="lit" x="88" y="6" width="14" height="94" rx="2"/><rect x="110" y="48" width="14" height="52" rx="2"/><rect x="132" y="36" width="14" height="64" rx="2"/><rect x="154" y="54" width="14" height="46" rx="2"/></svg>
            {% endcase %}
          </div>
        <div class="{% if feature.wide %}sm:col-start-1 sm:row-start-2 sm:mt-16 sm:max-w-sm sm:self-end{% endif %}">
          <h3 class="text-xl leading-snug tracking-tight text-balance md:text-[1.375rem]">{{ feature.title }}</h3>
          <p class="mt-3 leading-relaxed text-pretty text-base-content/70">{{ feature.text }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
