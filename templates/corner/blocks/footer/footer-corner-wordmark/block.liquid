<footer class="overflow-hidden bg-neutral text-neutral-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 pt-16 md:grid-cols-4 md:px-8 md:pt-20">
    <div>
      <p class="font-mono text-xs tracking-[0.25em] uppercase text-neutral-content/60">Find us</p>
      <address class="mt-4 not-italic">214 Marlow Street<br>Between the library and the tram depot<br><a href="tel:+15550142019" class="link-hover">+1 555 014 2019</a></address>
    </div>
    <div>
      <p class="font-mono text-xs tracking-[0.25em] uppercase text-neutral-content/60">Open</p>
      <p class="mt-4">Tuesday to Saturday, 7 am – 7 pm<br>Sunday, 8 am – 2 pm<br>Closed on Mondays</p>
    </div>
    <nav aria-label="Footer">
      <p class="font-mono text-xs tracking-[0.25em] uppercase text-neutral-content/60">Pages</p>
      <ul class="mt-4 space-y-1">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "footer" %}
        <li><a href="{{ item.href }}" class="link-hover">{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div>
      <p class="font-mono text-xs tracking-[0.25em] uppercase text-neutral-content/60">Follow</p>
      <ul class="mt-4 space-y-1">
        {% for item in data.navigation %}{% if item.place == "social" %}
        <li><a href="{{ item.href }}" class="link-hover">{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </div>
  </div>
  <p class="mt-16 px-3 text-center text-[23vw] leading-[0.78] font-extrabold tracking-tighter whitespace-nowrap uppercase md:mt-20" aria-hidden="true">Marlow St.</p>
  <p class="mx-auto max-w-7xl px-5 py-6 font-mono text-xs tracking-widest uppercase text-neutral-content/60 md:px-8">© 2026 Marlow Street Bakery</p>
</footer>
