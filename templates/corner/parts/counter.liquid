<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div data-reveal>
        <p class="font-mono text-xs tracking-[0.25em] uppercase text-base-content/70">On the counter today</p>
        <h2 class="mt-4 text-5xl leading-[0.9] font-extrabold uppercase md:text-7xl">Fresh from<br><em>the oven.</em></h2>
      </div>
      <a href="/menu" class="btn btn-outline self-start sm:self-auto" data-reveal>See the whole menu</a>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 md:gap-x-6 md:gap-y-12 lg:grid-cols-3">
      {% assign featured = data.menu | where: "featured" %}
      {% for item in featured limit: 6 %}
      <li class="group" data-reveal>
        <div class="aspect-[4/5] overflow-hidden rounded-box bg-base-200">
          {% if item.image %}<img src="{{ item.image }}" class="size-full object-cover transition duration-700 group-hover:scale-105">{% else %}<div class="size-full bg-linear-to-br from-primary/25 to-accent/40"></div>{% endif %}
        </div>
        <div class="mt-4 flex flex-col gap-1 border-b border-base-300 pb-3 sm:mt-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <h3 class="text-lg leading-tight font-extrabold uppercase sm:text-2xl">{{ item.name }}</h3>
          {% if item.price %}<span class="font-mono tabular-nums sm:text-lg">{{ item.price }}</span>{% endif %}
        </div>
        {% if item.description %}<p class="mt-3 text-sm text-pretty text-base-content/75 sm:text-base">{{ item.description }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
