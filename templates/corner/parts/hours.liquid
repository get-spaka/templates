<section class="bg-primary text-primary-content">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-12 md:gap-10 md:px-8 md:py-24">
    <div class="md:col-span-5">
      <p class="font-mono text-xs tracking-[0.25em] uppercase text-primary-content/75" data-reveal>Visit us</p>
      <h2 class="mt-4 text-5xl leading-[0.9] font-extrabold uppercase md:text-6xl" data-reveal>Come <em>early,</em> the rye goes first.</h2>
      <p class="mt-8 inline-flex items-center gap-3 rounded-full bg-accent px-4 py-2 font-mono text-sm text-accent-content" data-open-now data-open="Open now · until {time}" data-later="Opens today at {time}" data-next="Opens {day} at {time}" data-reveal>
        <span class="size-2 shrink-0 rounded-full bg-success" aria-hidden="true"></span>
        <span data-open-now-text>Open Tuesday to Sunday from 7 am</span>
      </p>
      <address class="mt-10 space-y-1 text-lg not-italic" data-reveal>
        <span class="block text-2xl font-extrabold uppercase">214 Marlow Street</span>
        <span class="block text-primary-content/80">Between the library and the old tram depot</span>
        <a href="tel:+15550142019" class="block font-mono text-primary-content/80 link-hover">+1 555 014 2019</a>
      </address>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        <a href="https://maps.google.com/?q=214+Marlow+Street" class="btn btn-accent">Get directions</a>
        <a href="/visit#order" class="btn btn-ghost border-primary-content/40 text-primary-content">Order ahead</a>
      </div>
    </div>
    <ul class="divide-y divide-primary-content/20 border-y border-primary-content/20 md:col-span-7" data-reveal>
      {% for item in data.hours %}
      <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-1 py-4 md:py-5" data-hours-row data-weekday="{{ item.weekday }}" data-opens="{{ item.opens }}" data-closes="{{ item.closes }}" data-day="{{ item.day }}">
        <span class="text-2xl font-extrabold uppercase md:text-4xl">{{ item.day }}</span>
        <span class="font-mono text-base tabular-nums md:text-lg">{{ item.hours }}</span>
        {% if item.note %}<span class="col-span-2 font-mono text-xs tracking-widest uppercase text-primary-content/65">{{ item.note }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
