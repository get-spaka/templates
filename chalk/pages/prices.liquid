<!doctype html>
<html lang="en">
<head>
<title>Prices and memberships — Holdfast Bouldering</title>
<meta name="description" content="No joining fee, and shoes included for members. Memberships from $49 a month, a day pass for $22, a ten-visit card and a $29 first visit with an intro.">
<meta property="og:title" content="Prices and memberships — Holdfast Bouldering">
<meta property="og:description" content="No joining fee, and shoes included for members. Memberships from $49 a month, a day pass for $22, a ten-visit card and a $29 first visit with an intro.">
</head>
<body data-line>
{% render 'header' %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="wrap pt-14 pb-16 lg:pt-20 lg:pb-20">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="warning" data-shape="1" style="--turn: 15" aria-hidden="true"></span>
      <span class="tape">Start</span>
      <h1 class="mt-6 max-w-5xl text-[clamp(2.5rem,7vw,6rem)] uppercase">No joining fee. Shoes included for members.</h1>
    </div>
    <p class="mt-8 max-w-2xl text-lg text-pretty md:text-xl" data-reveal>Climb once, ten times or every day. Every price below includes the whole gym: the walls, the training room and the yoga room.</p>
  </div>
</section>

{% render 'prices-board' %}

<section id="perks" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="success" data-shape="3" style="--turn: -15" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/70">What members get</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">More than the wall</h2>
      </div>
    </div>
    <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4" data-bolt>
      {% for perk in data["prices-perks"] %}
      <li class="border-t-2 border-base-300 pt-6">
        <span class="hold" data-tone="{% cycle 'warning', 'success', 'info', 'primary' %}" data-shape="{% cycle 'shape': '2', '4', '1', '3' %}" style="--hold-size: 2.5rem; --turn: {% cycle 'turn': '20', '-15', '35', '-30' %}" aria-hidden="true"></span>
        <h3 class="mt-5 text-xl">{{ perk.title }}</h3>
        <p class="mt-3 text-pretty text-base-content/80">{{ perk.text }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section id="join" class="scroll-mt-24 ply text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="right" data-tone="primary" data-shape="2" style="--turn: 25" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/75">Start a membership</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Join the wall</h2>
      </div>
    </div>
    <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-10">
      <form hx-post="/_data/memberships" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#membership-problems swap:innerHTML" class="flex flex-col gap-6 rounded-box bg-base-100 p-5 sm:p-8 lg:col-span-8 lg:p-10">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Membership</legend>
          <div class="flex flex-wrap gap-2">
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="plan" value="Monthly" class="sr-only" checked>Monthly</label>
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="plan" value="Annual" class="sr-only">Annual</label>
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="plan" value="Student" class="sr-only">Student</label>
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="plan" value="Youth" class="sr-only">Youth</label>
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="plan" value="Family add-on" class="sr-only">Family add-on</label>
          </div>
        </fieldset>
        <div class="grid gap-x-4 gap-y-2 sm:grid-cols-2">
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Start date</legend>
            <input name="start" type="date" class="input w-full">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Climbed here before?</legend>
            <select name="climbed_here" class="select w-full">
              <option>Yes</option>
              <option selected>Not yet</option>
            </select>
          </fieldset>
          <fieldset class="fieldset sm:col-span-2">
            <legend class="fieldset-legend">Your name</legend>
            <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Your email</legend>
            <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Your phone <span class="font-normal text-base-content/70">(optional)</span></legend>
            <input name="phone" type="tel" class="input w-full" maxlength="30" autocomplete="tel">
          </fieldset>
          <fieldset class="fieldset sm:col-span-2">
            <legend class="fieldset-legend">Anything we should know <span class="font-normal text-base-content/70">(optional)</span></legend>
            <textarea name="note" class="textarea w-full rounded-box" rows="3" maxlength="2000" placeholder="A student ID, a family member to add, a question."></textarea>
          </fieldset>
        </div>
        <div id="membership-problems" class="empty:hidden"></div>
        <div class="flex flex-col gap-4 border-t-2 border-base-300 pt-6 sm:flex-row sm:items-center">
          <button type="submit" class="btn btn-primary btn-lg whitespace-nowrap">Send the request</button>
          <p class="text-sm text-pretty text-base-content/70">Nothing to pay now. We write back, and you start at the desk with an ID.</p>
        </div>
      </form>
      <aside class="flex flex-col gap-8 lg:col-span-4" data-reveal>
        <div>
          <h3 class="text-xl">At the desk</h3>
          <p class="mt-3 text-pretty">A membership starts at the desk, with an ID and your first payment. It takes five minutes, and you can climb straight after.</p>
        </div>
        <div>
          <h3 class="text-xl">Desk hours</h3>
          <p class="mt-3">Monday to Friday, 6 am to 10 pm<br>Weekends, 8 am to 9 pm</p>
          <p class="mt-3"><a href="tel:+14235550148" class="link">(423) 555-0148</a></p>
        </div>
      </aside>
    </div>
  </div>
</section>

<section id="questions" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:gap-8 lg:py-28">
    <div class="relative lg:col-span-4">
      <span data-hold class="stop hold" data-side="left" data-tone="info" data-shape="4" style="--turn: 10" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/70">Questions</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,3.5rem)] uppercase">The fine print</h2>
      </div>
    </div>
    <div class="lg:col-span-7 lg:col-start-6" data-reveal>
      {% for item in data["prices-faq"] %}
      <details class="collapse collapse-plus rounded-none border-b-2 border-base-300" {% if forloop.first %}open{% endif %}>
        <summary class="collapse-title text-lg font-semibold">{{ item.question }}</summary>
        <div class="collapse-content px-0 text-pretty text-base-content/80 [&_p]:mt-2">{{ item.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
