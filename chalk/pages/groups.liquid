<!doctype html>
<html lang="en">
<head>
<title>Kids and groups — Holdfast Bouldering</title>
<meta name="description" content="A Saturday kids' club, a youth team, birthday parties for up to twelve, and coached sessions for schools, scouts and teams, in Chattanooga.">
<meta property="og:title" content="Kids and groups — Holdfast Bouldering">
<meta property="og:description" content="A Saturday kids' club, a youth team, birthday parties for up to twelve, and coached sessions for schools, scouts and teams, in Chattanooga.">
</head>
<body data-line>
{% render 'header' %}
<main>
<section class="bg-accent text-accent-content">
  <div class="wrap grid gap-10 pt-14 pb-16 lg:grid-cols-12 lg:items-end lg:gap-8 lg:pt-20 lg:pb-24">
    <div class="relative lg:col-span-7">
      <span data-hold class="stop hold" data-side="left" data-tone="warning" data-shape="1" style="--turn: 15" aria-hidden="true"></span>
      <span class="tape">Start</span>
      <h1 class="mt-6 text-[clamp(3rem,10vw,8rem)] uppercase">Bring the crew</h1>
    </div>
    <div class="lg:col-span-5" data-reveal>
      <p class="text-lg text-pretty md:text-xl">From six-year-olds on the Kids' Corner to the whole office on the Comp Wall: a coach, the right wall and the long table afterward.</p>
      <a href="#ask" class="btn btn-neutral mt-8 whitespace-nowrap">Ask about a group</a>
    </div>
  </div>
</section>

<section id="programs" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="right" data-tone="info" data-shape="2" style="--turn: -20" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/70">The programs</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Something for every age</h2>
      </div>
    </div>
    <ol class="mt-12 flex flex-col gap-16 lg:mt-20 lg:gap-24">
      {% for program in data.programs %}
      <li id="{{ program.id }}" data-tone="{{ program.tone }}" class="grid scroll-mt-24 gap-8 md:grid-cols-12 md:items-center lg:gap-12">
        <div class="md:col-span-6 {% cycle 'order': '', 'md:order-2' %}" data-reveal>
          {% if program.image %}<img src="{{ program.image }}" data-grade class="volume-{% cycle 'v': '1', '2', '3', '4', '2' %} aspect-[4/3] w-full object-cover">{% else %}<div class="volume-1 aspect-[4/3] w-full bg-base-200"></div>{% endif %}
        </div>
        <div class="md:col-span-6 lg:col-span-5 {% cycle 'start': 'lg:col-start-8', '' %}" data-reveal>
          <span class="hold" data-shape="{% cycle 'shape': '3', '1', '4', '2', '1' %}" style="--hold-size: 2.75rem; --turn: 20" aria-hidden="true"></span>
          <h3 class="mt-5 text-3xl lg:text-4xl">{{ program.name }}</h3>
          <p class="mt-4 text-lg text-pretty text-base-content/80">{{ program.summary }}</p>
          <dl class="mono mt-6 grid grid-cols-[auto_1fr] gap-x-5 gap-y-1">
            <dt class="text-base-content/70">Ages</dt><dd>{{ program.ages }}</dd>
            <dt class="text-base-content/70">When</dt><dd>{{ program.when }}</dd>
            <dt class="text-base-content/70">Price</dt><dd>{{ program.price }}</dd>
          </dl>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section id="party" class="scroll-mt-24 bg-secondary text-secondary-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="primary" data-shape="4" style="--turn: 30" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono">How a party goes</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Ninety minutes, start to top</h2>
      </div>
    </div>
    <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-8">
      {% for step in data["groups-steps"] %}
      <li class="border-t-2 border-secondary-content/30 pt-6" data-reveal>
        <p class="numeral text-5xl">{{ forloop.index }}</p>
        <h3 class="mt-5 text-xl">{{ step.title }}</h3>
        <p class="mt-3 text-pretty text-secondary-content/85">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section id="ask" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="right" data-tone="success" data-shape="1" style="--turn: -10" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/70">Ask about a group</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Tell us who's coming</h2>
      </div>
    </div>
    <div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-10">
      <form hx-post="/_data/group-inquiries" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#group-problems swap:innerHTML" class="flex flex-col gap-6 rounded-box border-2 border-base-300 p-5 sm:p-8 lg:col-span-8 lg:p-10">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">What it's for</legend>
          <div class="flex flex-wrap gap-2">
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="kind" value="Birthday party" class="sr-only" checked>Birthday party</label>
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="kind" value="School or scouts" class="sr-only">School or scouts</label>
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="kind" value="Team event" class="sr-only">Team event</label>
            <label class="inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-4 py-2.5 font-medium has-checked:border-primary has-checked:bg-primary has-checked:text-primary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="kind" value="Other" class="sr-only">Other</label>
          </div>
        </fieldset>
        <div class="grid gap-x-4 gap-y-2 sm:grid-cols-3">
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Date</legend>
            <input name="date" type="date" class="input w-full">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">How many</legend>
            <input name="size" type="number" min="1" max="200" class="input w-full">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Ages</legend>
            <input name="ages" type="text" maxlength="60" placeholder="8 to 10" class="input w-full">
          </fieldset>
        </div>
        <div class="grid gap-x-4 gap-y-2 sm:grid-cols-2">
          <fieldset class="fieldset sm:col-span-2">
            <legend class="fieldset-legend">Your name</legend>
            <input name="name" type="text" class="input w-full" required maxlength="200" autocomplete="name">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Your email</legend>
            <input name="email" type="email" class="input w-full" required maxlength="200" autocomplete="email">
          </fieldset>
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Your phone <span class="font-normal text-base-content/70">(optional)</span></legend>
            <input name="phone" type="tel" class="input w-full" maxlength="30" autocomplete="tel">
          </fieldset>
          <fieldset class="fieldset sm:col-span-2">
            <legend class="fieldset-legend">Tell us more <span class="font-normal text-base-content/70">(optional)</span></legend>
            <textarea name="message" class="textarea w-full rounded-box" rows="4" maxlength="4000" placeholder="The occasion, the time of day that suits you, anything we should plan for."></textarea>
          </fieldset>
        </div>
        <div id="group-problems" class="empty:hidden"></div>
        <div class="flex flex-col gap-4 border-t-2 border-base-300 pt-6 sm:flex-row sm:items-center">
          <button type="submit" class="btn btn-primary btn-lg whitespace-nowrap">Send the request</button>
          <p class="text-sm text-pretty text-base-content/70">We write back within two days with a date and a price. Nothing is paid until the day.</p>
        </div>
      </form>
      <aside class="lg:col-span-4" data-reveal>
        <h3 class="text-xl">Rather talk?</h3>
        <p class="mt-3 text-pretty">Will plans the parties and the school visits. Call the desk on <a href="tel:+14235550148" class="link whitespace-nowrap">(423) 555-0148</a> and ask for him.</p>
      </aside>
    </div>
  </div>
</section>

<section id="rules" class="scroll-mt-24 bg-base-200 text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="error" data-shape="3" style="--turn: -25" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/75">The rules for kids</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Good to know</h2>
      </div>
    </div>
    <dl class="mt-12 grid gap-4 md:grid-cols-3 lg:mt-16 lg:gap-6">
      {% for item in data["groups-faq"] %}
      <div class="rounded-box bg-base-100 p-6 lg:p-8" data-reveal>
        <dt class="display text-lg font-bold">{{ item.question }}</dt>
        <dd class="mt-3 text-pretty text-base-content/80 [&_p]:mt-2">{{ item.answer }}</dd>
      </div>
      {% endfor %}
    </dl>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
