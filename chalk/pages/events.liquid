<!doctype html>
<html lang="en">
<head>
<title>Events — Holdfast Bouldering</title>
<meta name="description" content="The Ironside Throwdown, reset nights, day trips to the boulders at Stone Fort and film nights at the Chalkboard.">
<meta property="og:title" content="Events — Holdfast Bouldering">
<meta property="og:description" content="The Ironside Throwdown, reset nights, day trips to the boulders at Stone Fort and film nights at the Chalkboard.">
</head>
<body data-line>
{% render 'header' %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="wrap pt-14 pb-12 lg:pt-20 lg:pb-16">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="warning" data-shape="1" style="--turn: 15" aria-hidden="true"></span>
      <span class="tape">Start</span>
      <h1 class="mt-6 max-w-5xl text-[clamp(2.5rem,7vw,6rem)] uppercase">Comps, trips and nights at the wall</h1>
    </div>
    <p class="mt-8 max-w-2xl text-lg text-pretty md:text-xl" data-reveal>A reset night every few weeks, a day on real rock each month, and once a winter the whole gym turns out for the Ironside Throwdown.</p>
  </div>
</section>

{% assign next = data.events.first %}
{% if next %}
{% case next.kind %}{% when "comp" %}{% assign tone = "error" %}{% when "trip" %}{% assign tone = "success" %}{% when "night" %}{% assign tone = "primary" %}{% when "film" %}{% assign tone = "info" %}{% else %}{% assign tone = "warning" %}{% endcase %}
<section class="ply text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="right" data-tone="success" data-shape="3" style="--turn: 25" aria-hidden="true"></span>
      <p class="mono text-base-content/75" data-reveal>Next up</p>
    </div>
    <a href="/events/{{ next.id }}" class="group mt-8 grid gap-8 rounded-box bg-base-100 p-5 sm:p-6 md:grid-cols-12 md:items-center lg:gap-10 lg:p-8" data-reveal>
      <div class="md:col-span-6">
        {% if next.cover %}<img src="{{ next.cover }}" data-grade class="volume-1 aspect-[4/3] w-full object-cover">{% else %}<div class="volume-1 aspect-[4/3] w-full bg-base-200"></div>{% endif %}
      </div>
      <div class="md:col-span-6">
        <div class="flex items-center gap-5">
          <span class="hold" data-tone="{{ tone }}" data-shape="4" style="--hold-size: 5.5rem; --turn: -10"><span class="numeral text-3xl">{{ next.date | date: "%-d" }}</span></span>
          <p class="mono">{{ next.date | date: "%A, %B %-d" }}<br>{{ next.time }}</p>
        </div>
        <h2 class="mt-6 text-[clamp(2rem,4.5vw,3.5rem)] uppercase hyphens-auto underline-offset-8 group-hover:underline">{{ next.title }}</h2>
        <p class="mt-4 text-lg text-pretty text-base-content/80">{{ next.summary }}</p>
        <p class="mono mt-5 text-base-content/75">{{ next.price }}</p>
        <span class="btn btn-primary mt-6 whitespace-nowrap">Details and sign-up</span>
      </div>
    </a>
  </div>
</section>
{% endif %}

<section class="bg-base-100 text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="info" data-shape="2" style="--turn: -20" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/70">After that</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">On the calendar</h2>
      </div>
    </div>
    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3 lg:gap-6">
      {% for event in data.events offset: 1 %}
      {% case event.kind %}{% when "comp" %}{% assign tone = "error" %}{% when "trip" %}{% assign tone = "success" %}{% when "night" %}{% assign tone = "primary" %}{% when "film" %}{% assign tone = "info" %}{% else %}{% assign tone = "warning" %}{% endcase %}
      <li data-reveal>
        <a href="/events/{{ event.id }}" class="group flex h-full flex-col rounded-box border-2 border-base-300 bg-base-100 p-5">
          {% if event.cover %}<img src="{{ event.cover }}" data-grade class="volume-{% cycle '2', '4', '3' %} aspect-[4/3] w-full object-cover">{% else %}<div class="volume-2 aspect-[4/3] w-full bg-base-200"></div>{% endif %}
          <div class="mt-6 flex items-center gap-4">
            <span class="hold" data-tone="{{ tone }}" data-shape="{% cycle 'shape': '1', '2', '4' %}" style="--hold-size: 3.5rem; --turn: 15"><span class="numeral text-xl">{{ event.date | date: "%-d" }}</span></span>
            <p class="mono text-base-content/75">{{ event.date | date: "%a %b %-d" }}<br>{{ event.time }}</p>
          </div>
          <h3 class="display mt-5 text-xl leading-tight font-bold underline-offset-4 group-hover:underline">{{ event.title }}</h3>
          <p class="mt-3 text-pretty text-base-content/80">{{ event.summary }}</p>
          <p class="mono mt-auto pt-5 text-base-content/75">{{ event.price }}</p>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
</main>
{% render 'footer' %}
</body>
</html>
