<!doctype html>
<html lang="en">
<head>
<title>The walls — Holdfast Bouldering</title>
<meta name="description" content="Six walls from a 75° slab to a 140° cave, 180 problems from VB to V10 in six color circuits, and one wall reset every Friday.">
<meta property="og:title" content="The walls — Holdfast Bouldering">
<meta property="og:description" content="Six walls from a 75° slab to a 140° cave, 180 problems from VB to V10 in six color circuits, and one wall reset every Friday.">
</head>
<body data-line>
{% render 'header' %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="wrap pt-14 pb-12 lg:pt-20 lg:pb-16">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="warning" data-shape="1" style="--turn: 15" aria-hidden="true"></span>
      <span class="tape">Start</span>
      <h1 class="mt-6 max-w-5xl text-[clamp(2.5rem,7vw,6rem)] uppercase">Six walls, 180 problems, one new set a week</h1>
    </div>
    <p class="mt-8 max-w-2xl text-lg text-pretty md:text-xl" data-reveal>Fourteen thousand square feet of fifteen-foot walls in a stove foundry from 1912. Every Friday one wall comes down and goes back up with new problems.</p>
  </div>
</section>

<section id="walls" class="scroll-mt-24 ply text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="right" data-tone="success" data-shape="3" style="--turn: 20" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/75">The walls in section</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">From slab to cave</h2>
      </div>
    </div>
    <ol class="mt-12 flex flex-col gap-6 lg:mt-16">
      {% for wall in data.walls %}{% assign feet = wall.height | split: " " | first %}
      <li id="{{ wall.id }}" class="grid scroll-mt-24 gap-6 rounded-box bg-base-100 p-5 sm:p-6 md:grid-cols-12 md:items-center lg:gap-8 lg:p-8" data-reveal>
        <div class="walls-drawing walls-drawing-one md:col-span-3" data-walls aria-hidden="true">
          <div class="wall-bay">
            <span class="wall-mat"></span>
            <span class="wall-profile" data-angle="{{ wall.angle }}" style="--angle: {{ wall.angle }}; --feet: {{ feet }}"></span>
          </div>
        </div>
        <div class="md:col-span-4">
          {% if wall.image %}<img src="{{ wall.image }}" data-grade class="volume-{% cycle '2', '4', '1', '3' %} aspect-[4/3] w-full object-cover">{% else %}<div class="volume-2 aspect-[4/3] w-full bg-base-200"></div>{% endif %}
        </div>
        <div class="md:col-span-5">
          <p class="numeral text-4xl lg:text-5xl">{{ wall.angle }}°</p>
          <h3 class="mt-3 text-2xl lg:text-3xl">{{ wall.name }}</h3>
          <p class="mt-1 font-semibold">{{ wall.style }}</p>
          <p class="mt-3 text-pretty text-base-content/80">{{ wall.summary }}</p>
          <dl class="mono mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
            <dt class="text-base-content/70">Height</dt><dd>{{ wall.height }}</dd>
            <dt class="text-base-content/70">Problems</dt><dd>{{ wall.problems }}</dd>
            <dt class="text-base-content/70">Last set</dt><dd><time datetime="{{ wall.last_reset }}" data-since>{{ wall.last_reset | date: "%b %-d" }}</time></dd>
            <dt class="text-base-content/70">Comes down</dt><dd><time datetime="{{ wall.next_reset }}" data-until>{{ wall.next_reset | date: "%b %-d" }}</time></dd>
          </dl>
        </div>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section id="set" class="scroll-mt-24 bg-base-100 text-base-content" data-set>
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="info" data-shape="2" style="--turn: -10" aria-hidden="true"></span>
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <div class="lg:col-span-7">
          <p class="mono text-base-content/70">The set</p>
          <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Every problem up now</h2>
        </div>
        <p class="text-lg text-pretty text-base-content/80 lg:col-span-5">Newest first, with the setter's one-line hint. Choose a color to see one circuit.</p>
      </div>
    </div>
    <fieldset class="mt-10 flex flex-wrap gap-2" data-reveal>
      <legend class="sr-only">Show one circuit</legend>
      <label class="mono inline-flex cursor-pointer items-center gap-2 rounded-field border-2 border-base-300 px-3.5 py-2 whitespace-nowrap has-checked:border-base-content has-checked:bg-base-content has-checked:text-base-100 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="circuit" value="all" class="sr-only" checked>All</label>
      {% for circuit in data.circuits %}
      <label data-tone="{{ circuit.tone }}" class="mono inline-flex cursor-pointer items-center gap-2 rounded-field border-2 border-base-300 px-3.5 py-2 whitespace-nowrap has-checked:border-base-content has-checked:bg-base-content has-checked:text-base-100 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="circuit" value="{{ circuit.tone }}" class="sr-only"><span class="hold" data-shape="2" style="--hold-size: 1rem" aria-hidden="true"></span>{{ circuit.name }}</label>
      {% endfor %}
    </fieldset>
    <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {% for problem in data.problems %}
      <li data-problem data-tone="{{ problem.tone }}" class="hold-tag flex gap-4 rounded-box border-2 border-base-300 bg-base-100 p-4 lg:p-5">
        <span class="hold" data-shape="{% cycle 'shape': '1', '3', '2', '4' %}" style="--hold-size: 4rem; --turn: {% cycle 'turn': '-20', '15', '35', '-5', '25' %}"><span class="numeral text-lg">{{ problem.grade }}</span></span>
        <div class="min-w-0">
          <span data-new-slot></span>
          <h3 class="mt-1 text-lg leading-tight text-balance">{{ problem.name }}</h3>
          <p class="mono mt-2 text-base-content/70">{{ problem.wall }} · {{ problem.setter }}</p>
          <p class="mono mt-1 text-base-content/70"><time datetime="{{ problem.set_on }}" data-since data-new="New">Set {{ problem.set_on | date: "%b %-d" }}</time></p>
          {% if problem.note %}<p class="mt-3 text-pretty text-base-content/85">“{{ problem.note }}”</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section id="resets" class="scroll-mt-24 bg-base-200 text-base-content">
  <div class="wrap grid gap-12 py-20 lg:grid-cols-12 lg:gap-8 lg:py-28">
    <div class="relative lg:col-span-5">
      <span data-hold class="stop hold" data-side="left" data-tone="error" data-shape="4" style="--turn: 30" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/75">The reset calendar</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">What comes down next</h2>
        <p class="mt-6 text-lg text-pretty">One wall every Friday. The setters strip it in the morning and set it through the day; it opens again at six, or at nine on a reset night.</p>
      </div>
    </div>
    <ol class="border-t-2 border-base-content/20 lg:col-span-7" data-reveal>
      {% assign upcoming = data.walls | sort: "next_reset" %}
      {% for wall in upcoming %}
      {% assign night = nil %}{% for event in data.events %}{% if event.kind == "night" and event.date == wall.next_reset %}{% assign night = event %}{% endif %}{% endfor %}
      <li class="grid grid-cols-[5.5rem_1fr] items-baseline gap-4 border-b-2 border-base-content/20 py-5 sm:grid-cols-[8rem_1fr_auto]">
        <p class="mono">{{ wall.next_reset | date: "%a %b %-d" }}</p>
        <p class="display text-xl font-bold">{{ wall.name }}</p>
        {% if night %}<a href="/events/{{ night.id }}" class="link col-start-2 font-medium whitespace-nowrap sm:col-start-auto">Reset night <span aria-hidden="true">→</span></a>{% else %}<p class="mono col-start-2 text-base-content/70 sm:col-start-auto">Opens at 6 pm</p>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{% render 'circuits', side: 'right' %}
{% render 'setters' %}
</main>
{% render 'footer' %}
</body>
</html>
