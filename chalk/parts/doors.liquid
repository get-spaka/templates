<section class="bg-accent text-accent-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="primary" data-shape="3" style="--turn: -40" aria-hidden="true"></span>
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <div class="lg:col-span-8">
          <p class="mono">Kids &amp; groups</p>
          <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Bring the crew</h2>
        </div>
        <p class="text-lg text-pretty lg:col-span-4">A club for kids, a team for teens, and the whole wall for a birthday, a class or an office.</p>
      </div>
    </div>
    <ul class="mt-12 grid gap-4 md:grid-cols-3 lg:mt-16 lg:gap-6">
      <li>
        <a href="/groups#kids-club" class="group flex h-full flex-col rounded-box bg-base-100 p-6 text-base-content lg:p-8">
          <span class="flex h-16 items-end gap-1" data-bolt aria-hidden="true">
            <span class="hold" data-tone="warning" data-shape="1" style="--hold-size: 3.5rem; --turn: 10"></span>
            <span class="hold" data-tone="success" data-shape="3" style="--hold-size: 2.25rem; --turn: -20"></span>
            <span class="hold mb-6" data-tone="info" data-shape="2" style="--hold-size: 1.75rem; --turn: 30"></span>
          </span>
          <h3 class="mt-8 text-2xl">The Kids' Club</h3>
          <p class="mono mt-2 text-base-content/70">Ages 6 to 11 · Saturdays</p>
          <p class="mt-4 text-pretty text-base-content/80">Games and real climbing on the Kids' Corner, a coach for every six kids.</p>
          <span class="mt-auto pt-8 font-semibold underline-offset-4 group-hover:underline">Join the club <span aria-hidden="true">→</span></span>
        </a>
      </li>
      <li>
        <a href="/groups#birthday-parties" class="group flex h-full flex-col rounded-box bg-base-100 p-6 text-base-content lg:p-8">
          <span class="flex h-16 items-end gap-1" data-bolt aria-hidden="true">
            <span class="hold mb-4" data-tone="primary" data-shape="4" style="--hold-size: 2.5rem; --turn: -15"></span>
            <span class="hold" data-tone="error" data-shape="1" style="--hold-size: 3.5rem; --turn: 45"></span>
            <span class="hold mb-8" data-tone="warning" data-shape="3" style="--hold-size: 1.5rem; --turn: 5"></span>
          </span>
          <h3 class="mt-8 text-2xl">Birthday parties</h3>
          <p class="mono mt-2 text-base-content/70">Up to 12 kids · 90 minutes</p>
          <p class="mt-4 text-pretty text-base-content/80">A coach, the Kids' Corner, climbing games, then the long table for cake.</p>
          <span class="mt-auto pt-8 font-semibold underline-offset-4 group-hover:underline">Plan a party <span aria-hidden="true">→</span></span>
        </a>
      </li>
      <li>
        <a href="/groups#team-events" class="group flex h-full flex-col rounded-box bg-base-100 p-6 text-base-content lg:p-8">
          <span class="flex h-16 items-end gap-1" data-bolt aria-hidden="true">
            <span class="hold" data-tone="info" data-shape="2" style="--hold-size: 3rem; --turn: -35"></span>
            <span class="hold mb-6" data-tone="neutral" data-shape="4" style="--hold-size: 2rem; --turn: 20"></span>
            <span class="hold" data-tone="success" data-shape="1" style="--hold-size: 2.75rem; --turn: 60"></span>
          </span>
          <h3 class="mt-8 text-2xl">Teams and schools</h3>
          <p class="mono mt-2 text-base-content/70">Classes, scouts, offices</p>
          <p class="mt-4 text-pretty text-base-content/80">A coached session on trust and problem solving, and the café's long table after.</p>
          <span class="mt-auto pt-8 font-semibold underline-offset-4 group-hover:underline">Ask about a group <span aria-hidden="true">→</span></span>
        </a>
      </li>
    </ul>
  </div>
</section>
