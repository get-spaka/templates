<section class="bg-neutral text-neutral-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="right" data-tone="warning" data-shape="2" style="--turn: 5" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-neutral-content/70">Prices</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">No joining fee</h2>
      </div>
    </div>
    <ul class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8 lg:mt-16">
      {% for plan in data.plans %}{% if plan.featured %}
      <li class="border-t-2 border-neutral-content/25 pt-6" data-reveal>
        <p class="mono text-neutral-content/70">{{ plan.name }}</p>
        <p class="numeral mt-5 text-[clamp(3.5rem,9vw,6.5rem)]"><span class="mr-1 align-[0.35em] text-[0.45em]">$</span>{{ plan.price }}</p>
        <p class="display mt-3 text-xl font-bold">{{ plan.per }}</p>
        <p class="mt-3 max-w-xs text-pretty text-neutral-content/75">{{ plan.note }}</p>
      </li>
      {% endif %}{% endfor %}
    </ul>
    <div class="mt-14 flex flex-col gap-6 border-t-2 border-neutral-content/25 pt-8 md:flex-row md:items-center md:justify-between" data-reveal>
      <p class="text-lg text-pretty">No joining fee. Shoes included for members.</p>
      <a href="/prices" class="btn btn-secondary whitespace-nowrap">All prices</a>
    </div>
  </div>
</section>
