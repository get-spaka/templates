<section id="setters" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="left" data-tone="error" data-shape="4" style="--turn: -10" aria-hidden="true"></span>
      <div data-reveal>
        <p class="mono text-base-content/70">The setters</p>
        <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Who sets the walls</h2>
      </div>
    </div>
    <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 lg:mt-16 lg:grid-cols-4 lg:gap-x-8" data-bolt>
      {% for member in data.team %}{% if member.role == "setter" %}{% assign names = member.name | split: " " %}
      <li data-tone="{{ member.tone }}">
        {% if member.photo %}<img src="{{ member.photo }}" data-grade class="volume-{% cycle '1', '2', '3', '4' %} aspect-square w-full max-w-48 object-cover">{% else %}<span class="hold" data-shape="{% cycle 'shape': '1', '4', '2', '3' %}" style="--hold-size: clamp(6rem, 22vw, 8.5rem); --turn: {% cycle 'turn': '-10', '15', '30', '-25' %}" aria-hidden="true"><span class="display text-2xl font-extrabold lg:text-3xl">{{ names[0] | slice: 0 }}{{ names[1] | slice: 0 }}</span></span>{% endif %}
        <h3 class="mt-5 text-lg lg:text-xl">{{ member.name }}</h3>
        <p class="mono mt-1 text-base-content/70">{{ member.title }}</p>
        <p class="mt-3 text-pretty text-base-content/80">“{{ member.style }}”</p>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
