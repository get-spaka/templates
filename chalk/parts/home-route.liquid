<section class="bg-base-100 text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="right" data-tone="primary" data-shape="4" style="--turn: -25" aria-hidden="true"></span>
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <div class="lg:col-span-8">
          <p class="mono text-base-content/70">Your first visit</p>
          <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Never climbed? Good.</h2>
        </div>
        <p class="text-lg text-pretty text-base-content/80 lg:col-span-4">Four moves from the door to the wall. Nobody needs shoes, strength or a partner.</p>
      </div>
    </div>
    <div class="ply mt-12 rounded-box px-5 py-10 sm:px-8 lg:mt-16 lg:p-12">
      <ol class="grid gap-10 lg:auto-cols-fr lg:grid-flow-col lg:gap-8" data-line style="--n: {{ data['home-steps'].size }}">
        {% for step in data["home-steps"] %}
        <li class="relative z-[2] flex gap-5 lg:block" style="--i: {{ forloop.index0 }}">
          <div class="relative shrink-0 lg:h-[calc(var(--n)*3rem+0.5rem)]">
            <span data-hold class="hold lg:absolute lg:top-[calc(var(--i)*3rem)] lg:left-0" data-tone="{% cycle 'warning', 'success', 'info', 'primary', 'error', 'neutral' %}" data-shape="{% cycle 'shape': '1', '3', '2', '4' %}" style="--hold-size: 3.5rem"><span class="numeral text-xl">{{ forloop.index }}</span></span>
          </div>
          <div class="pt-2 lg:pt-6">
            <h3 class="text-xl leading-tight">{{ step.title }}</h3>
            <p class="mt-3 text-pretty">{{ step.text }}</p>
          </div>
        </li>
        {% endfor %}
      </ol>
      <div class="mt-12 flex flex-col gap-6 border-t-2 border-base-content/15 pt-8 lg:flex-row lg:items-center lg:justify-between">
        <p class="display text-2xl font-extrabold text-balance lg:text-3xl"><span class="numeral">$29</span>: the intro, the day pass and shoes</p>
        <a href="/first-visit#book" class="btn btn-primary btn-lg whitespace-nowrap">Book a first visit</a>
      </div>
    </div>
  </div>
</section>
