<section id="week" class="scroll-mt-24 bg-base-100 text-base-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="{{ side | default: 'right' }}" data-tone="info" data-shape="3" style="--turn: 30" aria-hidden="true"></span>
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <div class="lg:col-span-7">
          <p class="mono text-base-content/70">The week</p>
          <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Every class, every day</h2>
        </div>
        <p class="text-lg text-pretty text-base-content/80 lg:col-span-5">Colored by level, in the same colors as the circuits on the wall: start on the yellows and work your way up.</p>
      </div>
    </div>
    {% assign days = "Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday" | split: "," %}
    <div class="mt-12 lg:mt-16" data-week>
      <fieldset class="flex flex-wrap gap-2 lg:hidden">
        <legend class="sr-only">Choose a day</legend>
        {% for day in days %}
        <label class="mono inline-flex cursor-pointer items-center rounded-field border-2 border-base-300 px-3.5 py-2 transition-colors has-checked:border-base-content has-checked:bg-base-content has-checked:text-base-100 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary"><input type="radio" name="week-day" value="{{ day | downcase }}" class="sr-only" {% if forloop.first %}checked{% endif %}>{{ day | slice: 0, 3 }}</label>
        {% endfor %}
      </fieldset>
      <div class="mt-8 lg:mt-0 lg:grid lg:grid-cols-[3.5rem_repeat(7,minmax(0,1fr))] lg:gap-x-1.5">
        <div class="hidden lg:block" aria-hidden="true">
          <div class="h-10"></div>
          <div class="mono relative h-[calc(16*var(--hour))] text-base-content/60">
            <span class="absolute top-0 -translate-y-1/2">6 am</span>
            <span class="absolute top-[calc(2*var(--hour))] -translate-y-1/2">8 am</span>
            <span class="absolute top-[calc(4*var(--hour))] -translate-y-1/2">10 am</span>
            <span class="absolute top-[calc(6*var(--hour))] -translate-y-1/2">Noon</span>
            <span class="absolute top-[calc(8*var(--hour))] -translate-y-1/2">2 pm</span>
            <span class="absolute top-[calc(10*var(--hour))] -translate-y-1/2">4 pm</span>
            <span class="absolute top-[calc(12*var(--hour))] -translate-y-1/2">6 pm</span>
            <span class="absolute top-[calc(14*var(--hour))] -translate-y-1/2">8 pm</span>
            <span class="absolute top-[calc(16*var(--hour))] -translate-y-1/2">10 pm</span>
          </div>
        </div>
        {% for day in days %}
        <div class="week-day" data-day="{{ day | downcase }}">
          <h3 class="week-head text-xl lg:flex lg:h-10 lg:items-start lg:justify-center lg:text-sm">{{ day }}</h3>
          <ol class="week-hours mt-4 flex flex-col gap-2 lg:mt-0 lg:block">
            {% assign none = true %}
            {% for session in data.sessions %}{% if session.day == day %}{% assign none = false %}{% assign s = session.start | split: ":" %}{% assign e = session.end | split: ":" %}
            <li class="week-session rounded-box px-3 py-2.5 lg:px-2 lg:py-1.5" data-tone="{{ session.tone }}" style="--sh: {{ s[0] }}; --sm: {{ s[1] }}; --eh: {{ e[0] }}; --em: {{ e[1] }}">
              <p class="mono text-[0.6875rem] leading-tight">{% render 'clock', time: session.start %} – {% render 'clock', time: session.end %}</p>
              <p class="mt-0.5 font-semibold leading-tight lg:text-[0.8125rem]">{% if session.class != blank %}<a href="/classes/{{ session.class }}" class="underline-offset-2 hover:underline">{{ session.title }}</a>{% else %}{{ session.title }}{% endif %}</p>
              <p class="text-sm text-base-content/75 lg:sr-only">{{ session.coach }}</p>
            </li>
            {% endif %}{% endfor %}
            {% if none %}<li class="text-base-content/70 lg:hidden">No classes; the wall is open.</li>{% endif %}
          </ol>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
