<section class="ply overflow-x-clip text-base-content">
  <div class="wrap grid gap-14 pt-12 pb-16 md:pt-16 lg:grid-cols-12 lg:items-center lg:gap-8 lg:pt-20 lg:pb-24">
    <div class="lg:col-span-7">
      <p class="mono text-base-content/75" data-reveal>Bouldering on the Southside · Chattanooga</p>
      <h1 class="mt-6 text-[clamp(3.25rem,15vw,11rem)] font-black uppercase">Find<br>your<br>line.</h1>
      <p class="mt-8 max-w-xl text-lg text-pretty md:text-xl" data-reveal>Bouldering in an old stove foundry on Chattanooga's Southside: 180 problems, a new set every Friday, from your first VB to the Cave's V10.</p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal>
        <a href="/first-visit#book" class="btn btn-primary btn-lg whitespace-nowrap">Book a first visit</a>
        <a href="/walls" class="btn btn-lg btn-outline border-base-content whitespace-nowrap">See what's new</a>
      </div>
      <div class="relative mt-12 flex items-center gap-4" data-bolt="load">
        <span data-hold class="stop hold" data-side="left" data-tone="warning" data-shape="1" style="--turn: 15" aria-hidden="true"></span>
        <span class="tape">Start</span>
        <span class="mono text-base-content/75">Open today, 6 am to 10 pm</span>
      </div>
    </div>
    <div class="relative lg:col-span-5" data-bolt="load">
      <img src="/media/hero-climber.jpg" data-grade class="volume-1 aspect-[4/5] w-full object-cover">
      <span class="hold absolute top-[-1.5rem] left-[12%]" data-tone="error" data-shape="2" style="--hold-size: 3.25rem; --turn: 25" aria-hidden="true"></span>
      <span class="hold absolute top-[18%] right-[1%]" data-tone="info" data-shape="3" style="--hold-size: 2.5rem; --turn: -15" aria-hidden="true"></span>
      <span class="hold absolute top-[46%] left-[-0.75rem]" data-tone="success" data-shape="4" style="--hold-size: 2.75rem; --turn: 40" aria-hidden="true"></span>
      <span class="hold absolute top-[62%] right-[3%]" data-tone="primary" data-shape="1" style="--hold-size: 3.5rem; --turn: -30" aria-hidden="true"></span>
      <span class="hold absolute bottom-[-1.25rem] left-[30%]" data-tone="neutral" data-shape="2" style="--hold-size: 3rem; --turn: 10" aria-hidden="true"></span>
      <span class="hold absolute bottom-[8%] left-[6%]" data-tone="warning" data-shape="3" style="--hold-size: 2rem; --turn: -45" aria-hidden="true"></span>
      <span class="hold absolute top-[30%] left-[44%] hidden md:inline-grid" data-tone="error" data-shape="4" style="--hold-size: 1.75rem; --turn: 70" aria-hidden="true"></span>
    </div>
  </div>
</section>
