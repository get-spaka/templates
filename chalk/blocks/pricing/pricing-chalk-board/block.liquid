<section id="board" class="scroll-mt-24 bg-neutral text-neutral-content">
  <div class="wrap py-20 lg:py-28">
    <div class="relative">
      <span data-hold class="stop hold" data-side="right" data-tone="warning" data-shape="2" style="--turn: 5" aria-hidden="true"></span>
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
        <div class="lg:col-span-7">
          <p class="mono text-neutral-content/70">Memberships</p>
          <h2 class="mt-4 text-[clamp(2.25rem,6vw,4.5rem)] uppercase">Climb every day</h2>
        </div>
        <p class="text-lg text-pretty text-neutral-content/80 lg:col-span-5">Unlimited climbing, no joining fee and no contract longer than a month. Shoes are included for members.</p>
      </div>
    </div>
    <ul class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
      {% for plan in data.plans %}{% if plan.kind == "membership" %}
      <li class="border-t-2 border-neutral-content/25 pt-6" data-reveal>
        <p class="mono text-neutral-content/70">{{ plan.name }}</p>
        <p class="numeral mt-5 text-[clamp(3.5rem,9vw,6.5rem)]"><span class="mr-1 align-[0.35em] text-[0.45em]">$</span>{{ plan.price }}</p>
        <p class="display mt-3 text-xl font-bold">{{ plan.per }}</p>
        <p class="mt-3 max-w-xs text-pretty text-neutral-content/75">{{ plan.note }}</p>
      </li>
      {% endif %}{% endfor %}
    </ul>
    <div class="mt-20 grid gap-10 border-t-2 border-neutral-content/25 pt-12 lg:mt-24 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4" data-reveal>
        <h3 class="text-2xl">Passes and extras</h3>
        <p class="mt-4 text-pretty text-neutral-content/80">Pay as you climb. A day pass covers the whole day: go for lunch at the Chalkboard and come back.</p>
      </div>
      <ul class="lg:col-span-7 lg:col-start-6" data-reveal>
        {% for plan in data.plans %}{% if plan.kind == "pass" %}
        <li class="border-b-2 border-neutral-content/15 py-4 first:pt-0">
          <div class="flex items-baseline gap-3">
            <span class="display text-lg font-bold">{{ plan.name }}</span>
            <span class="leader" aria-hidden="true"></span>
            <span class="numeral text-2xl">${{ plan.price }}</span>
          </div>
          <p class="mt-1 flex flex-wrap justify-between gap-x-4 text-neutral-content/70"><span>{{ plan.note }}</span><span class="mono">{{ plan.per }}</span></p>
        </li>
        {% endif %}{% endfor %}
      </ul>
    </div>
  </div>
</section>
