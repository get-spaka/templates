<section class="overflow-hidden bg-base-100 pb-16 text-base-content md:pb-24" aria-label="Selected images">
  <div class="overflow-x-auto" data-strip-track>
  <ul class="flex w-max" data-strip>
    {% for item in data.strip %}
    <li class="shrink-0 pr-3 md:pr-4">
      <figure>
        {% if item.image %}<img src="{{ item.image }}" class="h-56 w-auto object-cover md:h-80">{% else %}<div class="h-56 w-72 bg-base-300 md:h-80 md:w-96"></div>{% endif %}
        <figcaption class="mt-2 font-mono text-[0.65rem] tracking-[0.12em] uppercase text-base-content/60">{{ item.caption }}</figcaption>
      </figure>
    </li>
    {% endfor %}
  </ul>
  </div>
</section>
