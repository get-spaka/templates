<section class="bg-base-100 text-base-content" id="index">
  <div class="mx-auto max-w-[96rem] px-5 pb-16 md:px-10 md:pb-28">
    <div class="flex items-end justify-between gap-6 border-b border-base-content pb-4" data-reveal>
      <h2 class="text-sm font-medium">Selected work</h2>
      <p class="hidden font-mono text-[0.65rem] tracking-[0.12em] uppercase text-base-content/60 sm:block">Category · Place · Year</p>
    </div>
    {% assign rows = data.projects | where: "featured" %}
    <ol data-index>
      {% for item in rows %}
      <li>
        <a href="/work/{{ item.id }}" class="group grid grid-cols-[2.5rem_1fr_auto] items-center gap-x-4 gap-y-1 border-b border-base-300 py-4 transition-colors hover:text-primary lg:grid-cols-[4rem_1fr_10rem_12rem_4rem_5rem] md:py-6" data-index-row data-image="{{ item.cover }}" data-id="{{ item.id }}">
          <span class="font-mono text-xs text-base-content/60 group-hover:text-primary">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <span class="text-2xl font-light tracking-tight md:text-4xl">{{ item.title }}</span>
          <span class="col-start-2 font-mono text-[0.65rem] tracking-[0.12em] uppercase text-base-content/60 md:text-xs lg:col-start-auto">{{ item.category }}</span>
          <span class="hidden font-mono text-xs tracking-[0.12em] uppercase text-base-content/60 lg:block">{{ item.location }}</span>
          <span class="hidden font-mono text-xs text-base-content/60 lg:block">{{ item.year }}</span>
          {% if item.cover %}<img src="{{ item.cover }}" class="col-start-3 row-span-2 row-start-1 aspect-[4/3] w-20 object-cover lg:col-start-auto lg:row-span-1 lg:row-start-auto lg:justify-self-end" data-thumb style="view-transition-name: project-{{ item.id }}">{% endif %}
        </a>
      </li>
      {% endfor %}
    </ol>
    <a href="/work" class="mt-8 inline-flex items-center gap-2 text-sm link-hover hover:text-primary" data-reveal>All work <span aria-hidden="true">→</span></a>
  </div>
</section>
