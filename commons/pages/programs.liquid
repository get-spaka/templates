<!doctype html>
<html lang="en">
<head>
<title>Programs — Bread &amp; Bolts</title>
<meta name="description" content="The Tool Library, the Repair Café, the Porch Pantry, the Winter Swap and the Lot: when each is open, where, and who it is for.">
<meta property="og:title" content="Programs — Bread &amp; Bolts">
<meta property="og:description" content="The Tool Library, the Repair Café, the Porch Pantry, the Winter Swap and the Lot: when each is open, where, and who it is for.">
</head>
<body>
{% render 'header' %}
<main>
  <section class="bg-base-100 text-base-content">
    <div class="mx-auto grid max-w-[80rem] gap-8 px-5 pt-16 pb-14 md:px-8 lg:grid-cols-12 lg:items-end lg:pt-24 lg:pb-20" data-reveal>
      <h1 class="page-title lg:col-span-8">Five ways in</h1>
      <div class="lg:col-span-4">
        <p class="text-lg text-base-content/80">Everything we run on the North End, and when. Most of it is free, and none of it asks you to prove anything.</p>
        <p class="mt-5 text-lg font-semibold">Not sure where to start? Come by the porch, or call us at <a href="tel:+15635550141" class="ink-link whitespace-nowrap">(563) 555-0141</a>.</p>
      </div>
    </div>
  </section>
  <section class="bg-base-100 text-base-content">
    <div class="mx-auto max-w-[80rem] space-y-6 px-5 pb-24 md:px-8 lg:space-y-8">
      {% for program in data.programs %}
      <article id="{{ program.id }}" class="grid overflow-hidden rounded-box lg:grid-cols-2" data-tone="{{ program.tone }}" data-reveal>
        <div class="overflow-hidden {% cycle '', 'lg:order-2' %}" data-torn="{% cycle 'bottom', 'bottom' %}" data-tear="{{ forloop.index0 | modulo: 3 | plus: 1 }}">
          {% if program.cover %}<img src="{{ program.cover }}" class="aspect-[4/3] size-full object-cover lg:aspect-auto lg:min-h-[26rem]">{% endif %}
        </div>
        <div class="flex flex-col px-6 pt-6 pb-8 md:px-10 md:py-10">
          <h2 class="text-4xl md:text-6xl">{{ program.name }}</h2>
          <p class="mt-4 text-xl">{{ program.tagline }}</p>
          <dl class="mt-8 grid gap-x-6 gap-y-4 sm:grid-cols-[auto_1fr]">
            <dt class="kicker pt-1">When</dt><dd class="font-semibold">{{ program.when }}</dd>
            <dt class="kicker pt-1">Where</dt><dd class="font-semibold">{{ program.where }}</dd>
            <dt class="kicker pt-1">Who it's for</dt><dd class="font-semibold">{{ program.who }}</dd>
          </dl>
          <a href="/programs/{{ program.id }}" class="mt-auto self-start pt-8 text-lg font-semibold"><span class="ink-link">More about it</span> →</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
</main>
{% render 'footer' %}
</body>
</html>
