<!doctype html>
<html lang="en">
<head>
<title>Events — Bread &amp; Bolts</title>
<meta name="description" content="What's coming up at the shed on Couler Lane: the Winter Swap, the Repair Café, volunteer orientations, the Long Table supper and the seed swap.">
<meta property="og:title" content="Events — Bread &amp; Bolts">
<meta property="og:description" content="What's coming up at the shed on Couler Lane: the Winter Swap, the Repair Café, volunteer orientations, the Long Table supper and the seed swap.">
</head>
<body>
{% render 'header' %}
<main>
  <section class="bg-base-100 text-base-content">
    <div class="mx-auto grid max-w-[80rem] gap-8 px-5 pt-16 pb-16 md:px-8 lg:grid-cols-12 lg:items-end lg:pt-24 lg:pb-24" data-reveal>
      <h1 class="page-title lg:col-span-8">On the porch</h1>
      <p class="text-lg text-base-content/80 lg:col-span-4">Everything coming up at the shed and on the Lot. Most of it is free; save a spot so we know how much soup to make.</p>
    </div>
  </section>
  <section class="bg-secondary text-secondary-content" data-torn="both" data-tear="3">
    <div class="mx-auto max-w-[80rem] px-5 py-24 md:px-8 lg:py-28">
      {% assign current = "" %}
      {% for event in data.events %}
      {% assign month = event.date | date: "%B %Y" %}
      {% if month != current %}
      {% unless forloop.first %}</div>{% endunless %}
      <h2 class="flex items-baseline gap-4 border-b-2 border-secondary-content pb-3 text-4xl md:text-5xl {% unless forloop.first %}mt-20{% endunless %}" data-reveal>{{ event.date | date: "%B" }} <span class="kicker">{{ event.date | date: "%Y" }}</span></h2>
      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {% assign current = month %}
      {% endif %}
      {% render 'notice', event: event, tear: forloop.index %}
      {% if forloop.last %}</div>{% endif %}
      {% endfor %}
    </div>
  </section>
</main>
{% render 'footer' %}
</body>
</html>
