<!doctype html>
<html lang="en">
<head>
<title>{{ record.title }}, {{ record.date | date: "%B %-d" }} — Bread &amp; Bolts</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.title }}, {{ record.date | date: "%B %-d" }} — Bread &amp; Bolts">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header' %}
<main>
  <article class="bg-base-100 text-base-content">
    <div class="mx-auto grid max-w-[80rem] gap-12 px-5 pt-14 pb-20 md:px-8 lg:grid-cols-12 lg:pt-20 lg:pb-28">
      <div class="lg:col-span-7">
        <div data-reveal>
          <p class="kicker"><a href="/events" class="ink-link">Events</a> · {{ record.kind }}</p>
          <h1 class="page-title mt-5">{{ record.title }}</h1>
          <p class="mt-6 text-xl md:text-2xl">{{ record.summary }}</p>
        </div>
        {% if record.cover %}<div class="mt-10 overflow-hidden rounded-t-box" data-torn="bottom" data-tear="2" data-reveal><img src="{{ record.cover }}" class="aspect-[3/2] w-full object-cover"></div>{% endif %}
        <div class="story-text mt-10" data-reveal>{{ record.body }}</div>
      </div>
      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-28">
          <div class="rounded-b-box px-6 pt-10 pb-8 md:px-8" data-tone="sky" data-torn="top" data-tear="1" data-reveal>
            <div class="flex items-start justify-between gap-4">
              <p class="figure text-[7rem] md:text-[8.5rem]">{{ record.date | date: "%-d" }}</p>
              <p class="kicker pt-3 text-right">{{ record.date | date: "%B" }}<br>{{ record.date | date: "%A" }}</p>
            </div>
            {% if record.also != blank %}<p class="mt-2 font-semibold">{{ record.also }}</p>{% endif %}
            <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-5 gap-y-2">
              <dt class="kicker pt-0.5">Time</dt><dd class="font-semibold tabular-nums">{{ record.start }} – {{ record.end }}</dd>
              <dt class="kicker pt-0.5">Where</dt><dd class="font-semibold">{{ record.place }}</dd>
              <dt class="kicker pt-0.5">Cost</dt><dd class="font-semibold">{% if record.price != blank %}{{ record.price }}{% else %}<span class="free kicker">Free</span>{% endif %}</dd>
            </dl>
          </div>
          <div id="spot" class="mt-6 scroll-mt-28 rounded-box border-2 border-base-content p-6 md:p-8" data-reveal>
            <h2 class="text-3xl md:text-4xl">Save a spot</h2>
            <p class="mt-2 text-base-content/80">So we know how many chairs, fixers and bowls of soup to set out.</p>
            <form hx-post="/_data/rsvps" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#rsvp-problems swap:innerHTML" class="mt-6 flex flex-col gap-4">
              <input type="hidden" name="event" value="{{ record.title }}">
              <input type="hidden" name="date" value="{{ record.date | date: '%B %-d, %Y' }}">
              <label class="flex flex-col gap-2">
                <span class="font-semibold">Your name</span>
                <input name="name" required maxlength="120" autocomplete="name" class="input w-full">
              </label>
              <label class="flex flex-col gap-2">
                <span class="font-semibold">Your email</span>
                <input name="email" type="email" required maxlength="200" autocomplete="email" class="input w-full">
              </label>
              <label class="flex flex-col gap-2">
                <span class="font-semibold">How many of you</span>
                <input name="people" type="number" min="1" max="20" value="1" required class="input w-28">
              </label>
              <div id="rsvp-problems" class="empty:hidden"></div>
              <button class="btn btn-primary self-start">Save my spot</button>
            </form>
          </div>
        </div>
      </aside>
    </div>
  </article>
  <section class="bg-base-200 text-base-content">
    <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <h2 class="text-5xl md:text-6xl">Also on the board</h2>
        <a href="/events" class="ink-link text-lg font-semibold">All events →</a>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {% assign shown = 0 %}
        {% for event in data.events %}{% if event.id != record.id and shown < 3 %}{% assign shown = shown | plus: 1 %}
        {% render 'notice', event: event, tear: shown %}
        {% endif %}{% endfor %}
      </div>
    </div>
  </section>
</main>
{% render 'footer' %}
</body>
</html>
