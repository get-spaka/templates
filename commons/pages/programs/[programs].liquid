{%- assign next = data.programs | first -%}
{%- assign found = false -%}
{%- for program in data.programs -%}
  {%- if found -%}{%- assign next = program -%}{%- break -%}{%- endif -%}
  {%- if program.id == record.id -%}{%- assign found = true -%}{%- endif -%}
{%- endfor -%}
{%- assign story = data.stories | where: "program", record.id | first -%}
{%- assign event = data.events | where: "program", record.id | first -%}
<!doctype html>
<html lang="en">
<head>
<title>{{ record.name }} — Bread &amp; Bolts</title>
<meta name="description" content="{{ record.summary }}">
<meta property="og:title" content="{{ record.name }} — Bread &amp; Bolts">
<meta property="og:description" content="{{ record.summary }}">
</head>
<body>
{% render 'header' %}
<main>
  <section data-tone="{{ record.tone }}">
    <div class="mx-auto grid max-w-[80rem] gap-10 px-5 pt-14 pb-16 md:px-8 lg:grid-cols-12 lg:pt-20 lg:pb-24">
      <div class="lg:col-span-7" data-reveal>
        <p class="kicker"><a href="/programs" class="ink-link">Programs</a></p>
        <h1 class="page-title mt-5">{{ record.name }}</h1>
        <p class="mt-6 max-w-xl text-xl md:text-2xl">{{ record.tagline }}</p>
      </div>
      <dl class="grid content-end gap-x-6 gap-y-4 sm:grid-cols-[auto_1fr] lg:col-span-5" data-reveal>
        <dt class="kicker pt-1">When</dt><dd class="text-lg font-semibold">{{ record.when }}</dd>
        <dt class="kicker pt-1">Where</dt><dd class="text-lg font-semibold">{{ record.where }}</dd>
        <dt class="kicker pt-1">Who it's for</dt><dd class="text-lg font-semibold">{{ record.who }}</dd>
        <dt class="kicker pt-1">What it costs</dt><dd class="text-lg font-semibold">{{ record.cost }}</dd>
      </dl>
    </div>
  </section>
  <section class="bg-base-100 text-base-content">
    <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-16 md:px-8 lg:grid-cols-12 lg:py-24">
      <div class="lg:col-span-6" data-reveal>
        {% if record.cover %}<div class="overflow-hidden rounded-t-box" data-torn="bottom" data-tear="2"><img src="{{ record.cover }}" class="aspect-[4/5] w-full object-cover"></div>{% endif %}
      </div>
      <div class="lg:col-span-6">
        <div class="story-text" data-reveal>{{ record.body }}</div>
        {% if record.image %}<div class="mt-12 overflow-hidden rounded-t-box" data-torn="bottom" data-tear="3" data-reveal><img src="{{ record.image }}" class="aspect-[3/2] w-full object-cover"></div>{% endif %}
      </div>
    </div>
  </section>
  {% if record.steps.size > 0 %}
  <section class="bg-base-200 text-base-content">
    <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 lg:py-24">
      <div data-reveal>
        <p class="kicker text-base-content/70">Step by step</p>
        <h2 class="mt-4 text-5xl md:text-6xl">How it works</h2>
      </div>
      <ol class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {% for step in record.steps %}
        <li class="flex gap-5 lg:flex-col" data-reveal>
          <span class="figure grid size-20 shrink-0 place-items-center pt-2 text-5xl" data-tone="{{ record.tone }}" data-torn="both" data-tear="{{ forloop.index0 | modulo: 3 | plus: 1 }}" style="--tear: 0.4rem; --tear-tile: 5rem">{{ forloop.index }}</span>
          <p class="pt-2 text-lg font-semibold lg:pt-0">{{ step }}</p>
        </li>
        {% endfor %}
      </ol>
    </div>
  </section>
  {% endif %}
  <section class="bg-base-100 text-base-content">
    <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-20 md:px-8 lg:grid-cols-12 lg:py-28">
      {% if record.figure != blank %}
      <div class="lg:col-span-5" data-reveal>
        <div class="rounded-b-box px-6 pt-10 pb-8 md:px-8" data-tone="{{ record.tone }}" data-torn="top" data-tear="3">
          <p class="figure text-[clamp(4rem,9vw,7.5rem)]">{{ record.figure }}</p>
          <p class="mt-4 text-xl font-semibold">{{ record.figure_label }}</p>
        </div>
      </div>
      {% endif %}
      {% if story %}
      <figure class="lg:col-span-7" data-reveal>
        <span class="quote-mark text-8xl" aria-hidden="true">“</span>
        <blockquote class="font-heading text-[clamp(1.6rem,3vw,2.5rem)] leading-[1.12] font-semibold tracking-[-0.02em]">{{ story.quote }}</blockquote>
        <figcaption class="mt-6 text-lg"><span class="font-bold">{{ story.name }}</span>, {{ story.detail }}</figcaption>
      </figure>
      {% endif %}
    </div>
  </section>
  {% if event %}
  <section class="bg-secondary text-secondary-content" data-torn="both" data-tear="2">
    <div class="mx-auto grid max-w-[80rem] items-center gap-10 px-5 py-24 md:px-8 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="kicker">On the noticeboard</p>
        <h2 class="mt-4 text-5xl md:text-6xl">Next time</h2>
        <a href="/events" class="ink-link mt-6 inline-block text-lg font-semibold">Everything on the porch →</a>
      </div>
      <div class="max-w-md lg:col-span-5 lg:col-start-8">{% render 'notice', event: event, tear: 2 %}</div>
    </div>
  </section>
  {% endif %}
  <section class="bg-base-100 text-base-content">
    <div class="mx-auto flex max-w-[80rem] flex-wrap items-center justify-between gap-6 px-5 py-16 md:px-8">
      <p class="font-heading text-3xl font-bold tracking-[-0.02em] md:text-4xl">Want to help run it?</p>
      <a href="/volunteer#form" class="btn btn-primary btn-lg btn-wrap">Volunteer here</a>
    </div>
  </section>
  {% if next.id != record.id %}
  <a href="/programs/{{ next.id }}" class="group block" data-tone="{{ next.tone }}" data-torn="top" data-tear="1">
    <div class="mx-auto flex max-w-[80rem] flex-wrap items-end justify-between gap-4 px-5 pt-16 pb-14 md:px-8">
      <p><span class="kicker block">Next</span><span class="mt-3 block font-heading text-5xl font-extrabold tracking-[-0.03em] md:text-7xl">{{ next.name }}</span></p>
      <span class="door-arrow text-6xl transition-[translate] group-hover:translate-x-3 motion-reduce:transition-none md:text-8xl" aria-hidden="true">→</span>
    </div>
  </a>
  {% endif %}
</main>
{% render 'footer' %}
</body>
</html>
