<section data-tone="{{ record.tone }}">
  <div class="mx-auto grid max-w-[80rem] gap-10 px-5 pt-14 pb-16 md:px-8 lg:grid-cols-12 lg:pt-20 lg:pb-24">
    <div class="lg:col-span-7" data-reveal>
      <h1 class="page-title">{{ record.name }}</h1>
      <p class="mt-6 max-w-xl text-xl md:text-2xl">{{ record.tagline }}</p>
    </div>
    <dl class="grid content-end gap-x-6 gap-y-4 sm:grid-cols-[auto_1fr] lg:col-span-5" data-reveal>
      <dt class="kicker pt-1">When</dt><dd class="text-lg font-semibold">{{ record.when }}</dd>
      <dt class="kicker pt-1">Where</dt><dd class="text-lg font-semibold">{{ record.where }}</dd>
      <dt class="kicker pt-1">Who it's for</dt><dd class="text-lg font-semibold">{{ record.who }}</dd>
      <dt class="kicker pt-1">What it costs</dt><dd class="text-lg font-semibold">{{ record.cost }}</dd>
    </dl>
  </div>
</section>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-[80rem] gap-12 px-5 py-16 md:px-8 lg:grid-cols-12 lg:py-24">
    <div class="lg:col-span-6" data-reveal>
      {% if record.cover %}<div class="overflow-hidden rounded-t-box" data-torn="bottom" data-tear="2"><img src="{{ record.cover }}" class="aspect-[4/5] w-full object-cover"></div>{% else %}<div class="aspect-[4/5] w-full rounded-box bg-base-200"></div>{% endif %}
    </div>
    <div class="story-text lg:col-span-6" data-reveal>{{ record.body }}</div>
  </div>
</section>
