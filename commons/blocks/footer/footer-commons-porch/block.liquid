<footer class="site-footer bg-neutral text-neutral-content" data-torn="top" data-tear="2">
  <div class="mx-auto max-w-[80rem] px-5 pt-24 pb-12 md:px-8 md:pt-28">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <h2 class="poster">Come by the porch.</h2>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/give" class="btn btn-primary btn-lg">Donate</a>
          <a href="/volunteer#form" class="btn btn-lg btn-outline border-neutral-content text-neutral-content hover:bg-neutral-content hover:text-neutral">Volunteer</a>
        </div>
        <div class="mt-14 max-w-xl">
          <p class="kicker text-accent">The Porch Letter</p>
          <p class="mt-3 text-lg text-neutral-content/80">One short email on the first Monday of the month: what came in, what went out, and what the shed needs next.</p>
          <form hx-post="/_data/newsletter" hx-target="this" hx-swap="outerHTML" hx-status:422="target:#newsletter-problems swap:innerHTML" class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end">
            <label class="flex flex-col gap-1.5 sm:w-40">
              <span class="text-sm font-semibold">First name</span>
              <input name="name" autocomplete="given-name" maxlength="80" class="input w-full border-neutral-content/40 bg-neutral text-neutral-content">
            </label>
            <label class="flex flex-1 flex-col gap-1.5">
              <span class="text-sm font-semibold">Email</span>
              <input name="email" type="email" required autocomplete="email" maxlength="200" class="input w-full border-neutral-content/40 bg-neutral text-neutral-content">
            </label>
            <button class="btn btn-accent">Sign me up</button>
          </form>
          <div id="newsletter-problems" class="mt-3 empty:hidden"></div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <article class="notice max-w-md lg:ml-auto" data-tone="marigold">
          <div class="notice-sheet px-6 pb-7 md:px-8" data-torn="top" data-tear="3">
            <p class="kicker">The shed</p>
            <address class="mt-3 font-heading text-3xl leading-tight font-bold not-italic">41 Couler Lane<br>Dubuque, Iowa 52001</address>
            <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1.5">
              <dt class="font-semibold">Tuesday to Friday</dt><dd class="text-right tabular-nums">3 – 7 pm</dd><dt class="font-semibold">Saturday</dt><dd class="text-right tabular-nums">9 am – 2 pm</dd><dt class="font-semibold">The porch pantry</dt><dd class="text-right tabular-nums">Always open</dd>
            </dl>
            <p class="mt-6 font-semibold"><a href="tel:+15635550141" class="ink-link">(563) 555-0141</a><br><a href="mailto:hello@breadandbolts.org" class="ink-link break-all">hello@breadandbolts.org</a></p>
          </div>
          {% render 'tabs', href: "https://www.openstreetmap.org/search?query=41%20Couler%20Lane%2C%20Dubuque%2C%20Iowa", label: "41 Couler Lane", aria: "Get directions to 41 Couler Lane", external: true %}
        </article>
      </div>
    </div>
    <div class="mt-20 grid gap-10 border-t-2 border-neutral-content/20 pt-10 md:grid-cols-12">
      <p class="font-heading text-[1.75rem] leading-none font-extrabold tracking-[-0.03em] whitespace-nowrap md:col-span-4">Bread <span class="text-primary">&amp;</span> Bolts</p>
      <nav aria-label="Footer" class="md:col-span-5">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2 font-semibold sm:grid-cols-3">
          {% for item in data.navigation %}{% if item.place == "both" or item.place == "footer" %}
          <li><a href="{{ item.href }}" class="ink-link decoration-neutral-content/40">{{ item.label }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </nav>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold md:col-span-3 md:justify-end">
        {% for item in data.navigation %}{% if item.place == "social" %}
        <li><a href="{{ item.href }}" class="ink-link decoration-neutral-content/40">{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </div>
    <p class="mt-10 text-sm text-neutral-content/70">Bread &amp; Bolts is a 501(c)(3) nonprofit. Gifts are tax-deductible as the law allows. © 2026</p>
  </div>
</footer>
