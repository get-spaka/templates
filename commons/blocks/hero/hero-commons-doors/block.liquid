<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[90rem] px-5 pt-10 pb-16 md:px-8 lg:pt-14 lg:pb-24">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <h1 class="poster lg:col-span-9">What we have, we share.</h1>
      <p class="max-w-md text-lg text-base-content/80 lg:col-span-3 lg:pb-3">Tools to borrow, things to mend, food on the porch and coats for winter, on Dubuque's North End since 2017.</p>
    </div>
    <div data-doors class="mt-10 grid gap-5 lg:mt-14">
      <div class="door" data-tone="tomato" data-reveal>
        <a href="/volunteer" class="flex items-end justify-between gap-4 px-6 pt-6 pb-5 md:px-8 md:pt-8">
          <h2 class="text-[2.75rem] font-extrabold md:text-6xl">Lend a hand</h2>
          <span class="door-arrow text-5xl md:text-7xl" aria-hidden="true">→</span>
        </a>
        <div class="door-photo aspect-[16/9] lg:aspect-auto lg:h-[15rem]" data-torn="bottom" data-tear="1"><img src="/media/hands-sorting.jpg"></div>
        <ul class="grid gap-x-6 px-6 pt-3 pb-6 sm:grid-cols-2 md:px-8 md:pb-8">
          <li class="door-way" style="--i: 0"><a href="/volunteer#form" class="flex items-center justify-between gap-3 border-b-2 border-current/25 py-3 text-lg font-semibold">Volunteer <span aria-hidden="true">→</span></a></li>
          <li class="door-way" style="--i: 1"><a href="/give" class="flex items-center justify-between gap-3 border-b-2 border-current/25 py-3 text-lg font-semibold">Give money <span aria-hidden="true">→</span></a></li>
          <li class="door-way" style="--i: 2"><a href="/give#things" class="flex items-center justify-between gap-3 border-b-2 border-current/25 py-3 text-lg font-semibold">Give tools or coats <span aria-hidden="true">→</span></a></li>
          <li class="door-way" style="--i: 3"><a href="/volunteer#roles" class="flex items-center justify-between gap-3 border-b-2 border-current/25 py-3 text-lg font-semibold">Fix things with us <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
      <div class="door" data-tone="sky" data-reveal>
        <a href="/programs" class="flex items-end justify-between gap-4 px-6 pt-6 pb-5 md:px-8 md:pt-8">
          <h2 class="text-[2.75rem] font-extrabold md:text-6xl">Take what you need</h2>
          <span class="door-arrow text-5xl md:text-7xl" aria-hidden="true">→</span>
        </a>
        <div class="door-photo aspect-[16/9] lg:aspect-auto lg:h-[15rem]" data-torn="bottom" data-tear="3"><img src="/media/porch-pantry.jpg" class="object-[50%_78%]"></div>
        <ul class="grid gap-x-6 px-6 pt-3 pb-6 sm:grid-cols-2 md:px-8 md:pb-8">
          <li class="door-way" style="--i: 0"><a href="/programs/tool-library" class="flex items-center justify-between gap-3 border-b-2 border-current/25 py-3 text-lg font-semibold">Borrow a tool <span aria-hidden="true">→</span></a></li>
          <li class="door-way" style="--i: 1"><a href="/programs/repair-cafe" class="flex items-center justify-between gap-3 border-b-2 border-current/25 py-3 text-lg font-semibold">Get something mended <span aria-hidden="true">→</span></a></li>
          <li class="door-way" style="--i: 2"><a href="/programs/porch-pantry" class="flex items-center justify-between gap-3 border-b-2 border-current/25 py-3 text-lg font-semibold">Food on the porch <span aria-hidden="true">→</span></a></li>
          <li class="door-way" style="--i: 3"><a href="/programs/winter-swap" class="flex items-center justify-between gap-3 border-b-2 border-current/25 py-3 text-lg font-semibold">A warm coat <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </div>
  </div>
</section>
