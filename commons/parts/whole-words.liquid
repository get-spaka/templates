{%- comment -%} A title whose hyphenated words never break at their hyphen ("walk-in", not "walk-" then "in"). {%- endcomment -%}
{%- assign words = text | split: " " -%}
{%- for word in words -%}{%- if word contains "-" -%}<span class="whitespace-nowrap">{{ word }}</span>{%- else -%}{{ word }}{%- endif -%}{%- unless forloop.last %} {% endunless -%}{%- endfor -%}
