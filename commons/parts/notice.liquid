<article class="notice" data-tone="{{ tone | default: 'paper' }}" data-reveal>
  <div class="notice-sheet px-6 pb-7 md:px-7" data-torn="top" data-tear="{{ tear | default: 1 }}">
    <div class="flex items-start justify-between gap-4">
      <p class="figure text-[5.5rem] md:text-[6.5rem]">{{ event.date | date: "%-d" }}</p>
      <p class="kicker pt-2 text-right">{{ event.date | date: "%B" }}<br>{{ event.date | date: "%A" }}</p>
    </div>
    <p class="kicker mt-5">{{ event.kind }}</p>
    <h3 class="mt-2 text-2xl font-bold md:text-[1.75rem]"><a href="/events/{{ event.id }}" class="hover:underline">{{ event.title }}</a></h3>
    {% if event.also != blank %}<p class="mt-1 font-semibold">{{ event.also }}</p>{% endif %}
    <p class="mt-3 text-base-content/80"><span class="tabular-nums">{{ event.start }} – {{ event.end }}</span> · {{ event.place }}</p>
    {% if event.price != blank %}<p class="mt-5 font-semibold">{{ event.price }}</p>{% else %}<p class="mt-5"><span class="free kicker">Free</span></p>{% endif %}
  </div>
  {% capture aria %}Save a spot at {{ event.title }}, {{ event.date | date: "%B %-d" }}{% endcapture %}
  {% capture label %}Save a spot · {{ event.date | date: "%b %-d" }}{% endcapture %}
  {% capture href %}/events/{{ event.id }}#spot{% endcapture %}
  {% render 'tabs', href: href, label: label, aria: aria %}
</article>
