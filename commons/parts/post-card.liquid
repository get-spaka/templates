<a href="/news/{{ post.id }}" class="group block" data-reveal>
  <div class="overflow-hidden rounded-t-box" data-torn="bottom" data-tear="{{ tear | default: 1 }}">
    {% if post.cover %}<img src="{{ post.cover }}" class="aspect-[3/2] w-full object-cover transition-[scale] duration-700 group-hover:scale-[1.03] motion-reduce:transition-none">{% else %}<div class="aspect-[3/2] w-full bg-base-200"></div>{% endif %}
  </div>
  <p class="kicker mt-5 text-base-content/70">{{ post.kind }} · <span class="tabular-nums">{{ post.date | date: "%B %-d, %Y" }}</span></p>
  <h3 class="mt-3 text-2xl font-bold md:text-[1.75rem]"><span class="underline decoration-transparent decoration-[3px] underline-offset-[0.2em] transition-[text-decoration-color] group-hover:decoration-current">{{ post.title }}</span></h3>
  <p class="mt-3 text-base-content/80">{{ post.summary }}</p>
</a>
