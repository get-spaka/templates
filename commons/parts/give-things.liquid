<section id="things" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 lg:py-24">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="kicker text-base-content/70">Give things</p>
        <h2 class="mt-4 text-5xl md:text-6xl">What the shed can take</h2>
      </div>
      <p class="text-lg text-base-content/80 lg:col-span-5">Bring it by when we're open. If you're not sure we can use it, call first.</p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {% for thing in data["give-things"] %}
      <article class="rounded-box border-2 border-base-content bg-base-100 p-6 md:p-8" data-reveal>
        <h3 class="text-3xl font-bold">{{ thing.title }}</h3>
        <p class="mt-3 text-lg text-base-content/80">{{ thing.text }}</p>
        <dl class="mt-6 grid gap-x-4 gap-y-1.5 sm:grid-cols-[auto_1fr]">
          <dt class="kicker pt-0.5">When</dt><dd class="font-semibold">{{ thing.when }}</dd>
          <dt class="kicker pt-0.5">Where</dt><dd class="font-semibold">{{ thing.where }}</dd>
        </dl>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
