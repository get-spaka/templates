{%- assign appeal = data.appeal | first -%}
<section id="levels" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 lg:py-28">
    <div data-reveal>
      <p class="kicker text-base-content/70">Give money</p>
      <h2 class="mt-4 text-5xl md:text-7xl">What a gift does</h2>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {% for level in data["give-levels"] %}
      <div class="flex flex-col rounded-b-box px-6 pt-10 pb-7" data-tone="{{ level.tone }}" data-torn="top" data-tear="{{ forloop.index0 | modulo: 3 | plus: 1 }}" data-reveal>
        <p class="figure text-[clamp(3.5rem,5vw,4.5rem)]">{{ level.amount }}</p>
        <p class="mt-4 text-xl font-bold">{{ level.what }}</p>
        <p class="mt-3 mb-8">{{ level.text }}</p>
        <a {% if appeal.link != blank %}href="{{ appeal.link }}" target="_blank" rel="noopener"{% else %}href="#ways"{% endif %} class="btn btn-wrap mt-auto border-current bg-base-100 text-base-content hover:bg-base-content hover:text-base-100">{{ level.button }}</a>
      </div>
      {% endfor %}
    </div>
    <p class="mt-10 max-w-3xl text-base-content/80">Gifts are made on our secure donation page, which opens in a new tab. Bread &amp; Bolts is a <span class="whitespace-nowrap">501(c)(3)</span>; your gift is tax-deductible.</p>
  </div>
</section>
