<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 lg:py-24">
    <div data-reveal>
      <p class="kicker text-base-content/70">How it works</p>
      <h2 class="mt-4 text-5xl md:text-6xl">Three steps to your first shift</h2>
    </div>
    <ol class="mt-12 grid gap-10 md:grid-cols-3">
      {% for step in data["volunteer-steps"] %}
      <li class="border-t-2 border-base-content pt-6" data-reveal>
        <p class="figure text-7xl md:text-8xl">{{ forloop.index }}</p>
        <h3 class="mt-5 text-2xl font-bold md:text-3xl">{{ step.title }}</h3>
        <p class="mt-3 text-lg text-base-content/80">{{ step.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
