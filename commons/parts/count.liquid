<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="kicker text-base-content/70">{% if about %}Last year, all of it{% else %}The count{% endif %}</p>
        <h2 class="mt-4 text-5xl md:text-7xl">{% if about %}Our year in numbers{% else %}Last year on the North End{% endif %}</h2>
      </div>
      {% unless about %}<a href="/about#numbers" class="ink-link text-lg font-semibold">Our year in numbers →</a>{% endunless %}
    </div>
    <div class="mt-14 grid gap-x-6 gap-y-8 md:grid-cols-2 {% if about %}lg:grid-cols-3{% endif %}">
      {% for f in figures %}
      <div class="slip {% unless about %}md:even:translate-y-12{% endunless %}" data-reveal>
        <div class="rounded-b-box px-6 pt-10 pb-8 md:px-8" data-tone="{{ f.tone }}" data-torn="top" data-tear="{{ forloop.index0 | modulo: 3 | plus: 1 }}">
          <p class="figure {% if about %}text-[clamp(4rem,6.4vw,6rem)]{% else %}text-[clamp(4rem,11vw,9rem)]{% endif %}">{{ f.figure }}</p>
          <p class="mt-4 text-xl font-semibold">{{ f.label }}</p>
        </div>
        {% if f.note != blank %}<p class="hand mt-4 ml-3">{{ f.note }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>
