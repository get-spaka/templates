<section id="roles" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 pb-20 md:px-8 lg:pb-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="kicker text-base-content/70">What you'd do</p>
        <h2 class="mt-4 text-5xl md:text-7xl">Five jobs on the board</h2>
      </div>
      <p class="text-lg text-base-content/80 lg:col-span-5">Pick one or try them all. Tear off a tab and tell us which.</p>
    </div>
    <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {% for role in data["volunteer-roles"] %}
      <article class="notice" data-tone="kraft" data-reveal>
        <div class="notice-sheet px-6 pb-7 md:px-7" data-torn="top" data-tear="{{ forloop.index0 | modulo: 3 | plus: 1 }}">
          <p class="kicker">{{ role.program }}</p>
          <h3 class="mt-3 text-3xl font-bold">{{ role.title }}</h3>
          <p class="mt-4">{{ role.text }}</p>
          <dl class="mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5">
            <dt class="kicker pt-0.5">When</dt><dd class="font-semibold">{{ role.when }}</dd>
            <dt class="kicker pt-0.5">How often</dt><dd class="font-semibold">{{ role.often }}</dd>
          </dl>
        </div>
        {% capture aria %}I'm in: {{ role.title }}, sign up{% endcapture %}
        {% render 'tabs', href: "#form", label: "I'm in!", aria: aria %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
