<section class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 lg:py-24">
    <div data-reveal>
      <p class="kicker text-base-content/70">Questions</p>
      <h2 class="mt-4 text-5xl md:text-6xl">Before you sign up</h2>
    </div>
    <div class="mt-12 grid gap-x-10 md:grid-cols-2">
      {% for item in data["volunteer-faq"] %}
      <details class="group border-t-2 border-base-content py-5" data-reveal>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-xl font-bold [&::-webkit-details-marker]:hidden">
          <span>{{ item.question }}</span>
          <span class="font-heading text-3xl leading-none transition-[rotate] group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 pr-10 text-lg text-base-content/80">{{ item.answer }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
