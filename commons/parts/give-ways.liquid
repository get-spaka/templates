<section id="ways" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[80rem] px-5 py-20 md:px-8 lg:py-24">
    <div data-reveal>
      <p class="kicker text-base-content/70">Other ways</p>
      <h2 class="mt-4 text-5xl md:text-6xl">Other ways to give</h2>
    </div>
    <div class="mt-12 grid gap-x-10 md:grid-cols-3">
      {% for way in data["give-ways"] %}
      <div class="border-t-2 border-base-content py-6" data-reveal>
        <h3 class="text-2xl font-bold">{{ way.question }}</h3>
        <p class="mt-3 text-lg text-base-content/80">{{ way.answer }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
