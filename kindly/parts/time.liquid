{%- comment -%} A 24-hour time of the records ("16:30") as guests read it: "4:30" and "pm" in engraved capitals. {%- endcomment -%}
{%- assign hm = t | split: ":" -%}{%- assign h = hm[0] | plus: 0 -%}{%- assign m = hm[1] | default: "00" -%}{%- if h >= 12 -%}{%- assign half = "pm" -%}{%- else -%}{%- assign half = "am" -%}{%- endif -%}{%- assign h12 = h | modulo: 12 -%}{%- if h12 == 0 -%}{%- assign h12 = 12 -%}{%- endif -%}
{%- if plain -%}{{ h12 }}{% if m != "00" %}:{{ m }}{% endif %}&nbsp;{{ half }}{%- else -%}<span class="whitespace-nowrap">{{ h12 }}{% if m != "00" %}:{{ m }}{% endif %}<span class="engraved ml-1.5 align-[0.45em] text-[0.3em]">{{ half }}</span></span>{%- endif -%}
