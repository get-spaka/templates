<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 pt-16 pb-14 text-center md:px-8 md:pt-24 md:pb-20">
    <p class="engraved text-base-content/75" data-reveal>{{ label }}</p>
    <h1 class="page-title mx-auto mt-6 max-w-[16ch]" data-reveal>{{ title }}</h1>
    <p class="mx-auto mt-7 max-w-[38rem] text-[1.1875rem] leading-relaxed text-base-content/80" data-reveal>{{ text }}</p>
    <div class="rule-diamond mx-auto mt-12 max-w-[20rem]" aria-hidden="true"><span class="size-1.5 rotate-45 bg-accent"></span></div>
  </div>
</section>
