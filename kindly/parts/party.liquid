<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-24 md:px-8 md:py-32">
    <div class="max-w-[40rem]" data-reveal>
      <p class="engraved text-base-content/75">On the lawn with us</p>
      <h2 class="section-title mt-5">The people standing with us</h2>
    </div>
    <ul class="mt-14 grid grid-cols-2 gap-x-5 gap-y-12 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-8">
      {% for person in data.party %}
      <li data-reveal>
        {% if person.photo != blank %}{% render 'diecut', src: person.photo, shape: "arch", class: "aspect-[3/4] w-full" %}{% else %}
        <div class="liner diecut-arch grid aspect-[3/4] w-full place-items-center" aria-hidden="true"><span class="serif relative rounded-full bg-secondary px-4 py-2 text-[clamp(2.25rem,4vw,3.25rem)] leading-none text-secondary-content">{% assign words = person.name | split: " " %}{{ words.first | slice: 0 }}{{ words.last | slice: 0 }}</span></div>{% endif %}
        <h3 class="serif mt-5 text-[1.5rem] leading-tight">{{ person.name }}</h3>
        <p class="engraved mt-2 text-[0.6875rem] text-base-content/75">{{ person.role }}</p>
        <p class="mt-1 text-[0.9375rem] font-semibold">{{ person.relation }}</p>
        <p class="body-copy mt-2 text-[0.9375rem]">{{ person.text }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
