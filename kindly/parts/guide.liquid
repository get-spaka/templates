{%- assign tabs = "eat,see,do" | split: "," -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-24 md:px-8 md:py-32">
    <div class="max-w-[40rem]" data-reveal>
      <p class="engraved text-base-content/75">Between the parties</p>
      <h2 class="section-title mt-5">On the island</h2>
    </div>
    <div class="guide-tabs mt-12">
      {% for tab in tabs %}
      <input type="radio" name="guide-tab" id="guide-{{ tab }}" {% if forloop.first %}checked{% endif %}>
      <label for="guide-{{ tab }}" class="guide-tab">{% case tab %}{% when "eat" %}Eat{% when "see" %}See{% else %}Do{% endcase %}</label>
      <div class="guide-panel">
        <ul class="grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-3 lg:gap-x-10">
          {% for place in data.guide %}{% if place.category == tab %}
          <li class="{% cycle "guide": 'rotate-[-1.5deg]', 'rotate-[1deg]', 'rotate-[-0.5deg]' %}">
            <div class="stamp">
              <div class="stamp-frame">
                <div class="aspect-[4/3] overflow-hidden" data-print>{% if place.image != blank %}<img src="{{ place.image }}" class="h-full w-full object-cover" loading="lazy">{% else %}<span class="diecut-empty flex h-full w-full" aria-hidden="true"></span>{% endif %}</div>
                <p class="engraved absolute top-3 left-3 rounded-sm bg-base-100/90 px-1.5 py-0.5 text-[0.5625rem]">{{ place.label }}</p>
              </div>
            </div>
            <h3 class="serif mt-5 text-[1.5rem] leading-tight">{{ place.name }}</h3>
            <p class="body-copy mt-2 text-[0.9375rem]">{{ place.text }}</p>
          </li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
