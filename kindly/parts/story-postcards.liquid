<section class="bg-base-100 text-base-content">
  <ol class="mx-auto max-w-[76rem] space-y-16 px-5 pb-24 md:space-y-24 md:px-8 md:pb-32">
    {% for chapter in data.story %}
    <li class="flex {% cycle 'lg:justify-start', 'lg:justify-end' %}">
      <article class="postcard grid w-full max-w-[62rem] sm:grid-cols-[5fr_6fr]" style="--tilt: {% cycle '-1.5deg', '2deg', '-2deg', '1.5deg' %}" data-reveal>
        <div class="p-4 sm:p-5 sm:pr-0">
          {% render 'diecut', src: chapter.image, shape: chapter.shape, class: "aspect-[4/3] w-full sm:aspect-auto sm:h-full sm:min-h-[20rem]" %}
        </div>
        <div class="postcard-back grid gap-6 p-6 sm:grid-cols-[1fr_auto] sm:p-8">
          <div class="sm:border-r sm:border-base-300 sm:pr-6">
            <p class="engraved text-base-content/70">{{ chapter.year }}</p>
            <h2 class="serif mt-2 text-[clamp(1.75rem,2.6vw,2.25rem)] leading-[1.06]">{{ chapter.title }}</h2>
            <div class="body-copy mt-4 text-[0.9688rem]">{{ chapter.text }}</div>
          </div>
          <div class="flex flex-row items-start gap-5 sm:w-[7.5rem] sm:flex-col sm:items-center">
            {% render 'postmark', place: chapter.place, month: chapter.month, year: chapter.year %}
            <svg class="postmark-lines hidden h-6 w-28 sm:block" viewBox="0 0 112 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M0 4c9-4 19 4 28 0s19-4 28 0 19 4 28 0 19-4 28 0M0 12c9-4 19 4 28 0s19-4 28 0 19 4 28 0 19-4 28 0M0 20c9-4 19 4 28 0s19-4 28 0 19 4 28 0 19-4 28 0"/></svg>
            <div class="hidden w-full space-y-1 sm:block" aria-hidden="true"><div class="address-line"></div><div class="address-line"></div><div class="address-line"></div></div>
          </div>
        </div>
      </article>
    </li>
    {% endfor %}
  </ol>
</section>
