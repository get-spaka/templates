<section class="relative isolate overflow-hidden bg-neutral text-neutral-content">
  <div class="absolute inset-x-0 top-0 -z-10 h-[58%] md:h-full" data-print>
    <img src="/media/straits-dusk.jpg" class="h-full w-full object-cover">
    <div class="absolute inset-0 bg-gradient-to-b from-neutral/10 via-neutral/20 to-neutral" aria-hidden="true"></div>
  </div>
  <div class="mx-auto flex min-h-[min(calc(100svh-4.5rem),58rem)] max-w-[84rem] flex-col items-center justify-end px-4 pt-[min(16svh,8rem)] pb-10 md:px-8 md:pt-10 md:pb-12">
    <div class="envelope" data-envelope>
      <div class="env-stage">
        <div class="env-back" aria-hidden="true"><span class="liner"></span></div>
        <div class="env-flap" aria-hidden="true"><span class="env-flap-in liner"></span><span class="env-flap-out"></span></div>
        <div class="env-card">
          <p class="engraved text-base-content/75">Together with their families</p>
          <h1 class="env-names pressed mt-[5cqw]">Iris Novak <span class="amp script" aria-label="and">&amp;</span> Callum Shaw</h1>
          <p class="env-invite serif-italic mt-[3.5cqw] text-base-content/85">invite you to their wedding</p>
          <p class="env-date serif pressed mt-[4cqw]">June 12, 2027</p>
          <p class="engraved mt-[3cqw] text-base-content/75">Saturday · half past four in the afternoon</p>
          <p class="engraved mx-auto mt-[2cqw] max-w-[34ch] text-base-content/75">Larkspur Cottage · East Bluff · Mackinac Island, Michigan</p>
        </div>
        <div class="env-pocket" aria-hidden="true"><span></span></div>
        <span class="env-seal seal" aria-hidden="true"><span class="wax"><span class="monogram">I&thinsp;C</span></span></span>
      </div>
    </div>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="/rsvp" class="btn btn-lg rounded-full border-base-100 bg-base-100 px-7 whitespace-nowrap text-base-content shadow-none">Kindly reply</a>
      <a href="/weekend" class="btn btn-lg btn-outline rounded-full border-neutral-content/70 px-7 whitespace-nowrap text-neutral-content hover:bg-neutral-content hover:text-neutral">See the weekend</a>
    </div>
  </div>
</section>
