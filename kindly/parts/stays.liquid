<section id="stay" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-24 md:px-8 md:py-32">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <p class="engraved text-base-content/75">Rooms held for you</p>
        <h2 class="section-title mt-5">Where to stay</h2>
      </div>
      <p class="serif-italic text-[1.375rem] leading-snug lg:col-span-5" data-reveal>It's the Lilac Festival's last weekend: please book early.</p>
    </div>
    <ul class="mt-14 border-t border-base-content/15">
      {% for stay in data.stays %}
      <li class="grid gap-6 border-b border-base-content/15 py-10 md:grid-cols-[12rem_1fr] lg:grid-cols-[14rem_1fr_17rem] lg:gap-10" data-reveal>
        {% render 'diecut', src: stay.image, shape: "pebble", class: "aspect-[4/3] w-full max-w-[18rem] md:max-w-none" %}
        <div>
          <p class="engraved text-base-content/70">{{ stay.kind }} · {{ stay.where }}</p>
          <h3 class="serif mt-2 text-[clamp(1.875rem,2.6vw,2.5rem)] leading-none">{{ stay.name }}</h3>
          <p class="mt-3 font-semibold">{{ stay.distance }}</p>
          <p class="body-copy mt-2 max-w-[36rem]">{{ stay.note }}</p>
        </div>
        <div class="flex flex-col gap-3 md:col-start-2 lg:col-start-3 lg:items-end lg:text-right">
          <p class="serif text-[1.5rem] leading-none">From {{ stay.rate }}</p>
          {% if stay.code != blank %}<p class="engraved text-[0.6875rem] text-primary">Code {{ stay.code }} · book by {{ stay.cutoff | date: "%B %-d" }}</p>{% endif %}
          <div class="mt-1 flex flex-wrap items-center gap-x-5 gap-y-2 lg:justify-end">
            <a href="{{ stay.link }}" class="btn btn-primary whitespace-nowrap" rel="noopener" target="_blank">Book a room</a>
            <a href="tel:{{ stay.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="text-link whitespace-nowrap">{{ stay.phone }}</a>
          </div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
