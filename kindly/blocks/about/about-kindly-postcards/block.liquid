<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-[84rem] px-5 py-24 md:px-8 md:py-32">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7" data-reveal>
        <p class="engraved text-base-content/75">Ten summers, in postcards</p>
        <h2 class="section-title mt-5 max-w-[16ch]">How we got here</h2>
      </div>
      <div class="md:col-span-5 md:text-right" data-reveal>
        <a href="/story" class="btn btn-outline btn-primary whitespace-nowrap">Read our story</a>
      </div>
    </div>
    <ul class="mt-16 grid gap-10 md:grid-cols-3 md:gap-0">
      {% assign n = 0 %}
      {% for chapter in data.story %}{% if chapter.home %}{% assign n = n | plus: 1 %}{% if n > 3 %}{% break %}{% endif %}
      <li class="postcard relative md:mx-[-0.75rem] {% if n == 2 %}md:mt-14 md:z-[2]{% elsif n == 3 %}md:mt-4{% endif %}" style="--tilt: {% if n == 1 %}-2deg{% elsif n == 2 %}1.5deg{% else %}-1deg{% endif %}" data-reveal>
        <div class="p-4 pb-0">
          {%- assign src = chapter.image -%}{%- assign shape = chapter.shape -%}{%- assign class = "aspect-[4/3] w-full" -%}<figure class="diecut diecut-{{ shape | default: 'arch' }} {{ class }}" data-diecut data-print>{% if src != blank %}<img src="{{ src }}" loading="lazy">{% else %}<span class="diecut-empty h-full w-full" aria-hidden="true"><svg class="size-10 opacity-60" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="24" cy="17" r="6"/><circle cx="18" cy="23" r="5"/><circle cx="30" cy="23" r="5"/><path d="M24 26v16"/></svg></span>{% endif %}</figure>
        </div>
        <div class="relative p-6 pt-5">
          {%- assign place = chapter.place -%}{%- assign month = chapter.month -%}{%- assign year = chapter.year -%}{%- assign class = "absolute -top-12 right-4 bg-base-200/70" -%}<span class="postmark {{ class }}" aria-hidden="true"><span class="engraved">{{ place }}<br>{{ month }} {{ year }}</span></span>
          <p class="engraved text-base-content/70">{{ chapter.year }}</p>
          <h3 class="serif mt-2 pr-14 text-[1.75rem] leading-[1.08]">{{ chapter.title }}</h3>
          <p class="body-copy mt-3 text-[0.9375rem]">{{ chapter.summary }}</p>
        </div>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
