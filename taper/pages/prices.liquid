<!doctype html>
<html lang="en">
<head>
<title>Prices — Good Side, Hampden</title>
<meta name="description" content="Every service at Good Side takes a set amount of chair time. You pay for that time at the level of whoever's cutting. Same for every head.">
<meta property="og:title" content="Prices — Good Side, Hampden">
<meta property="og:description" content="Priced by chair time and level, never by gender: the grid, the menu and the questions people ask.">
</head>
<body>
{% render 'header' %}
<main>
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-6 px-5 pt-14 pb-14 md:px-8 md:pt-20 md:pb-20 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-6" data-reveal>
      <p class="board text-primary">By time and level</p>
      <h1 class="mt-4 text-[clamp(3rem,5vw+1rem,5.5rem)] leading-[0.98] tracking-[-0.01em]">Prices</h1>
    </div>
    <p class="max-w-[52ch] text-lg leading-relaxed text-base-content/80 md:text-xl lg:col-span-6" data-reveal>Every service takes a set amount of chair time. You pay for that time at the level of whoever's cutting. Same for every head.</p>
  </div>
  <div class="mx-auto grid max-w-7xl grid-cols-3 gap-2 px-5 pb-16 sm:gap-3 md:px-8 md:pb-20" data-reveal="stagger">
    <img src="/media/tool-scissors.jpg" class="aspect-[4/3] w-full rounded-box object-cover">
    <img src="/media/shop-counter.jpg" class="aspect-[4/3] w-full rounded-box object-cover">
    <img src="/media/tool-razor.jpg" class="aspect-[4/3] w-full rounded-box object-cover">
  </div>
</section>
{% render 'levels' %}
{% render 'rate-grid' %}
{% render 'menu' %}
{% render 'questions', list: data["prices-faq"], label: "Questions", title: "What people ask about prices" %}
{% render 'booking-band' %}
</main>
{% render 'footer' %}
</body>
</html>
