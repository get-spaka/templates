<section id="hours" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-3 pb-20 md:px-5 md:pb-28">
    <div class="grid gap-12 rounded-box bg-base-200 px-5 py-14 md:px-10 md:py-16 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7" data-reveal>
        <p class="board text-primary">The week at the chair</p>
        <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.5rem)] leading-[1.05] text-balance">Open six days, late four of them</h2>
        {% render 'week', class: "mt-10" %}
      </div>
      <div class="flex flex-col gap-8 lg:col-span-5 lg:border-l lg:border-base-content/10 lg:pl-12" data-reveal>
        <div>
          <h3 class="board text-base-content/60">Find us</h3>
          <address class="mt-3 font-heading text-[1.75rem] leading-tight not-italic"><span class="whitespace-nowrap">14 Mill Row</span><br>Hampden, Baltimore</address>
          <p class="mt-2 text-base text-base-content/70">A step off the Avenue, West 36th Street.</p>
          <a href="https://www.openstreetmap.org/search?query=14%20Mill%20Row%2C%20Hampden%2C%20Baltimore" class="mt-3 inline-flex font-semibold text-primary underline underline-offset-4">Get directions</a>
        </div>
        <div>
          <h3 class="board text-base-content/60">Call the shop</h3>
          <a href="tel:+14105550136" class="figure mt-2 inline-block text-[1.375rem] whitespace-nowrap">(410) 555-0136</a>
        </div>
        <p class="rounded-box bg-secondary p-5 text-base leading-relaxed text-secondary-content"><span class="font-semibold">Walk-ins Tuesday to Friday from 10 to noon,</span> first come, first cut. After that, book ahead.</p>
      </div>
    </div>
  </div>
</section>
