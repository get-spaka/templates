<section id="levels" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 pb-20 md:px-8 md:pb-24">
    <div data-reveal>
      <p class="board text-primary">How levels work</p>
      <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.5rem)] leading-[1.05] text-balance">Four steps, from pale to deep</h2>
    </div>
    <ol class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
      {% for lv in data.levels %}
      {%- assign people = data.team | where: "level", lv.number -%}
      <li class="flex flex-col rounded-box p-6 md:p-7" data-step="{{ lv.step }}">
        <span class="display text-[3.5rem]">{{ lv.number }}</span>
        <h3 class="mt-6 text-[1.5rem] leading-tight">{{ lv.name }}</h3>
        <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed opacity-85">{{ lv.meaning }}</p>
        {% if people.size > 0 %}
        <p class="mt-6 border-t border-current/20 pt-4 text-[0.9375rem]"><span class="board block opacity-75">At this level</span>
          {% for p in people %}<a href="/team/{{ p.id }}" class="mt-1 inline-block font-semibold underline-offset-4 hover:underline">{{ p.name }}</a>{% unless forloop.last %}<span class="opacity-60">, </span>{% endunless %}{% endfor %}
        </p>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
