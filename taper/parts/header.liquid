<header class="site-header sticky top-0 z-40 border-b border-base-300 text-base-content">
  <div class="mx-auto flex min-h-[4.75rem] max-w-7xl items-center gap-4 px-5 py-2.5 md:px-8 lg:gap-8">
    <div class="flex min-w-0 flex-col gap-1 lg:flex-row lg:items-center lg:gap-6">
      <a href="/" class="shrink-0 font-heading text-[1.75rem] leading-none whitespace-nowrap md:text-[2rem]" aria-label="Good Side, home">Good Side</a>
      {% render 'open-sign', short: true, class: "text-[0.8125rem] text-base-content/80 lg:border-l lg:border-base-300 lg:pl-6 lg:text-sm" %}
    </div>
    <nav aria-label="Main" class="ml-auto hidden xl:block">
      <ul class="flex items-center gap-7 text-[0.9375rem] font-semibold whitespace-nowrap">
        {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
        <li><a href="{{ item.href }}" class="py-2 underline-offset-[0.45em] hover:underline {% if page.url contains item.href %}underline decoration-primary decoration-2{% endif %}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <div class="ml-auto flex shrink-0 items-center gap-2 xl:ml-2">
      <a href="/book" class="btn btn-primary hidden whitespace-nowrap sm:inline-flex">Book a chair</a>
      <div class="dropdown dropdown-end xl:hidden">
        <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Open the menu">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16"/><path d="M4 16h16"/></svg>
        </div>
        <div tabindex="0" class="dropdown-content z-50 mt-3 w-72 rounded-box border border-base-300 bg-base-100 p-3 shadow-lg">
          <ul class="menu w-full p-0 text-base">
            {% for item in data.navigation %}{% if item.place == "both" or item.place == "header" %}
            <li><a href="{{ item.href }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endif %}{% endfor %}
          </ul>
          <div class="mt-2 flex flex-col gap-2 border-t border-base-300 px-1 pt-3">
            <a href="/book" class="btn btn-primary">Book a chair</a>
            <a href="tel:+14105550136" class="btn btn-ghost">Call (410) 555-0136</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
