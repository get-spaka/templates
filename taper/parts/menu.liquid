{%- comment -%}The menu, grouped. A timed service shows its chair time and the lowest level's price from the rates; flat_price overrides both.{%- endcomment -%}
{%- assign groups = "Cuts,Color,Shaves & beards,Kids & extras" | split: "," -%}
<section id="menu" class="bg-base-200 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="board text-primary">The menu</p>
        <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.5rem)] leading-[1.05] text-balance">Everything we do, and how long it takes</h2>
      </div>
      <p class="max-w-[62ch] text-lg leading-relaxed text-base-content/80 lg:col-span-5">Prices start at level 1 and rise with each step. “From” means the time depends on your hair; we'll tell you before we start.</p>
    </div>
    <div class="mt-14 grid gap-x-16 gap-y-14 lg:grid-cols-2">
      {% for group in groups %}
      {%- assign items = data.services | where: "group", group -%}
      {% if items.size > 0 %}
      <div data-reveal>
        <h3 class="text-[1.75rem] leading-tight">{{ group }}</h3>
        <ul class="mt-5 divide-y divide-base-300 border-y border-base-300">
          {% for s in items %}
          {%- assign rate = data.rates | where: "minutes", s.minutes | first -%}
          <li class="py-4">
            <div class="flex items-baseline gap-3">
              <span class="text-[1.125rem] font-semibold">{{ s.name }}</span>
              <span aria-hidden="true" class="min-w-6 flex-1 translate-y-[-0.3em] border-b-2 border-dotted border-base-content/25"></span>
              <span class="figure text-[1.125rem] whitespace-nowrap">{% if s.flat_price != blank %}{{ s.flat_price }}{% elsif rate %}from {{ rate.price_1 }}{% else %}{{ s.price }}{% endif %}</span>
            </div>
            <div class="mt-1 flex items-start justify-between gap-4">
              {% if s.summary != blank %}<p class="text-[0.9375rem] leading-snug text-base-content/70">{{ s.summary }}</p>{% endif %}
              {% if s.minutes %}<span class="board shrink-0 pt-0.5 whitespace-nowrap text-base-content/70">{% if s.from %}from {% endif %}{{ s.minutes }} min</span>{% endif %}
            </div>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% endfor %}
    </div>
    <p class="mt-14 border-y border-base-300 py-6 text-center text-[1.0625rem] text-balance" data-reveal>Every cut includes a wash if you want one, a hot towel at the neck and styling to finish.</p>
  </div>
</section>
