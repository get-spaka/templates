<footer class="on-night bg-neutral text-neutral-content">
  <div class="mx-auto max-w-7xl px-5 pt-16 md:px-8 md:pt-20">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <a href="/" class="font-heading text-[3.25rem] leading-none whitespace-nowrap">Good Side</a>
        <p class="board mt-4 text-neutral-content/70">Barbershop &amp; hair studio</p>
        <p class="mt-6 max-w-xs leading-relaxed text-neutral-content/80">In a former mill office with tall windows, a step off the Avenue since 2019. Step-free entrance.</p>
      </div>
      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-8">
        <div>
          <h2 class="board text-neutral-content/60">Find us</h2>
          <address class="mt-4 leading-relaxed not-italic"><span class="whitespace-nowrap">14 Mill Row</span><br>Hampden, Baltimore, <span class="whitespace-nowrap">MD 21211</span></address>
          <a href="https://www.openstreetmap.org/search?query=14%20Mill%20Row%2C%20Hampden%2C%20Baltimore" class="mt-3 inline-flex font-semibold underline underline-offset-4">Get directions</a>
          <p class="mt-6 leading-relaxed"><a href="tel:+14105550136" class="figure whitespace-nowrap hover:underline">(410) 555-0136</a><br><a href="mailto:chairs@goodside.example" class="hover:underline">chairs@goodside.example</a></p>
          {% for item in data.navigation %}{% if item.place == "social" %}<a href="{{ item.href }}" class="mt-3 inline-flex font-semibold hover:underline">{{ item.label }}</a>{% endif %}{% endfor %}
        </div>
        <div>
          <h2 class="board text-neutral-content/60">Hours</h2>
          <ul class="figure mt-4 space-y-1.5 text-[0.9375rem] font-normal">
            {% for row in data.hours %}
            <li class="flex justify-between gap-4"><span>{{ row.day }}</span><span class="text-right text-neutral-content/80">{{ row.hours }}</span></li>
            {% endfor %}
          </ul>
        </div>
        <nav aria-label="Footer">
          <h2 class="board text-neutral-content/60">Pages</h2>
          <ul class="mt-4 space-y-2">
            {% for item in data.navigation %}{% if item.place == "both" or item.place == "footer" %}
            <li><a href="{{ item.href }}" class="hover:underline">{{ item.label }}</a></li>
            {% endif %}{% endfor %}
          </ul>
        </nav>
      </div>
    </div>
    <div class="mt-16 grid grid-cols-4 overflow-hidden rounded-full" data-fade="band" aria-hidden="true"><span data-step="1"></span><span data-step="2"></span><span data-step="3"></span><span data-step="4"></span></div>
    <div class="flex flex-col gap-3 py-6 text-sm text-neutral-content/70 md:flex-row md:items-center md:justify-between">
      <p>Every head priced by its time in the chair, never by gender.</p>
      <p>© 2026 Good Side, Baltimore</p>
    </div>
  </div>
</footer>
