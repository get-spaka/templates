<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 pb-20 md:px-8 md:pb-28 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="board text-primary">The rules</p>
      <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.25rem)] leading-[1.05] text-balance">Short, and the same for everyone</h2>
    </div>
    <ul class="divide-y divide-base-300 border-y border-base-300 lg:col-span-8" data-reveal="stagger">
      {% for rule in data["book-faq"] %}
      <li class="grid gap-1 py-5 sm:grid-cols-[16rem_1fr] sm:gap-8">
        <h3 class="board pt-1 text-[0.8125rem] text-base-content">{{ rule.question }}</h3>
        <div class="prose-taper text-base-content/80">{{ rule.answer }}</div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
