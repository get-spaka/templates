<section id="team" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 pb-20 md:px-8 md:pb-28">
    <div class="grid gap-6 border-t border-base-300 pt-16 md:pt-20 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="board text-primary">The chairs</p>
        <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.5rem)] leading-[1.05] text-balance">Five people, four levels</h2>
      </div>
      <p class="max-w-[62ch] text-lg leading-relaxed text-base-content/80 lg:col-span-5">Book someone by name, or book a level and take whoever's free. The chip under each name is the column you'll pay.</p>
    </div>
    <div class="mt-12 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 md:grid-cols-3 lg:grid-cols-5" data-reveal="stagger">
      {% for member in data.team %}
      {%- assign first_name = member.name | split: " " | first -%}
      <div class="flex flex-col">
        <a href="/team/{{ member.id }}" class="group block">
          {% render 'portrait', member: member, class: "aspect-[3/4] rounded-box" %}
          <h3 class="mt-4 text-[1.375rem] leading-tight group-hover:text-primary">{{ member.name }}</h3>
        </a>
        {% if member.pronouns != blank %}<p class="mt-0.5 text-[0.875rem] text-base-content/60">{{ member.pronouns }}</p>{% endif %}
        {% if member.level %}<div class="mt-3">{% render 'level-chip', level: member.level, data: data %}</div>{% endif %}
        {% if member.bio != blank %}<p class="mt-3 text-[0.9375rem] leading-snug text-base-content/80">{{ member.bio }}</p>{% endif %}
        <a href="/book?with={{ member.id }}" class="mt-auto inline-flex pt-4 text-[0.9375rem] font-semibold text-primary underline-offset-4 hover:underline">Book with {{ first_name }}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
