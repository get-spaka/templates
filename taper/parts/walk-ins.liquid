<section id="walk-ins" class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-3 pb-20 md:px-5 md:pb-28">
    <div class="grid gap-10 rounded-box bg-base-200 px-5 py-14 md:px-10 md:py-16 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4" data-reveal>
        <p class="board text-primary">Walk-ins</p>
        <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.25rem)] leading-[1.05] text-balance">Or just come in</h2>
        <p class="mt-5 text-lg leading-relaxed text-base-content/80">Walk-ins: Tuesday to Friday, 10 to noon. Put your name on the board at the desk and we'll cut in order.</p>
      </div>
      <div class="lg:col-span-8" data-reveal>
        {% render 'week', large: true %}
      </div>
    </div>
  </div>
</section>
