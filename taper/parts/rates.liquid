{%- comment -%}
The fade: chair times against the four levels, each column on its step (data-fade, data-step).
On a phone, level chips (radio inputs) choose the column shown beside the chair times.
Parameters: limit (how many chair times; all when blank), book (a "Book at this level" link under each column), name (the chips' group, unique on the page).
{%- endcomment -%}
{%- assign group = name | default: "rates" | append: "-level" -%}
<div data-rates>
  <fieldset class="md:hidden">
    <legend class="board text-base-content/70">Who's cutting</legend>
    <div class="mt-3 flex flex-wrap gap-2">
      {% for lv in data.levels %}
      <label class="rate-chip" data-step="{{ lv.step }}"><input type="radio" name="{{ group }}" value="{{ lv.number }}" {% if lv.number == 2 %}checked{% endif %}><span>{{ lv.number }} · {{ lv.name }}</span></label>
      {% endfor %}
    </div>
  </fieldset>
  <div class="mt-6 md:mt-0" data-fade>
    <table class="rates">
      <thead>
        <tr>
          <th scope="col" class="w-[38%] pr-4 pb-4 text-left align-bottom md:w-[34%]"><span class="board text-base-content/60">Chair time</span></th>
          {% for lv in data.levels %}
          <th scope="col" class="px-3 pt-4 pb-3 text-left align-bottom md:px-4" data-step="{{ lv.step }}" data-col="{{ lv.number }}">
            <span class="block"><span class="display block text-[2rem] md:text-[2.5rem]">{{ lv.number }}</span><span class="board mt-2 block">{{ lv.name }}</span></span>
          </th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for rate in data.rates %}{% if limit == blank or forloop.index <= limit %}
        <tr>
          <th scope="row" class="py-4 pr-4 text-left align-top font-normal">
            <span class="flex items-baseline gap-2"><span class="display text-[2.25rem] md:text-[2.75rem]">{{ rate.minutes }}</span><span class="board text-base-content/60">min</span></span>
            {% if rate.usually != blank %}<span class="mt-1 block text-[0.9375rem] leading-snug text-base-content/70">{{ rate.usually }}</span>{% endif %}
          </th>
          {% for lv in data.levels %}
          {%- assign key = "price_" | append: lv.number -%}
          <td class="px-3 py-4 md:px-4" data-step="{{ lv.step }}" data-col="{{ lv.number }}"><span class="figure block text-[1.25rem] md:text-[1.375rem]">{{ rate[key] }}</span></td>
          {% endfor %}
        </tr>
        {% endif %}{% endfor %}
      </tbody>
      {% if book %}
      <tfoot>
        <tr>
          <td></td>
          {% for lv in data.levels %}
          <td class="px-3 pt-2 pb-4 md:px-4" data-step="{{ lv.step }}" data-col="{{ lv.number }}"><a href="/book?level={{ lv.number }}" class="inline-flex items-center gap-1 text-[0.9375rem] font-semibold whitespace-nowrap underline underline-offset-4">Book at this level</a></td>
          {% endfor %}
        </tr>
      </tfoot>
      {% endif %}
    </table>
    <div class="mt-3 overflow-hidden rounded-full" data-fade="band" aria-hidden="true"><span data-step="1"></span><span data-step="2"></span><span data-step="3"></span><span data-step="4"></span></div>
  </div>
</div>
