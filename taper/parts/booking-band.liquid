<section class="on-night bg-neutral text-neutral-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7" data-reveal>
      <h2 class="text-[clamp(2.5rem,5vw+1rem,5rem)] leading-[1] text-balance">Pull up a chair.</h2>
      <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-neutral-content/80">Tell us what you'd like and when suits you. We text you back within two hours while we're open.</p>
    </div>
    <div class="flex flex-col gap-6 lg:col-span-5" data-reveal>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="/book" class="btn btn-lg whitespace-nowrap border-transparent bg-base-100 text-base-content hover:bg-base-200">Book a chair</a>
        <a href="tel:+14105550136" class="text-base leading-snug"><span class="block text-neutral-content/70">Or call the shop</span><span class="figure text-[1.25rem] whitespace-nowrap">(410) 555-0136</span></a>
      </div>
      {% render 'open-sign', class: "text-base text-neutral-content/90" %}
    </div>
  </div>
</section>
