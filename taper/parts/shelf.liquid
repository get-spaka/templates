<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4" data-reveal>
      <p class="board text-primary">On the shelf</p>
      <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.25rem)] leading-[1.05] text-balance">What we use, and sell at the desk</h2>
      <p class="mt-5 text-lg leading-relaxed text-base-content/80">Ask whoever cut you what they used: we'll show you how much, and how.</p>
      <p class="board mt-6 inline-block rounded-full bg-secondary px-3 py-1.5 text-secondary-content">Sold in the shop only</p>
    </div>
    <ul class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8" data-reveal="stagger">
      {% for item in data.shelf %}
      <li class="flex gap-4 border-t border-base-300 py-6">
        <span class="mt-1 grid size-7 shrink-0 place-items-center rounded-full text-primary-content" data-step="4" aria-hidden="true"><svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7"/></svg></span>
        <div>
          <h3 class="text-[1.375rem] leading-snug">{{ item.title }}</h3>
          {% if item.text != blank %}<p class="mt-1.5 text-[1rem] leading-relaxed text-base-content/75">{{ item.text }}</p>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
