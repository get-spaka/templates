{%- comment -%}Questions and answers, as an accordion. Parameters: list (the datasource's records), title, label.{%- endcomment -%}
<section class="bg-base-100 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="board text-primary">{{ label }}</p>
      <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.5rem)] leading-[1.05] text-balance">{{ title }}</h2>
    </div>
    <div class="divide-y divide-base-300 border-y border-base-300 lg:col-span-8" data-reveal>
      {% for item in list %}
      <details class="group py-1" name="questions" {% if forloop.first %}open{% endif %}>
        <summary class="flex cursor-pointer items-start justify-between gap-6 py-4 text-[1.1875rem] font-semibold">
          <span>{{ item.question }}</span>
          <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full border border-base-content/30 transition-transform group-open:rotate-45" aria-hidden="true"><svg class="size-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 1v10M1 6h10"/></svg></span>
        </summary>
        <div class="prose-taper max-w-[62ch] pb-5 text-base-content/80">{{ item.answer }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
