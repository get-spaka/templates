<section class="bg-base-100 text-base-content">
  <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="board text-primary">What a cut costs</p>
        <h2 class="mt-4 text-[clamp(2rem,3vw+1rem,3.5rem)] leading-[1.05] text-balance">Pay for the time, not the label.</h2>
      </div>
      <p class="max-w-[62ch] text-lg leading-relaxed text-base-content/80 lg:col-span-5">Every service takes a set amount of chair time. You pay for that time at the level of whoever's cutting: the deeper the step, the more years in the chair.</p>
    </div>
    <div class="mt-12" data-rates data-reveal>
      <fieldset class="md:hidden">
        <legend class="board text-base-content/70">Who's cutting</legend>
        <div class="mt-3 flex flex-wrap gap-2">
          <label class="rate-chip" data-step="1"><input type="radio" name="grid-level" value="1"><span>1 · New talent</span></label>
          <label class="rate-chip" data-step="2"><input type="radio" name="grid-level" value="2" checked><span>2 · Barber &amp; stylist</span></label>
          <label class="rate-chip" data-step="3"><input type="radio" name="grid-level" value="3"><span>3 · Senior</span></label>
          <label class="rate-chip" data-step="4"><input type="radio" name="grid-level" value="4"><span>4 · Master</span></label>
        </div>
      </fieldset>
      <div class="mt-6 md:mt-0" data-fade>
        <table class="rates">
          <thead>
            <tr>
              <th scope="col" class="w-[38%] pr-4 pb-4 text-left align-bottom md:w-[34%]"><span class="board text-base-content/60">Chair time</span></th>
              <th scope="col" class="px-3 pt-4 pb-3 text-left align-bottom md:px-4" data-step="1" data-col="1"><span class="block"><span class="display block text-[2rem] md:text-[2.5rem]">1</span><span class="board mt-2 block">New talent</span></span></th>
              <th scope="col" class="px-3 pt-4 pb-3 text-left align-bottom md:px-4" data-step="2" data-col="2"><span class="block"><span class="display block text-[2rem] md:text-[2.5rem]">2</span><span class="board mt-2 block">Barber &amp; stylist</span></span></th>
              <th scope="col" class="px-3 pt-4 pb-3 text-left align-bottom md:px-4" data-step="3" data-col="3"><span class="block"><span class="display block text-[2rem] md:text-[2.5rem]">3</span><span class="board mt-2 block">Senior</span></span></th>
              <th scope="col" class="px-3 pt-4 pb-3 text-left align-bottom md:px-4" data-step="4" data-col="4"><span class="block"><span class="display block text-[2rem] md:text-[2.5rem]">4</span><span class="board mt-2 block">Master</span></span></th>
            </tr>
          </thead>
          <tbody>
            {% for rate in data.rates %}
            <tr>
              <th scope="row" class="py-4 pr-4 text-left align-top font-normal">
                <span class="flex items-baseline gap-2"><span class="display text-[2.25rem] md:text-[2.75rem]">{{ rate.minutes }}</span><span class="board text-base-content/60">min</span></span>
                {% if rate.usually != blank %}<span class="mt-1 block text-[0.9375rem] leading-snug text-base-content/70">{{ rate.usually }}</span>{% endif %}
              </th>
              <td class="px-3 py-4 md:px-4" data-step="1" data-col="1"><span class="figure block text-[1.25rem] md:text-[1.375rem]">{{ rate.price_1 }}</span></td>
              <td class="px-3 py-4 md:px-4" data-step="2" data-col="2"><span class="figure block text-[1.25rem] md:text-[1.375rem]">{{ rate.price_2 }}</span></td>
              <td class="px-3 py-4 md:px-4" data-step="3" data-col="3"><span class="figure block text-[1.25rem] md:text-[1.375rem]">{{ rate.price_3 }}</span></td>
              <td class="px-3 py-4 md:px-4" data-step="4" data-col="4"><span class="figure block text-[1.25rem] md:text-[1.375rem]">{{ rate.price_4 }}</span></td>
            </tr>
            {% endfor %}
          </tbody>
          <tfoot>
            <tr><td></td><td class="h-3" data-step="1" data-col="1"></td><td class="h-3" data-step="2" data-col="2"></td><td class="h-3" data-step="3" data-col="3"></td><td class="h-3" data-step="4" data-col="4"></td></tr>
          </tfoot>
        </table>
        <div class="mt-3 overflow-hidden rounded-full" data-fade="band" aria-hidden="true"><span data-step="1"></span><span data-step="2"></span><span data-step="3"></span><span data-step="4"></span></div>
      </div>
    </div>
  </div>
</section>
